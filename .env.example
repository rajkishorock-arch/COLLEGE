# ====================================================================
# CampusPulse — Production Environment Configuration Template
# ====================================================================

# 1. APPLICATION & SERVER SETTINGS
PORT=3000
NODE_ENV=production
SESSION_SECRET=replace_with_64_character_cryptographically_secure_random_string
SESSION_TIMEOUT_MINUTES=60
ALLOW_INSECURE_COOKIES=false
SHOW_DEMO_CREDENTIALS=false

# 2. DATABASE CONFIGURATION
# Set to 'sqlite' for local development; 'postgres' for production SaaS
DB_DIALECT=postgres
DATABASE_URL=postgresql://campuspulse_app:StrongSecurePassword@your-db-host:5432/campuspulse?sslmode=require
DB_POOL_MIN=5
DB_POOL_MAX=25
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
ALLOW_INSECURE_DB=false

# 3. OBJECT STORAGE CONFIGURATION
# Set to 'local' for local development; 's3' for production AWS S3 / Cloudflare R2 / MinIO
STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=campuspulse-production-storage
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY=your_access_key_id
OBJECT_STORAGE_SECRET_KEY=your_secret_access_key
MAX_UPLOAD_SIZE_BYTES=10485760

# 4. EMAIL & NOTIFICATION SETTINGS (SMTP or Resend API)
# Standard SMTP configuration (Gmail, Hostinger, AWS SES, Zoho)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=no-reply@yourcollege.edu
FROM_NAME=CampusPulse Platform
# Optional: Resend REST API (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key

# 5. PAYMENT GATEWAY SETTINGS (Razorpay)
# For real live card/UPI payments. If left empty, operates in smart sandbox gateway mode.
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# 6. AI & MACHINE LEARNING ASSISTANT (Google Gemini API)
# Connects the floating chatbot to live AI reasoning with real-time student database context
GEMINI_API_KEY=AIzaSy_your_gemini_api_key

# 7. OBSERVABILITY & RATE LIMITING
LOG_LEVEL=info
TEST_MODE=false
