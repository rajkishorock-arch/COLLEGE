<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password - CampusPulse</title>
  
  <!-- Anti-Flash Instant Theme Detection -->
  <script>
    (function() {
      try {
        const theme = localStorage.getItem('campuspulse-theme') || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Exact Google Fonts Pairing: Space Grotesk + Inter ONLY -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[var(--bg-primary)] text-[var(--text-primary)] min-h-screen flex flex-col justify-between p-4 py-8 transition-colors duration-200">

  <div class="max-w-md w-full mx-auto flex items-center justify-between mb-4 fade-slide-up">
    <a href="/login" class="text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] flex items-center gap-1.5 transition-colors">
      <i class="fa-solid fa-arrow-left text-xs"></i>
      <span>Back to Sign In</span>
    </a>
    <%- include('partials/theme-toggle') %>
  </div>

  <div class="w-full max-w-md mx-auto">
    <!-- Header Brand -->
    <div class="text-center mb-6 fade-slide-up">
      <div class="w-14 h-14 rounded-[12px] bg-[var(--accent-primary)] text-white flex items-center justify-center text-2xl mx-auto shadow-lg shadow-[var(--accent-glow)] mb-3">
        <i class="fa-solid fa-key"></i>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-[var(--text-primary)] tracking-tight font-['Space_Grotesk']">CAMPUS<span class="text-[var(--accent-primary)]">PULSE</span></h1>
      <p class="text-[#5B5F6B] text-sm mt-1">Institutional Password Recovery</p>
    </div>

    <!-- Recovery Card -->
    <div class="card fade-slide-up stagger-1">
      
      <div class="mb-7">
        <div class="flex items-center gap-2 mb-2">
          <span class="status-pill text-xs font-semibold badge-accent">
            Step <%= step %> of 2
          </span>
        </div>
        <h2 class="text-2xl font-bold text-[#111318] tracking-tight font-['Space_Grotesk']">
          <%= step === 1 ? 'Find Your Account' : 'Security Verification' %>
        </h2>
        <p class="text-sm text-[#5B5F6B] mt-1.5 leading-relaxed">
          <%= step === 1 ? 'Enter your institutional email address to retrieve your security challenge.' : 'Answer your chosen security question to securely update your password.' %>
        </p>
      </div>

      <!-- Alerts -->
      <% if (error) { %>
        <div class="flash-alert flash-alert-error mb-6 p-4 rounded-[8px] bg-[#FEECEE] border border-[var(--danger)] text-[#E5384B] text-xs sm:text-sm font-medium flex items-center gap-3">
          <i class="fa-solid fa-circle-exclamation text-base shrink-0"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <% if (step === 1) { %>
        <!-- Step 1: Email Form -->
        <form action="/forgot-password/verify" method="POST" class="space-y-5">
          <div>
            <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-2">
              Registered Email Address *
            </label>
            <div class="input-icon-wrapper">
              <div class="input-icon">
                <i class="fa-solid fa-envelope"></i>
              </div>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="e.g. alex@college.edu or admin@college.edu"
                value="<%= email || '' %>"
                class="w-full pr-4 py-3 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] placeholder-[#8B8F99] focus:border-[var(--accent-primary)] focus:outline-none transition-all"
              />
            </div>
            <p class="text-[11px] text-[#8B8F99] mt-2">Enter the email associated with your student or staff profile.</p>
          </div>

          <button 
            type="submit" 
            class="btn-primary w-full py-3.5 text-sm font-semibold rounded-[8px] flex items-center justify-center gap-2.5"
          >
            <span class="btn-text">Find Account & Continue</span>
            <i class="fa-solid fa-arrow-right text-xs btn-text"></i>
          </button>
        </form>

      <% } else { %>
        <!-- Step 2: Answer Question and Set New Password -->
        <form action="/forgot-password/reset" method="POST" class="space-y-5">
          <input type="hidden" name="email" value="<%= email %>">

          <!-- Account badge -->
          <div class="p-3 rounded-[8px] bg-[#F7F7F9] border border-[#E5E7EB] flex items-center justify-between text-xs">
            <span class="text-[#5B5F6B] truncate">Account: <strong class="text-[#111318]"><%= email %></strong></span>
            <a href="/forgot-password" class="text-[var(--accent-primary)] hover:underline shrink-0 text-[11px] font-semibold">Change</a>
          </div>

          <!-- Question Display -->
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-2">
              Your Security Question
            </label>
            <div class="p-3.5 rounded-[8px] bg-[#FFFFFF] border border-[#E5E7EB] text-sm font-medium text-[#111318] flex items-center gap-3">
              <i class="fa-solid fa-circle-question text-[var(--accent-primary)] text-base shrink-0"></i>
              <span><%= question %></span>
            </div>
          </div>

          <!-- Answer Input -->
          <div>
            <label for="security_answer" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-2">
              Security Answer *
            </label>
            <input 
              type="text" 
              id="security_answer" 
              name="security_answer" 
              required 
              placeholder="Enter your confidential answer"
              autocomplete="off"
              class="w-full px-4 py-3 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] placeholder-[#8B8F99] focus:border-[var(--accent-primary)] focus:outline-none transition-all"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="new_password" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-2">
                New Password *
              </label>
              <input 
                type="password" 
                id="new_password" 
                name="new_password" 
                required 
                minlength="6"
                placeholder="••••••••"
                class="w-full px-4 py-3 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] placeholder-[#8B8F99] focus:border-[var(--accent-primary)] focus:outline-none transition-all"
              />
            </div>

            <div>
              <label for="confirm_password" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-2">
                Confirm *
              </label>
              <input 
                type="password" 
                id="confirm_password" 
                name="confirm_password" 
                required 
                minlength="6"
                placeholder="••••••••"
                class="w-full px-4 py-3 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] placeholder-[#8B8F99] focus:border-[var(--accent-primary)] focus:outline-none transition-all"
              />
            </div>
          </div>

          <button 
            type="submit" 
            class="btn-primary w-full py-3.5 text-sm font-semibold rounded-[8px] flex items-center justify-center gap-2.5 mt-2"
          >
            <i class="fa-solid fa-lock-open btn-text"></i>
            <span class="btn-text">Reset & Update Password</span>
          </button>
        </form>
      <% } %>

      <!-- Back to login -->
      <div class="mt-7 text-center text-xs text-[#5B5F6B] pt-5 border-t border-[#E5E7EB]">
        Remember your password? 
        <a href="/login" class="font-semibold text-[var(--accent-primary)] hover:underline ml-1">
          Back to Sign In
        </a>
      </div>

    </div>

    <!-- Security info -->
    <p class="text-center text-xs text-[#8B8F99] mt-6 font-medium">
      Security answers are verified securely via one-way bcrypt hashing
    </p>
  </div>

  <script src="/js/main.js"></script>
</body>
</html>
