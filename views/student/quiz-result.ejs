<!-- Quiz Auto-Graded Result Report (Exact Dark Theme & Typography Spec) -->
<div class="max-w-3xl mx-auto space-y-[48px]">

  <!-- Score Summary Hero Card -->
  <div class="card relative overflow-hidden text-center" style="--i: 1;">
    
    <% if (percentage >= 75) { %>
      <!-- Celebratory Confetti Burst Particles -->
      <div class="confetti-container absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
        <div class="confetti-piece" style="left: 8%; animation-delay: 0s; background-color: var(--accent-primary);"></div>
        <div class="confetti-piece" style="left: 22%; animation-delay: 0.12s; background-color: var(--success);"></div>
        <div class="confetti-piece" style="left: 38%; animation-delay: 0.05s; background-color: var(--warning);"></div>
        <div class="confetti-piece" style="left: 54%; animation-delay: 0.18s; background-color: var(--accent-primary-hover);"></div>
        <div class="confetti-piece" style="left: 72%; animation-delay: 0.08s; background-color: var(--success);"></div>
        <div class="confetti-piece" style="left: 88%; animation-delay: 0.22s; background-color: var(--accent-primary);"></div>
      </div>
    <% } %>

    <div class="w-16 h-16 mx-auto rounded-[12px] <%= percentage >= 75 ? 'bg-[#E8F8EE] text-[var(--success)] border border-[#A7F3D0] celebration-pulse' : (passed ? 'bg-[#E8F8EE] text-[var(--success)] border border-[#A7F3D0]' : 'bg-[#FEECEE] text-[var(--danger)] border border-[#FECDD3]') %> flex items-center justify-center text-2xl mb-4 relative z-10">
      <i class="fa-solid <%= passed ? 'fa-award' : 'fa-triangle-exclamation' %>"></i>
    </div>

    <span class="status-pill text-xs font-semibold mb-3 relative z-10 <%= percentage >= 75 ? 'badge-success' : (passed ? 'badge-success' : 'badge-danger') %>">
      <%= percentage >= 75 ? '🎉 Outstanding Performance!' : (passed ? 'Assessment Passed' : 'Assessment Needs Improvement') %>
    </span>

    <h1 class="page-title text-[#111318] relative z-10">
      <%= quiz.title %>
    </h1>
    <p class="body-text mt-1 relative z-10 text-xs text-[#5B5F6B]">Course Module: <%= quiz.subject %></p>

    <!-- Score Big Box with Hero Metric Number & Count-Up Animation -->
    <div class="my-6 p-6 max-w-sm mx-auto bg-[#FFFFFF] rounded-[8px] border border-[#E5E7EB]">
      <span class="stat-label text-[#8B8F99] block mb-2">Final Evaluation Score</span>
      <div class="metric-number <%= passed ? 'text-[var(--success)]' : 'text-[var(--danger)]' %>">
        <span id="score-count-up" data-target-score="<%= score %>"><%= score %></span> <span class="text-2xl text-[#8B8F99] font-bold">/ <%= total %></span>
      </div>
      <p class="text-xs font-semibold text-[#5B5F6B] mt-2">Overall Accuracy: <%= percentage %>%</p>
    </div>

    <div class="flex items-center justify-center gap-4">
      <a 
        href="/student/quiz/<%= quiz.id %>" 
        class="btn-secondary py-2.5 px-5 text-xs font-medium"
      >
        <i class="fa-solid fa-rotate-left"></i>
        <span>Retake Quiz</span>
      </a>
      <a 
        href="/student/quiz" 
        class="btn-primary py-2.5 px-5 text-xs font-semibold"
      >
        <i class="fa-solid fa-list-check"></i>
        <span>All Quizzes</span>
      </a>
    </div>

  </div>

  <!-- Question by Question Breakdown -->
  <div class="space-y-6" style="--i: 2;">
    <div class="flex items-start gap-3.5 px-1">
      <div class="w-10 h-10 rounded-[8px] bg-[#F0EDFD] text-[var(--accent-primary)] flex items-center justify-center text-base shrink-0 mt-0.5 border border-[var(--border-subtle)]">
        <i class="fa-solid fa-clipboard-check"></i>
      </div>
      <div>
        <h2 class="section-title">Detailed Question Review</h2>
        <p class="text-muted-desc">Examine correct choices alongside your submitted responses</p>
      </div>
    </div>

    <div class="space-y-4">
      <% breakdown.forEach((item) => { %>
        <div class="card space-y-4 border <%= item.isCorrect ? 'border-[#A7F3D0] bg-[#FFFFFF]' : 'border-[#FECDD3] bg-[#FFFFFF]' %>">
          
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-start gap-3.5">
              <span class="w-7 h-7 rounded-[6px] <%= item.isCorrect ? 'bg-[rgba(46,213,115,0.2)] text-[var(--success)]' : 'bg-[rgba(255,71,87,0.2)] text-[var(--danger)]' %> flex items-center justify-center text-xs font-bold shrink-0 mt-0.5 font-['Space_Grotesk']">
                <%= item.number %>
              </span>
              <h3 class="card-title text-[#111318] leading-snug text-base"><%= item.question %></h3>
            </div>
            <span class="status-pill text-xs font-semibold shrink-0 <%= item.isCorrect ? 'badge-success' : 'badge-danger' %>">
              <i class="fa-solid <%= item.isCorrect ? 'fa-check' : 'fa-xmark' %> mr-1"></i>
              <%= item.isCorrect ? 'Correct' : 'Incorrect' %>
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs pt-2">
            <div class="p-4 rounded-[8px] <%= item.isCorrect ? 'bg-[#FFFFFF] border border-[rgba(46,213,115,0.25)] text-[#111318]' : 'bg-[#FFFFFF] border border-[rgba(255,71,87,0.25)] text-[#111318]' %>">
              <span class="stat-label text-[#8B8F99] block mb-1">Your Answer:</span>
              <span class="font-bold uppercase text-[var(--accent-primary)] font-['Space_Grotesk']">Option <%= item.selectedOption %>:</span>
              <span class="font-medium text-[#111318]"><%= item['option_' + item.selectedOption] || 'None' %></span>
            </div>

            <div class="p-4 rounded-[8px] bg-[#FFFFFF] border border-[#E5E7EB] text-[#111318]">
              <span class="stat-label text-[#8B8F99] block mb-1">Correct Answer:</span>
              <span class="font-bold uppercase text-[var(--success)] font-['Space_Grotesk']">Option <%= item.correctOption %>:</span>
              <span class="font-medium text-[#111318]"><%= item['option_' + item.correctOption] %></span>
            </div>
          </div>

        </div>
      <% }); %>
    </div>
  </div>

</div>
