<div class="space-y-[48px]">

  <!-- Header -->
  <div class="card" style="--i: 1;">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold badge-accent mb-2">
          <i class="fa-solid fa-calendar-days"></i>
          <span>Academic Schedule</span>
        </div>
        <h1 class="page-title text-[#111318]">Weekly Class Timetable</h1>
        <p class="body-text mt-1.5 text-sm">Schedule of enrolled lectures, laboratory sessions, and assigned halls for <%= studentCourse %></p>
      </div>

      <span class="status-pill text-xs font-semibold badge-accent">
        <%= totalSlots %> Weekly Class Slots
      </span>
    </div>
  </div>

  <!-- Weekly Grid: Days as Columns -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4">
    <% days.forEach((day, dIdx) => { %>
      <% const daySlots = timetableByDay[day] || []; %>
      <div class="card p-4 flex flex-col justify-start" style="--i: <%= dIdx + 2 %>;">
        
        <!-- Day Column Header -->
        <div class="pb-3 mb-3 border-b border-[#E5E7EB] flex items-center justify-between">
          <h3 class="font-bold text-[#111318] text-sm font-['Space_Grotesk']"><%= day %></h3>
          <span class="text-[10px] text-[#8B8F99] font-mono"><%= daySlots.length %> classes</span>
        </div>

        <!-- Class Slots in Day -->
        <% if (daySlots.length > 0) { %>
          <div class="space-y-3">
            <% daySlots.forEach(slot => { %>
              <div class="p-3 rounded-[8px] bg-[#FFFFFF] border border-[#E5E7EB] hover:border-[var(--accent-primary)] transition-all">
                <div class="text-[11px] font-mono text-[var(--accent-primary)] font-semibold mb-1">
                  <%= slot.start_time %> - <%= slot.end_time %>
                </div>
                <div class="font-bold text-[#111318] text-xs leading-snug">
                  <%= slot.subject %>
                </div>
                <div class="text-[10px] text-[#5B5F6B] mt-1.5 flex items-center gap-1">
                  <i class="fa-solid fa-door-open text-[#8B8F99]"></i>
                  <span><%= slot.room || 'Classroom' %></span>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="py-8 text-center text-[#8B8F99] text-xs">
            <i class="fa-regular fa-calendar-xmark text-lg mb-1 block"></i>
            <span>No Lectures Scheduled</span>
          </div>
        <% } %>

      </div>
    <% }); %>
  </div>

</div>
