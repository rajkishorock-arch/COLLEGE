<!-- Student Library Portal (Exact Dark Theme & Typography Spec) -->
<div class="space-y-[48px]">

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4" style="--i: 1;">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#F0EDFD] border border-[#DDD6FE] text-[var(--accent-primary)] text-xs font-semibold mb-2">
        <i class="fa-solid fa-book-open-reader"></i>
        <span>Campus Library Services</span>
      </div>
      <h1 class="page-title text-[#111318]">
        Library & Circulation Portal
      </h1>
      <p class="body-text mt-1.5 max-w-2xl text-sm">
        Browse available textbooks, view active borrowed materials, and monitor due dates to prevent overdue holds.
      </p>
    </div>
  </div>

  <!-- My Borrowed Books Section -->
  <div class="card" style="--i: 2;">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <div class="flex items-start gap-3.5">
        <div class="w-10 h-10 rounded-[8px] bg-[#FEF6E7] text-[var(--warning)] flex items-center justify-center text-base shrink-0 mt-0.5 border border-[var(--border-subtle)]">
          <i class="fa-solid fa-book-bookmark"></i>
        </div>
        <div>
          <h2 class="section-title">My Active Loans & Circulation</h2>
          <p class="text-muted-desc">Books currently checked out to your student account and return schedules</p>
        </div>
      </div>
      <span class="status-pill text-xs font-semibold badge-accent self-start sm:self-center">
        <%= myIssuedBooks.filter(b => b.status === 'Issued').length %> Currently Issued
      </span>
    </div>

    <% if (myIssuedBooks && myIssuedBooks.length > 0) { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[20px]">
        <% myIssuedBooks.forEach(issue => { %>
          <div class="p-6 rounded-[8px] border <%= issue.isOverdue ? 'border-[var(--danger)] bg-[rgba(255,71,87,0.06)]' : (issue.status === 'Returned' ? 'border-[#E5E7EB] bg-[#FFFFFF]' : 'border-[#DDD6FE] bg-[rgba(108,92,231,0.06)]') %> flex flex-col justify-between card-interactive">
            <div>
              <div class="flex items-start justify-between gap-2 mb-3">
                <span class="label-caps px-2.5 py-0.5 rounded-[6px] bg-[#FFFFFF] border border-[#E5E7EB] text-[#5B5F6B]">
                  <%= issue.category %>
                </span>
                <% if (issue.status === 'Returned') { %>
                  <span class="status-pill text-xs font-semibold text-[#5B5F6B] bg-[#F7F7F9] border border-[#E5E7EB]">
                    Returned
                  </span>
                <% } else if (issue.isOverdue) { %>
                  <span class="status-pill text-xs font-bold badge-danger">
                    Overdue
                  </span>
                <% } else { %>
                  <span class="status-pill text-xs font-semibold badge-success">
                    Active Loan
                  </span>
                <% } %>
              </div>

              <h3 class="card-title text-[#111318] leading-snug text-base"><%= issue.title %></h3>
              <p class="text-xs text-[#5B5F6B] mt-1">Author: <%= issue.author %></p>
            </div>

            <div class="mt-5 pt-3.5 border-t border-[#E5E7EB] space-y-2 text-xs">
              <div class="flex items-center justify-between text-[#8B8F99]">
                <span>Issue Date:</span>
                <span class="font-medium text-[#5B5F6B]"><%= issue.issue_date %></span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-[#8B8F99]">Due Date:</span>
                <span class="font-bold <%= issue.isOverdue ? 'text-[var(--danger)]' : 'text-[#111318]' %>">
                  <%= issue.due_date %>
                </span>
              </div>
              <% if (issue.return_date) { %>
                <div class="flex items-center justify-between text-[#8B8F99]">
                  <span>Returned on:</span>
                  <span class="font-semibold text-[var(--success)]"><%= issue.return_date %></span>
                </div>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="py-12 text-center text-[#8B8F99] bg-[#FFFFFF] rounded-[8px] border border-[#E5E7EB]">
        <div class="w-12 h-12 rounded-[12px] bg-[#FFFFFF] text-[#8B8F99] flex items-center justify-center text-xl mx-auto mb-3 border border-[#E5E7EB]">
          <i class="fa-solid fa-book-bookmark"></i>
        </div>
        <p class="font-bold text-[#111318] text-sm">No borrowed books on your account</p>
        <p class="text-xs text-[#5B5F6B] max-w-sm mx-auto mt-1">You currently have no checked-out titles. Browse the catalog below to find course textbooks.</p>
      </div>
    <% } %>
  </div>

  <!-- Central Library Catalog Section -->
  <div class="card p-0 overflow-hidden" style="--i: 3;">
    <div class="p-[28px] border-b border-[#E5E7EB] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-start gap-3.5">
        <div class="w-10 h-10 rounded-[8px] bg-[#F0EDFD] text-[var(--accent-primary)] flex items-center justify-center text-base shrink-0 mt-0.5 border border-[var(--border-subtle)]">
          <i class="fa-solid fa-book"></i>
        </div>
        <div>
          <h2 class="section-title">Explore Central Catalog</h2>
          <p class="text-muted-desc">Search textbook inventory, reference materials, and research publications</p>
        </div>
      </div>

      <!-- Search Form -->
      <form action="/student/library" method="GET" class="flex items-center gap-2 max-w-md w-full">
        <div class="relative flex-1">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#8B8F99] text-xs">
            <i class="fa-solid fa-magnifying-glass"></i>
          </div>
          <input 
            type="text" 
            name="q" 
            placeholder="Search title, author, or category..." 
            value="<%= searchQuery %>"
            class="w-full pl-9 pr-3.5 py-2 text-xs bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318] placeholder-[#8B8F99]"
          />
        </div>
        <button type="submit" class="btn-primary py-2 px-3.5 text-xs font-semibold shrink-0">
          <i class="fa-solid fa-search"></i>
          <span>Search</span>
        </button>
        <% if (searchQuery) { %>
          <a href="/student/library" class="px-2.5 py-2 text-[#5B5F6B] hover:text-[#111318] text-xs font-semibold">Clear</a>
        <% } %>
      </form>
    </div>

    <!-- Catalog Table -->
    <div class="overflow-x-auto">
      <table class="table-comfortable">
        <thead>
          <tr>
            <th>Book Title</th>
            <th>Author</th>
            <th>Category</th>
            <th class="text-center">Available Copies</th>
            <th class="text-right">Availability Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#E5E7EB]">
          <% if (allBooks && allBooks.length > 0) { %>
            <% allBooks.forEach(b => { %>
              <tr class="hover:bg-[#F7F7F9]/40 transition-colors">
                <td class="font-semibold text-[#111318]">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-[8px] bg-[#F0EDFD] text-[var(--accent-primary)] flex items-center justify-center text-xs shrink-0 border border-[var(--border-subtle)]">
                      <i class="fa-solid fa-book"></i>
                    </div>
                    <span><%= b.title %></span>
                  </div>
                </td>
                <td class="text-[#5B5F6B] text-xs font-medium"><%= b.author %></td>
                <td>
                  <span class="label-caps px-2.5 py-0.5 rounded-[6px] bg-[#FFFFFF] border border-[#E5E7EB] text-[#5B5F6B]">
                    <%= b.category %>
                  </span>
                </td>
                <td class="text-center font-bold text-[#111318] font-['Space_Grotesk']">
                  <%= b.available_copies %> <span class="text-[#8B8F99] font-normal">/ <%= b.total_copies %></span>
                </td>
                <td class="text-right">
                  <% if (b.available_copies > 0) { %>
                    <span class="status-pill text-xs font-semibold badge-success">
                      <i class="fa-solid fa-check text-[11px]"></i> In Stock
                    </span>
                  <% } else { %>
                    <span class="status-pill text-xs font-semibold badge-warning">
                      <i class="fa-solid fa-clock text-[11px]"></i> Checked Out
                    </span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="py-12 text-center text-[#8B8F99]">
                <div class="w-12 h-12 rounded-[12px] bg-[#FFFFFF] text-[#8B8F99] flex items-center justify-center text-xl mx-auto mb-3 border border-[#E5E7EB]">
                  <i class="fa-solid fa-book-open"></i>
                </div>
                <p class="font-bold text-[#111318] text-sm">No books found matching your search</p>
                <p class="text-xs text-[#5B5F6B] max-w-sm mx-auto mt-1">We couldn't find any titles for "<%= searchQuery %>". Try searching by broader subject terms or author names.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>

</div>
