<!-- Student Dashboard — Enterprise Higher Education SaaS -->
<div class="space-y-6">

  <!-- ========================================================================= -->
  <!-- 1. WELCOME BANNER & ACADEMIC STATUS                                       -->
  <!-- ========================================================================= -->
  <div class="card card-static p-6 sm:p-7 relative overflow-hidden bg-surface border border-subtle">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full badge-accent text-xs font-semibold tracking-wide mb-3">
          <span class="w-2 h-2 rounded-full" style="background-color: var(--success);"></span>
          <span>Active Academic Term 2026</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-primary tracking-tight">
          Welcome back, <%= user.name %>! 👋
        </h1>
        <p class="text-secondary text-sm mt-1.5 font-normal leading-relaxed">
          Roll Number: <span class="font-bold text-primary"><%= user.roll_no %></span> • Program: <span class="font-bold text-primary"><%= user.course %></span>
        </p>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-2.5 shrink-0 flex-wrap">
        <a href="/student/checkin" class="btn-primary !min-h-[42px] px-4 text-xs font-bold shadow-sm">
          <i class="fa-solid fa-qrcode text-xs"></i>
          <span>Self Check-In</span>
        </a>
        <a href="/student/attendance" class="btn-secondary !min-h-[42px] px-4 text-xs font-semibold">
          <i class="fa-solid fa-clipboard-user text-xs"></i>
          <span>Attendance</span>
        </a>
        <a href="/student/quiz" class="btn-secondary !min-h-[42px] px-4 text-xs font-semibold">
          <i class="fa-solid fa-pen-to-square text-xs"></i>
          <span>Take Quiz</span>
        </a>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 2. CORE ACADEMIC METRICS (4-Column Clean Grid)                            -->
  <!-- ========================================================================= -->
  <div class="stat-grid-4">
    
    <!-- 1. Attendance Metric -->
    <div class="stat-card-clean">
      <div>
        <div class="stat-header">
          <span class="stat-title">Attendance Rate</span>
          <div class="stat-icon" style="background-color: rgba(79, 70, 229, 0.08); color: var(--accent-primary);">
            <i class="fa-solid fa-clipboard-check"></i>
          </div>
        </div>
        <div class="flex items-baseline gap-3">
          <span class="stat-number" style="color: <%= stats.attendancePercentage >= 75 ? 'var(--success)' : 'var(--danger)' %>;">
            <%= stats.attendancePercentage %>%
          </span>
          <span class="status-pill text-[11px] font-bold <%= stats.attendancePercentage >= 75 ? 'badge-success' : 'badge-danger' %>">
            <%= stats.attendancePercentage >= 75 ? 'Eligible' : 'Shortage' %>
          </span>
        </div>
        <!-- Progress bar -->
        <div class="w-full h-1.5 rounded-full mt-3 overflow-hidden" style="background-color: var(--border-subtle);">
          <div class="h-full rounded-full transition-all duration-500" style="width: <%= Math.min(stats.attendancePercentage, 100) %>%; background-color: <%= stats.attendancePercentage >= 75 ? 'var(--success)' : 'var(--danger)' %>;"></div>
        </div>
      </div>
      <div class="stat-meta">
        <span><%= stats.attendedClasses %> of <%= stats.totalClasses %> sessions attended</span>
      </div>
    </div>

    <!-- 2. Cumulative Academic Average -->
    <div class="stat-card-clean">
      <div>
        <div class="stat-header">
          <span class="stat-title">Academic Score</span>
          <div class="stat-icon" style="background-color: rgba(22, 163, 74, 0.08); color: var(--success);">
            <i class="fa-solid fa-award"></i>
          </div>
        </div>
        <div class="flex items-baseline gap-3">
          <span class="stat-number">
            <%= stats.averageMarks %>%
          </span>
          <span class="status-pill text-[11px] font-bold badge-success">
            Cumulative
          </span>
        </div>
        <p class="text-xs text-secondary mt-2">
          Across <%= results.length %> evaluated course examinations.
        </p>
      </div>
      <div class="stat-meta">
        <a href="/student/results" class="text-accent font-bold hover:underline flex items-center gap-1">
          <span>Detailed Marksheets</span>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>
    </div>

    <!-- 3. Active Library Loans -->
    <div class="stat-card-clean">
      <div>
        <div class="stat-header">
          <span class="stat-title">Library Loans</span>
          <div class="stat-icon" style="background-color: rgba(217, 119, 6, 0.08); color: var(--warning);">
            <i class="fa-solid fa-book-bookmark"></i>
          </div>
        </div>
        <div class="flex items-baseline gap-3">
          <span class="stat-number">
            <%= stats.issuedBooksCount %>
          </span>
          <span class="status-pill text-[11px] font-bold <%= stats.issuedBooksCount > 0 ? 'badge-warning' : 'badge-accent' %>">
            Books Out
          </span>
        </div>
        <p class="text-xs text-secondary mt-2">
          Checked out on your institutional student card.
        </p>
      </div>
      <div class="stat-meta">
        <a href="/student/library" class="text-accent font-bold hover:underline flex items-center gap-1">
          <span>Library Catalog</span>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>
    </div>

    <!-- 4. Online Quizzes & Tests -->
    <div class="stat-card-clean">
      <div>
        <div class="stat-header">
          <span class="stat-title">Assessments</span>
          <div class="stat-icon" style="background-color: rgba(79, 70, 229, 0.08); color: var(--accent-primary);">
            <i class="fa-solid fa-pen-to-square"></i>
          </div>
        </div>
        <div class="flex items-baseline gap-3">
          <span class="stat-number">
            <%= stats.availableQuizzesCount %>
          </span>
          <span class="status-pill text-[11px] font-bold badge-accent">
            Available
          </span>
        </div>
        <p class="text-xs text-secondary mt-2">
          <%= stats.totalQuizzes %> published departmental quizzes.
        </p>
      </div>
      <div class="stat-meta">
        <a href="/student/quiz" class="text-accent font-bold hover:underline flex items-center gap-1">
          <span>Attempt Tests</span>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>
    </div>

  </div>

  <!-- ========================================================================= -->
  <!-- 3. TWO-COLUMN OPERATIONAL GRID                                            -->
  <!-- ========================================================================= -->
  <div class="dashboard-grid-main">
    
    <!-- LEFT COLUMN: Recent Attendance & Results (8 / 12) -->
    <div class="space-y-6">
      
      <!-- Recent Attendance Table Card -->
      <div class="card card-static p-5 sm:p-6">
        <div class="flex items-center justify-between mb-4 border-b border-subtle pb-3">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg badge-accent flex items-center justify-center text-xs">
              <i class="fa-solid fa-calendar-check"></i>
            </div>
            <div>
              <h2 class="text-base font-bold text-primary">Recent Class Attendance</h2>
              <p class="text-xs text-secondary">Verified records recorded by course instructors</p>
            </div>
          </div>
          <a href="/student/attendance" class="text-xs font-bold text-accent hover:underline flex items-center gap-1">
            <span>Full Record</span>
            <i class="fa-solid fa-arrow-right text-[10px]"></i>
          </a>
        </div>

        <% if (recentAttendance && recentAttendance.length > 0) { %>
          <div class="table-responsive-container">
            <table class="table-clean">
              <thead>
                <tr>
                  <th>Subject / Course</th>
                  <th>Session Date</th>
                  <th style="text-align: right;">Status</th>
                </tr>
              </thead>
              <tbody>
                <% recentAttendance.forEach(att => { %>
                  <tr>
                    <td class="font-bold">
                      <%= att.subject %>
                    </td>
                    <td class="text-secondary text-xs">
                      <%= att.date %>
                    </td>
                    <td style="text-align: right;">
                      <span class="status-pill text-xs font-bold <%= att.status === 'Present' ? 'badge-success' : 'badge-danger' %>">
                        <%= att.status === 'Present' ? '✓ Present' : '✗ Absent' %>
                      </span>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="p-8 text-center text-muted">
            <i class="fa-regular fa-calendar-xmark text-2xl mb-2 text-muted"></i>
            <p class="text-xs font-bold text-primary">No attendance records yet</p>
            <p class="text-[11px] text-secondary mt-0.5">Your professors haven't recorded roll call sessions yet.</p>
          </div>
        <% } %>
      </div>

      <!-- Recent Examination Results Card -->
      <div class="card card-static p-5 sm:p-6">
        <div class="flex items-center justify-between mb-4 border-b border-subtle pb-3">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg badge-success flex items-center justify-center text-xs">
              <i class="fa-solid fa-square-poll-vertical"></i>
            </div>
            <div>
              <h2 class="text-base font-bold text-primary">Semester Examination Results</h2>
              <p class="text-xs text-secondary">Evaluated grades published by the examination cell</p>
            </div>
          </div>
          <a href="/student/results" class="text-xs font-bold text-accent hover:underline flex items-center gap-1">
            <span>View All</span>
            <i class="fa-solid fa-arrow-right text-[10px]"></i>
          </a>
        </div>

        <% if (results && results.length > 0) { %>
          <div class="table-responsive-container">
            <table class="table-clean">
              <thead>
                <tr>
                  <th>Subject</th>
                  <th>Marks Obtained</th>
                  <th>Percentage</th>
                  <th style="text-align: right;">Grade</th>
                </tr>
              </thead>
              <tbody>
                <% results.forEach(res => { %>
                  <tr>
                    <td class="font-bold">
                      <%= res.subject %>
                    </td>
                    <td class="text-secondary text-xs">
                      <span class="font-bold text-primary"><%= res.marks_obtained %></span> / <%= res.max_marks %>
                    </td>
                    <td style="min-width: 120px;">
                      <div class="flex items-center gap-2 text-xs">
                        <div class="flex-1 h-1.5 rounded-full overflow-hidden" style="background-color: var(--border-subtle);">
                          <div class="h-full rounded-full" style="width: <%= res.percentage %>%; background-color: var(--accent-primary);"></div>
                        </div>
                        <span class="font-bold text-[11px]"><%= res.percentage %>%</span>
                      </div>
                    </td>
                    <td style="text-align: right;">
                      <span class="status-pill text-xs font-bold <%= res.grade.startsWith('A') ? 'badge-success' : 'badge-accent' %>">
                        <%= res.grade %>
                      </span>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="p-8 text-center text-muted">
            <i class="fa-regular fa-file-lines text-2xl mb-2 text-muted"></i>
            <p class="text-xs font-bold text-primary">No examination results published yet</p>
            <p class="text-[11px] text-secondary mt-0.5">Grades will appear here once finalized by the controller of examinations.</p>
          </div>
        <% } %>
      </div>

    </div>

    <!-- RIGHT COLUMN: Notice Board & Library / Quick Tools (4 / 12) -->
    <div class="space-y-6">
      
      <!-- Notice Board / Announcements -->
      <div class="card card-static p-5 sm:p-6 space-y-4">
        <div class="flex items-center justify-between border-b border-subtle pb-3">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-bullhorn text-xs" style="color: var(--accent-primary);"></i>
            <h3 class="text-sm font-bold text-primary">Campus Notices</h3>
          </div>
          <a href="/student/announcements" class="text-[11px] font-bold text-accent hover:underline">
            View All
          </a>
        </div>

        <% if (announcements && announcements.length > 0) { %>
          <div class="space-y-3">
            <% announcements.forEach(a => { %>
              <div class="p-3.5 rounded-xl border border-subtle bg-surface-hover space-y-1.5">
                <div class="flex items-center justify-between text-[10px]">
                  <span class="status-pill py-0.5 px-2 font-bold <%= a.priority === 'urgent' ? 'badge-danger' : 'badge-accent' %>">
                    <%= a.priority.toUpperCase() %>
                  </span>
                  <span class="text-muted"><%= new Date(a.created_at).toLocaleDateString([], { month: 'short', day: 'numeric' }) %></span>
                </div>
                <h4 class="text-xs font-bold text-primary leading-tight"><%= a.title %></h4>
                <p class="text-[11px] text-secondary line-clamp-2 leading-relaxed"><%= a.body %></p>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="p-6 text-center text-muted">
            <i class="fa-regular fa-bell text-xl mb-1 text-muted"></i>
            <p class="text-xs font-semibold text-secondary">No notices right now</p>
            <p class="text-[10px] text-muted">All active campus updates will show here.</p>
          </div>
        <% } %>
      </div>

      <!-- Active Library Books Card -->
      <div class="card card-static p-5 sm:p-6 space-y-4">
        <div class="flex items-center justify-between border-b border-subtle pb-3">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-book-bookmark text-xs" style="color: var(--warning);"></i>
            <h3 class="text-sm font-bold text-primary">Library Circulation</h3>
          </div>
          <a href="/student/library" class="text-[11px] font-bold text-accent hover:underline">
            Catalog
          </a>
        </div>

        <% if (issuedBooks && issuedBooks.length > 0) { %>
          <div class="space-y-2.5">
            <% issuedBooks.forEach(b => { %>
              <div class="p-3 rounded-xl border border-subtle bg-surface flex items-center justify-between text-xs">
                <div>
                  <p class="font-bold text-primary text-xs truncate max-w-[180px]"><%= b.title %></p>
                  <p class="text-[10px] text-muted mt-0.5">Due: <%= b.due_date %></p>
                </div>
                <span class="status-pill text-[10px] font-bold <%= b.isOverdue ? 'badge-danger' : 'badge-warning' %>">
                  <%= b.isOverdue ? 'Overdue' : 'Borrowed' %>
                </span>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="p-6 text-center text-muted">
            <i class="fa-solid fa-book-open text-xl mb-1 text-muted"></i>
            <p class="text-xs font-semibold text-secondary">No books currently borrowed</p>
            <a href="/student/library" class="text-[11px] text-accent font-bold hover:underline inline-block mt-1">Browse College Library →</a>
          </div>
        <% } %>
      </div>

      <!-- Quick Academic Links -->
      <div class="card card-static p-5 space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-muted">Direct Shortcuts</h3>
        <div class="space-y-1.5 text-xs">
          <a href="/student/timetable" class="flex items-center justify-between p-2 rounded-lg hover:bg-surface-hover transition-colors font-medium text-secondary hover:text-primary">
            <span class="flex items-center gap-2">
              <i class="fa-solid fa-calendar-days text-xs text-accent"></i>
              <span>Weekly Class Timetable</span>
            </span>
            <i class="fa-solid fa-chevron-right text-[10px] text-muted"></i>
          </a>
          <a href="/student/assignments" class="flex items-center justify-between p-2 rounded-lg hover:bg-surface-hover transition-colors font-medium text-secondary hover:text-primary">
            <span class="flex items-center gap-2">
              <i class="fa-solid fa-file-arrow-up text-xs text-accent"></i>
              <span>Assignments & Submissions</span>
            </span>
            <i class="fa-solid fa-chevron-right text-[10px] text-muted"></i>
          </a>
          <a href="/student/fees" class="flex items-center justify-between p-2 rounded-lg hover:bg-surface-hover transition-colors font-medium text-secondary hover:text-primary">
            <span class="flex items-center gap-2">
              <i class="fa-solid fa-receipt text-xs text-accent"></i>
              <span>Tuition Fee Receipts</span>
            </span>
            <i class="fa-solid fa-chevron-right text-[10px] text-muted"></i>
          </a>
        </div>
      </div>

    </div>

  </div>

</div>
