<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Sign Up - CampusPulse Multi-Tenant Platform' %></title>
  
  <!-- Anti-Flash Instant Theme Detection -->
  <script>
    (function() {
      try {
        const theme = localStorage.getItem('campuspulse-theme') || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Google Fonts Pairing: Space Grotesk + Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[var(--bg-primary)] text-[var(--text-primary)] min-h-screen flex flex-col justify-between p-4 py-6 sm:py-10 transition-colors duration-200">

  <!-- Header with Brand & Theme Toggle -->
  <div class="max-w-2xl w-full mx-auto flex items-center justify-between mb-6 fade-slide-up">
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-10 h-10 rounded-[10px] bg-[var(--accent-primary)] text-white flex items-center justify-center text-lg shadow-md shadow-[var(--accent-glow)] group-hover:scale-105 transition-transform">
        <i class="fa-solid fa-graduation-cap"></i>
      </div>
      <div>
        <span class="text-xl font-bold font-['Space_Grotesk'] text-[var(--text-primary)] tracking-tight">CAMPUS<span class="text-[var(--accent-primary)]">PULSE</span></span>
        <span class="block text-[10px] text-[var(--text-muted)] uppercase tracking-wider font-semibold">Autonomous SaaS Platform</span>
      </div>
    </a>

    <div class="flex items-center gap-3">
      <%- include('partials/theme-toggle') %>
    </div>
  </div>

  <!-- Form Card Container -->
  <div class="w-full max-w-2xl mx-auto">
    <div class="card p-6 sm:p-8 fade-slide-up stagger-1">
      
      <!-- Tab Switcher (Institution vs Student) -->
      <div class="flex items-center p-1 rounded-[10px] bg-[var(--bg-surface-hover)] border border-[var(--border-subtle)] mb-8">
        <button 
          type="button" 
          id="tab-btn-institution" 
          onclick="switchTab('institution')"
          class="flex-1 py-2.5 px-3 rounded-[8px] text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition-all <%= (!activeTab || activeTab === 'institution') ? 'bg-[var(--bg-surface)] text-[var(--accent-primary)] shadow-sm' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]' %>"
        >
          <i class="fa-solid fa-building-columns"></i>
          <span>Register New Institution</span>
          <span class="hidden md:inline-block px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-[rgba(108,92,231,0.12)] text-[var(--accent-primary)]">SaaS Owner</span>
        </button>

        <button 
          type="button" 
          id="tab-btn-student" 
          onclick="switchTab('student')"
          class="flex-1 py-2.5 px-3 rounded-[8px] text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition-all <%= (activeTab === 'student') ? 'bg-[var(--bg-surface)] text-[var(--accent-primary)] shadow-sm' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]' %>"
        >
          <i class="fa-solid fa-user-graduate"></i>
          <span>Join as Student</span>
        </button>
      </div>

      <!-- Error Alert -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 p-4 rounded-[8px] bg-[#FEECEE] dark:bg-red-950/40 border border-[var(--danger)] text-[#E5384B] dark:text-red-400 text-xs sm:text-sm font-medium flex items-center gap-3">
          <i class="fa-solid fa-circle-exclamation text-base shrink-0"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <!-- TAB 1: REGISTER INSTITUTION (Self-Service SaaS) -->
      <div id="tab-content-institution" class="<%= (!activeTab || activeTab === 'institution') ? '' : 'hidden' %>">
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-[var(--text-primary)] tracking-tight font-['Space_Grotesk']">
            Create Your Institution
          </h2>
          <p class="text-sm text-[var(--text-secondary)] mt-1">
            Register your college, university, or academy. You will automatically become the institution owner and tenant administrator.
          </p>
        </div>

        <form action="/register-institution" method="POST" class="space-y-5">
          <input type="hidden" name="signup_type" value="institution">

          <!-- Section: Administrator Identity -->
          <div class="p-4 rounded-[10px] bg-[var(--bg-surface-hover)] border border-[var(--border-subtle)] space-y-4">
            <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--accent-primary)] flex items-center gap-2">
              <i class="fa-solid fa-user-shield"></i>
              <span>1. Institution Owner / Administrator Identity</span>
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="admin_name" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                  Your Full Legal Name *
                </label>
                <input 
                  type="text" 
                  id="admin_name" 
                  name="full_name" 
                  required 
                  placeholder="e.g. Dr. Arthur Pendelton"
                  value="<%= typeof formData !== 'undefined' && (formData.full_name || formData.name) ? (formData.full_name || formData.name) : '' %>"
                  class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
                />
              </div>

              <div>
                <label for="admin_email" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                  Official / Work Email *
                </label>
                <input 
                  type="email" 
                  id="admin_email" 
                  name="email" 
                  required 
                  placeholder="dean@college.edu"
                  value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
                  class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="admin_password" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                  Master Password (min 6 chars) *
                </label>
                <input 
                  type="password" 
                  id="admin_password" 
                  name="password" 
                  required 
                  minlength="6"
                  placeholder="••••••••"
                  class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
                />
              </div>

              <div>
                <label for="admin_confirm_password" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                  Confirm Password *
                </label>
                <input 
                  type="password" 
                  id="admin_confirm_password" 
                  name="confirm_password" 
                  required 
                  minlength="6"
                  placeholder="••••••••"
                  class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
                />
              </div>
            </div>
          </div>

          <!-- Section: Institution Profile -->
          <div class="p-4 rounded-[10px] bg-[var(--bg-surface-hover)] border border-[var(--border-subtle)] space-y-4">
            <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--accent-primary)] flex items-center gap-2">
              <i class="fa-solid fa-school"></i>
              <span>2. Institutional Credentials & Data Plane</span>
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="inst_name" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                  Official Institution / College Name *
                </label>
                <input 
                  type="text" 
                  id="inst_name" 
                  name="institution_name" 
                  required 
                  placeholder="e.g. Stanford Polytechnic Institute"
                  value="<%= typeof formData !== 'undefined' && formData.institution_name ? formData.institution_name : '' %>"
                  class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
                />
              </div>

              <div>
                <label for="inst_type" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                  Institution Type
                </label>
                <select id="inst_type" name="institution_type" class="w-full px-4 py-2.5 rounded-[8px] border text-sm">
                  <option value="university">University</option>
                  <option value="college" selected>College of Higher Education</option>
                  <option value="engineering">Institute of Technology / Engineering</option>
                  <option value="medical">Medical & Health Sciences Institute</option>
                  <option value="business">Business & Management School</option>
                  <option value="academy">Polytechnic / Academy</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="inst_code" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                  Institution Code <span class="text-[var(--text-muted)] font-normal">(Optional)</span>
                </label>
                <input 
                  type="text" 
                  id="inst_code" 
                  name="institution_code" 
                  placeholder="e.g. SPI, MIT, OXFORD"
                  class="w-full px-4 py-2.5 rounded-[8px] border text-sm uppercase"
                />
              </div>

              <div>
                <label for="inst_phone" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                  Contact Phone <span class="text-[var(--text-muted)] font-normal">(Optional)</span>
                </label>
                <input 
                  type="text" 
                  id="inst_phone" 
                  name="phone" 
                  placeholder="+1 (555) 234-5678"
                  class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
                />
              </div>
            </div>

            <div>
              <label for="dept_name" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                Initial Department <span class="font-normal text-[var(--text-muted)] lowercase">(optional)</span>
              </label>
              <input 
                type="text" 
                id="dept_name" 
                name="default_department" 
                value="<%= typeof formData !== 'undefined' && formData.default_department ? formData.default_department : '' %>"
                placeholder="e.g. Civil, Medicine, English, or leave empty"
                class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
              />
              <p class="text-[11px] text-[var(--text-muted)] mt-1">
                Optional: You can configure departments tailored to your academic discipline in Step 2 of the setup wizard.
              </p>
            </div>
          </div>

          <div class="p-3.5 rounded-[8px] bg-[rgba(108,92,231,0.06)] border border-[rgba(108,92,231,0.2)] text-xs text-[var(--text-secondary)] flex items-start gap-2.5">
            <i class="fa-solid fa-lock text-[var(--accent-primary)] mt-0.5"></i>
            <span>
              By creating an institution, you will be automatically provisioned as its verified <strong>Tenant Administrator & Owner</strong> with autonomous management authority.
            </span>
          </div>

          <button 
            type="submit" 
            class="btn-primary w-full py-3.5 text-base font-bold shadow-lg shadow-[var(--accent-glow)]"
          >
            <span>Create Institution & Start Setup</span>
            <i class="fa-solid fa-arrow-right ml-2 text-xs"></i>
          </button>
        </form>
      </div>

      <!-- TAB 2: JOIN AS STUDENT (Enrollment) -->
      <div id="tab-content-student" class="<%= (activeTab === 'student') ? '' : 'hidden' %>">
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-[var(--text-primary)] tracking-tight font-['Space_Grotesk']">
            Student Enrollment Profile
          </h2>
          <p class="text-sm text-[var(--text-secondary)] mt-1">
            Register your academic student identity to access course timetables, quizzes, results, and attendance records.
          </p>
        </div>

        <form action="/signup" method="POST" class="space-y-4">
          <input type="hidden" name="signup_type" value="student">

          <div>
            <label for="student_tenant_id" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
              Select Your Institution / College *
            </label>
            <select 
              id="student_tenant_id" 
              name="tenant_id" 
              required
              class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
            >
              <% if (typeof tenants !== 'undefined' && tenants && tenants.length > 0) { %>
                <% tenants.forEach(t => { %>
                  <option value="<%= t.id %>" <%= (typeof selectedTenantId !== 'undefined' && selectedTenantId === t.id) ? 'selected' : '' %>>
                    <%= t.name %> (<%= t.code %>)
                  </option>
                <% }); %>
              <% } else { %>
                <option value="tenant_default" selected>CampusPulse Institute of Technology (DEFAULT)</option>
              <% } %>
            </select>
          </div>

          <div>
            <label for="student_name" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
              Full Legal Name *
            </label>
            <input 
              type="text" 
              id="student_name" 
              name="name" 
              required 
              placeholder="e.g. Alex Johnson"
              class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="student_email" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                Email Address *
              </label>
              <input 
                type="email" 
                id="student_email" 
                name="email" 
                required 
                placeholder="alex@college.edu"
                class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
              />
            </div>

            <div>
              <label for="student_roll_no" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                Roll Number / Student ID *
              </label>
              <input 
                type="text" 
                id="student_roll_no" 
                name="roll_no" 
                required 
                placeholder="CS-2026-089"
                class="w-full px-4 py-2.5 rounded-[8px] border text-sm uppercase"
              />
            </div>
          </div>

          <div>
            <label for="student_course" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
              Academic Course / Program *
            </label>
            <input 
              type="text" 
              id="student_course" 
              name="course" 
              required 
              placeholder="e.g. B.Tech Computer Science"
              class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="student_password" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                Password *
              </label>
              <input 
                type="password" 
                id="student_password" 
                name="password" 
                required 
                minlength="6"
                placeholder="••••••••"
                class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
              />
            </div>

            <div>
              <label for="student_confirm_password" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                Confirm Password *
              </label>
              <input 
                type="password" 
                id="student_confirm_password" 
                name="confirm_password" 
                required 
                minlength="6"
                placeholder="••••••••"
                class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
              />
            </div>
          </div>

          <button 
            type="submit" 
            class="btn-primary w-full py-3 text-sm font-semibold"
          >
            <span>Complete Student Enrollment</span>
            <i class="fa-solid fa-arrow-right ml-2 text-xs"></i>
          </button>
        </form>
      </div>

      <!-- Redirect to Sign In -->
      <div class="mt-8 pt-6 border-t border-[var(--border-subtle)] text-center text-xs text-[var(--text-secondary)]">
        Already have an account? 
        <a href="/login" class="font-bold text-[var(--accent-primary)] hover:underline ml-1">
          Sign In to Portal
        </a>
      </div>

    </div>
  </div>

  <!-- Bottom Brand Footer -->
  <footer class="text-center text-xs text-[var(--text-muted)] mt-8">
    <p>&copy; <%= new Date().getFullYear() %> CampusPulse Enterprise • Autonomous Multi-Tenant Architecture</p>
  </footer>

  <script src="/js/main.js"></script>
  <script>
    function switchTab(tab) {
      const instBtn = document.getElementById('tab-btn-institution');
      const studBtn = document.getElementById('tab-btn-student');
      const instContent = document.getElementById('tab-content-institution');
      const studContent = document.getElementById('tab-content-student');

      if (tab === 'institution') {
        instBtn.className = 'flex-1 py-2.5 px-3 rounded-[8px] text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition-all bg-[var(--bg-surface)] text-[var(--accent-primary)] shadow-sm';
        studBtn.className = 'flex-1 py-2.5 px-3 rounded-[8px] text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition-all text-[var(--text-secondary)] hover:text-[var(--text-primary)]';
        instContent.classList.remove('hidden');
        studContent.classList.add('hidden');
      } else {
        studBtn.className = 'flex-1 py-2.5 px-3 rounded-[8px] text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition-all bg-[var(--bg-surface)] text-[var(--accent-primary)] shadow-sm';
        instBtn.className = 'flex-1 py-2.5 px-3 rounded-[8px] text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition-all text-[var(--text-secondary)] hover:text-[var(--text-primary)]';
        studContent.classList.remove('hidden');
        instContent.classList.add('hidden');
      }
    }
  </script>
</body>
</html>
