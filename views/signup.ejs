<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Sign Up - CampusPulse' %></title>
  
  <!-- Anti-Flash Instant Theme Detection -->
  <script>
    (function() {
      try {
        const theme = localStorage.getItem('campuspulse-theme') || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Google Fonts: Space Grotesk + Google Sans Flex + Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,slnt,wdth,wght,ROND@8..144,-10..0,25..150,400..700,0..100&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&display=swap">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-white dark:bg-[#090C15] text-gray-900 dark:text-gray-100 antialiased overflow-x-hidden selection:bg-emerald-500 selection:text-white">

  <!-- ========================================================================= -->
  <!-- Split Screen Authentication Layout (1:1 Match with User Reference)       -->
  <!-- ========================================================================= -->
  <div class="auth-split-container">
    
    <!-- LEFT: FORM COLUMN -->
    <div class="auth-form-column">
      <div class="w-full max-w-md mx-auto py-6">
        
        <!-- Top Row: Back to Home + Theme Switcher -->
        <div class="flex items-center justify-between mb-4">
          <a href="/" class="inline-flex items-center text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors group">
            <i class="fa-solid fa-arrow-left text-xs mr-2 transition-transform duration-200 group-hover:-translate-x-0.5"></i>
            <span>Back to Home</span>
          </a>
          <%- include('partials/theme-toggle') %>
        </div>

        <!-- Brand Title: CampusPulse -->
        <div class="mb-4">
          <h1 class="text-3xl sm:text-4xl font-black text-gray-900 dark:text-white tracking-tight font-['Space_Grotesk',sans-serif]">
            CampusPulse
          </h1>
        </div>

        <!-- Heading: Create an Account -->
        <div class="mb-5">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white tracking-tight mb-1.5 font-['Space_Grotesk',sans-serif]">
            Create an Account
          </h2>
          <p class="text-sm text-gray-500 dark:text-gray-400">
            Have an account? 
            <a href="/login" class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">
              Log in now
            </a>
          </p>
        </div>

        <!-- Role Toggle Capsule: Student | Institution Admin -->
        <div class="flex bg-gray-100 dark:bg-gray-800/80 p-1 gap-1 mb-5 rounded-full w-full border border-gray-200 dark:border-gray-700">
          <button 
            type="button" 
            id="tab-btn-student"
            onclick="switchAuthRole('student')"
            class="flex-1 py-2 px-3 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 <%= (!activeTab || activeTab === 'student') ? 'bg-[#00ed64] text-[#001e2b] shadow-xs' : 'text-gray-600 dark:text-gray-300 hover:text-gray-900' %>"
          >
            <i class="fa-solid fa-user-graduate mr-1.5 text-xs"></i>
            <span>Student</span>
          </button>
          <button 
            type="button" 
            id="tab-btn-institution"
            onclick="switchAuthRole('institution')"
            class="flex-1 py-2 px-3 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 <%= (activeTab === 'institution') ? 'bg-[#00ed64] text-[#001e2b] shadow-xs' : 'text-gray-600 dark:text-gray-300 hover:text-gray-900' %>"
          >
            <i class="fa-solid fa-building-columns mr-1.5 text-xs"></i>
            <span>Institution Admin</span>
          </button>
        </div>

        <!-- Flash Alert Messages -->
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="p-3.5 mb-4 rounded-xl text-xs sm:text-sm flex items-start gap-2.5 bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-300">
            <i class="fa-solid fa-circle-exclamation text-base shrink-0 mt-0.5 text-red-500"></i>
            <span class="font-medium"><%= error %></span>
          </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
          <div class="p-3.5 mb-4 rounded-xl text-xs sm:text-sm flex items-start gap-2.5 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300">
            <i class="fa-solid fa-circle-check text-base shrink-0 mt-0.5 text-emerald-500"></i>
            <span class="font-medium"><%= success %></span>
          </div>
        <% } %>

        <!-- Sign Up with Google Button -->
        <button 
          type="button" 
          onclick="handleGoogleSignupNotice()" 
          class="auth-google-btn mb-4"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
          </svg>
          <span class="font-medium text-gray-700 dark:text-gray-200">Sign up with Google</span>
        </button>

        <!-- Divider -->
        <div class="relative mb-4">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-gray-200 dark:border-gray-800"></div>
          </div>
          <div class="relative flex justify-center text-xs">
            <span class="px-3 bg-white dark:bg-[#090C15] text-gray-400 font-medium">
              Or with email and password
            </span>
          </div>
        </div>

        <!-- ================= STUDENT FORM ================= -->
        <form 
          id="form-student" 
          action="/signup" 
          method="POST" 
          class="space-y-3 <%= (activeTab === 'institution') ? 'hidden' : '' %>"
        >
          <input type="hidden" name="signup_type" value="student">

          <div>
            <input 
              type="text" 
              name="name" 
              required 
              placeholder="Full Name" 
              value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>"
              class="auth-clean-input"
            />
          </div>

          <div>
            <input 
              type="email" 
              name="email" 
              required 
              placeholder="Student Email (e.g. roll@college.edu)" 
              value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
              class="auth-clean-input"
            />
          </div>

          <div class="grid grid-cols-2 gap-2.5">
            <div>
              <input 
                type="text" 
                name="roll_no" 
                required 
                placeholder="Roll / Reg No" 
                value="<%= typeof formData !== 'undefined' && formData.roll_no ? formData.roll_no : '' %>"
                class="auth-clean-input"
              />
            </div>
            <div>
              <input 
                type="text" 
                name="course" 
                required 
                placeholder="Course / Branch" 
                value="<%= typeof formData !== 'undefined' && formData.course ? formData.course : '' %>"
                class="auth-clean-input"
              />
            </div>
          </div>

          <% if (typeof tenants !== 'undefined' && tenants && tenants.length > 0) { %>
          <div>
            <select name="tenant_id" class="auth-clean-input cursor-pointer">
              <% tenants.forEach(t => { %>
                <option value="<%= t.id %>" <%= (typeof selectedTenantId !== 'undefined' && selectedTenantId === t.id) ? 'selected' : '' %>>
                  <%= t.name %> (<%= t.code %>)
                </option>
              <% }); %>
            </select>
          </div>
          <% } %>

          <div class="grid grid-cols-2 gap-2.5">
            <div class="relative">
              <input 
                type="password" 
                id="student-password" 
                name="password" 
                required 
                placeholder="Password (min 6)" 
                class="auth-clean-input !pr-9"
              />
              <button 
                type="button" 
                onclick="togglePasswordVisibility('student-password', this)"
                class="absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-700 dark:hover:text-gray-200"
                style="background: transparent; border: none;"
              >
                <i class="fa-regular fa-eye text-xs"></i>
              </button>
            </div>
            <div>
              <input 
                type="password" 
                name="confirm_password" 
                required 
                placeholder="Confirm Password" 
                class="auth-clean-input"
              />
            </div>
          </div>

          <!-- Sign Up Submit Button with Ambient Orange Halo Glow -->
          <div class="auth-halo-button-wrapper pt-2">
            <div class="auth-halo-button-glow" aria-hidden="true"></div>
            <div class="auth-halo-button-border">
              <button type="submit" class="auth-halo-button-inner">
                <span>Create Student Account</span>
              </button>
            </div>
          </div>
        </form>

        <!-- ================= INSTITUTION ADMIN FORM ================= -->
        <form 
          id="form-institution" 
          action="/register-institution" 
          method="POST" 
          class="space-y-3 <%= (activeTab !== 'institution') ? 'hidden' : '' %>"
        >
          <input type="hidden" name="signup_type" value="institution">

          <div>
            <input 
              type="text" 
              name="institution_name" 
              required 
              placeholder="Institution Name (e.g. Apex Institute of Technology)" 
              value="<%= typeof formData !== 'undefined' && formData.institution_name ? formData.institution_name : '' %>"
              class="auth-clean-input"
            />
          </div>

          <div>
            <input 
              type="text" 
              name="name" 
              required 
              placeholder="Administrator Full Name" 
              value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>"
              class="auth-clean-input"
            />
          </div>

          <div>
            <input 
              type="email" 
              name="email" 
              required 
              placeholder="Official Administrator Email" 
              value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
              class="auth-clean-input"
            />
          </div>

          <div class="grid grid-cols-2 gap-2.5">
            <div class="relative">
              <input 
                type="password" 
                id="inst-password" 
                name="password" 
                required 
                placeholder="Password (min 6)" 
                class="auth-clean-input !pr-9"
              />
              <button 
                type="button" 
                onclick="togglePasswordVisibility('inst-password', this)"
                class="absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-700 dark:hover:text-gray-200"
                style="background: transparent; border: none;"
              >
                <i class="fa-regular fa-eye text-xs"></i>
              </button>
            </div>
            <div>
              <input 
                type="password" 
                name="confirm_password" 
                required 
                placeholder="Confirm Password" 
                class="auth-clean-input"
              />
            </div>
          </div>

          <!-- Register Institution Submit Button with Ambient Orange Halo Glow -->
          <div class="auth-halo-button-wrapper pt-2">
            <div class="auth-halo-button-glow" aria-hidden="true"></div>
            <div class="auth-halo-button-border">
              <button type="submit" class="auth-halo-button-inner">
                <span>Deploy Institution Workspace</span>
              </button>
            </div>
          </div>
        </form>

        <!-- Terms & Privacy Note -->
        <p class="text-[11px] text-gray-400 text-center mt-6">
          By signing up, you agree to CampusPulse's 
          <a href="#" class="underline hover:text-gray-600 dark:hover:text-gray-300">Terms of Service</a> and 
          <a href="#" class="underline hover:text-gray-600 dark:hover:text-gray-300">Privacy Policy</a>.
        </p>

      </div>
    </div>

    <!-- RIGHT: SHOWCASE IMAGE COLUMN (55-65% Desktop) -->
    <div class="auth-showcase-column">
      
      <!-- Ambient Glowing Orbs -->
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-[#00ed64]/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-[#00684a]/25 rounded-full blur-3xl pointer-events-none"></div>
      <div 
        class="absolute inset-0 pointer-events-none" 
        style="background: radial-gradient(circle at center, rgba(0, 237, 100, 0.12) 0%, transparent 70%);"
      ></div>

      <!-- Framed Workshop Photo Container (Hardware & Systems Lab) -->
      <div class="auth-showcase-frame">
        <img 
          src="https://images.pexels.com/photos/8438951/pexels-photo-8438951.jpeg" 
          alt="IoT Hardware & Embedded Systems Workshop" 
          class="auth-showcase-img"
        />
        
        <!-- Bottom Vignette Gradient -->
        <div class="auth-showcase-overlay"></div>

        <!-- Bottom Typography Overlay -->
        <div class="auth-showcase-content">
          <div class="auth-badge-pill">
            <span class="w-2 h-2 rounded-full bg-[#00ed64] animate-pulse"></span>
            <span>IOT &amp; CAMPUS CLOUD</span>
          </div>

          <h3 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-white mb-2 font-['Space_Grotesk',sans-serif]">
            Welcome to CampusPulse
          </h3>

          <p class="text-sm sm:text-base font-medium text-[#c1ccd6] max-w-lg leading-relaxed">
            Empowering the future with connected hardware, sensors &amp; intelligent edge campus automation.
          </p>
        </div>
      </div>

    </div>

  </div>

  <script src="/js/main.js"></script>
  <script>
    // Switch between Student and Institution registration tabs
    function switchAuthRole(role) {
      const studentForm = document.getElementById('form-student');
      const instForm = document.getElementById('form-institution');
      const studentBtn = document.getElementById('tab-btn-student');
      const instBtn = document.getElementById('tab-btn-institution');

      if (role === 'student') {
        studentForm.classList.remove('hidden');
        instForm.classList.add('hidden');
        studentBtn.className = 'flex-1 py-2 px-3 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 bg-[#00ed64] text-[#001e2b] shadow-xs';
        instBtn.className = 'flex-1 py-2 px-3 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 text-gray-600 dark:text-gray-300 hover:text-gray-900';
      } else {
        instForm.classList.remove('hidden');
        studentForm.classList.add('hidden');
        instBtn.className = 'flex-1 py-2 px-3 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 bg-[#00ed64] text-[#001e2b] shadow-xs';
        studentBtn.className = 'flex-1 py-2 px-3 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 text-gray-600 dark:text-gray-300 hover:text-gray-900';
      }
    }

    // Toggle Password Visibility
    function togglePasswordVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      const icon = btn.querySelector('i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      }
    }

    // Google Sign-up Notification
    function handleGoogleSignupNotice() {
      alert('Google OAuth Enrollment: Direct Google SSO will be provisioned by your verified institution administrator.');
    }
  </script>
</body>
</html>
