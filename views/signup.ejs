<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Registration - College Management Platform</title>
  
  <!-- Exact Google Fonts Pairing: Space Grotesk + Inter ONLY -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[#FFFFFF] text-[#111318] min-h-screen flex items-center justify-center p-4 py-8">

  <div class="w-full max-w-lg">
    <!-- Header Brand -->
    <div class="text-center mb-6 fade-slide-up">
      <div class="w-12 h-12 rounded-[12px] bg-[var(--accent-primary)] text-white flex items-center justify-center text-xl mx-auto shadow-lg shadow-[var(--accent-glow)] mb-3">
        <i class="fa-solid fa-user-plus"></i>
      </div>
      <h1 class="text-2xl font-bold text-[#111318] tracking-tight font-['Space_Grotesk']">CAMPUS<span class="text-[var(--accent-primary)]">PULSE</span></h1>
      <p class="text-[#5B5F6B] text-xs mt-1">Student Enrollment Portal</p>
    </div>

    <!-- Signup Card: 12px radius, 28px padding, --bg-surface, --border-subtle -->
    <div class="card fade-slide-up stagger-1">
      
      <div class="mb-7">
        <h2 class="text-2xl font-bold text-[#111318] tracking-tight font-['Space_Grotesk']">Create Student Profile</h2>
        <p class="text-sm text-[#5B5F6B] mt-1.5 leading-relaxed">Register your official academic identity to access courses, quizzes, and attendance records</p>
      </div>

      <!-- Error Alert -->
      <% if (error) { %>
        <div class="flash-alert flash-alert-error mb-6 p-4 rounded-[8px] bg-[#FEECEE] border border-[var(--danger)] text-[#E5384B] text-xs sm:text-sm font-medium flex items-center gap-3">
          <i class="fa-solid fa-circle-exclamation text-base shrink-0"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/signup" method="POST" class="space-y-5">
        
        <div>
          <label for="tenant_id" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-2">
            Institution / College *
          </label>
          <select 
            id="tenant_id" 
            name="tenant_id" 
            required
            class="w-full px-4 py-3 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] focus:border-[var(--accent-primary)] focus:outline-none"
          >
            <% if (typeof tenants !== 'undefined' && tenants && tenants.length > 0) { %>
              <% tenants.forEach(t => { %>
                <option value="<%= t.id %>" <%= (typeof selectedTenantId !== 'undefined' && selectedTenantId === t.id) || (typeof formData !== 'undefined' && formData.tenant_id === t.id) ? 'selected' : '' %>>
                  <%= t.name %> (<%= t.code %>)
                </option>
              <% }); %>
            <% } else { %>
              <option value="tenant_default" selected>CampusPulse Institute of Technology (DEFAULT)</option>
            <% } %>
          </select>
        </div>

        <div>
          <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-2">
            Full Legal Name *
          </label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            required 
            placeholder="e.g. Alex Johnson"
            value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>"
            class="w-full px-4 py-3 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] placeholder-[#8B8F99]"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-2">
              Email Address *
            </label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              placeholder="e.g. alex@college.edu"
              value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
              class="w-full px-4 py-3 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] placeholder-[#8B8F99]"
            />
          </div>

          <div>
            <label for="roll_no" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-2">
              Roll Number (Unique) *
            </label>
            <input 
              type="text" 
              id="roll_no" 
              name="roll_no" 
              required 
              placeholder="e.g. CS2026-045"
              value="<%= typeof formData !== 'undefined' && formData.roll_no ? formData.roll_no : '' %>"
              class="w-full px-4 py-3 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] uppercase placeholder-[#8B8F99]"
            />
          </div>
        </div>

        <div>
          <label for="course" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-2">
            Academic Course / Department *
          </label>
          <select 
            id="course" 
            name="course" 
            required 
            class="w-full px-4 py-3 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318]"
          >
            <option value="">Select your enrolled program</option>
            <option value="B.Tech Computer Science" <%= (typeof formData !== 'undefined' && formData.course === 'B.Tech Computer Science') ? 'selected' : '' %>>B.Tech Computer Science</option>
            <option value="B.Tech Information Technology" <%= (typeof formData !== 'undefined' && formData.course === 'B.Tech Information Technology') ? 'selected' : '' %>>B.Tech Information Technology</option>
            <option value="B.Tech AI & Data Science" <%= (typeof formData !== 'undefined' && formData.course === 'B.Tech AI & Data Science') ? 'selected' : '' %>>B.Tech AI & Data Science</option>
            <option value="B.Tech Electronics & Communication" <%= (typeof formData !== 'undefined' && formData.course === 'B.Tech Electronics & Communication') ? 'selected' : '' %>>B.Tech Electronics & Communication</option>
            <option value="B.Tech Mechanical Engineering" <%= (typeof formData !== 'undefined' && formData.course === 'B.Tech Mechanical Engineering') ? 'selected' : '' %>>B.Tech Mechanical Engineering</option>
            <option value="BCA / MCA" <%= (typeof formData !== 'undefined' && formData.course === 'BCA / MCA') ? 'selected' : '' %>>BCA / MCA</option>
          </select>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-2">
              Password (min 6) *
            </label>
            <input 
              type="password" 
              id="password" 
              name="password" 
              required 
              minlength="6"
              placeholder="••••••••"
              class="w-full px-4 py-3 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] placeholder-[#8B8F99]"
            />
          </div>

          <div>
            <label for="confirm_password" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-2">
              Confirm Password *
            </label>
            <input 
              type="password" 
              id="confirm_password" 
              name="confirm_password" 
              required 
              minlength="6"
              placeholder="••••••••"
              class="w-full px-4 py-3 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] placeholder-[#8B8F99]"
            />
          </div>
        </div>

        <div class="p-4 rounded-[8px] bg-[#F7F7F9] border border-[#E5E7EB] space-y-4">
          <div class="flex items-center gap-2 text-xs font-semibold text-[var(--accent-primary)] uppercase tracking-wider">
            <i class="fa-solid fa-shield-halved"></i>
            <span>Account Recovery Setup</span>
          </div>

          <div>
            <label for="security_question" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-2">
              Security Question *
            </label>
            <select 
              id="security_question" 
              name="security_question" 
              required 
              class="w-full px-4 py-3 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318]"
            >
              <option value="What is your favorite subject?">What is your favorite subject?</option>
              <option value="What was the name of your first school?">What was the name of your first school?</option>
              <option value="What is your hometown or city of birth?">What is your hometown or city of birth?</option>
              <option value="What was your first pet's name?">What was your first pet's name?</option>
            </select>
          </div>

          <div>
            <label for="security_answer" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-2">
              Security Answer (Case-Insensitive) *
            </label>
            <input 
              type="text" 
              id="security_answer" 
              name="security_answer" 
              required 
              placeholder="e.g. Computer Science"
              class="w-full px-4 py-3 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] placeholder-[#8B8F99]"
            />
            <p class="text-[11px] text-[#8B8F99] mt-1.5">This answer is hashed with bcrypt and used to recover your account if you forget your password.</p>
          </div>
        </div>

        <button 
          type="submit" 
          class="btn-primary w-full mt-3 py-3.5 text-sm font-semibold rounded-[8px] flex items-center justify-center gap-2.5"
        >
          <span class="btn-text">Complete Student Registration</span>
          <i class="fa-solid fa-arrow-right text-xs btn-text"></i>
        </button>
      </form>

      <!-- Back to login -->
      <div class="mt-7 text-center text-xs text-[#5B5F6B]">
        Already registered with the college? 
        <a href="/login" class="font-semibold text-[var(--accent-primary)] hover:underline ml-1">
          Sign In
        </a>
      </div>

    </div>
  </div>

  <script src="/js/main.js"></script>
</body>
</html>
