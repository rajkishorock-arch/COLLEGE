            <div>
              <label for="student_confirm_password" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                Confirm Password *
              </label>
              <input 
                type="password" 
                id="student_confirm_password" 
                name="confirm_password" 
                required 
                minlength="6"
                placeholder="••••••••"
                class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
              />
            </div>
          </div>

          <button 
            type="submit" 
            class="btn-primary w-full py-3.5 text-sm font-bold shadow-md shadow-[var(--accent-glow)] flex items-center justify-center gap-2"
          >
            <span>Complete Student Enrollment</span>
            <i class="fa-solid fa-arrow-right text-xs"></i>
          </button>
        </form>
      </div>

      <!-- Redirect to Sign In -->
      <div class="mt-8 pt-6 border-t border-[var(--border-subtle)] text-center text-xs text-[var(--text-secondary)]">
        Already have an institutional account? 
        <a href="/login" class="font-bold text-[var(--accent-primary)] hover:underline ml-1">
          Sign In to Portal
        </a>
      </div>

    </div>
  </div>

  <!-- Bottom Brand Footer -->
  <footer class="text-center text-xs text-[var(--text-muted)] mt-8 space-y-1">
    <p>&copy; <%= new Date().getFullYear() %> CampusPulse Enterprise • Autonomous Multi-Tenant Architecture</p>
    <p class="text-[11px] text-[var(--text-muted)]">Bank-Grade 256-bit Encryption • DPDP Act & GDPR Ready • AICTE Registry Connected</p>
  </footer>

  <!-- Modal for Legal Terms -->
  <div id="legal-modal" class="fixed inset-0 z-50 bg-black/60 hidden backdrop-blur-sm flex items-center justify-center p-4">
    <div class="card max-w-lg w-full p-6 shadow-2xl space-y-4">
      <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-3">
        <h3 id="modal-title" class="text-base font-bold text-[var(--text-primary)]">Policy Details</h3>
        <button type="button" onclick="closeModal()" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] text-lg">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div id="modal-body" class="text-xs text-[var(--text-secondary)] max-h-72 overflow-y-auto space-y-2 leading-relaxed">
        <!-- Content injected via JavaScript -->
      </div>
      <div class="text-right pt-2 border-t border-[var(--border-subtle)]">
        <button type="button" onclick="closeModal()" class="btn-primary px-4 py-2 text-xs font-bold">I Understand</button>
      </div>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script>
    // Tab Switcher
    function switchTab(tab) {
      const instBtn = document.getElementById('tab-btn-institution');
      const studBtn = document.getElementById('tab-btn-student');
      const instContent = document.getElementById('tab-content-institution');
      const studContent = document.getElementById('tab-content-student');

      if (tab === 'institution') {
        instBtn.className = 'flex-1 py-2.5 px-3 rounded-[8px] text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition-all bg-[var(--bg-surface)] text-[var(--accent-primary)] shadow-sm';
        studBtn.className = 'flex-1 py-2.5 px-3 rounded-[8px] text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition-all text-[var(--text-secondary)] hover:text-[var(--text-primary)]';
        instContent.classList.remove('hidden');
        studContent.classList.add('hidden');
      } else {
        studBtn.className = 'flex-1 py-2.5 px-3 rounded-[8px] text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition-all bg-[var(--bg-surface)] text-[var(--accent-primary)] shadow-sm';
        instBtn.className = 'flex-1 py-2.5 px-3 rounded-[8px] text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition-all text-[var(--text-secondary)] hover:text-[var(--text-primary)]';
        studContent.classList.remove('hidden');
        instContent.classList.add('hidden');
      }
    }

    // Multi-Step Form Logic
    let currentStep = 1;
    function goToStep(step) {
      // Validate Step 1 before proceeding
      if (step === 2 && currentStep === 1) {
        const name = document.getElementById('admin_name').value.trim();
        const email = document.getElementById('admin_email').value.trim();
        const pwd = document.getElementById('admin_password').value;
        const confirmPwd = document.getElementById('admin_confirm_password').value;
        const phone = document.getElementById('inst_phone').value.trim();

        if (!name || !email || !pwd || !phone) {
          alert('Please fill in all required fields on Step 1 (Name, Email, Password, Phone).');
          return;
        }

        if (pwd.length < 12) {
          alert('Master Password must be at least 12 characters long according to institutional security policy.');
          return;
        }

        if (pwd !== confirmPwd) {
          alert('Passwords do not match. Please re-enter your password.');
          return;
        }
      }

      // Validate Step 2 before proceeding
      if (step === 3 && currentStep === 2) {
        const instName = document.getElementById('inst_name').value.trim();
        const instCode = document.getElementById('inst_code').value.trim();
        if (!instName || !instCode) {
          alert('Please provide your official Institution Name and Institution Code.');
          return;
        }
      }

      currentStep = step;

      // Update step visibility
      document.getElementById('step-1-content').classList.toggle('hidden', step !== 1);
      document.getElementById('step-2-content').classList.toggle('hidden', step !== 2);
      document.getElementById('step-3-content').classList.toggle('hidden', step !== 3);

      // Update progress bar
      const bar = document.getElementById('step-progress-bar');
      const text = document.getElementById('step-indicator-text');
      const pct = document.getElementById('step-percent-text');

      if (step === 1) {
        bar.style.width = '33.33%';
        text.innerText = 'Step 1 of 3: Administrator Identity & Security';
        pct.innerText = '33% Completed';
        document.getElementById('step-label-1').className = 'font-bold text-[var(--accent-primary)]';
        document.getElementById('step-label-2').className = 'text-[var(--text-muted)]';
        document.getElementById('step-label-3').className = 'text-[var(--text-muted)]';
      } else if (step === 2) {
        bar.style.width = '66.66%';
        text.innerText = 'Step 2 of 3: Institution Credentials & Data Region';
        pct.innerText = '66% Completed';
        document.getElementById('step-label-1').className = 'text-emerald-500 font-semibold';
        document.getElementById('step-label-2').className = 'font-bold text-[var(--accent-primary)]';
        document.getElementById('step-label-3').className = 'text-[var(--text-muted)]';
      } else if (step === 3) {
        bar.style.width = '100%';
        text.innerText = 'Step 3 of 3: Subscription Plan & Compliance';
        pct.innerText = '100% Ready';
        document.getElementById('step-label-1').className = 'text-emerald-500 font-semibold';
        document.getElementById('step-label-2').className = 'text-emerald-500 font-semibold';
        document.getElementById('step-label-3').className = 'font-bold text-[var(--accent-primary)]';
      }

      window.scrollTo({ top: 120, behavior: 'smooth' });
    }

    // Password Visibility Toggle
    function togglePasswordVisibility(inputId, iconId) {
      const input = document.getElementById(inputId);
      const icon = document.getElementById(iconId);
      if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'fa-solid fa-eye-slash text-[11px]';
      } else {
        input.type = 'password';
        icon.className = 'fa-solid fa-eye text-[11px]';
      }
    }

    // Password Strength Meter
    function updatePasswordStrength() {
      const pwd = document.getElementById('admin_password').value;
      const bar = document.getElementById('pwd-strength-bar');
      const label = document.getElementById('pwd-strength-label');

      const chkLen = pwd.length >= 12;
      const chkUpper = /[A-Z]/.test(pwd);
      const chkLower = /[a-z]/.test(pwd);
      const chkNum = /[0-9]/.test(pwd);
      const chkSpec = /[^A-Za-z0-9]/.test(pwd);

      updateCheckPill('chk-length', chkLen);
      updateCheckPill('chk-cases', chkUpper && chkLower);
      updateCheckPill('chk-number', chkNum);
      updateCheckPill('chk-special', chkSpec);

      let score = 0;
      if (chkLen) score += 35;
      if (chkUpper && chkLower) score += 25;
      if (chkNum) score += 20;
      if (chkSpec) score += 20;

      bar.style.width = Math.max(10, score) + '%';
      if (score >= 90) {
        bar.className = 'h-full bg-emerald-500 transition-all duration-300';
        label.className = 'font-bold text-emerald-500';
        label.innerText = 'Very Strong';
      } else if (score >= 65) {
        bar.className = 'h-full bg-amber-500 transition-all duration-300';
        label.className = 'font-bold text-amber-500';
        label.innerText = 'Medium';
      } else {
        bar.className = 'h-full bg-red-500 transition-all duration-300';
        label.className = 'font-bold text-red-500';
        label.innerText = 'Weak (Needs 12+ chars & symbols)';
      }

      checkPasswordMatch();
    }

    function updateCheckPill(id, passed) {
      const el = document.getElementById(id);
      if (passed) {
        el.className = 'text-emerald-600 dark:text-emerald-400 font-semibold flex items-center gap-1.5';
        el.querySelector('i').className = 'fa-solid fa-check text-[10px]';
      } else {
        el.className = 'text-[var(--text-muted)] flex items-center gap-1.5';
        el.querySelector('i').className = 'fa-solid fa-circle text-[8px]';
      }
    }

    function checkPasswordMatch() {
      const p1 = document.getElementById('admin_password').value;
      const p2 = document.getElementById('admin_confirm_password').value;
      const msg = document.getElementById('pwd-match-msg');
      if (p2.length > 0 && p1 !== p2) {
        msg.classList.remove('hidden');
      } else {
        msg.classList.add('hidden');
      }
    }

    // Email OTP Verification
    let generatedDevOtp = '';
    async function requestEmailOtp() {
      const email = document.getElementById('admin_email').value.trim();
      if (!email || !email.includes('@')) {
        alert('Please enter a valid official email address first.');
        return;
      }

      const btn = document.getElementById('btn-send-otp');
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';

      try {
        const res = await fetch('/api/auth/send-verification-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        const data = await res.json();

        if (data.success) {
          document.getElementById('otp-verify-box').classList.remove('hidden');
          const msg = document.getElementById('otp-status-msg');
          msg.className = 'text-xs font-medium text-emerald-600 dark:text-emerald-400';
          msg.innerText = data.message;

          // Dev helper pill
          if (data.devOtp) {
            generatedDevOtp = data.devOtp;
            document.getElementById('dev-otp-pill').classList.remove('hidden');
            document.getElementById('dev-otp-code-btn').innerText = data.devOtp;
          }

          startOtpTimer(600);
        } else {
          alert(data.message || 'Could not send verification OTP.');
        }
      } catch (err) {
        alert('Network error sending verification code.');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-rotate-right"></i> Resend OTP';
      }
    }

    function fillDevOtp() {
      if (generatedDevOtp) {
        document.getElementById('otp-input').value = generatedDevOtp;
        confirmEmailOtp();
      }
    }

    async function confirmEmailOtp() {
      const email = document.getElementById('admin_email').value.trim();
      const otp = document.getElementById('otp-input').value.trim();
      if (!otp) return;

      try {
        const res = await fetch('/api/auth/verify-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, otp })
        });
        const data = await res.json();
        const msg = document.getElementById('otp-status-msg');

        if (data.success) {
          msg.className = 'text-xs font-bold text-emerald-600 dark:text-emerald-400';
          msg.innerText = '✓ ' + data.message;
          document.getElementById('email-verified-badge').classList.remove('hidden');
          document.getElementById('btn-send-otp').classList.add('hidden');
        } else {
          msg.className = 'text-xs font-semibold text-red-500';
          msg.innerText = '✗ ' + data.message;
        }
      } catch (e) {
        alert('Verification request failed.');
      }
    }

    let timerInterval = null;
    function startOtpTimer(seconds) {
      if (timerInterval) clearInterval(timerInterval);
      const timerEl = document.getElementById('otp-timer');
      let remaining = seconds;

      timerInterval = setInterval(() => {
        remaining--;
        const m = Math.floor(remaining / 60);
        const s = remaining % 60;
        timerEl.innerText = `${m}:${s < 10 ? '0' : ''}${s}`;
        if (remaining <= 0) {
          clearInterval(timerInterval);
          timerEl.innerText = 'Expired';
        }
      }, 1000);
    }

    // AICTE / UGC National Institution Lookup
    let lookupDebounce = null;
    function handleInstitutionInput(val) {
      clearTimeout(lookupDebounce);
      const dropdown = document.getElementById('inst-lookup-dropdown');

      if (!val || val.trim().length < 2) {
        dropdown.classList.add('hidden');
        dropdown.innerHTML = '';
        return;
      }

      lookupDebounce = setTimeout(async () => {
        try {
          const res = await fetch('/api/institutions/lookup?q=' + encodeURIComponent(val));
          const data = await res.json();

          if (data.success && data.results && data.results.length > 0) {
            dropdown.innerHTML = data.results.map(inst => `
              <div 
                onclick="selectInstitution('${inst.name.replace(/'/g, "\\'")}', '${inst.code}', '${inst.aicteCode}', '${inst.type}')" 
                class="p-3 hover:bg-[var(--bg-surface-hover)] cursor-pointer transition-colors"
              >
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-[var(--text-primary)]">${inst.name}</span>
                  <span class="text-[10px] font-semibold text-emerald-600 bg-emerald-100 dark:bg-emerald-950/60 px-1.5 py-0.5 rounded">
                    ${inst.aicteCode}
                  </span>
                </div>
                <div class="text-[11px] text-[var(--text-muted)] mt-0.5 flex items-center gap-2">
                  <span>${inst.category}</span> • <span>${inst.state}</span>
                </div>
              </div>
            `).join('');
            dropdown.classList.remove('hidden');
          } else {
            dropdown.classList.add('hidden');
          }
        } catch (e) {
          dropdown.classList.add('hidden');
        }
      }, 250);
    }

    function selectInstitution(name, code, aicteCode, type) {
      document.getElementById('inst_name').value = name;
      document.getElementById('inst_code').value = code;
      document.getElementById('aicte_code').value = aicteCode;
      document.getElementById('inst_type').value = type || 'engineering';
      document.getElementById('inst-lookup-dropdown').classList.add('hidden');
      document.getElementById('aicte-badge').classList.remove('hidden');
    }

    // Close autocomplete on click outside
    document.addEventListener('click', (e) => {
      const dropdown = document.getElementById('inst-lookup-dropdown');
      if (!dropdown.contains(e.target) && e.target.id !== 'inst_name') {
        dropdown.classList.add('hidden');
      }
    });

    // Plan Card Selection Styling
    document.querySelectorAll('.plan-card input[type="radio"]').forEach(radio => {
      radio.addEventListener('change', () => {
        document.querySelectorAll('.plan-card').forEach(c => {
          c.classList.remove('border-2', 'border-[var(--accent-primary)]', 'bg-[rgba(108,92,231,0.04)]');
          c.classList.add('border', 'border-[var(--border-subtle)]', 'bg-[var(--bg-surface)]');
        });
        const card = radio.closest('.plan-card');
        card.classList.remove('border', 'border-[var(--border-subtle)]');
        card.classList.add('border-2', 'border-[var(--accent-primary)]', 'bg-[rgba(108,92,231,0.04)]');
      });
    });

    // Legal Policy Modals
    function openModal(type) {
      const modal = document.getElementById('legal-modal');
      const title = document.getElementById('modal-title');
      const body = document.getElementById('modal-body');

      if (type === 'terms') {
        title.innerText = 'CampusPulse SaaS Terms of Service';
        body.innerHTML = `
          <p><strong>1. Institutional License:</strong> CampusPulse grants your higher education institution a non-exclusive license to administer academic data, student records, and institutional attendance operations.</p>
          <p><strong>2. Autonomous Tenant Isolation:</strong> Every institution is provisioned with cryptographically separated database rows adhering to PostgreSQL Row-Level Security (RLS) standards.</p>
          <p><strong>3. Uptime & SLA Guarantee:</strong> 99.95% production uptime commitment with automated daily cryptographic backups and failover.</p>
        `;
      } else if (type === 'privacy') {
        title.innerText = 'CampusPulse Privacy Policy (DPDP & GDPR Compliant)';
        body.innerHTML = `
          <p><strong>1. Data Sovereignty:</strong> Student records and sensitive institutional PII are localized within your chosen geographic data plane (India, Europe, or US).</p>
          <p><strong>2. Encryption:</strong> AES-256 at rest and TLS 1.3 in transit.</p>
          <p><strong>3. Zero Third-Party Monetization:</strong> CampusPulse never sells, analyzes, or shares student or faculty personal data with advertisers.</p>
        `;
      } else {
        title.innerText = 'Data Processing Agreement (DPA)';
        body.innerHTML = `
          <p><strong>1. Educational Role:</strong> The institution acts as the Data Controller; CampusPulse acts as the Data Processor.</p>
          <p><strong>2. Right to Erasure & Portability:</strong> Complete JSON/SQL/CSV export of institutional rosters and logs available on demand.</p>
        `;
      }

      modal.classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('legal-modal').classList.add('hidden');
    }
  </script>
</body>
</html>
