            <!-- Legal & Compliance Checkboxes (Critique Item 3) -->
            <div class="p-4 rounded-[10px] bg-[var(--bg-surface-hover)] border border-[var(--border-subtle)] space-y-3">
              <div class="flex items-start gap-2.5">
                <input 
                  type="checkbox" 
                  id="terms_accepted" 
                  name="terms_accepted" 
