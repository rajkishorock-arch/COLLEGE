  <script src="/js/main.js"></script>
  <script>
    // Tab Switcher
    function switchTab(tab) {
      const instBtn = document.getElementById('tab-btn-institution');
      const studBtn = document.getElementById('tab-btn-student');
      const instContent = document.getElementById('tab-content-institution');
      const studContent = document.getElementById('tab-content-student');

      if (tab === 'institution') {
        instBtn.classList.add('active');
        studBtn.classList.remove('active');
        instContent.classList.remove('hidden');
        studContent.classList.add('hidden');
      } else {
        studBtn.classList.add('active');
        instBtn.classList.remove('active');
        studContent.classList.remove('hidden');
        instContent.classList.add('hidden');
      }
    }

    // Multi-Step Form Logic
    let currentStep = 1;
    function goToStep(step) {
      // Validate Step 1 before proceeding
      if (step === 2 && currentStep === 1) {
        const name = document.getElementById('admin_name').value.trim();
        const email = document.getElementById('admin_email').value.trim();
        const pwd = document.getElementById('admin_password').value;
        const confirmPwd = document.getElementById('admin_confirm_password').value;
        const phone = document.getElementById('inst_phone').value.trim();

        if (!name || !email || !pwd || !phone) {
          alert('Please fill in all required fields on Step 1 (Name, Email, Password, Phone).');
          return;
        }

        if (pwd.length < 12) {
          alert('Administrator password must be at least 12 characters long according to institutional security policy.');
          return;
        }

        if (pwd !== confirmPwd) {
          alert('Passwords do not match. Please re-enter your password.');
          return;
        }
      }

      // Validate Step 2 before proceeding
      if (step === 3 && currentStep === 2) {
        const instName = document.getElementById('inst_name').value.trim();
        const instCode = document.getElementById('inst_code').value.trim();
        if (!instName || !instCode) {
          alert('Please provide your official Institution Name and Institution Code.');
          return;
        }
      }

      currentStep = step;

      // Update step visibility
      document.getElementById('step-1-content').classList.toggle('hidden', step !== 1);
      document.getElementById('step-2-content').classList.toggle('hidden', step !== 2);
      document.getElementById('step-3-content').classList.toggle('hidden', step !== 3);

      // Update visual stepper nodes and connector lines
      const node1 = document.getElementById('step-node-1');
      const node2 = document.getElementById('step-node-2');
      const node3 = document.getElementById('step-node-3');
      const line1 = document.getElementById('step-line-1');
      const line2 = document.getElementById('step-line-2');
      const dot1 = document.getElementById('step-dot-1');
      const dot2 = document.getElementById('step-dot-2');
      const dot3 = document.getElementById('step-dot-3');
      const eyebrow = document.getElementById('stepper-eyebrow');
      const title = document.getElementById('stepper-title');
      const pct = document.getElementById('stepper-percent');

      // Reset states
      [node1, node2, node3].forEach(n => {
        n.classList.remove('active', 'completed');
      });
      [line1, line2].forEach(l => l.classList.remove('completed'));
      dot1.innerHTML = '1';
      dot2.innerHTML = '2';
      dot3.innerHTML = '3';

      if (step === 1) {
        node1.classList.add('active');
        eyebrow.innerText = 'STEP 01';
        title.innerText = 'Administrator Identity & Security';
        pct.innerText = '33% Completed';
      } else if (step === 2) {
        node1.classList.add('completed');
        dot1.innerHTML = '<i class="fa-solid fa-check text-[11px]"></i>';
        line1.classList.add('completed');
        node2.classList.add('active');
        eyebrow.innerText = 'STEP 02';
        title.innerText = 'Institution Details & Data Residency';
        pct.innerText = '66% Completed';
      } else if (step === 3) {
        node1.classList.add('completed');
        dot1.innerHTML = '<i class="fa-solid fa-check text-[11px]"></i>';
        line1.classList.add('completed');
        node2.classList.add('completed');
        dot2.innerHTML = '<i class="fa-solid fa-check text-[11px]"></i>';
        line2.classList.add('completed');
        node3.classList.add('active');
        eyebrow.innerText = 'STEP 03';
        title.innerText = 'Subscription Plan & Compliance';
        pct.innerText = '100% Ready';
      }

      window.scrollTo({ top: 100, behavior: 'smooth' });
    }

    // Password Visibility Toggle
    function togglePasswordVisibility(inputId, iconId) {
      const input = document.getElementById(inputId);
      const icon = document.getElementById(iconId);
      if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'fa-regular fa-eye-slash text-xs';
      } else {
        input.type = 'password';
        icon.className = 'fa-regular fa-eye text-xs';
      }
    }

    // Password Strength Meter
    function updatePasswordStrength() {
      const pwd = document.getElementById('admin_password').value;
      const bar = document.getElementById('pwd-strength-bar');
      const label = document.getElementById('pwd-strength-label');

      const chkLen = pwd.length >= 12;
      const chkUpper = /[A-Z]/.test(pwd);
      const chkLower = /[a-z]/.test(pwd);
      const chkNum = /[0-9]/.test(pwd);
      const chkSpec = /[^A-Za-z0-9]/.test(pwd);

      updateCheckPill('chk-length', chkLen);
      updateCheckPill('chk-cases', chkUpper && chkLower);
      updateCheckPill('chk-number', chkNum);
      updateCheckPill('chk-special', chkSpec);

      let score = 0;
      if (chkLen) score += 35;
      if (chkUpper && chkLower) score += 25;
      if (chkNum) score += 20;
      if (chkSpec) score += 20;

      bar.style.width = Math.max(10, score) + '%';
      if (score >= 90) {
        bar.className = 'h-full bg-emerald-500 transition-all duration-300 rounded-full';
        label.className = 'font-bold text-emerald-600';
        label.innerText = 'Strong';
      } else if (score >= 70) {
        bar.className = 'h-full bg-indigo-500 transition-all duration-300 rounded-full';
        label.className = 'font-bold text-indigo-600';
        label.innerText = 'Good';
      } else if (score >= 40) {
        bar.className = 'h-full bg-amber-500 transition-all duration-300 rounded-full';
        label.className = 'font-bold text-amber-600';
        label.innerText = 'Fair';
      } else {
        bar.className = 'h-full bg-red-500 transition-all duration-300 rounded-full';
        label.className = 'font-bold text-red-500';
        label.innerText = 'Weak';
      }

      checkPasswordMatch();
    }

    function updateCheckPill(id, passed) {
      const el = document.getElementById(id);
      if (passed) {
        el.className = 'text-emerald-700 font-semibold flex items-center gap-2';
        el.querySelector('i').className = 'fa-solid fa-circle-check text-[11px] text-emerald-500';
      } else {
        el.className = 'text-muted flex items-center gap-2';
        el.querySelector('i').className = 'fa-regular fa-circle text-[10px]';
      }
    }

    function checkPasswordMatch() {
      const p1 = document.getElementById('admin_password').value;
      const p2 = document.getElementById('admin_confirm_password').value;
      const msg = document.getElementById('pwd-match-msg');
      if (p2.length > 0 && p1 !== p2) {
        msg.classList.remove('hidden');
      } else {
        msg.classList.add('hidden');
      }
    }

    // Email OTP Verification
    let generatedDevOtp = '';
    async function requestEmailOtp() {
      const email = document.getElementById('admin_email').value.trim();
      if (!email || !email.includes('@')) {
        alert('Please enter a valid official institutional email address first.');
        return;
      }

      const btn = document.getElementById('btn-send-otp');
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> <span>Sending...</span>';

      try {
        const res = await fetch('/api/auth/send-verification-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        const data = await res.json();

        if (data.success) {
          document.getElementById('otp-verify-box').classList.remove('hidden');
          const msg = document.getElementById('otp-status-msg');
          msg.className = 'text-xs font-medium text-emerald-700';
          msg.innerText = data.message;

          // Store devOtp in memory (kept clean from production UI view)
          if (data.devOtp) {
            generatedDevOtp = data.devOtp;
            // Discreet helper for localhost testing
            if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
              document.getElementById('dev-otp-pill').classList.remove('hidden');
            }
          }

          startOtpTimer(600);
        } else {
          alert(data.message || 'Could not send verification code.');
        }
      } catch (err) {
        alert('Network error communicating with the verification service.');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-rotate-right text-xs"></i> <span>Resend code</span>';
      }
    }

    function fillDevOtp() {
      if (generatedDevOtp) {
        document.getElementById('otp-input').value = generatedDevOtp;
        confirmEmailOtp();
      }
    }

    async function confirmEmailOtp() {
      const email = document.getElementById('admin_email').value.trim();
      const otp = document.getElementById('otp-input').value.trim();
      if (!otp) return;

      try {
        const res = await fetch('/api/auth/verify-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, otp })
        });
        const data = await res.json();
        const msg = document.getElementById('otp-status-msg');

        if (data.success) {
          msg.className = 'text-xs font-bold text-emerald-700';
          msg.innerText = '✓ ' + data.message;
          document.getElementById('email-verified-badge').classList.remove('hidden');
          document.getElementById('btn-send-otp').classList.add('hidden');
        } else {
          msg.className = 'text-xs font-semibold text-red-500';
          msg.innerText = '✗ ' + data.message;
        }
      } catch (e) {
        alert('Verification request failed.');
      }
    }

    let timerInterval = null;
    function startOtpTimer(seconds) {
      if (timerInterval) clearInterval(timerInterval);
      const timerEl = document.getElementById('otp-timer');
      let remaining = seconds;

      timerInterval = setInterval(() => {
        remaining--;
        const m = Math.floor(remaining / 60);
        const s = remaining % 60;
        timerEl.innerText = `${m}:${s < 10 ? '0' : ''}${s}`;
        if (remaining <= 0) {
          clearInterval(timerInterval);
          timerEl.innerText = 'Expired';
        }
      }, 1000);
    }

    // AICTE / UGC National Institution Lookup
    let lookupDebounce = null;
    function handleInstitutionInput(val) {
      clearTimeout(lookupDebounce);
      const dropdown = document.getElementById('inst-lookup-dropdown');

      if (!val || val.trim().length < 2) {
        dropdown.classList.add('hidden');
        dropdown.innerHTML = '';
        return;
      }

      lookupDebounce = setTimeout(async () => {
        try {
          const res = await fetch('/api/institutions/lookup?q=' + encodeURIComponent(val));
          const data = await res.json();

          if (data.success && data.results && data.results.length > 0) {
            dropdown.innerHTML = data.results.map(inst => `
              <div 
                onclick="selectInstitution('${inst.name.replace(/'/g, "\\'")}', '${inst.code}', '${inst.aicteCode}', '${inst.type}')" 
                class="p-3 hover:bg-[var(--bg-surface-hover)] cursor-pointer transition-colors"
                style="padding: 10px 14px;"
              >
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-primary">${inst.name}</span>
                  <span class="badge-success text-[10px] font-semibold px-1.5 py-0.5">
                    ${inst.aicteCode}
                  </span>
                </div>
                <div class="text-[11px] text-muted mt-0.5 flex items-center gap-2">
                  <span>${inst.category}</span> • <span>${inst.state}</span>
                </div>
              </div>
            `).join('');
            dropdown.classList.remove('hidden');
          } else {
            dropdown.classList.add('hidden');
          }
        } catch (e) {
          dropdown.classList.add('hidden');
        }
      }, 250);
    }

    function selectInstitution(name, code, aicteCode, type) {
      document.getElementById('inst_name').value = name;
      document.getElementById('inst_code').value = code;
      document.getElementById('aicte_code').value = aicteCode;
      document.getElementById('inst_type').value = type || 'engineering';
      document.getElementById('inst-lookup-dropdown').classList.add('hidden');
      document.getElementById('aicte-badge').classList.remove('hidden');
    }

    // Close autocomplete on click outside
    document.addEventListener('click', (e) => {
      const dropdown = document.getElementById('inst-lookup-dropdown');
      if (dropdown && !dropdown.contains(e.target) && e.target.id !== 'inst_name') {
        dropdown.classList.add('hidden');
      }
    });

    // Radio Selection Card Styling
    document.querySelectorAll('input[type="radio"]').forEach(radio => {
      radio.addEventListener('change', () => {
        const groupName = radio.name;
        document.querySelectorAll(`input[name="${groupName}"]`).forEach(r => {
          const card = r.closest('.selection-card');
          if (card) card.classList.remove('selected');
        });
        const activeCard = radio.closest('.selection-card');
        if (activeCard) activeCard.classList.add('selected');
      });
    });

    // Modal Handling
    function openModal(type) {
      const modal = document.getElementById('legal-modal');
      const title = document.getElementById('modal-title');
      const body = document.getElementById('modal-body');

      if (type === 'terms') {
        title.innerText = 'CampusPulse SaaS Terms of Service';
        body.innerHTML = `
          <p><strong>1. Institutional License:</strong> CampusPulse grants your higher education institution a non-exclusive license to administer academic data, student records, and institutional operations.</p>
          <p><strong>2. Autonomous Tenant Isolation:</strong> Every institution is provisioned with cryptographically separated database rows adhering to PostgreSQL Row-Level Security (RLS) standards.</p>
          <p><strong>3. Uptime & SLA Guarantee:</strong> 99.95% production uptime commitment with automated daily cryptographic backups and multi-region failover.</p>
        `;
      } else if (type === 'privacy') {
        title.innerText = 'Privacy Policy & Data Sovereignty';
        body.innerHTML = `
          <p><strong>1. Data Sovereignty:</strong> Student records and sensitive institutional PII are localized within your chosen geographic data plane (India, Europe, or US).</p>
          <p><strong>2. Encryption:</strong> Bank-grade AES-256 at rest and TLS 1.3 in transit.</p>
          <p><strong>3. Zero Third-Party Monetization:</strong> CampusPulse never sells, analyzes, or shares student or faculty personal data with third-party advertisers.</p>
        `;
      } else if (type === 'dpa') {
        title.innerText = 'Data Processing Agreement (DPA)';
        body.innerHTML = `
          <p><strong>1. Educational Role:</strong> The institution acts as the Data Controller; CampusPulse acts as the Data Processor.</p>
          <p><strong>2. Right to Erasure & Portability:</strong> Complete JSON/SQL/CSV export of institutional rosters and logs is available on demand at any time.</p>
        `;
      } else if (type === 'help') {
        title.innerText = 'Institutional Onboarding Support';
        body.innerHTML = `
          <p><strong>Dedicated Procurement & IT Assistance:</strong></p>
          <p>Our institutional onboarding team is available 24/7 to assist registrars, deans, and IT departments with tenant setup, student roster migration, and compliance audits.</p>
          <p><strong>Direct Contacts:</strong></p>
          <p>• Email: <a href="mailto:institutional-support@campuspulse.edu" style="color: var(--accent-primary); font-weight: bold;">institutional-support@campuspulse.edu</a></p>
          <p>• Direct Registrar Desk: +91 (022) 5000-PULSE</p>
        `;
      }

      modal.classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('legal-modal').classList.add('hidden');
    }
  </script>
</body>
</html>
