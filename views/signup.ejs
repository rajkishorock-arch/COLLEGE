<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Sign Up - CampusPulse Multi-Tenant Platform' %></title>
  
  <!-- Anti-Flash Instant Theme Detection -->
  <script>
    (function() {
      try {
        const theme = localStorage.getItem('campuspulse-theme') || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Google Fonts Pairing: Space Grotesk + Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[var(--bg-primary)] text-[var(--text-primary)] min-h-screen flex flex-col justify-between p-4 py-6 sm:py-10 transition-colors duration-200">

  <!-- Header with Brand & Theme Toggle -->
  <div class="max-w-3xl w-full mx-auto flex items-center justify-between mb-6 fade-slide-up">
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-10 h-10 rounded-[10px] bg-[var(--accent-primary)] text-white flex items-center justify-center text-lg shadow-md shadow-[var(--accent-glow)] group-hover:scale-105 transition-transform">
        <i class="fa-solid fa-graduation-cap"></i>
      </div>
      <div>
        <span class="text-xl font-bold font-['Space_Grotesk'] text-[var(--text-primary)] tracking-tight">CAMPUS<span class="text-[var(--accent-primary)]">PULSE</span></span>
        <span class="block text-[10px] text-[var(--text-muted)] uppercase tracking-wider font-semibold">Autonomous Higher Education SaaS</span>
      </div>
    </a>

    <div class="flex items-center gap-3">
      <%- include('partials/theme-toggle') %>
    </div>
  </div>

  <!-- Form Card Container -->
  <div class="w-full max-w-3xl mx-auto">
    <div class="card p-6 sm:p-9 fade-slide-up stagger-1 shadow-xl border border-[var(--border-subtle)]">
      
      <!-- Tab Switcher (Institution vs Student) -->
      <div class="flex items-center p-1 rounded-[10px] bg-[var(--bg-surface-hover)] border border-[var(--border-subtle)] mb-8">
        <button 
          type="button" 
          id="tab-btn-institution" 
          onclick="switchTab('institution')"
          class="flex-1 py-2.5 px-3 rounded-[8px] text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition-all <%= (!activeTab || activeTab === 'institution') ? 'bg-[var(--bg-surface)] text-[var(--accent-primary)] shadow-sm' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]' %>"
        >
          <i class="fa-solid fa-building-columns"></i>
          <span>Register Institution</span>
          <span class="hidden md:inline-block px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-[rgba(108,92,231,0.12)] text-[var(--accent-primary)]">Multi-Step</span>
        </button>

        <button 
          type="button" 
          id="tab-btn-student" 
          onclick="switchTab('student')"
          class="flex-1 py-2.5 px-3 rounded-[8px] text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition-all <%= (activeTab === 'student') ? 'bg-[var(--bg-surface)] text-[var(--accent-primary)] shadow-sm' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]' %>"
        >
          <i class="fa-solid fa-user-graduate"></i>
          <span>Join as Student</span>
        </button>
      </div>

      <!-- Error Alert -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 p-4 rounded-[10px] bg-[#FEECEE] dark:bg-red-950/40 border border-[var(--danger)] text-[#E5384B] dark:text-red-400 text-xs sm:text-sm font-medium flex items-start gap-3">
          <i class="fa-solid fa-circle-exclamation text-base shrink-0 mt-0.5"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <!-- TAB 1: REGISTER INSTITUTION (Enterprise 3-Step Guided Flow) -->
      <div id="tab-content-institution" class="<%= (!activeTab || activeTab === 'institution') ? '' : 'hidden' %>">
        
        <!-- Step Progress Indicator -->
        <div class="mb-8">
          <div class="flex items-center justify-between mb-2">
            <span id="step-indicator-text" class="text-xs font-bold uppercase tracking-wider text-[var(--accent-primary)]">
              Step 1 of 3: Administrator Identity & Security
            </span>
            <span id="step-percent-text" class="text-xs font-semibold text-[var(--text-muted)]">33% Completed</span>
          </div>
          <div class="w-full h-2 rounded-full bg-[var(--bg-surface-hover)] overflow-hidden">
            <div id="step-progress-bar" class="h-full bg-[var(--accent-primary)] transition-all duration-300 rounded-full" style="width: 33.33%;"></div>
          </div>

          <div class="grid grid-cols-3 gap-2 mt-3 text-center text-[11px] font-medium text-[var(--text-secondary)]">
            <div id="step-label-1" class="font-bold text-[var(--accent-primary)]">1. Admin Identity</div>
            <div id="step-label-2" class="text-[var(--text-muted)]">2. Institution & Region</div>
            <div id="step-label-3" class="text-[var(--text-muted)]">3. Plan & Compliance</div>
          </div>
        </div>

        <form id="institution-signup-form" action="/register-institution" method="POST">
          <input type="hidden" name="signup_type" value="institution">

          <!-- ========================================== -->
          <!-- STEP 1: ADMINISTRATOR IDENTITY & SECURITY  -->
          <!-- ========================================== -->
          <div id="step-1-content" class="space-y-5">
            <div class="border-b border-[var(--border-subtle)] pb-3">
              <h2 class="text-xl font-bold font-['Space_Grotesk'] text-[var(--text-primary)]">
                Institution Administrator Identity
              </h2>
              <p class="text-xs sm:text-sm text-[var(--text-secondary)] mt-1">
                Enter your official identity details. You will become the verified tenant owner with full administrative authority.
              </p>
            </div>

            <!-- Full Legal Name -->
            <div>
              <label for="admin_name" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                Full Legal Name *
              </label>
              <div class="relative">
                <i class="fa-solid fa-user absolute left-3.5 top-3.5 text-xs text-[var(--text-muted)]"></i>
                <input 
                  type="text" 
                  id="admin_name" 
                  name="full_name" 
                  required 
                  placeholder="e.g. Dr. Arthur Pendelton"
                  value="<%= typeof formData !== 'undefined' && (formData.full_name || formData.name) ? (formData.full_name || formData.name) : '' %>"
                  class="w-full pl-9 pr-4 py-2.5 rounded-[8px] border text-sm"
                />
              </div>
            </div>

            <!-- Official Email & OTP Verification -->
            <div class="p-4 rounded-[10px] bg-[var(--bg-surface-hover)] border border-[var(--border-subtle)] space-y-3">
              <div class="flex items-center justify-between">
                <label for="admin_email" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
                  Official / Institutional Email *
                </label>
                <span id="email-verified-badge" class="hidden text-[11px] font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-100 dark:bg-emerald-950/60 px-2 py-0.5 rounded-full flex items-center gap-1">
                  <i class="fa-solid fa-circle-check"></i> Verified
                </span>
              </div>

              <div class="flex flex-col sm:flex-row gap-2">
                <div class="relative flex-1">
                  <i class="fa-solid fa-envelope absolute left-3.5 top-3.5 text-xs text-[var(--text-muted)]"></i>
                  <input 
                    type="email" 
                    id="admin_email" 
                    name="email" 
                    required 
                    placeholder="dean@college.edu or principal@college.edu.in"
                    value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
                    class="w-full pl-9 pr-4 py-2.5 rounded-[8px] border text-sm"
                  />
                </div>
                <button 
                  type="button" 
                  id="btn-send-otp" 
                  onclick="requestEmailOtp()" 
                  class="px-4 py-2.5 rounded-[8px] bg-[var(--bg-surface)] hover:bg-[var(--accent-glow)] border border-[var(--border-subtle)] text-xs font-bold text-[var(--accent-primary)] hover:border-[var(--accent-primary)] transition-all shrink-0 flex items-center justify-center gap-1.5"
                >
                  <i class="fa-solid fa-shield-halved"></i>
                  <span>Send OTP</span>
                </button>
              </div>

              <!-- OTP Verification Inline Container -->
              <div id="otp-verify-box" class="hidden pt-3 border-t border-[var(--border-subtle)] space-y-2">
                <div class="flex items-center justify-between text-xs text-[var(--text-secondary)]">
                  <span>Enter 6-digit code sent to your email:</span>
                  <span id="otp-timer" class="font-mono text-amber-500 font-semibold">10:00</span>
                </div>

                <div class="flex gap-2">
                  <input 
                    type="text" 
                    id="otp-input" 
                    maxlength="6" 
                    placeholder="123456" 
                    class="w-36 tracking-widest font-mono text-center px-3 py-2 rounded-[8px] border text-sm uppercase font-bold"
                  />
                  <button 
                    type="button" 
                    onclick="confirmEmailOtp()" 
                    class="btn-primary px-4 py-2 text-xs font-bold"
                  >
                    Verify Code
                  </button>
                </div>

                <!-- Dev Auto-Fill Helper for Quick Demo/Testing -->
                <div id="dev-otp-pill" class="hidden text-[11px] text-[var(--text-muted)] flex items-center gap-2">
                  <i class="fa-solid fa-terminal text-[var(--accent-primary)]"></i>
                  <span>Test OTP generated:</span>
                  <button 
                    type="button" 
                    id="dev-otp-code-btn" 
                    onclick="fillDevOtp()" 
                    class="px-2 py-0.5 rounded bg-[rgba(108,92,231,0.15)] text-[var(--accent-primary)] font-mono font-bold hover:underline"
                  >
                    123456
                  </button>
                </div>
                <div id="otp-status-msg" class="text-xs font-medium"></div>
              </div>
            </div>

            <!-- Master Password with Strict 12-char Policy & Live Strength Meter -->
            <div class="p-4 rounded-[10px] bg-[var(--bg-surface-hover)] border border-[var(--border-subtle)] space-y-3">
              <div class="flex items-center justify-between">
                <label for="admin_password" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
                  Master Admin Password (Min 12 characters) *
                </label>
                <button 
                  type="button" 
                  onclick="togglePasswordVisibility('admin_password', 'pwd-toggle-icon')" 
                  class="text-xs text-[var(--accent-primary)] hover:underline flex items-center gap-1 font-semibold"
                >
                  <i id="pwd-toggle-icon" class="fa-solid fa-eye text-[11px]"></i>
                  <span>Show</span>
                </button>
              </div>

              <div class="relative">
                <i class="fa-solid fa-lock absolute left-3.5 top-3.5 text-xs text-[var(--text-muted)]"></i>
                <input 
                  type="password" 
                  id="admin_password" 
                  name="password" 
                  required 
                  minlength="12"
                  oninput="updatePasswordStrength()"
                  placeholder="Create a strong 12+ character master password"
                  class="w-full pl-9 pr-4 py-2.5 rounded-[8px] border text-sm"
                />
              </div>

              <!-- Password Strength Bar -->
              <div class="space-y-1.5 pt-1">
                <div class="flex items-center justify-between text-[11px]">
                  <span class="text-[var(--text-muted)] font-medium">Security Strength:</span>
                  <span id="pwd-strength-label" class="font-bold text-red-500">Very Weak</span>
                </div>
                <div class="w-full h-1.5 rounded-full bg-[var(--bg-surface)] overflow-hidden">
                  <div id="pwd-strength-bar" class="h-full bg-red-500 transition-all duration-300" style="width: 15%;"></div>
                </div>
              </div>

              <!-- Live Requirement Checkpoints -->
              <div class="grid grid-cols-2 gap-1.5 pt-1 text-[11px]">
                <div id="chk-length" class="text-[var(--text-muted)] flex items-center gap-1.5">
                  <i class="fa-solid fa-circle text-[8px]"></i> At least 12 characters
                </div>
                <div id="chk-cases" class="text-[var(--text-muted)] flex items-center gap-1.5">
                  <i class="fa-solid fa-circle text-[8px]"></i> Upper & lowercase letters
                </div>
                <div id="chk-number" class="text-[var(--text-muted)] flex items-center gap-1.5">
                  <i class="fa-solid fa-circle text-[8px]"></i> At least 1 number (0-9)
                </div>
                <div id="chk-special" class="text-[var(--text-muted)] flex items-center gap-1.5">
                  <i class="fa-solid fa-circle text-[8px]"></i> At least 1 symbol (!@#$%^&*)
                </div>
              </div>

              <!-- Confirm Password -->
              <div class="pt-2">
                <label for="admin_confirm_password" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                  Confirm Master Password *
                </label>
                <div class="relative">
                  <i class="fa-solid fa-key absolute left-3.5 top-3.5 text-xs text-[var(--text-muted)]"></i>
                  <input 
                    type="password" 
                    id="admin_confirm_password" 
                    name="confirm_password" 
                    required 
                    minlength="12"
                    oninput="checkPasswordMatch()"
                    placeholder="Repeat master password"
                    class="w-full pl-9 pr-4 py-2.5 rounded-[8px] border text-sm"
                  />
                </div>
                <div id="pwd-match-msg" class="text-[11px] font-medium mt-1 text-red-500 hidden">Passwords do not match</div>
              </div>
            </div>

            <!-- Contact Phone -->
            <div>
              <label for="inst_phone" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                Primary Contact / Mobile Phone *
              </label>
              <div class="relative">
                <i class="fa-solid fa-phone absolute left-3.5 top-3.5 text-xs text-[var(--text-muted)]"></i>
                <input 
                  type="text" 
                  id="inst_phone" 
                  name="phone" 
                  required
                  placeholder="+91 (987) 654-3210 or +1 (555) 234-5678"
                  value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>"
                  class="w-full pl-9 pr-4 py-2.5 rounded-[8px] border text-sm"
                />
              </div>
            </div>

            <!-- Navigation: Step 1 -> 2 -->
            <button 
              type="button" 
              onclick="goToStep(2)" 
              class="btn-primary w-full py-3.5 text-sm font-bold shadow-lg shadow-[var(--accent-glow)] flex items-center justify-center gap-2"
            >
              <span>Continue to Institution Details</span>
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </button>
          </div>

          <!-- ========================================== -->
          <!-- STEP 2: INSTITUTION PROFILE & DATA PLANE   -->
          <!-- ========================================== -->
          <div id="step-2-content" class="hidden space-y-5">
            <div class="border-b border-[var(--border-subtle)] pb-3">
              <h2 class="text-xl font-bold font-['Space_Grotesk'] text-[var(--text-primary)]">
                Institution Credentials & Data Residency
              </h2>
              <p class="text-xs sm:text-sm text-[var(--text-secondary)] mt-1">
                Configure your college registry details and select your dedicated regional data plane.
              </p>
            </div>

            <!-- Institution Name with Live AICTE Registry Auto-Search -->
            <div class="relative">
              <div class="flex items-center justify-between mb-1.5">
                <label for="inst_name" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
                  Official Institution / College Name *
                </label>
                <span id="aicte-badge" class="hidden text-[11px] font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-100 dark:bg-emerald-950/60 px-2 py-0.5 rounded-full flex items-center gap-1">
                  <i class="fa-solid fa-award"></i> AICTE / UGC Recognized
                </span>
              </div>

              <div class="relative">
                <i class="fa-solid fa-building-columns absolute left-3.5 top-3.5 text-xs text-[var(--text-muted)]"></i>
                <input 
                  type="text" 
                  id="inst_name" 
                  name="institution_name" 
                  required 
                  oninput="handleInstitutionInput(this.value)"
                  placeholder="e.g. Indian Institute of Technology Bombay or Stanford University"
                  value="<%= typeof formData !== 'undefined' && formData.institution_name ? formData.institution_name : '' %>"
                  class="w-full pl-9 pr-4 py-2.5 rounded-[8px] border text-sm"
                  autocomplete="off"
                />
              </div>

              <!-- Live Autocomplete Dropdown -->
              <div id="inst-lookup-dropdown" class="hidden absolute z-30 left-0 right-0 mt-1 bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-[8px] shadow-xl overflow-hidden divide-y divide-[var(--border-subtle)]">
                <!-- Injected via JavaScript -->
              </div>
              <input type="hidden" id="aicte_code" name="aicte_code" value="">
            </div>

            <!-- Institution Code & Type -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="inst_code" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                  Institution Code *
                </label>
                <input 
                  type="text" 
                  id="inst_code" 
                  name="institution_code" 
                  required
                  placeholder="e.g. IITB, BITS, STANFORD"
                  class="w-full px-4 py-2.5 rounded-[8px] border text-sm uppercase font-mono font-bold"
                />
                <p class="text-[11px] text-[var(--text-muted)] mt-1">Unique tenant identifier used for student logins.</p>
              </div>

              <div>
                <label for="inst_type" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                  Institution Type *
                </label>
                <select id="inst_type" name="institution_type" class="w-full px-4 py-2.5 rounded-[8px] border text-sm">
                  <option value="engineering" selected>Institute of Technology / Engineering</option>
                  <option value="university">University</option>
                  <option value="college">College of Higher Education</option>
                  <option value="medical">Medical & Health Sciences Institute</option>
                  <option value="business">Business & Management School</option>
                  <option value="academy">Polytechnic / Academy</option>
                </select>
              </div>
            </div>

            <!-- Data Plane / Region Selector (Critique Item 2A) -->
            <div class="p-4 rounded-[10px] bg-[var(--bg-surface-hover)] border border-[var(--border-subtle)] space-y-3">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)]">
                  Data Plane & Residency Region *
                </label>
                <p class="text-[11px] text-[var(--text-muted)] mt-0.5">
                  Select where your student records, grades, and audit trail are physically stored and processed.
                </p>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <!-- Region 1: India -->
                <label class="relative flex flex-col p-3 rounded-[8px] border-2 border-[var(--accent-primary)] bg-[var(--bg-surface)] cursor-pointer hover:border-[var(--accent-primary)] transition-all">
                  <input type="radio" name="data_region" value="in-west-mumbai" checked class="sr-only">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-base">🇮🇳</span>
                    <span class="text-xs font-bold text-[var(--text-primary)]">India (Mumbai)</span>
                  </div>
                  <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold mb-1">DPDP Act Compliant</span>
                  <span class="text-[10px] text-[var(--text-muted)]">Ultra-low latency (<20ms). Complete national data localization.</span>
                </label>

                <!-- Region 2: Europe -->
                <label class="relative flex flex-col p-3 rounded-[8px] border border-[var(--border-subtle)] bg-[var(--bg-surface)] cursor-pointer hover:border-[var(--accent-primary)] transition-all">
                  <input type="radio" name="data_region" value="eu-central-frankfurt" class="sr-only">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-base">🇪🇺</span>
                    <span class="text-xs font-bold text-[var(--text-primary)]">Europe (Frankfurt)</span>
                  </div>
                  <span class="text-[10px] text-indigo-600 dark:text-indigo-400 font-semibold mb-1">GDPR Certified</span>
                  <span class="text-[10px] text-[var(--text-muted)]">Strict European sovereignty & encryption standards.</span>
                </label>

                <!-- Region 3: US -->
                <label class="relative flex flex-col p-3 rounded-[8px] border border-[var(--border-subtle)] bg-[var(--bg-surface)] cursor-pointer hover:border-[var(--accent-primary)] transition-all">
                  <input type="radio" name="data_region" value="us-east-virginia" class="sr-only">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-base">🇺🇸</span>
                    <span class="text-xs font-bold text-[var(--text-primary)]">US (N. Virginia)</span>
                  </div>
                  <span class="text-[10px] text-sky-600 dark:text-sky-400 font-semibold mb-1">SOC 2 / FERPA</span>
                  <span class="text-[10px] text-[var(--text-muted)]">Global high-availability for international programs.</span>
                </label>
              </div>
            </div>

            <!-- Campus Address -->
            <div>
              <label for="inst_address" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                Campus Physical Address <span class="font-normal text-[var(--text-muted)] lowercase">(optional)</span>
              </label>
              <input 
                type="text" 
                id="inst_address" 
                name="address" 
                placeholder="e.g. 100 University Boulevard, Tech Campus, Mumbai"
                class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
              />
            </div>

            <!-- Navigation: Step 2 Buttons -->
            <div class="flex items-center gap-3">
              <button 
                type="button" 
                onclick="goToStep(1)" 
                class="px-5 py-3 rounded-[8px] border border-[var(--border-subtle)] text-xs font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-hover)] transition-all"
              >
                <i class="fa-solid fa-arrow-left mr-1.5"></i> Back
              </button>

              <button 
                type="button" 
                onclick="goToStep(3)" 
                class="btn-primary flex-1 py-3.5 text-sm font-bold shadow-lg shadow-[var(--accent-glow)] flex items-center justify-center gap-2"
              >
                <span>Continue to Plan & Compliance</span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
              </button>
            </div>
          </div>

          <!-- ========================================== -->
          <!-- STEP 3: SUBSCRIPTION PLAN & COMPLIANCE     -->
          <!-- ========================================== -->
          <div id="step-3-content" class="hidden space-y-5">
            <div class="border-b border-[var(--border-subtle)] pb-3">
              <h2 class="text-xl font-bold font-['Space_Grotesk'] text-[var(--text-primary)]">
                Subscription Plan & Compliance Consent
              </h2>
              <p class="text-xs sm:text-sm text-[var(--text-secondary)] mt-1">
                Select your institution's subscription tier. All plans include a 30-day risk-free guarantee.
              </p>
            </div>

            <!-- Pricing Tiers (Critique Item 2B) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
              <!-- Tier 1: Starter -->
              <label class="plan-card relative flex flex-col p-4 rounded-[10px] border border-[var(--border-subtle)] bg-[var(--bg-surface)] cursor-pointer hover:border-[var(--accent-primary)] transition-all">
