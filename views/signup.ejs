                  class="mt-1 w-4 h-4 rounded text-[var(--accent-primary)] focus:ring-[var(--accent-primary)]"
                />
                <label for="terms_accepted" class="text-xs text-[var(--text-secondary)]">
                  I accept the 
                  <a href="#terms-modal" onclick="openModal('terms')" class="text-[var(--accent-primary)] font-bold hover:underline">Terms of Service</a>, 
                  <a href="#privacy-modal" onclick="openModal('privacy')" class="text-[var(--accent-primary)] font-bold hover:underline">Privacy Policy</a>, and 
