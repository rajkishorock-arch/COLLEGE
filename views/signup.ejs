<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Register Institution - CampusPulse Enterprise SaaS' %></title>
  
  <!-- Anti-Flash Instant Theme Detection -->
  <script>
    (function() {
      try {
        const theme = localStorage.getItem('campuspulse-theme') || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[var(--bg-primary)] text-[var(--text-primary)] min-h-screen flex flex-col justify-between transition-colors duration-200 antialiased">

  <!-- ========================================================================= -->
  <!-- 1. GLOBAL APPLICATION HEADER                                              -->
  <!-- ========================================================================= -->
  <header class="app-header">
    <div class="app-header-inner">
      <!-- CampusPulse Logo & SaaS Identity -->
      <a href="/" class="brand-link">
        <div class="brand-icon-box">
          <i class="fa-solid fa-graduation-cap"></i>
        </div>
        <div class="brand-text-col">
          <div class="flex items-center">
            <span class="brand-name">CAMPUS<span style="color: var(--accent-primary);">PULSE</span></span>
            <span class="brand-tag">ENTERPRISE</span>
          </div>
          <span class="brand-sub">Autonomous Higher Education SaaS</span>
        </div>
      </a>

      <!-- Right Header Actions: Help, Theme Switcher, Sign In -->
      <div class="flex items-center gap-2">
        <button 
          type="button" 
          onclick="openModal('help')" 
          class="btn-secondary !min-h-[36px] !py-1.5 !px-3 !text-xs font-semibold"
          title="Institutional Onboarding Support"
        >
          <i class="fa-regular fa-circle-question text-sm" style="color: var(--accent-primary);"></i>
          <span class="hidden sm:inline">Help & Support</span>
        </button>

        <div class="header-sep"></div>

        <!-- Accessible Segmented Theme Switcher -->
        <%- include('partials/theme-toggle') %>

        <div class="header-sep"></div>

        <a 
          href="/login" 
          class="btn-primary !min-h-[36px] !py-1.5 !px-3.5 !text-xs font-semibold"
        >
          <span>Sign In</span>
          <i class="fa-solid fa-arrow-right-to-bracket text-[10px]"></i>
        </a>
      </div>
    </div>
  </header>

  <!-- ========================================================================= -->
  <!-- 2. MAIN REGISTRATION ONBOARDING SECTION                                   -->
  <!-- ========================================================================= -->
  <main class="app-container">
    
    <!-- Top Eyebrow & Hero Header -->
    <div style="max-width: 720px; margin-bottom: 28px;">
      <div class="eyebrow-pill">
        <i class="fa-solid fa-building-columns text-[10px]"></i>
        <span>INSTITUTION ONBOARDING</span>
      </div>
      <h1 class="page-title-enterprise">
        Register your institution
      </h1>
      <p class="page-subtitle-enterprise">
        Set up your dedicated institutional workspace and begin managing your higher education operations with CampusPulse.
      </p>
    </div>

    <!-- Segmented Tab Switcher: Institution vs Student -->
    <div style="max-width: 440px; margin-bottom: 28px;">
      <div class="segmented-tab-group">
        <button 
          type="button" 
          id="tab-btn-institution" 
          onclick="switchTab('institution')"
          class="segmented-tab-btn <%= (!activeTab || activeTab === 'institution') ? 'active' : '' %>"
        >
          <i class="fa-solid fa-building-columns text-xs"></i>
          <span>Register Institution</span>
        </button>

        <button 
          type="button" 
          id="tab-btn-student" 
          onclick="switchTab('student')"
          class="segmented-tab-btn <%= (activeTab === 'student') ? 'active' : '' %>"
        >
          <i class="fa-solid fa-user-graduate text-xs"></i>
          <span>Join as Student</span>
        </button>
      </div>
    </div>

    <!-- Error Alert Notification -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="badge-danger w-full p-4 mb-6 rounded-xl flex items-start gap-3 shadow-sm" style="border-radius: 12px;">
        <i class="fa-solid fa-circle-exclamation text-base shrink-0 mt-0.5"></i>
        <div class="flex-1">
          <p class="font-bold">Action Required</p>
          <p class="text-xs sm:text-sm mt-0.5"><%= error %></p>
        </div>
      </div>
    <% } %>

    <!-- Success Alert Notification -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="badge-success w-full p-4 mb-6 rounded-xl flex items-start gap-3 shadow-sm" style="border-radius: 12px;">
        <i class="fa-solid fa-circle-check text-base shrink-0 mt-0.5"></i>
        <span><%= success %></span>
      </div>
    <% } %>

    <!-- ======================================================================= -->
    <!-- TAB 1: REGISTER INSTITUTION (Enterprise 2-Column Onboarding Layout)     -->
    <!-- ======================================================================= -->
    <div id="tab-content-institution" class="<%= (!activeTab || activeTab === 'institution') ? '' : 'hidden' %>">
      
      <!-- Visual Onboarding Stepper Bar -->
      <div class="card card-static mb-8 p-5" style="border-radius: 14px;">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 border-b border-subtle pb-3">
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider block" style="color: var(--accent-primary);" id="stepper-eyebrow">
              STEP 01
            </span>
            <span class="text-sm font-bold text-primary" id="stepper-title">
              Administrator Identity & Security
            </span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-medium text-secondary">Progress:</span>
            <span id="stepper-percent" class="badge-accent text-xs font-bold px-2.5 py-1">
              33% Completed
            </span>
          </div>
        </div>

        <!-- Stepper Nodes & Connecting Lines -->
        <div class="stepper-nav">
          <!-- Step 1 Node -->
          <div id="step-node-1" class="stepper-node active">
            <div class="stepper-dot">
              <span id="step-dot-1">1</span>
            </div>
            <div class="hidden sm:block">
              <p class="text-xs font-bold text-primary">01 Identity</p>
              <p class="text-[11px] text-secondary">Admin Credentials</p>
            </div>
          </div>

          <div id="step-line-1" class="stepper-connector"></div>

          <!-- Step 2 Node -->
          <div id="step-node-2" class="stepper-node">
            <div class="stepper-dot">
              <span id="step-dot-2">2</span>
            </div>
            <div class="hidden sm:block">
              <p class="text-xs font-bold text-secondary">02 Institution</p>
              <p class="text-[11px] text-muted">College & Region</p>
            </div>
          </div>

          <div id="step-line-2" class="stepper-connector"></div>

          <!-- Step 3 Node -->
          <div id="step-node-3" class="stepper-node">
            <div class="stepper-dot">
              <span id="step-dot-3">3</span>
            </div>
            <div class="hidden sm:block">
              <p class="text-xs font-bold text-secondary">03 Plan</p>
              <p class="text-[11px] text-muted">Tier & Compliance</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Two-Column Grid: Left (Form Card) | Right (Information Panel) -->
      <div class="onboarding-2col-grid">
        
        <!-- =================================================================== -->
        <!-- LEFT COLUMN: MAIN FORM CARD (7/12)                                  -->
        <!-- =================================================================== -->
        <div>
          <div class="card card-static p-6 sm:p-8">
            
            <form id="institution-signup-form" action="/register-institution" method="POST" autocomplete="on">
              <input type="hidden" name="signup_type" value="institution">

              <!-- ============================================================= -->
              <!-- STEP 1: ADMINISTRATOR IDENTITY & SECURITY                     -->
              <!-- ============================================================= -->
              <div id="step-1-content" class="space-y-6">
                <div class="border-b border-subtle pb-4">
                  <h2 class="text-xl font-bold text-primary">
                    Administrator identity
                  </h2>
                  <p class="text-xs sm:text-sm text-secondary mt-1">
                    Tell us who will manage this institution. You will become the verified tenant owner with full administrative authority.
                  </p>
                </div>

                <!-- Full Legal Name -->
                <div>
                  <div class="flex items-center justify-between mb-1">
                    <label for="admin_name" class="block text-xs font-bold uppercase tracking-wider text-secondary">
                      Full Legal Name *
                    </label>
                    <span class="text-[11px] text-muted">Official ID</span>
                  </div>
                  <p class="text-xs text-secondary mb-2">Used as the official administrator identity on reports and audits.</p>
                  <div class="input-with-icon">
                    <i class="fa-regular fa-user input-icon-left"></i>
                    <input 
                      type="text" 
                      id="admin_name" 
                      name="full_name" 
                      required 
                      placeholder="e.g. Dr. Arthur Pendelton"
                      value="<%= typeof formData !== 'undefined' && (formData.full_name || formData.name) ? (formData.full_name || formData.name) : '' %>"
                    />
                  </div>
                </div>

                <!-- Official Institutional Email & Verification Block -->
                <div class="p-4 sm:p-5 rounded-xl bg-surface-hover border border-subtle space-y-3" style="border-radius: 12px;">
                  <div class="flex items-center justify-between">
                    <div>
                      <label for="admin_email" class="block text-xs font-bold uppercase tracking-wider text-secondary">
                        Official Institutional Email *
                      </label>
                      <p class="text-[11px] text-secondary mt-0.5">Use your university/college faculty or administrative domain.</p>
                    </div>
                    <span id="email-verified-badge" class="hidden badge-success text-xs font-bold px-2.5 py-1">
                      <i class="fa-solid fa-circle-check"></i> Email Verified
                    </span>
                  </div>

                  <div class="flex flex-col sm:flex-row gap-2.5">
                    <div class="input-with-icon flex-1">
                      <i class="fa-regular fa-envelope input-icon-left"></i>
                      <input 
                        type="email" 
                        id="admin_email" 
                        name="email" 
                        required 
                        placeholder="dean@college.edu or principal@college.edu.in"
                        value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
                      />
                    </div>
                    <button 
                      type="button" 
                      id="btn-send-otp" 
                      onclick="requestEmailOtp()" 
                      class="btn-secondary !min-h-[48px] px-4 text-xs font-bold shrink-0 flex items-center justify-center gap-2"
                    >
                      <i class="fa-solid fa-paper-plane text-xs" style="color: var(--accent-primary);"></i>
                      <span>Send verification code</span>
                    </button>
                  </div>

                  <!-- Professional OTP Verification Container -->
                  <div id="otp-verify-box" class="hidden pt-3 border-t border-subtle space-y-3">
                    <div class="flex items-center justify-between text-xs text-secondary">
                      <span>We've sent a 6-digit verification code to your email.</span>
                      <div class="flex items-center gap-1 font-semibold text-amber-600">
                        <i class="fa-regular fa-clock"></i>
                        <span id="otp-timer" class="font-mono">10:00</span>
                      </div>
                    </div>

                    <div class="flex flex-col sm:flex-row gap-2.5">
                      <input 
                        type="text" 
                        id="otp-input" 
                        maxlength="6" 
                        placeholder="••••••" 
                        style="letter-spacing: 0.3em; font-family: monospace; text-align: center; max-width: 180px; font-weight: bold; text-transform: uppercase;"
                      />
                      <button 
                        type="button" 
                        onclick="confirmEmailOtp()" 
                        class="btn-primary !min-h-[48px] px-5 py-3 text-xs font-bold flex items-center justify-center gap-2"
                      >
                        <i class="fa-solid fa-shield-halved text-xs"></i>
                        <span>Verify email</span>
                      </button>
                    </div>

                    <!-- Development OTP Assist (Hidden from normal view, accessible for localhost dev) -->
                    <div id="dev-otp-pill" class="hidden text-[11px] text-muted pt-1 flex items-center gap-2">
                      <span class="opacity-75">Demo Assist:</span>
                      <button 
                        type="button" 
                        id="dev-otp-code-btn" 
                        onclick="fillDevOtp()" 
                        class="text-accent font-mono font-bold hover:underline"
                        style="background: transparent; border: none; cursor: pointer;"
                      >
                        Autofill Code
                      </button>
                    </div>
                    <div id="otp-status-msg" class="text-xs font-medium"></div>
                  </div>
                </div>

                <!-- Password Section: Professional Enterprise Component -->
                <div class="p-4 sm:p-5 rounded-xl bg-surface-hover border border-subtle space-y-3" style="border-radius: 12px;">
                  <div class="flex items-center justify-between">
                    <div>
                      <label for="admin_password" class="block text-xs font-bold uppercase tracking-wider text-secondary">
                        Create a secure administrator password *
                      </label>
                      <p class="text-[11px] text-secondary mt-0.5">Enterprise security policy requires 12+ characters.</p>
                    </div>
                    <button 
                      type="button" 
                      onclick="togglePasswordVisibility('admin_password', 'pwd-toggle-icon')" 
                      class="text-xs text-accent hover:underline flex items-center gap-1 font-semibold p-1"
                      style="background: transparent; border: none; cursor: pointer;"
                    >
                      <i id="pwd-toggle-icon" class="fa-regular fa-eye text-xs"></i>
                      <span>Show</span>
                    </button>
                  </div>

                  <div class="input-with-icon">
                    <i class="fa-solid fa-lock input-icon-left"></i>
                    <input 
                      type="password" 
                      id="admin_password" 
                      name="password" 
                      required 
                      minlength="12"
                      oninput="updatePasswordStrength()"
                      placeholder="••••••••••••"
                    />
                  </div>

                  <!-- Password Strength Meter -->
                  <div class="space-y-1 pt-1">
                    <div class="flex items-center justify-between text-xs">
                      <span class="text-secondary font-medium">Password strength:</span>
                      <span id="pwd-strength-label" class="font-bold text-red-500">Very Weak</span>
                    </div>
                    <div class="w-full h-1.5 rounded-full overflow-hidden" style="background-color: var(--border-subtle); height: 6px;">
                      <div id="pwd-strength-bar" class="h-full bg-red-500 transition-all duration-300 rounded-full" style="width: 15%; height: 100%;"></div>
                    </div>
                  </div>

                  <!-- Compact Requirement Checklist -->
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2 text-xs">
                    <div id="chk-length" class="text-muted flex items-center gap-2">
                      <i class="fa-regular fa-circle text-[10px]"></i>
                      <span>At least 12 characters</span>
                    </div>
                    <div id="chk-cases" class="text-muted flex items-center gap-2">
                      <i class="fa-regular fa-circle text-[10px]"></i>
                      <span>Uppercase & lowercase letters</span>
                    </div>
                    <div id="chk-number" class="text-muted flex items-center gap-2">
                      <i class="fa-regular fa-circle text-[10px]"></i>
                      <span>At least one number (0-9)</span>
                    </div>
                    <div id="chk-special" class="text-muted flex items-center gap-2">
                      <i class="fa-regular fa-circle text-[10px]"></i>
                      <span>At least one special character</span>
                    </div>
                  </div>

                  <!-- Confirm Password -->
                  <div class="pt-3 border-t border-subtle">
                    <label for="admin_confirm_password" class="block text-xs font-bold uppercase tracking-wider text-secondary mb-1.5">
                      Confirm administrator password *
                    </label>
                    <div class="input-with-icon">
                      <i class="fa-solid fa-key input-icon-left"></i>
                      <input 
                        type="password" 
                        id="admin_confirm_password" 
                        name="confirm_password" 
                        required 
                        minlength="12"
                        oninput="checkPasswordMatch()"
                        placeholder="Repeat master password"
                      />
                    </div>
                    <div id="pwd-match-msg" class="text-xs font-semibold mt-1 text-red-500 hidden flex items-center gap-1.5">
                      <i class="fa-solid fa-circle-exclamation text-[11px]"></i>
                      <span>Passwords do not match</span>
                    </div>
                  </div>
                </div>

                <!-- Primary Administrative Phone -->
                <div>
                  <label for="inst_phone" class="block text-xs font-bold uppercase tracking-wider text-secondary mb-1">
                    Primary Contact / Mobile Phone *
                  </label>
                  <p class="text-xs text-secondary mb-2">Used for critical administrative security alerts and SMS verification.</p>
                  <div class="input-with-icon">
                    <i class="fa-solid fa-phone input-icon-left"></i>
                    <input 
                      type="tel" 
                      id="inst_phone" 
                      name="phone" 
                      required
                      placeholder="+91 (987) 654-3210 or +1 (555) 234-5678"
                      value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>"
                    />
                  </div>
                </div>

                <!-- Primary CTA: Step 1 -> Step 2 -->
                <div class="pt-2">
                  <button 
                    type="button" 
                    onclick="goToStep(2)" 
                    class="btn-primary w-full py-3.5 text-sm font-bold flex items-center justify-center gap-2.5 rounded-xl shadow-md"
                  >
                    <span>Continue to Institution Details</span>
                    <i class="fa-solid fa-arrow-right text-xs"></i>
                  </button>
                </div>
              </div>

              <!-- ============================================================= -->
              <!-- STEP 2: INSTITUTION PROFILE & DATA REGION                     -->
              <!-- ============================================================= -->
              <div id="step-2-content" class="hidden space-y-6">
                <div class="border-b border-subtle pb-4">
                  <h2 class="text-xl font-bold text-primary">
                    Institution details & data residency
                  </h2>
                  <p class="text-xs sm:text-sm text-secondary mt-1">
                    Configure your college registry details and select your dedicated regional data plane.
                  </p>
                </div>

                <!-- Official Institution Name with Live AICTE Registry Auto-Search -->
                <div class="relative">
                  <div class="flex items-center justify-between mb-1">
                    <label for="inst_name" class="block text-xs font-bold uppercase tracking-wider text-secondary">
                      Official Institution / College Name *
                    </label>
                    <span id="aicte-badge" class="hidden badge-success text-[11px] font-bold px-2 py-0.5">
                      <i class="fa-solid fa-award"></i> AICTE / UGC Recognized
                    </span>
                  </div>
                  <p class="text-xs text-secondary mb-2">Type your college name to search the verified AICTE/UGC national registry.</p>
                  
                  <div class="input-with-icon">
                    <i class="fa-solid fa-building-columns input-icon-left"></i>
                    <input 
                      type="text" 
                      id="inst_name" 
                      name="institution_name" 
                      required 
                      oninput="handleInstitutionInput(this.value)"
                      placeholder="e.g. Indian Institute of Technology Bombay or Stanford University"
                      value="<%= typeof formData !== 'undefined' && formData.institution_name ? formData.institution_name : '' %>"
                      autocomplete="off"
                    />
                  </div>

                  <!-- Autocomplete Dropdown List -->
                  <div id="inst-lookup-dropdown" class="hidden absolute z-30 left-0 right-0 mt-1 bg-surface border border-subtle rounded-xl shadow-xl overflow-hidden divide-y divide-subtle max-h-64 overflow-y-auto">
                    <!-- Results populated dynamically by JS -->
                  </div>
                  <input type="hidden" id="aicte_code" name="aicte_code" value="">
                </div>

                <!-- Institution Code & Institution Type -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label for="inst_code" class="block text-xs font-bold uppercase tracking-wider text-secondary mb-1.5">
                      Institution Code *
                    </label>
                    <input 
                      type="text" 
                      id="inst_code" 
                      name="institution_code" 
                      required
                      placeholder="e.g. IITB, BITS, STANFORD"
                      style="text-transform: uppercase; font-family: monospace; font-weight: bold;"
                    />
                    <p class="text-[11px] text-secondary mt-1">Unique tenant identifier for student portals.</p>
                  </div>

                  <div>
                    <label for="inst_type" class="block text-xs font-bold uppercase tracking-wider text-secondary mb-1.5">
                      Institution Type *
                    </label>
                    <select id="inst_type" name="institution_type">
                      <option value="engineering" selected>Institute of Technology / Engineering</option>
                      <option value="university">University</option>
                      <option value="college">College of Higher Education</option>
                      <option value="medical">Medical & Health Sciences Institute</option>
                      <option value="business">Business & Management School</option>
                      <option value="academy">Polytechnic / Academy</option>
                    </select>
                    <p class="text-[11px] text-secondary mt-1">Sets appropriate curriculum frameworks.</p>
                  </div>
                </div>

                <!-- Dedicated Regional Data Residency Plane -->
                <div class="p-4 sm:p-5 rounded-xl bg-surface-hover border border-subtle space-y-3" style="border-radius: 12px;">
                  <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-secondary">
                      Data Plane & Regional Residency *
                    </label>
                    <p class="text-[11px] text-secondary mt-0.5">
                      Select where your student records, grades, and audit trail are physically stored and processed.
                    </p>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <!-- India Data Plane -->
                    <label class="selection-card selected">
                      <input type="radio" name="data_region" value="in-west-mumbai" checked class="sr-only">
                      <div class="flex items-center gap-2 mb-1">
                        <span class="text-base">🇮🇳</span>
                        <span class="text-xs font-bold text-primary">India (Mumbai)</span>
                      </div>
                      <span class="text-[10px] font-bold mb-1" style="color: var(--success);">DPDP Act Compliant</span>
                      <span class="text-[11px] text-secondary leading-tight">Ultra-low latency (<20ms). Complete national data localization.</span>
                    </label>

                    <!-- Europe Data Plane -->
                    <label class="selection-card">
                      <input type="radio" name="data_region" value="eu-central-frankfurt" class="sr-only">
                      <div class="flex items-center gap-2 mb-1">
                        <span class="text-base">🇪🇺</span>
                        <span class="text-xs font-bold text-primary">Europe (Frankfurt)</span>
                      </div>
                      <span class="text-[10px] font-bold mb-1" style="color: var(--accent-primary);">GDPR Certified</span>
                      <span class="text-[11px] text-secondary leading-tight">Strict European sovereignty & encryption standards.</span>
                    </label>

                    <!-- US Data Plane -->
                    <label class="selection-card">
                      <input type="radio" name="data_region" value="us-east-virginia" class="sr-only">
                      <div class="flex items-center gap-2 mb-1">
                        <span class="text-base">🇺🇸</span>
                        <span class="text-xs font-bold text-primary">US (N. Virginia)</span>
                      </div>
                      <span class="text-[10px] font-bold mb-1" style="color: #0284C7;">SOC 2 / FERPA</span>
                      <span class="text-[11px] text-secondary leading-tight">Global high-availability for international programs.</span>
                    </label>
                  </div>
                </div>

                <!-- Campus Address -->
                <div>
                  <label for="inst_address" class="block text-xs font-bold uppercase tracking-wider text-secondary mb-1.5">
                    Campus Physical Address <span class="font-normal text-muted lowercase">(optional)</span>
                  </label>
                  <input 
                    type="text" 
                    id="inst_address" 
                    name="address" 
                    placeholder="e.g. 100 University Boulevard, Tech Campus, Mumbai"
                  />
                </div>

                <!-- Step 2 Navigation Actions -->
                <div class="flex items-center gap-3 pt-2">
                  <button 
                    type="button" 
                    onclick="goToStep(1)" 
                    class="btn-secondary px-5 py-3 text-xs font-bold"
                  >
                    <i class="fa-solid fa-arrow-left mr-1.5"></i> Back
                  </button>

                  <button 
                    type="button" 
                    onclick="goToStep(3)" 
                    class="btn-primary flex-1 py-3.5 text-sm font-bold shadow-md flex items-center justify-center gap-2"
                  >
                    <span>Continue to Plan & Compliance</span>
                    <i class="fa-solid fa-arrow-right text-xs"></i>
                  </button>
                </div>
              </div>

              <!-- ============================================================= -->
