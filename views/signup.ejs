                </div>
                <div class="text-lg font-bold text-[var(--text-primary)] mb-2">₹5 Lakhs<span class="text-[10px] font-normal text-[var(--text-muted)]">/yr</span></div>
                <ul class="text-[11px] text-[var(--text-secondary)] space-y-1 mb-2 flex-1">
                  <li><i class="fa-solid fa-check text-emerald-500 mr-1"></i> Core Attendance & Timetable</li>
                  <li><i class="fa-solid fa-check text-emerald-500 mr-1"></i> Library Catalog & Loans</li>
                  <li><i class="fa-solid fa-check text-emerald-500 mr-1"></i> Standard Email Support</li>
                </ul>
              </label>

              <!-- Tier 2: Professional (Recommended) -->
              <label class="plan-card relative flex flex-col p-4 rounded-[10px] border-2 border-[var(--accent-primary)] bg-[rgba(108,92,231,0.04)] cursor-pointer transition-all">
                <input type="radio" name="plan_tier" value="professional" checked class="sr-only">
                <div class="absolute -top-2.5 right-3 bg-[var(--accent-primary)] text-white text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full shadow-sm">
                  Recommended
                </div>
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-xs font-bold text-[var(--accent-primary)]">Professional</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-[rgba(108,92,231,0.12)] text-[var(--accent-primary)] font-semibold">5,000 Students</span>
                </div>
                <div class="text-lg font-bold text-[var(--text-primary)] mb-2">₹15 Lakhs<span class="text-[10px] font-normal text-[var(--text-muted)]">/yr</span></div>
                <ul class="text-[11px] text-[var(--text-secondary)] space-y-1 mb-2 flex-1">
                  <li><i class="fa-solid fa-check text-emerald-500 mr-1"></i> <strong>All Core Modules</strong></li>
                  <li><i class="fa-solid fa-check text-emerald-500 mr-1"></i> <strong>Predictive Academic AI</strong></li>
                  <li><i class="fa-solid fa-check text-emerald-500 mr-1"></i> <strong>Course Analytics & Heatmaps</strong></li>
                  <li><i class="fa-solid fa-check text-emerald-500 mr-1"></i> Priority 24/7 SLA Support</li>
                </ul>
              </label>

              <!-- Tier 3: Enterprise -->
              <label class="plan-card relative flex flex-col p-4 rounded-[10px] border border-[var(--border-subtle)] bg-[var(--bg-surface)] cursor-pointer hover:border-[var(--accent-primary)] transition-all">
                <input type="radio" name="plan_tier" value="enterprise" class="sr-only">
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-xs font-bold text-[var(--text-primary)]">Enterprise</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-100 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 font-semibold">Unlimited</span>
                </div>
                <div class="text-lg font-bold text-[var(--text-primary)] mb-2">₹30+ Lakhs<span class="text-[10px] font-normal text-[var(--text-muted)]">/yr</span></div>
                <ul class="text-[11px] text-[var(--text-secondary)] space-y-1 mb-2 flex-1">
                  <li><i class="fa-solid fa-check text-emerald-500 mr-1"></i> Multi-Campus Federation</li>
                  <li><i class="fa-solid fa-check text-emerald-500 mr-1"></i> Custom SIS Integrations</li>
                  <li><i class="fa-solid fa-check text-emerald-500 mr-1"></i> Dedicated Account Manager</li>
                </ul>
              </label>
