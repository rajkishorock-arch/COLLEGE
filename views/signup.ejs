            <!-- Final Submission Buttons -->
            <div class="flex items-center gap-3">
              <button 
                type="button" 
                onclick="goToStep(2)" 
                class="px-5 py-3 rounded-[8px] border border-[var(--border-subtle)] text-xs font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-hover)] transition-all"
              >
                <i class="fa-solid fa-arrow-left mr-1.5"></i> Back
              </button>

              <button 
                type="submit" 
                class="btn-primary flex-1 py-3.5 text-base font-bold shadow-lg shadow-[var(--accent-glow)] flex items-center justify-center gap-2"
              >
                <i class="fa-solid fa-rocket text-sm"></i>
                <span>Register Institution & Start Onboarding</span>
              </button>
            </div>
          </div>
        </form>
      </div>

      <!-- TAB 2: JOIN AS STUDENT (Enrollment) -->
      <div id="tab-content-student" class="<%= (activeTab === 'student') ? '' : 'hidden' %>">
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-[var(--text-primary)] tracking-tight font-['Space_Grotesk']">
            Student Enrollment Profile
          </h2>
          <p class="text-sm text-[var(--text-secondary)] mt-1">
            Register your academic student identity to access course timetables, quizzes, results, and attendance records.
          </p>
        </div>

        <form action="/signup" method="POST" class="space-y-4">
          <input type="hidden" name="signup_type" value="student">

          <div>
            <label for="student_tenant_id" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
              Select Your Institution / College *
            </label>
            <select 
              id="student_tenant_id" 
              name="tenant_id" 
              required
              class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
            >
              <% if (typeof tenants !== 'undefined' && tenants && tenants.length > 0) { %>
                <% tenants.forEach(t => { %>
                  <option value="<%= t.id %>" <%= (typeof selectedTenantId !== 'undefined' && selectedTenantId === t.id) ? 'selected' : '' %>>
                    <%= t.name %> (<%= t.code %>)
                  </option>
                <% }); %>
              <% } else { %>
                <option value="tenant_default" selected>CampusPulse Institute of Technology (DEFAULT)</option>
              <% } %>
            </select>
          </div>

          <div>
            <label for="student_name" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
              Full Legal Name *
            </label>
            <input 
              type="text" 
              id="student_name" 
              name="name" 
              required 
              placeholder="e.g. Alex Johnson"
              class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="student_email" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                Email Address *
              </label>
              <input 
                type="email" 
                id="student_email" 
                name="email" 
                required 
                placeholder="alex@college.edu"
                class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
