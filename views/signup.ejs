            <!-- Guarantee Callout -->
            <div class="p-3 rounded-[8px] bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/50 text-xs text-emerald-800 dark:text-emerald-300 flex items-center gap-2.5">
              <i class="fa-solid fa-shield-check text-base text-emerald-600 shrink-0"></i>
              <span><strong>30-Day Money-Back Guarantee:</strong> Evaluate CampusPulse risk-free. Complete data export available at any time.</span>
