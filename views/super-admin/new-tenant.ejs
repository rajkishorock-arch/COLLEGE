<div class="max-w-3xl mx-auto space-y-6">
  
  <!-- Breadcrumb -->
  <div class="flex items-center gap-2">
    <a href="/super-admin" class="text-xs font-semibold text-[#8B8F99] hover:text-[#111318] transition-colors">
      Platform Admin
    </a>
    <span class="text-[#8B8F99] text-xs">/</span>
    <a href="/super-admin/tenants" class="text-xs font-semibold text-[#8B8F99] hover:text-[#111318] transition-colors">
      Institutions
    </a>
    <span class="text-[#8B8F99] text-xs">/</span>
    <span class="text-xs font-semibold text-[#111318]">New Institution</span>
  </div>

  <div class="card p-6 sm:p-8">
    <div class="mb-6 pb-4 border-b border-[#E5E7EB]">
      <h1 class="text-xl sm:text-2xl font-bold text-[#111318] font-['Space_Grotesk'] tracking-tight">
        Onboard New Collegiate Institution
      </h1>
      <p class="text-xs sm:text-sm text-[#5B5F6B] mt-1">
        Provision an isolated collegiate tenant, configure institutional branding, and assign the primary College Administrator.
      </p>
    </div>

    <!-- Error Alert -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 p-4 rounded-[8px] bg-[#FEECEE] border border-[var(--danger)] text-[#E5384B] text-sm font-medium flex items-center gap-3">
        <i class="fa-solid fa-circle-exclamation shrink-0 text-base"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/super-admin/tenants/new" method="POST" class="space-y-6">
      
      <!-- Section 1: Institutional Identity -->
      <div>
        <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--accent-primary)] mb-3 flex items-center gap-2">
          <i class="fa-solid fa-building-columns"></i>
          <span>1. Institutional Identity</span>
        </h2>
        
        <div class="space-y-4">
          <div>
            <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-1.5">
              Full Legal Institution Name *
            </label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required 
              placeholder="e.g. Apex Institute of Technology"
              value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>"
              class="w-full px-4 py-2.5 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] placeholder-[#8B8F99] focus:outline-none focus:border-[var(--accent-primary)]"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="code" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-1.5">
                Institutional Code (Unique ID) *
              </label>
              <input 
                type="text" 
                id="code" 
                name="code" 
                required 
                placeholder="e.g. APEX or MIT"
                value="<%= typeof formData !== 'undefined' && formData.code ? formData.code : '' %>"
                class="w-full px-4 py-2.5 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm font-mono uppercase text-[#111318] placeholder-[#8B8F99] focus:outline-none focus:border-[var(--accent-primary)]"
              />
              <span class="text-[11px] text-[#8B8F99] mt-1 block">Generates isolated tenantId e.g. tenant_apex</span>
            </div>

            <div>
              <label for="shortName" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-1.5">
                Display Acronym / Short Name
              </label>
              <input 
                type="text" 
                id="shortName" 
                name="shortName" 
                placeholder="e.g. AIT"
                value="<%= typeof formData !== 'undefined' && formData.shortName ? formData.shortName : '' %>"
                class="w-full px-4 py-2.5 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] placeholder-[#8B8F99] focus:outline-none focus:border-[var(--accent-primary)]"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-1.5">
                Official Support Email
              </label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                placeholder="e.g. contact@apex.edu"
                value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
                class="w-full px-4 py-2.5 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] placeholder-[#8B8F99] focus:outline-none focus:border-[var(--accent-primary)]"
              />
            </div>

            <div>
              <label for="phone" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-1.5">
                Official Phone Number
              </label>
              <input 
                type="text" 
                id="phone" 
                name="phone" 
                placeholder="e.g. +1 (555) 987-6543"
                value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>"
                class="w-full px-4 py-2.5 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] placeholder-[#8B8F99] focus:outline-none focus:border-[var(--accent-primary)]"
              />
            </div>
          </div>

          <div>
            <label for="address" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-1.5">
              Campus Physical Address
            </label>
            <input 
              type="text" 
              id="address" 
              name="address" 
              placeholder="e.g. 500 University Way, Academic District"
              value="<%= typeof formData !== 'undefined' && formData.address ? formData.address : '' %>"
              class="w-full px-4 py-2.5 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] placeholder-[#8B8F99] focus:outline-none focus:border-[var(--accent-primary)]"
            />
          </div>
        </div>
      </div>

      <!-- Section 2: Branding & Academic Year -->
      <div class="pt-4 border-t border-[#E5E7EB]">
        <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--accent-primary)] mb-3 flex items-center gap-2">
          <i class="fa-solid fa-palette"></i>
          <span>2. Branding & Theme Colors</span>
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="primaryColor" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-1.5">
              Primary Brand Color
            </label>
            <div class="flex items-center gap-2">
              <input 
                type="color" 
                id="primaryColorPicker" 
                value="#6C5CE7"
                onchange="document.getElementById('primaryColor').value = this.value"
                class="w-10 h-10 rounded border border-[#E5E7EB] p-0.5 cursor-pointer"
              />
              <input 
                type="text" 
                id="primaryColor" 
                name="primaryColor" 
                value="#6C5CE7"
                class="w-full px-3 py-2 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm font-mono text-[#111318]"
              />
            </div>
          </div>

          <div>
            <label for="secondaryColor" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-1.5">
              Secondary Tone Color
            </label>
            <div class="flex items-center gap-2">
              <input 
                type="color" 
                id="secondaryColorPicker" 
                value="#111318"
                onchange="document.getElementById('secondaryColor').value = this.value"
                class="w-10 h-10 rounded border border-[#E5E7EB] p-0.5 cursor-pointer"
              />
              <input 
                type="text" 
                id="secondaryColor" 
                name="secondaryColor" 
                value="#111318"
                class="w-full px-3 py-2 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm font-mono text-[#111318]"
              />
            </div>
          </div>

          <div>
            <label for="academicYear" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-1.5">
              Current Academic Year
            </label>
            <input 
              type="text" 
              id="academicYear" 
              name="academicYear" 
              value="2025-2026"
              class="w-full px-3 py-2 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318]"
            />
          </div>
        </div>
      </div>

      <!-- Section 3: Initial College Administrator -->
      <div class="pt-4 border-t border-[#E5E7EB]">
        <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--accent-primary)] mb-3 flex items-center gap-2">
          <i class="fa-solid fa-user-shield"></i>
          <span>3. Initial College Administrator Account</span>
        </h2>
        <p class="text-xs text-[#5B5F6B] mb-4">
          This administrator will be granted full authority strictly scoped to this institution's data.
        </p>

        <div class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="adminName" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-1.5">
                Administrator Full Name *
              </label>
              <input 
                type="text" 
                id="adminName" 
                name="adminName" 
                required 
                placeholder="e.g. Dr. Robert Vance"
                value="<%= typeof formData !== 'undefined' && formData.adminName ? formData.adminName : '' %>"
                class="w-full px-4 py-2.5 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] placeholder-[#8B8F99]"
              />
            </div>

            <div>
              <label for="adminEmail" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-1.5">
                Administrator Email Address *
              </label>
              <input 
                type="email" 
                id="adminEmail" 
                name="adminEmail" 
                required 
                placeholder="e.g. admin@apex.edu"
                value="<%= typeof formData !== 'undefined' && formData.adminEmail ? formData.adminEmail : '' %>"
                class="w-full px-4 py-2.5 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] placeholder-[#8B8F99]"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="adminPassword" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-1.5">
                Temporary Password *
              </label>
              <input 
                type="password" 
                id="adminPassword" 
                name="adminPassword" 
                required 
                minlength="6"
                placeholder="Minimum 6 characters"
                class="w-full px-4 py-2.5 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] placeholder-[#8B8F99]"
              />
            </div>

            <div>
              <label for="confirmPassword" class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-1.5">
                Confirm Password *
              </label>
              <input 
                type="password" 
                id="confirmPassword" 
                name="confirmPassword" 
                required 
                minlength="6"
                placeholder="Confirm temporary password"
                class="w-full px-4 py-2.5 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-sm text-[#111318] placeholder-[#8B8F99]"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Form Actions -->
      <div class="pt-6 border-t border-[#E5E7EB] flex items-center justify-end gap-3">
        <a href="/super-admin/tenants" class="px-5 py-2.5 rounded-[8px] text-xs font-semibold text-[#5B5F6B] hover:text-[#111318] hover:bg-[#F7F7F9] transition-colors">
          Cancel
        </a>
        <button type="submit" class="btn btn-primary px-6 py-2.5">
          <i class="fa-solid fa-check text-xs mr-1.5"></i>
          Provision Institution
        </button>
      </div>

    </form>
  </div>

</div>
