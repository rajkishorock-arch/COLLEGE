<div class="space-y-6">
  
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <a href="/super-admin" class="text-xs font-semibold text-[#8B8F99] hover:text-[#111318] transition-colors">
          Platform Admin
        </a>
        <span class="text-[#8B8F99] text-xs">/</span>
        <span class="text-xs font-semibold text-[#111318]">Platform Audit</span>
      </div>
      <h1 class="text-2xl font-bold text-[#111318] tracking-tight font-['Space_Grotesk'] mt-1">
        Global Platform Audit Logs
      </h1>
      <p class="text-xs sm:text-sm text-[#5B5F6B] mt-0.5">
        Immutable, cross-tenant security and administrative activity audit trail.
      </p>
    </div>
  </div>

  <!-- Audit Table Card -->
  <div class="card p-6">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs sm:text-sm">
        <thead>
          <tr class="border-b border-[#E5E7EB] text-[#5B5F6B] text-[11px] uppercase tracking-wider font-semibold">
            <th class="py-3 px-3">Timestamp</th>
            <th class="py-3 px-3">Institution</th>
            <th class="py-3 px-3">Administrator</th>
            <th class="py-3 px-3">Action</th>
            <th class="py-3 px-3">Details</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#E5E7EB]">
          <% if (auditLogs && auditLogs.length > 0) { %>
            <% auditLogs.forEach(log => { %>
              <tr class="hover:bg-[#F7F7F9] transition-colors">
                <td class="py-3 px-3 whitespace-nowrap text-[#8B8F99] font-mono text-[11px]">
                  <%= new Date(log.created_at).toLocaleString() %>
                </td>
                <td class="py-3 px-3">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-mono font-bold bg-[#F0EEFF] text-[#6C5CE7]">
                    <%= log.tenant_code || log.tenant_id %>
                  </span>
                </td>
                <td class="py-3 px-3">
                  <div class="font-semibold text-[#111318]"><%= log.admin_name || 'System' %></div>
                  <div class="text-[11px] text-[#8B8F99]"><%= log.admin_email || '' %></div>
                </td>
                <td class="py-3 px-3">
                  <span class="font-semibold text-[#111318]"><%= log.action %></span>
                </td>
                <td class="py-3 px-3 text-[#5B5F6B] text-xs max-w-md">
                  <%= log.details %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="py-8 text-center text-xs text-[#8B8F99]">
                No platform audit entries recorded yet.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="pt-4 border-t border-[#E5E7EB] flex items-center justify-between text-xs text-[#5B5F6B]">
        <span>Showing Page <%= currentPage %> of <%= totalPages %> (<%= totalLogs %> events)</span>
        <div class="flex items-center gap-2">
          <% if (currentPage > 1) { %>
            <a href="/super-admin/audit?page=<%= currentPage - 1 %>" class="px-3 py-1.5 rounded-[6px] border border-[#E5E7EB] hover:bg-[#F7F7F9]">
              Previous
            </a>
          <% } %>
          <% if (currentPage < totalPages) { %>
            <a href="/super-admin/audit?page=<%= currentPage + 1 %>" class="px-3 py-1.5 rounded-[6px] border border-[#E5E7EB] hover:bg-[#F7F7F9]">
              Next
            </a>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>

</div>
