<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'CampusPulse - Higher Education Management Platform' %></title>
  
  <!-- Anti-Flash Instant Theme Detection -->
  <script>
    (function() {
      try {
        const theme = localStorage.getItem('campuspulse-theme') || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Google Fonts: Inter + Space Grotesk -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <!-- Tailwind CSS via CSP-allowed Cloudflare CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" />

  <!-- Chart.js CDN for results & analytics -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- CampusPulse Core Design System -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[var(--bg-primary)] text-[var(--text-primary)] min-h-screen flex flex-col antialiased transition-colors duration-200">

  <% if (typeof user !== 'undefined' && user) { %>
    <!-- Authenticated AppShell (Zero-Overlap Flexbox Architecture) -->
    <div class="app-layout">
      <!-- Fixed/Sticky Desktop Sidebar & Mobile Drawer -->
      <%- include('partials/sidebar') %>

      <!-- Main Operational Area (Starts strictly AFTER sidebar) -->
      <div class="app-main-area">
        <!-- Top Navigation Bar -->
        <%- include('partials/topbar') %>

        <!-- Main Content Area: Centered, Non-Overlapping -->
        <main class="app-content-container">
          <%- include('partials/alerts') %>
          <%- body %>
        </main>

        <!-- Institutional Footer -->
        <footer class="py-4 px-6 border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] text-center text-xs text-[var(--text-muted)]">
          <p>&copy; <%= new Date().getFullYear() %> CampusPulse Enterprise • Autonomous Multi-Tenant Higher Education SaaS</p>
        </footer>
      </div>
    </div>

    <!-- Chatbot widget for students -->
    <% if (user.role === 'student') { %>
      <%- include('partials/chatbot') %>
    <% } %>

  <% } else { %>
    <!-- Fallback Unauthenticated Container -->
    <main class="flex-1 flex flex-col justify-center items-center px-4 py-8 max-w-[1280px] w-full mx-auto">
      <%- include('partials/alerts') %>
      <%- body %>
    </main>
  <% } %>

  <!-- Application Interaction Logic -->
  <script src="/js/main.js"></script>
</body>
</html>
