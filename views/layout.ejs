<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'CampusPulse - Higher Education Management Platform' %></title>
  
  <!-- Anti-Flash Instant Theme Detection -->
  <script>
    (function() {
      try {
        const theme = localStorage.getItem('campuspulse-theme') || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Google Fonts: Google Sans Flex + Google Sans Code + Google Symbols + Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,slnt,wdth,wght,ROND@8..144,-10..0,25..150,400..700,0..100&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans+Code:ital,wght@0,400..700;1,400..700&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Symbols:opsz,wght,FILL,GRAD,ROND@20..48,100..700,0..1,-50..200,0..100&display=block">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <!-- Tailwind CSS via CSP-allowed Cloudflare CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" />

  <!-- Chart.js CDN for results & analytics -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- CampusPulse Antigravity Design System -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-canvas bg-[var(--bg-primary)] text-primary text-[var(--text-primary)] min-h-screen flex flex-col antialiased transition-colors duration-200 relative overflow-x-hidden">

  <!-- Ambient Antigravity Background Mesh & Glow Orbs -->
  <div class="agy-ambient-canvas" aria-hidden="true">
    <div class="agy-orb agy-orb-1"></div>
    <div class="agy-orb agy-orb-2"></div>
    <div class="agy-orb agy-orb-3"></div>
  </div>

  <% if (typeof user !== 'undefined' && user) { %>
    <!-- Authenticated AppShell (Zero-Overlap Flexbox Architecture) -->
    <div class="app-layout relative z-10">
      <!-- Fixed/Sticky Desktop Sidebar & Mobile Drawer -->
      <%- include('partials/sidebar') %>

      <!-- Main Operational Area (Starts strictly AFTER sidebar) -->
      <div class="app-main-area">
        <!-- Top Navigation Bar -->
        <%- include('partials/topbar') %>

        <!-- Main Content Area: Centered, Non-Overlapping -->
        <main class="app-content-container">
          <%- include('partials/alerts') %>
          <%- body %>
        </main>

        <!-- Institutional Footer -->
        <footer class="py-4 px-6 border-t border-subtle border-[var(--border-subtle)] bg-surface bg-[var(--bg-surface)] text-center text-xs text-muted text-[var(--text-muted)]">
          <p>&copy; <%= new Date().getFullYear() %> CampusPulse Enterprise • Autonomous Multi-Tenant Higher Education SaaS</p>
        </footer>
      </div>
    </div>

    <!-- Chatbot widget for students -->
    <% if (user.role === 'student') { %>
      <%- include('partials/chatbot') %>
    <% } %>

  <% } else { %>
    <!-- Fallback Unauthenticated Container -->
    <main class="flex-1 flex flex-col justify-center items-center px-4 py-8 max-w-[1280px] w-full mx-auto">
      <%- include('partials/alerts') %>
      <%- body %>
    </main>
  <% } %>

  <!-- Application Interaction Logic -->
  <script src="/js/main.js"></script>
</body>
</html>
