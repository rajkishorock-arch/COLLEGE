<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CampusPulse - The Modern College Management Platform</title>

  <!-- Anti-Flash Instant Theme Detection -->
  <script>
    (function() {
      try {
        const theme = localStorage.getItem('campuspulse-theme') || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Google Fonts: Space Grotesk (Headings/Stats) + Inter (Body/UI) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[var(--bg-primary)] text-[var(--text-primary)] antialiased selection:bg-[var(--accent-primary)] selection:text-white transition-colors duration-200">

  <!-- =========================================================================
       1. Top Sticky Navigation Bar
       ========================================================================= -->
  <header class="sticky top-0 z-50 bg-[var(--bg-surface)]/90 backdrop-blur-md border-b border-[var(--border-subtle)] transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-[10px] bg-[var(--accent-primary)] text-white flex items-center justify-center text-xl shadow-md shadow-[var(--accent-glow)] group-hover:scale-105 transition-transform">
          <i class="fa-solid fa-graduation-cap"></i>
        </div>
        <div>
          <span class="font-bold text-xl tracking-tight text-[var(--text-primary)] block leading-none font-['Space_Grotesk']">
            CAMPUS<span class="text-[var(--accent-primary)]">PULSE</span>
          </span>
          <span class="text-[10px] uppercase tracking-wider text-[var(--text-muted)] font-medium block mt-1">
            Autonomous SaaS Platform
          </span>
        </div>
      </a>

      <!-- Desktop Anchor Navigation Links -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-[var(--text-secondary)]">
        <a href="#features" class="hover:text-[var(--accent-primary)] transition-colors">Features</a>
        <a href="#preview" class="hover:text-[var(--accent-primary)] transition-colors">Live Preview</a>
        <a href="#how-it-works" class="hover:text-[var(--accent-primary)] transition-colors">How It Works</a>
        <a href="#security" class="hover:text-[var(--accent-primary)] transition-colors">Security</a>
      </nav>

      <!-- Action Buttons & Theme Selector -->
      <div class="hidden sm:flex items-center gap-3">
        <%- include('partials/theme-toggle') %>
        <a 
          href="/login" 
          class="btn-secondary py-2.5 px-4 text-xs font-semibold rounded-[8px]"
        >
          Sign In
        </a>
        <a 
          href="/signup" 
          class="btn-primary py-2.5 px-5 text-xs font-semibold rounded-[8px] flex items-center gap-2"
        >
          <span>Create Institution</span>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex md:hidden items-center gap-2">
        <%- include('partials/theme-toggle') %>
        <button 
          id="landing-mobile-menu-btn" 
          type="button" 
          aria-label="Toggle Navigation Menu"
          class="p-2 rounded-[8px] border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-hover)]"
        >
          <i class="fa-solid fa-bars text-lg"></i>
        </button>
      </div>

    </div>

    <!-- Mobile Navigation Dropdown -->
    <div id="landing-mobile-menu" class="hidden md:hidden border-b border-[var(--border-subtle)] bg-[var(--bg-surface)] px-6 py-4 space-y-3">
      <a href="#features" class="block text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--accent-primary)]">Features</a>
      <a href="#preview" class="block text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--accent-primary)]">Live Preview</a>
      <a href="#how-it-works" class="block text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--accent-primary)]">How It Works</a>
      <a href="#security" class="block text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--accent-primary)]">Security</a>
      <div class="pt-3 border-t border-[var(--border-subtle)] flex flex-col gap-2">
        <a href="/login" class="btn-secondary py-2.5 text-center text-xs font-semibold">Sign In</a>
        <a href="/signup" class="btn-primary py-2.5 text-center text-xs font-semibold">Create Institution</a>
      </div>
    </div>
  </header>

  <!-- =========================================================================
       2. Hero Section
       ========================================================================= -->
  <section class="relative overflow-hidden hero-glow-backdrop pt-12 pb-20 lg:pt-20 lg:pb-28 border-b border-[#E5E7EB]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Left: Hero Headline & CTAs (7 cols) -->
        <div class="lg:col-span-7 space-y-6 fade-slide-up">
          
          <!-- Live Badge -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[rgba(108,92,231,0.12)] border border-[rgba(108,92,231,0.25)] text-[var(--accent-primary)] text-xs font-semibold tracking-wide">
            <span class="w-2 h-2 rounded-full bg-[var(--accent-primary)] animate-pulse"></span>
            <span>Self-Service Multi-Tenant Higher Education SaaS</span>
          </div>

          <!-- Main Bold Headline -->
          <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-bold text-[var(--text-primary)] leading-[1.12] tracking-tight font-['Space_Grotesk']">
            Autonomous Campus Operations. <br/>
            <span class="bg-gradient-to-r from-[var(--accent-primary)] via-[#818CF8] to-[#6366F1] bg-clip-text text-transparent">
              Instant Institutional Cloud.
            </span>
          </h1>

          <!-- Supporting Paragraph -->
          <p class="text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed max-w-2xl font-normal">
            Deploy your college, university, or institute in seconds. An enterprise multi-tenant operating system featuring Row-Level Security, private file storage, PIN-based attendance check-ins, gradebook analytics, and autonomous institutional administration without manual platform bottlenecks.
          </p>

          <!-- Dual Call to Action Buttons -->
          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
            <a 
              href="/signup" 
              class="btn-primary py-3.5 px-7 text-sm font-bold rounded-[10px] flex items-center justify-center gap-2.5 shadow-lg shadow-[var(--accent-glow)]"
            >
              <span>Create Your Institution</span>
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>

            <a 
              href="/signup?tab=student" 
              class="btn-secondary py-3.5 px-6 text-sm font-semibold rounded-[10px] flex items-center justify-center gap-2"
            >
              <i class="fa-solid fa-user-graduate text-xs text-[var(--accent-primary)]"></i>
              <span>Join as Student</span>
            </a>
          </div>

          <!-- Trust Indicators -->
          <div class="pt-6 border-t border-[#E5E7EB] grid grid-cols-1 sm:grid-cols-3 gap-3.5 text-xs text-[#5B5F6B]">
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-circle-check text-[var(--success)] text-sm shrink-0"></i>
              <span class="font-medium text-[#111318]">Session Code Check-In</span>
            </div>
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-circle-check text-[var(--success)] text-sm shrink-0"></i>
              <span class="font-medium text-[#111318]">Two-Tier Super Admin</span>
            </div>
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-circle-check text-[var(--success)] text-sm shrink-0"></i>
              <span class="font-medium text-[#111318]">Automated Audit History</span>
            </div>
          </div>

        </div>

        <!-- Right: Interactive Live Platform Preview Panel (5 cols) -->
        <div class="lg:col-span-5 fade-slide-up stagger-1">
          <div class="preview-card p-6 sm:p-7 relative overflow-hidden bg-white">
            
            <!-- Preview Banner Header -->
            <div class="flex items-center justify-between pb-4 mb-5 border-b border-[#E5E7EB]">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#1E9E57]"></span>
                <span class="text-[11px] font-bold uppercase tracking-wider text-[#111318]">
                  Live Platform Preview
                </span>
              </div>
              <span class="status-pill text-[10px] py-0.5 px-2 font-bold badge-accent">
                Active Session
              </span>
            </div>

            <!-- Mini Preview Cards Grid -->
            <div class="space-y-4">
              
              <!-- 1. Real-Time Attendance Highlight -->
              <div class="p-4 rounded-[10px] border border-[#E5E7EB] bg-[#FAFAFB] flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-[8px] bg-[#E8F8EE] text-[var(--success)] flex items-center justify-center text-base font-bold shrink-0">
                    <i class="fa-solid fa-clipboard-user"></i>
                  </div>
                  <div>
                    <p class="text-xs font-bold text-[#111318] leading-tight">Lecture Attendance</p>
                    <p class="text-[11px] text-[#5B5F6B] mt-0.5">Session Code: <span class="font-mono font-bold text-[var(--accent-primary)]">#CS842</span></p>
                  </div>
                </div>
                <div class="text-right">
                  <span class="metric-number text-xl font-bold text-[#1E9E57]">87.4%</span>
                  <span class="block text-[9px] uppercase font-bold text-[#8B8F99]">Verified</span>
                </div>
              </div>

              <!-- 2. Academic Performance Metric -->
              <div class="p-4 rounded-[10px] border border-[#E5E7EB] bg-[#FFFFFF] shadow-sm">
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center gap-2">
                    <div class="w-6 h-6 rounded-[6px] bg-[#EDE9FE] text-[#6C5CE7] flex items-center justify-center text-xs">
                      <i class="fa-solid fa-chart-simple"></i>
                    </div>
                    <span class="text-xs font-bold text-[#111318]">Academic CGPA & Scores</span>
                  </div>
                  <span class="status-pill text-[10px] py-0.5 px-2 font-bold badge-success">3.82 CGPA</span>
                </div>
                <div class="space-y-1.5 pt-1">
                  <div class="flex items-center justify-between text-[11px]">
                    <span class="text-[#5B5F6B]">Data Structures (CS-301)</span>
                    <span class="font-bold text-[#111318]">92 / 100</span>
                  </div>
                  <div class="w-full bg-[#E5E7EB] h-1.5 rounded-full overflow-hidden">
                    <div class="bg-[var(--accent-primary)] h-1.5 rounded-full" style="width: 92%"></div>
                  </div>
                </div>
              </div>

              <!-- 3. Library & Circulation Highlight -->
              <div class="p-3.5 rounded-[10px] border border-[#E5E7EB] bg-[#FAFAFB] flex items-center justify-between text-xs">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-[6px] bg-[#FEF6E7] text-[var(--warning)] flex items-center justify-center text-sm">
                    <i class="fa-solid fa-book-bookmark"></i>
                  </div>
                  <div>
                    <p class="font-bold text-[#111318] text-xs">Algorithms (CLRS)</p>
                    <p class="text-[10px] text-[#5B5F6B]">Due: In 48 hours</p>
                  </div>
                </div>
                <span class="status-pill text-[10px] py-0.5 px-2 font-bold badge-warning">Borrowed</span>
              </div>

              <!-- 4. Next Assessment Banner -->
              <div class="p-3 rounded-[8px] bg-[#EDE9FE]/50 border border-[#DDD6FE] flex items-center justify-between text-xs">
                <div class="flex items-center gap-2">
                  <i class="fa-solid fa-stopwatch text-[#6C5CE7]"></i>
                  <span class="text-[#6C5CE7] font-semibold text-[11px]">Next Quiz: Operating Systems</span>
                </div>
                <span class="text-[10px] font-bold text-[#6C5CE7]">Tomorrow 10:00 AM</span>
              </div>

            </div>

            <!-- Footer Badge -->
            <div class="mt-5 pt-4 border-t border-[#E5E7EB] flex items-center justify-between text-[11px] text-[#8B8F99]">
              <span class="flex items-center gap-1.5">
                <i class="fa-solid fa-shield-halved text-[#1E9E57]"></i>
                <span>Protected with Bcrypt + Salt</span>
              </span>
              <a href="/login" class="font-semibold text-[var(--accent-primary)] hover:underline flex items-center gap-1">
                <span>Try Demo</span>
                <i class="fa-solid fa-chevron-right text-[9px]"></i>
              </a>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- =========================================================================
       3. Features Section (6 Modules in 3x2 Grid)
       ========================================================================= -->
  <section id="features" class="py-20 lg:py-28 bg-[#FAFAFB] border-b border-[#E5E7EB]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-16 scroll-reveal">
        <span class="status-pill text-xs font-semibold badge-accent mb-3 inline-block">
          Comprehensive Campus Modules
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold text-[#111318] tracking-tight font-['Space_Grotesk'] mt-2">
          Engineered for Every Dimension of Campus Life
        </h2>
        <p class="body-text text-sm sm:text-base text-[#5B5F6B] mt-3">
          Each feature is tailored to remove administrative bottlenecks and empower students to stay on top of their academic roadmap.
        </p>
      </div>

      <!-- Feature Cards Grid (3 Columns) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Card 1: Self Check-In Attendance -->
        <div class="card p-7 scroll-reveal delay-100 flex flex-col justify-between hover:border-[var(--accent-primary)]">
          <div>
            <div class="w-12 h-12 rounded-[10px] bg-[#EDE9FE] text-[#6C5CE7] flex items-center justify-center text-xl mb-5">
              <i class="fa-solid fa-qrcode"></i>
            </div>
            <h3 class="text-lg font-bold text-[#111318] font-['Space_Grotesk'] mb-2">
              Self Check-In Attendance
            </h3>
            <p class="text-xs text-[#5B5F6B] leading-relaxed">
              Professors launch time-limited 15-minute PIN sessions from the podium. Students check in securely with single-attempt verification to eliminate proxy attendance.
            </p>
          </div>
          <div class="pt-5 mt-5 border-t border-[#E5E7EB] flex items-center justify-between text-xs text-[#8B8F99]">
            <span class="font-medium text-[#111318]">Session Code Based</span>
            <i class="fa-solid fa-arrow-right text-[10px] text-[var(--accent-primary)]"></i>
          </div>
        </div>

        <!-- Card 2: Results & CGPA Tracking -->
        <div class="card p-7 scroll-reveal delay-200 flex flex-col justify-between hover:border-[var(--accent-primary)]">
          <div>
            <div class="w-12 h-12 rounded-[10px] bg-[#E8F8EE] text-[#1E9E57] flex items-center justify-center text-xl mb-5">
              <i class="fa-solid fa-chart-column"></i>
            </div>
            <h3 class="text-lg font-bold text-[#111318] font-['Space_Grotesk'] mb-2">
              Results & Academic CGPA
            </h3>
            <p class="text-xs text-[#5B5F6B] leading-relaxed">
              Semester-wise examination records, automated percentage calculations, and digital report card generation with printable transcripts for student verification.
            </p>
          </div>
          <div class="pt-5 mt-5 border-t border-[#E5E7EB] flex items-center justify-between text-xs text-[#8B8F99]">
            <span class="font-medium text-[#111318]">Semester 1-8 Breakdown</span>
            <i class="fa-solid fa-arrow-right text-[10px] text-[var(--accent-primary)]"></i>
          </div>
        </div>

        <!-- Card 3: Library & Circulation -->
        <div class="card p-7 scroll-reveal delay-300 flex flex-col justify-between hover:border-[var(--accent-primary)]">
          <div>
            <div class="w-12 h-12 rounded-[10px] bg-[#FEF6E7] text-[#E08E00] flex items-center justify-center text-xl mb-5">
              <i class="fa-solid fa-book-open-reader"></i>
            </div>
            <h3 class="text-lg font-bold text-[#111318] font-['Space_Grotesk'] mb-2">
              Library Catalog & Loans
            </h3>
            <p class="text-xs text-[#5B5F6B] leading-relaxed">
              Complete catalog browsing, real-time availability counters, issue/return logging, and automatic overdue notifications to keep textbooks circulating smoothly.
            </p>
          </div>
          <div class="pt-5 mt-5 border-t border-[#E5E7EB] flex items-center justify-between text-xs text-[#8B8F99]">
            <span class="font-medium text-[#111318]">Live Copy Tracking</span>
            <i class="fa-solid fa-arrow-right text-[10px] text-[var(--accent-primary)]"></i>
          </div>
        </div>

        <!-- Card 4: Quizzes & Digital Assessments -->
        <div class="card p-7 scroll-reveal delay-100 flex flex-col justify-between hover:border-[var(--accent-primary)]">
          <div>
            <div class="w-12 h-12 rounded-[10px] bg-[#F0EDFD] text-[var(--accent-primary)] flex items-center justify-center text-xl mb-5">
              <i class="fa-solid fa-pen-to-square"></i>
            </div>
            <h3 class="text-lg font-bold text-[#111318] font-['Space_Grotesk'] mb-2">
              Online Quizzes & Assessments
            </h3>
            <p class="text-xs text-[#5B5F6B] leading-relaxed">
              Multiple-choice tests with countdown timers, randomized options, instant evaluation upon submission, and automated entry into student academic scorecards.
            </p>
          </div>
          <div class="pt-5 mt-5 border-t border-[#E5E7EB] flex items-center justify-between text-xs text-[#8B8F99]">
            <span class="font-medium text-[#111318]">Instant Auto-Grading</span>
            <i class="fa-solid fa-arrow-right text-[10px] text-[var(--accent-primary)]"></i>
          </div>
        </div>

        <!-- Card 5: Announcements & Timetable -->
        <div class="card p-7 scroll-reveal delay-200 flex flex-col justify-between hover:border-[var(--accent-primary)]">
          <div>
            <div class="w-12 h-12 rounded-[10px] bg-[#FEECEE] text-[#E5384B] flex items-center justify-center text-xl mb-5">
              <i class="fa-solid fa-bullhorn"></i>
            </div>
            <h3 class="text-lg font-bold text-[#111318] font-['Space_Grotesk'] mb-2">
              Announcements & Timetable
            </h3>
            <p class="text-xs text-[#5B5F6B] leading-relaxed">
              Weekly class schedule by day and hour, hall assignments, and institutional announcements prioritized into normal, important, and urgent campus broadcasts.
            </p>
          </div>
          <div class="pt-5 mt-5 border-t border-[#E5E7EB] flex items-center justify-between text-xs text-[#8B8F99]">
            <span class="font-medium text-[#111318]">Weekly Schedule View</span>
            <i class="fa-solid fa-arrow-right text-[10px] text-[var(--accent-primary)]"></i>
          </div>
        </div>

        <!-- Card 6: Role-Based Security & Governance -->
        <div class="card p-7 scroll-reveal delay-300 flex flex-col justify-between hover:border-[var(--accent-primary)]">
          <div>
            <div class="w-12 h-12 rounded-[10px] bg-[#EDE9FE] text-[#6C5CE7] flex items-center justify-center text-xl mb-5">
              <i class="fa-solid fa-user-shield"></i>
            </div>
            <h3 class="text-lg font-bold text-[#111318] font-['Space_Grotesk'] mb-2">
              Role-Based Governance
            </h3>
            <p class="text-xs text-[#5B5F6B] leading-relaxed">
              Two-tier admin hierarchy (Super Admin & Staff Admin), brute force lockout after 5 failed attempts, password-confirmed credential editing, and comprehensive audit logs.
            </p>
          </div>
          <div class="pt-5 mt-5 border-t border-[#E5E7EB] flex items-center justify-between text-xs text-[#8B8F99]">
            <span class="font-medium text-[#111318]">Audit Trail Logging</span>
            <i class="fa-solid fa-arrow-right text-[10px] text-[var(--accent-primary)]"></i>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- =========================================================================
       4. How It Works Section
       ========================================================================= -->
  <section id="how-it-works" class="py-20 lg:py-28 bg-[#FFFFFF] border-b border-[#E5E7EB]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Heading -->
      <div class="text-center max-w-3xl mx-auto mb-16 scroll-reveal">
        <span class="status-pill text-xs font-semibold badge-accent mb-3 inline-block">
          Simple Onboarding
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold text-[#111318] tracking-tight font-['Space_Grotesk'] mt-2">
          Seamless from Orientation to Graduation
        </h2>
        <p class="body-text text-sm sm:text-base text-[#5B5F6B] mt-3">
          Designed with zero friction for new students and complete governance for college administrators.
        </p>
      </div>

      <!-- 4 Step Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

        <!-- Step 1 -->
        <div class="p-6 rounded-[12px] bg-[#FAFAFB] border border-[#E5E7EB] scroll-reveal delay-100 flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-[8px] bg-[var(--accent-primary)] text-white flex items-center justify-center font-bold text-sm font-['Space_Grotesk'] mb-4 shadow-sm">
              01
            </div>
            <h3 class="text-base font-bold text-[#111318] font-['Space_Grotesk'] mb-2">
              Sign Up or Sign In
            </h3>
            <p class="text-xs text-[#5B5F6B] leading-relaxed">
              Register as a student with your verified Roll Number and department, or sign in using your administrative credentials.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-[#E5E7EB] text-[11px] font-semibold text-[var(--accent-primary)]">
            Instant Enrollment →
          </div>
        </div>

        <!-- Step 2 -->
        <div class="p-6 rounded-[12px] bg-[#FAFAFB] border border-[#E5E7EB] scroll-reveal delay-200 flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-[8px] bg-[#111318] text-white flex items-center justify-center font-bold text-sm font-['Space_Grotesk'] mb-4 shadow-sm">
              02
            </div>
            <h3 class="text-base font-bold text-[#111318] font-['Space_Grotesk'] mb-2">
              Access 360° Portal
            </h3>
            <p class="text-xs text-[#5B5F6B] leading-relaxed">
              Explore your live dashboard with today's timetable, current attendance percentages, issued books, and urgent announcements.
            </p>
          </div>
