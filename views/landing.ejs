<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CampusPulse - The Modern College Management Platform</title>

  <!-- Anti-Flash Instant Theme Detection -->
  <script>
    (function() {
      try {
        const theme = localStorage.getItem('campuspulse-theme') || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Google Fonts: Space Grotesk (Headings/Stats) + Inter (Body/UI) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  <!-- Tailwind CSS via CDNJS (allowed by CSP) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[var(--bg-primary)] text-[var(--text-primary)] antialiased selection:bg-[var(--accent-primary)] selection:text-white transition-colors duration-200">

  <!-- =========================================================================
       1. Top Sticky Navigation Bar
       ========================================================================= -->
  <header class="sticky top-0 z-50 bg-[var(--bg-surface)]/95 backdrop-blur-md border-b border-[var(--border-subtle)] transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-9 h-9 rounded-lg bg-[var(--accent-primary)] text-white flex items-center justify-center text-lg shadow-sm group-hover:scale-105 transition-transform">
          <i class="fa-solid fa-graduation-cap"></i>
        </div>
        <div>
          <span class="font-bold text-lg tracking-tight text-[var(--text-primary)] block leading-none font-['Space_Grotesk']">
            CAMPUS<span class="text-[var(--accent-primary)]">PULSE</span>
          </span>
          <span class="text-[10px] uppercase tracking-wider text-[var(--text-muted)] font-medium block mt-1">
            Higher Education SaaS
          </span>
        </div>
      </a>

      <!-- Desktop Anchor Navigation Links -->
      <nav class="landing-nav-desktop text-xs font-semibold text-[var(--text-secondary)]">
        <a href="#modules" class="hover:text-[var(--accent-primary)] transition-colors">Academic Modules</a>
        <a href="#how-it-works" class="hover:text-[var(--accent-primary)] transition-colors">How It Works</a>
        <a href="#security" class="hover:text-[var(--accent-primary)] transition-colors">Security & Multi-Tenancy</a>
      </nav>

      <!-- Action Buttons & Theme Selector -->
      <div class="landing-actions-desktop">
        <%- include('partials/theme-toggle') %>
        <a 
          href="/login" 
          class="btn-secondary py-2 px-3.5 text-xs font-semibold rounded-lg"
        >
          Sign In
        </a>
        <a 
          href="/signup" 
          class="btn-primary py-2 px-4 text-xs font-semibold rounded-lg flex items-center gap-1.5"
        >
          <span>Create Institution</span>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="landing-mobile-toggle">
        <%- include('partials/theme-toggle') %>
        <button 
          id="landing-mobile-menu-btn" 
          type="button" 
          aria-label="Toggle Navigation Menu"
          class="p-2 rounded-lg border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-hover)]"
        >
          <i class="fa-solid fa-bars text-base"></i>
        </button>
      </div>

    </div>

    <!-- Mobile Navigation Dropdown -->
    <div id="landing-mobile-menu" class="hidden md:hidden border-b border-[var(--border-subtle)] bg-[var(--bg-surface)] px-6 py-4 space-y-3">
      <a href="#modules" class="block text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--accent-primary)]">Academic Modules</a>
      <a href="#how-it-works" class="block text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--accent-primary)]">How It Works</a>
      <a href="#security" class="block text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--accent-primary)]">Security</a>
      <div class="pt-3 border-t border-[var(--border-subtle)] flex flex-col gap-2">
        <a href="/login" class="btn-secondary py-2 text-center text-xs font-semibold">Sign In</a>
        <a href="/signup" class="btn-primary py-2 text-center text-xs font-semibold">Create Institution</a>
      </div>
    </div>
  </header>

  <!-- =========================================================================
       2. Hero Section
       ========================================================================= -->
  <section class="relative overflow-hidden pt-12 pb-16 lg:pt-16 lg:pb-24 border-b border-[var(--border-subtle)] bg-gradient-to-b from-[var(--bg-surface)] to-[var(--bg-primary)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="landing-hero-grid">
        
        <!-- Left: Hero Headline & CTAs (7 cols) -->
        <div class="lg:col-span-7 space-y-5">
          
          <!-- Identity Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800 text-[var(--accent-primary)] text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-[var(--accent-primary)] animate-pulse"></span>
            <span>CampusPulse • Self-Service Multi-Tenant Higher Education SaaS</span>
          </div>

          <!-- Main Bold Headline -->
          <h1 class="text-3xl sm:text-4xl lg:text-[46px] font-bold text-[var(--text-primary)] leading-[1.18] tracking-tight font-['Space_Grotesk']">
            Modern Campus Operations,<br/>
            <span class="text-[var(--accent-primary)]">Simplified.</span>
          </h1>

          <!-- Supporting Paragraph -->
          <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed max-w-2xl font-normal">
            Manage academic operations, attendance, results, library, assignments, fees, announcements and institutional workflows from one secure platform.
          </p>

          <!-- Dual Call to Action Buttons -->
          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <a 
              href="/signup" 
              class="btn-primary py-3 px-6 text-sm font-semibold rounded-lg flex items-center justify-center gap-2 shadow-sm"
            >
              <span>Create Your Institution</span>
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>

            <a 
              href="/signup?tab=student" 
              class="btn-secondary py-3 px-6 text-sm font-semibold rounded-lg flex items-center justify-center gap-2"
            >
              <i class="fa-solid fa-user-graduate text-xs text-[var(--accent-primary)]"></i>
              <span>Join as Student</span>
            </a>
          </div>

          <!-- Trust Indicators -->
          <div class="pt-5 border-t border-[var(--border-subtle)] grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs text-[var(--text-secondary)]">
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-circle-check text-green-500 text-xs shrink-0"></i>
              <span class="font-medium text-[var(--text-primary)]">15-Min Session Check-In</span>
            </div>
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-circle-check text-green-500 text-xs shrink-0"></i>
              <span class="font-medium text-[var(--text-primary)]">Two-Tier Governance</span>
            </div>
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-circle-check text-green-500 text-xs shrink-0"></i>
              <span class="font-medium text-[var(--text-primary)]">Automated Audit Trail</span>
            </div>
          </div>

        </div>

        <!-- Right: Interactive Live Platform Preview Panel (5 cols) -->
        <div class="lg:col-span-5">
          <div class="card p-5 sm:p-6 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] shadow-md">
            
            <!-- Preview Banner Header -->
            <div class="flex items-center justify-between pb-3.5 mb-4 border-b border-[var(--border-subtle)]">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-green-500 animate-pulse"></span>
                <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-primary)]">
                  Live Platform Preview
                </span>
              </div>
              <span class="status-pill text-[10px] py-0.5 px-2 font-bold badge-accent">
                Active Session
              </span>
            </div>

            <!-- Mini Preview Cards Grid -->
            <div class="space-y-3">
              
              <!-- 1. Real-Time Attendance Highlight -->
              <div class="p-3.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-primary)] flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-lg bg-green-50 dark:bg-green-950/40 text-green-600 dark:text-green-400 flex items-center justify-center text-sm font-bold shrink-0">
                    <i class="fa-solid fa-clipboard-user"></i>
                  </div>
                  <div>
                    <p class="text-xs font-bold text-[var(--text-primary)] leading-tight">Lecture Attendance</p>
                    <p class="text-[11px] text-[var(--text-secondary)] mt-0.5">Session Code: <span class="font-mono font-bold text-[var(--accent-primary)]">#CS842</span></p>
                  </div>
                </div>
                <div class="text-right">
                  <span class="text-lg font-bold text-green-600 dark:text-green-400">87.4%</span>
                  <span class="block text-[9px] uppercase font-bold text-[var(--text-muted)]">Verified</span>
                </div>
              </div>

              <!-- 2. Academic Performance Metric -->
              <div class="p-3.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] shadow-xs">
                <div class="flex items-center justify-between mb-1.5">
                  <div class="flex items-center gap-2">
                    <div class="w-6 h-6 rounded-md bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xs">
                      <i class="fa-solid fa-chart-simple"></i>
                    </div>
                    <span class="text-xs font-bold text-[var(--text-primary)]">Academic CGPA & Scores</span>
                  </div>
                  <span class="status-pill text-[10px] py-0.5 px-2 font-bold badge-success">3.82 CGPA</span>
                </div>
                <div class="space-y-1 pt-1">
                  <div class="flex items-center justify-between text-[11px]">
                    <span class="text-[var(--text-secondary)]">Data Structures (CS-301)</span>
                    <span class="font-bold text-[var(--text-primary)]">92 / 100</span>
                  </div>
                  <div class="w-full bg-[var(--border-subtle)] h-1.5 rounded-full overflow-hidden">
                    <div class="bg-[var(--accent-primary)] h-1.5 rounded-full" style="width: 92%"></div>
                  </div>
                </div>
              </div>

              <!-- 3. Library & Circulation Highlight -->
              <div class="p-3 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-primary)] flex items-center justify-between text-xs">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-md bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 flex items-center justify-center text-sm">
                    <i class="fa-solid fa-book-bookmark"></i>
                  </div>
                  <div>
                    <p class="font-bold text-[var(--text-primary)] text-xs">Algorithms (CLRS)</p>
                    <p class="text-[10px] text-[var(--text-secondary)]">Due: In 48 hours</p>
                  </div>
                </div>
                <span class="status-pill text-[10px] py-0.5 px-2 font-bold badge-warning">Borrowed</span>
              </div>

              <!-- 4. Next Assessment Banner -->
              <div class="p-2.5 rounded-md bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800 flex items-center justify-between text-xs">
                <div class="flex items-center gap-2">
                  <i class="fa-solid fa-stopwatch text-[var(--accent-primary)]"></i>
                  <span class="text-[var(--accent-primary)] font-semibold text-[11px]">Next Quiz: Operating Systems</span>
                </div>
                <span class="text-[10px] font-bold text-[var(--accent-primary)]">Tomorrow 10:00 AM</span>
              </div>

            </div>

            <!-- Footer Badge -->
            <div class="mt-4 pt-3.5 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11px] text-[var(--text-muted)]">
              <span class="flex items-center gap-1.5">
                <i class="fa-solid fa-shield-halved text-green-500"></i>
                <span>Protected with RLS Isolation</span>
              </span>
              <a href="/login" class="font-semibold text-[var(--accent-primary)] hover:underline flex items-center gap-1">
                <span>Try Demo</span>
                <i class="fa-solid fa-chevron-right text-[9px]"></i>
              </a>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- =========================================================================
       3. Academic Modules Section (10 Modules in Responsive Grid)
       ========================================================================= -->
  <section id="modules" class="py-16 lg:py-24 bg-[var(--bg-surface)] border-b border-[var(--border-subtle)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="status-pill text-xs font-semibold badge-accent mb-2.5 inline-block">
          Autonomous Higher-Education Modules
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[var(--text-primary)] tracking-tight font-['Space_Grotesk']">
          Engineered for Every Dimension of Campus Life
        </h2>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] mt-2.5">
          Ten integrated operational modules built to eliminate paperwork, automate records, and give students, faculty, and administration unified institutional oversight.
        </p>
      </div>

      <!-- Feature Cards Grid (10 Modules) -->
      <div class="landing-modules-grid">

        <!-- 1: Attendance -->
        <div class="card p-6 flex flex-col justify-between hover:border-[var(--accent-primary)] transition-all">
          <div>
            <div class="w-10 h-10 rounded-lg bg-green-50 dark:bg-green-950/40 text-green-600 dark:text-green-400 flex items-center justify-center text-lg mb-4">
              <i class="fa-solid fa-qrcode"></i>
            </div>
            <h3 class="text-base font-bold text-[var(--text-primary)] font-['Space_Grotesk'] mb-1.5">
              Attendance & PIN Check-In
            </h3>
            <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
              Faculty launch time-bounded 15-minute PIN sessions from the lecture podium. Students verify in real time with single-attempt anti-proxy safeguards.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs text-[var(--text-muted)]">
            <span class="font-medium text-[var(--text-primary)]">Anti-Proxy Verification</span>
            <i class="fa-solid fa-arrow-right text-[10px] text-[var(--accent-primary)]"></i>
          </div>
        </div>

        <!-- 2: Academic Results & CGPA -->
        <div class="card p-6 flex flex-col justify-between hover:border-[var(--accent-primary)] transition-all">
          <div>
            <div class="w-10 h-10 rounded-lg bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-lg mb-4">
              <i class="fa-solid fa-chart-column"></i>
            </div>
            <h3 class="text-base font-bold text-[var(--text-primary)] font-['Space_Grotesk'] mb-1.5">
              Academic Results & CGPA
            </h3>
            <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
              Automated SGPA/CGPA grade calculation, semester grade sheets, mark uploads, and instant digital transcript verification across all 8 semesters.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs text-[var(--text-muted)]">
            <span class="font-medium text-[var(--text-primary)]">Automated Calculation</span>
            <i class="fa-solid fa-arrow-right text-[10px] text-[var(--accent-primary)]"></i>
          </div>
        </div>

        <!-- 3: Library Catalog & Circulation -->
        <div class="card p-6 flex flex-col justify-between hover:border-[var(--accent-primary)] transition-all">
          <div>
            <div class="w-10 h-10 rounded-lg bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 flex items-center justify-center text-lg mb-4">
              <i class="fa-solid fa-book-open-reader"></i>
            </div>
            <h3 class="text-base font-bold text-[var(--text-primary)] font-['Space_Grotesk'] mb-1.5">
              Library Catalog & Loans
            </h3>
            <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
              Complete institutional book repository, live available copy counts, issue/return circulation logs, and automatic return date alerts.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs text-[var(--text-muted)]">
            <span class="font-medium text-[var(--text-primary)]">Live Inventory Tracking</span>
            <i class="fa-solid fa-arrow-right text-[10px] text-[var(--accent-primary)]"></i>
          </div>
        </div>

        <!-- 4: Assignments & Submissions -->
        <div class="card p-6 flex flex-col justify-between hover:border-[var(--accent-primary)] transition-all">
          <div>
            <div class="w-10 h-10 rounded-lg bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center text-lg mb-4">
              <i class="fa-solid fa-file-arrow-up"></i>
            </div>
            <h3 class="text-base font-bold text-[var(--text-primary)] font-['Space_Grotesk'] mb-1.5">
              Coursework & Assignments
            </h3>
            <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
              Faculty assign coursework with attachment support and deadlines. Students upload solutions securely with automated status and grading notifications.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs text-[var(--text-muted)]">
            <span class="font-medium text-[var(--text-primary)]">Digital Submissions</span>
            <i class="fa-solid fa-arrow-right text-[10px] text-[var(--accent-primary)]"></i>
          </div>
        </div>

        <!-- 5: Fee Status & Receipts -->
        <div class="card p-6 flex flex-col justify-between hover:border-[var(--accent-primary)] transition-all">
          <div>
            <div class="w-10 h-10 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-lg mb-4">
              <i class="fa-solid fa-receipt"></i>
            </div>
            <h3 class="text-base font-bold text-[var(--text-primary)] font-['Space_Grotesk'] mb-1.5">
              Fee Status & Invoices
            </h3>
            <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
              Semester tuition schedules, clearance tracking, dues balance breakdown, and downloadable digital fee receipts for students and accounts teams.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs text-[var(--text-muted)]">
            <span class="font-medium text-[var(--text-primary)]">Clearance Tracking</span>
            <i class="fa-solid fa-arrow-right text-[10px] text-[var(--accent-primary)]"></i>
          </div>
        </div>

        <!-- 6: Announcements & Notice Board -->
        <div class="card p-6 flex flex-col justify-between hover:border-[var(--accent-primary)] transition-all">
          <div>
            <div class="w-10 h-10 rounded-lg bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 flex items-center justify-center text-lg mb-4">
              <i class="fa-solid fa-bullhorn"></i>
            </div>
            <h3 class="text-base font-bold text-[var(--text-primary)] font-['Space_Grotesk'] mb-1.5">
              Announcements & Notices
            </h3>
            <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
              Institutional broadcasts categorized by severity (Urgent, Important, General) with department-targeted delivery and banner alerts.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs text-[var(--text-muted)]">
            <span class="font-medium text-[var(--text-primary)]">Targeted Broadcasts</span>
            <i class="fa-solid fa-arrow-right text-[10px] text-[var(--accent-primary)]"></i>
          </div>
        </div>

        <!-- 7: Online Quizzes & Tests -->
        <div class="card p-6 flex flex-col justify-between hover:border-[var(--accent-primary)] transition-all">
          <div>
            <div class="w-10 h-10 rounded-lg bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center text-lg mb-4">
              <i class="fa-solid fa-pen-to-square"></i>
            </div>
            <h3 class="text-base font-bold text-[var(--text-primary)] font-['Space_Grotesk'] mb-1.5">
              Quizzes & Timed Tests
            </h3>
            <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
              Online multiple choice evaluations with automated countdown timers, randomized answer orders, and instant scoring upon submission.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs text-[var(--text-muted)]">
            <span class="font-medium text-[var(--text-primary)]">Instant Evaluation</span>
            <i class="fa-solid fa-arrow-right text-[10px] text-[var(--accent-primary)]"></i>
          </div>
        </div>

        <!-- 8: Timetable & Schedule -->
        <div class="card p-6 flex flex-col justify-between hover:border-[var(--accent-primary)] transition-all">
          <div>
            <div class="w-10 h-10 rounded-lg bg-teal-50 dark:bg-teal-950/40 text-teal-600 dark:text-teal-400 flex items-center justify-center text-lg mb-4">
              <i class="fa-solid fa-calendar-days"></i>
            </div>
            <h3 class="text-base font-bold text-[var(--text-primary)] font-['Space_Grotesk'] mb-1.5">
              Timetable & Lecture Halls
            </h3>
            <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
              Day-by-day classroom routing, period schedules, room numbers, and faculty assignments mapped to ensure zero scheduling conflicts.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs text-[var(--text-muted)]">
            <span class="font-medium text-[var(--text-primary)]">Weekly Grid Layout</span>
            <i class="fa-solid fa-arrow-right text-[10px] text-[var(--accent-primary)]"></i>
          </div>
        </div>

        <!-- 9: Multi-Tenant Security & Isolation -->
        <div class="card p-6 flex flex-col justify-between hover:border-[var(--accent-primary)] transition-all">
          <div>
            <div class="w-10 h-10 rounded-lg bg-sky-50 dark:bg-sky-950/40 text-sky-600 dark:text-sky-400 flex items-center justify-center text-lg mb-4">
              <i class="fa-solid fa-shield-halved"></i>
            </div>
            <h3 class="text-base font-bold text-[var(--text-primary)] font-['Space_Grotesk'] mb-1.5">
              Multi-Tenant Security
            </h3>
            <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
