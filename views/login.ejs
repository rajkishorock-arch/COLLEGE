<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In - CampusPulse Enterprise SaaS</title>
  
  <!-- Anti-Flash Instant Theme Detection -->
  <script>
    (function() {
      try {
        const theme = localStorage.getItem('campuspulse-theme') || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Google Fonts: Google Sans Flex + Google Sans Code + Google Symbols + Inter (Same as antigravity.google) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,slnt,wdth,wght,ROND@8..144,-10..0,25..150,400..700,0..100&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans+Code:ital,wght@0,400..700;1,400..700&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Symbols:opsz,wght,FILL,GRAD,ROND@20..48,100..700,0..1,-50..200,0..100&display=block">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[var(--bg-primary)] text-[var(--text-primary)] min-h-screen flex flex-col justify-between transition-colors duration-200 antialiased relative overflow-x-hidden">

  <!-- ========================================================================= -->
  <!-- Ambient Antigravity Aurora Mesh & Glowing Blur Orbs                       -->
  <!-- ========================================================================= -->
  <div class="agy-ambient-canvas" aria-hidden="true">
    <div class="agy-orb agy-orb-1"></div>
    <div class="agy-orb agy-orb-2"></div>
    <div class="agy-orb agy-orb-3"></div>
  </div>

  <!-- ========================================================================= -->
  <!-- 1. Sleek Navigation Header                                                -->
  <!-- ========================================================================= -->
  <header class="relative z-20 w-full border-b border-[var(--border-subtle)] bg-[var(--bg-surface)]/80 backdrop-blur-md transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-[var(--accent-primary)] to-[var(--accent-neon)] text-white flex items-center justify-center text-lg shadow-sm group-hover:scale-105 transition-transform duration-200">
          <i class="fa-solid fa-graduation-cap"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-bold text-base tracking-tight text-[var(--text-primary)] block leading-none font-['Google_Sans_Flex']">
              CAMPUS<span class="text-[var(--accent-primary)]">PULSE</span>
            </span>
            <span class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded font-mono font-bold bg-[rgba(26,115,232,0.1)] text-[var(--accent-primary)] border border-[rgba(26,115,232,0.2)]">
              ENTERPRISE
            </span>
          </div>
          <span class="text-[10px] text-[var(--text-muted)] font-medium block mt-0.5">
            Higher Education Platform
          </span>
        </div>
      </a>

      <!-- Right Header Actions -->
      <div class="flex items-center gap-3">
        <%- include('partials/theme-toggle') %>
        <div class="hidden sm:block w-px h-5 bg-[var(--border-subtle)]"></div>
        <a 
          href="/" 
          class="btn-agy-secondary !py-2 !px-3.5 !text-xs font-semibold"
        >
          <i class="fa-solid fa-arrow-left text-[10px]"></i>
          <span class="hidden sm:inline">Back to Home</span>
        </a>
      </div>

    </div>
  </header>

  <!-- ========================================================================= -->
  <!-- 2. Main Login Form & Antigravity Glass Container                         -->
  <!-- ========================================================================= -->
  <main class="relative z-10 flex-1 flex items-center justify-center p-4 sm:p-6 py-12">
    <div class="w-full max-w-[460px] agy-reveal">
      
      <!-- Antigravity Frosted Glass Card -->
      <div class="agy-glass-card p-6 sm:p-9 relative overflow-hidden">
        
        <!-- Header Eyebrow & Titles -->
        <div class="mb-7 text-center sm:text-left">
          <div class="agy-pill mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-primary)] animate-pulse"></span>
            <span>SECURE GATEWAY</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-bold text-[var(--text-primary)] tracking-tight font-['Google_Sans_Flex']">
            Sign in to CampusPulse
          </h1>
          <p class="text-xs sm:text-sm text-[var(--text-secondary)] mt-1.5 leading-relaxed font-['Google_Sans_Flex']">
            Enter your credentials to access your verified institution workspace.
          </p>
        </div>

        <!-- Flash Alerts -->
        <% if (error) { %>
          <div class="w-full p-3.5 mb-5 rounded-xl text-xs sm:text-sm flex items-start gap-2.5 bg-red-500/10 border border-red-500/25 text-red-600 dark:text-red-400">
            <i class="fa-solid fa-circle-exclamation text-base shrink-0 mt-0.5"></i>
            <span class="font-medium"><%= error %></span>
          </div>
        <% } %>

        <% if (success) { %>
          <div class="w-full p-3.5 mb-5 rounded-xl text-xs sm:text-sm flex items-start gap-2.5 bg-emerald-500/10 border border-emerald-500/25 text-emerald-600 dark:text-emerald-400">
            <i class="fa-solid fa-circle-check text-base shrink-0 mt-0.5"></i>
            <span class="font-medium"><%= success %></span>
          </div>
        <% } %>

        <!-- Login Form -->
        <form action="/login" method="POST" class="space-y-4" id="login-form">
          
          <!-- Email Input -->
          <div>
            <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5 font-['Google_Sans_Flex']">
              Email Address <span class="text-red-500">*</span>
            </label>
            <div class="agy-input-group">
              <i class="fa-regular fa-envelope agy-input-icon"></i>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                autocomplete="email"
                placeholder="admin@college.edu or student@college.edu"
                class="agy-input font-['Google_Sans_Flex']"
              />
            </div>
          </div>

          <!-- Password Input with Show/Hide Eye Toggle -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] font-['Google_Sans_Flex']">
                Password <span class="text-red-500">*</span>
              </label>
              <a href="/forgot-password" class="text-xs font-semibold text-[var(--accent-primary)] hover:underline font-['Google_Sans_Flex']">
                Forgot password?
              </a>
            </div>
            <div class="agy-input-group relative">
              <i class="fa-solid fa-lock agy-input-icon"></i>
              <input 
                type="password" 
                id="password" 
                name="password" 
                required 
                autocomplete="current-password"
                placeholder="••••••••••••"
                class="agy-input font-['Google_Sans_Flex'] !pr-11"
              />
              <button 
                type="button" 
                onclick="togglePasswordVisibility('password', this)"
                aria-label="Toggle password visibility"
                class="absolute right-3.5 top-1/2 -translate-y-1/2 text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors p-1"
                style="background: transparent; border: none; cursor: pointer;"
              >
                <i class="fa-regular fa-eye text-sm" id="eye-icon"></i>
              </button>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button 
              type="submit" 
              class="btn-agy-primary w-full py-3.5 text-sm font-bold flex items-center justify-center gap-2 shadow-lg"
            >
              <span>Sign In to Platform</span>
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </button>
          </div>
        </form>

        <% if (typeof showDemoCredentials !== 'undefined' && showDemoCredentials) { %>
        <!-- 1-Click Multi-Tenant Demo Credentials -->
        <div class="mt-8 pt-6 border-t border-[var(--border-subtle)]">
          <div class="flex items-center justify-between gap-1.5 mb-3.5">
            <div class="flex items-center gap-1.5">
              <i class="fa-solid fa-bolt text-amber-500 text-xs"></i>
              <span class="text-[11px] font-bold tracking-wider text-[var(--text-secondary)] uppercase font-['Google_Sans_Flex']">
                1-Click Demo Credentials
              </span>
            </div>
            <span class="text-[10px] text-[var(--text-muted)] font-mono">Auto-fills form</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-['Google_Sans_Flex']">
            <!-- Super Admin -->
            <button 
              type="button" 
              onclick="fillCredentials('admin@college.edu', 'admin123', this)"
              class="demo-pill group"
            >
              <div class="flex items-center gap-2.5 truncate">
                <div class="w-6 h-6 rounded-lg bg-indigo-500/10 text-[var(--accent-primary)] flex items-center justify-center text-xs shrink-0">
                  <i class="fa-solid fa-crown text-[10px]"></i>
                </div>
                <div class="truncate">
                  <div class="font-bold text-[var(--text-primary)] truncate">Super Admin</div>
                  <div class="text-[10px] text-[var(--text-muted)] font-mono">admin@college.edu</div>
                </div>
              </div>
              <i class="fa-solid fa-arrow-turn-down text-[10px] text-[var(--text-muted)] group-hover:text-[var(--accent-primary)] transition-colors ml-1"></i>
            </button>

            <!-- Student CPIT -->
            <button 
              type="button" 
              onclick="fillCredentials('alex@college.edu', 'student123', this)"
              class="demo-pill group"
            >
              <div class="flex items-center gap-2.5 truncate">
                <div class="w-6 h-6 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-xs shrink-0">
                  <i class="fa-solid fa-user-graduate text-[10px]"></i>
                </div>
                <div class="truncate">
                  <div class="font-bold text-[var(--text-primary)] truncate">Student (CPIT)</div>
                  <div class="text-[10px] text-[var(--text-muted)] font-mono">alex@college.edu</div>
                </div>
              </div>
              <i class="fa-solid fa-arrow-turn-down text-[10px] text-[var(--text-muted)] group-hover:text-[var(--accent-primary)] transition-colors ml-1"></i>
            </button>
            
            <!-- Apex Admin -->
            <button 
              type="button" 
              onclick="fillCredentials('admin@apex.edu', 'admin123', this)"
              class="demo-pill group"
            >
              <div class="flex items-center gap-2.5 truncate">
                <div class="w-6 h-6 rounded-lg bg-blue-500/10 text-blue-500 flex items-center justify-center text-xs shrink-0">
                  <i class="fa-solid fa-building-columns text-[10px]"></i>
                </div>
                <div class="truncate">
                  <div class="font-bold text-[var(--text-primary)] truncate">Apex Admin</div>
                  <div class="text-[10px] text-[var(--text-muted)] font-mono">admin@apex.edu</div>
                </div>
              </div>
              <i class="fa-solid fa-arrow-turn-down text-[10px] text-[var(--text-muted)] group-hover:text-[var(--accent-primary)] transition-colors ml-1"></i>
            </button>

            <!-- Apex Student -->
            <button 
              type="button" 
              onclick="fillCredentials('student@apex.edu', 'student123', this)"
              class="demo-pill group"
            >
              <div class="flex items-center gap-2.5 truncate">
                <div class="w-6 h-6 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center text-xs shrink-0">
                  <i class="fa-solid fa-graduation-cap text-[10px]"></i>
                </div>
                <div class="truncate">
                  <div class="font-bold text-[var(--text-primary)] truncate">Apex Student</div>
                  <div class="text-[10px] text-[var(--text-muted)] font-mono">student@apex.edu</div>
                </div>
              </div>
              <i class="fa-solid fa-arrow-turn-down text-[10px] text-[var(--text-muted)] group-hover:text-[var(--accent-primary)] transition-colors ml-1"></i>
            </button>
          </div>
        </div>
        <% } %>

        <!-- Registration Onboarding Links -->
        <div class="mt-7 pt-5 border-t border-[var(--border-subtle)] text-center text-xs text-[var(--text-secondary)] space-y-2 font-['Google_Sans_Flex']">
          <div>
            Deploying a university or institution? 
            <a href="/register-institution" class="font-bold text-[var(--accent-primary)] hover:underline ml-1 inline-flex items-center gap-1">
              <span>Register Institution</span>
              <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </a>
          </div>
          <div class="text-[11px] text-[var(--text-muted)]">
            Enrolled student joining campus? 
            <a href="/signup?tab=student" class="font-medium text-[var(--text-secondary)] hover:text-[var(--accent-primary)] hover:underline ml-1">
              Student Sign Up
            </a>
          </div>
        </div>

      </div>

      <!-- Trust & Security Badge -->
      <div class="flex items-center justify-center gap-2 text-center text-[11px] text-[var(--text-muted)] mt-6 font-['Google_Sans_Flex']">
        <i class="fa-solid fa-shield-halved text-[var(--accent-primary)] text-xs"></i>
        <span>Multi-tenant row-level isolation & salted bcrypt authentication</span>
      </div>

    </div>
  </main>

  <!-- ========================================================================= -->
  <!-- 3. Minimal Compact Footer                                                 -->
  <!-- ========================================================================= -->
  <footer class="relative z-20 py-4 px-6 border-t border-[var(--border-subtle)] bg-[var(--bg-surface)]/80 backdrop-blur-md text-xs text-[var(--text-muted)] font-['Google_Sans_Flex']">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
      <div class="flex items-center gap-2">
        <span class="font-bold text-[var(--text-primary)]">CampusPulse Enterprise</span>
        <span>•</span>
        <span>Higher Education Platform</span>
      </div>
      <div class="flex items-center gap-5">
        <a href="/signup?tab=institution" class="hover:text-[var(--accent-primary)] transition-colors">Register Institution</a>
        <a href="/signup?tab=student" class="hover:text-[var(--accent-primary)] transition-colors">Student Sign Up</a>
        <a href="mailto:support@college.edu" class="hover:text-[var(--accent-primary)] transition-colors">Support</a>
      </div>
    </div>
  </footer>

  <script src="/js/main.js"></script>
  <script>
    // 1-Click Credentials Auto-fill with Visual Feedback
    function fillCredentials(email, password, btnElement) {
      const emailInput = document.getElementById('email');
      const passwordInput = document.getElementById('password');

      emailInput.value = email;
      passwordInput.value = password;

      // Add tactile flash animation
      if (btnElement) {
        btnElement.classList.add('flash-filled');
        setTimeout(() => btnElement.classList.remove('flash-filled'), 600);
      }

      // Briefly highlight inputs
      emailInput.classList.add('ring-2', 'ring-indigo-500');
      passwordInput.classList.add('ring-2', 'ring-indigo-500');
      setTimeout(() => {
        emailInput.classList.remove('ring-2', 'ring-indigo-500');
        passwordInput.classList.remove('ring-2', 'ring-indigo-500');
      }, 500);
    }

    // Toggle Password Visibility
    function togglePasswordVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      const icon = btn.querySelector('i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      }
    }
  </script>
</body>
</html>
