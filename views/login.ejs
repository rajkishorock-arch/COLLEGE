<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In - College Management Platform</title>
  
  <!-- Anti-Flash Instant Theme Detection -->
  <script>
    (function() {
      try {
        const theme = localStorage.getItem('campuspulse-theme') || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Exact Google Fonts Pairing: Space Grotesk + Inter ONLY -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[var(--bg-primary)] text-[var(--text-primary)] min-h-screen flex flex-col justify-between p-4 py-8 transition-colors duration-200">

  <!-- Top Bar with Theme Toggle -->
  <div class="max-w-md w-full mx-auto flex items-center justify-between mb-4 fade-slide-up">
    <a href="/" class="text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] flex items-center gap-1.5 transition-colors">
      <i class="fa-solid fa-arrow-left text-xs"></i>
      <span>Back to Home</span>
    </a>
    <%- include('partials/theme-toggle') %>
  </div>

  <div class="w-full max-w-md mx-auto">
    <!-- Header Brand -->
    <div class="text-center mb-6 fade-slide-up">
      <div class="w-14 h-14 rounded-[12px] bg-[var(--accent-primary)] text-white flex items-center justify-center text-2xl mx-auto shadow-lg shadow-[var(--accent-glow)] mb-3">
        <i class="fa-solid fa-graduation-cap"></i>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-[var(--text-primary)] tracking-tight font-['Space_Grotesk']">CAMPUS<span class="text-[var(--accent-primary)]">PULSE</span></h1>
      <p class="text-[var(--text-secondary)] text-sm mt-1">Autonomous Multi-Tenant Operating Platform</p>
    </div>

    <!-- Login Card: 12px radius, 28px padding, --bg-surface, --border-subtle -->
    <div class="card fade-slide-up stagger-1">
      
      <div class="mb-7">
        <h2 class="text-2xl font-bold text-[#111318] tracking-tight font-['Space_Grotesk']">Institutional Sign In</h2>
        <p class="text-sm text-[#5B5F6B] mt-1.5 leading-relaxed">Access your verified student dashboard or administrator controls</p>
      </div>

      <!-- Alerts -->
      <% if (error) { %>
        <div class="flash-alert flash-alert-error mb-6 p-4 rounded-[8px] bg-[#FEECEE] border border-[var(--danger)] text-[#E5384B] text-xs sm:text-sm font-medium flex items-center gap-3">
          <i class="fa-solid fa-circle-exclamation text-base shrink-0"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <% if (success) { %>
        <div class="flash-alert flash-alert-success mb-6 p-4 rounded-[8px] bg-[#E8F8EE] border border-[var(--success)] text-[#1E9E57] text-xs sm:text-sm font-medium flex items-center gap-3">
          <i class="fa-solid fa-circle-check text-base shrink-0"></i>
          <span><%= success %></span>
        </div>
      <% } %>

      <form action="/login" method="POST" class="space-y-5">
        <div>
          <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-2">
            Email Address
          </label>
          <div class="input-icon-wrapper">
            <div class="input-icon">
              <i class="fa-solid fa-envelope"></i>
            </div>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              placeholder="e.g. admin@college.edu or student@college.edu"
              class="w-full pr-4 py-3 bg-[var(--bg-primary)] border border-[var(--border-subtle)] rounded-[8px] text-sm text-[#111318] placeholder-[var(--text-muted)] focus:border-[var(--accent-primary)] focus:outline-none transition-all"
            />
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
              Password
            </label>
            <a href="/forgot-password" class="text-xs font-semibold text-[var(--accent-primary)] hover:underline">
              Forgot Password?
            </a>
          </div>
          <div class="input-icon-wrapper">
            <div class="input-icon">
              <i class="fa-solid fa-lock"></i>
            </div>
            <input 
              type="password" 
              id="password" 
              name="password" 
              required 
              placeholder="••••••••"
              class="w-full pr-4 py-3 bg-[var(--bg-primary)] border border-[var(--border-subtle)] rounded-[8px] text-sm text-[#111318] placeholder-[var(--text-muted)] focus:border-[var(--accent-primary)] focus:outline-none transition-all"
            />
          </div>
        </div>

        <button 
          type="submit" 
          class="btn-primary w-full py-3.5 text-sm font-semibold rounded-[8px] flex items-center justify-center gap-2.5 mt-2"
        >
          <span class="btn-text">Sign In to Platform</span>
          <i class="fa-solid fa-arrow-right text-xs btn-text"></i>
        </button>
      </form>

      <% if (typeof showDemoCredentials !== 'undefined' && showDemoCredentials) { %>
      <!-- Quick Demo Access Section -->
      <div class="mt-8 pt-6 border-t border-[#E5E7EB]">
        <div class="flex items-center justify-center gap-2 mb-3">
          <i class="fa-solid fa-bolt text-[var(--warning)] text-xs"></i>
          <p class="text-[11px] font-semibold tracking-wider text-[#8B8F99] uppercase">
            1-Click Multi-Tenant Demo Credentials
          </p>
        </div>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <!-- Tenant 1: Default -->
          <button 
            type="button" 
            onclick="fillCredentials('admin@college.edu', 'admin123')"
            class="py-2 px-2.5 rounded-[8px] border border-[#DDD6FE] bg-[#EDE9FE]/50 hover:bg-[#EDE9FE] text-[#6C5CE7] transition-all text-left flex items-center gap-2"
          >
            <i class="fa-solid fa-crown text-[10px]"></i>
            <span class="truncate">Super Admin (CPIT)</span>
          </button>
          <button 
            type="button" 
            onclick="fillCredentials('alex@college.edu', 'student123')"
            class="py-2 px-2.5 rounded-[8px] border border-[#E5E7EB] bg-[#F7F7F9] hover:bg-[#E5E7EB] text-[#111318] transition-all text-left flex items-center gap-2"
          >
            <i class="fa-solid fa-user-graduate text-[10px] text-[var(--accent-primary)]"></i>
            <span class="truncate">Alex (CPIT Student)</span>
          </button>
          
          <!-- Tenant 2: Apex Institute -->
          <button 
            type="button" 
            onclick="fillCredentials('admin@apex.edu', 'admin123')"
            class="py-2 px-2.5 rounded-[8px] border border-emerald-200 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 transition-all text-left flex items-center gap-2"
          >
            <i class="fa-solid fa-building-columns text-[10px] text-emerald-600"></i>
            <span class="truncate">Apex College Admin</span>
          </button>
          <button 
            type="button" 
            onclick="fillCredentials('student@apex.edu', 'student123')"
            class="py-2 px-2.5 rounded-[8px] border border-emerald-200 bg-emerald-50/60 hover:bg-emerald-100 text-emerald-800 transition-all text-left flex items-center gap-2"
          >
            <i class="fa-solid fa-graduation-cap text-[10px] text-emerald-600"></i>
            <span class="truncate">Sarah (Apex Student)</span>
          </button>
        </div>
      </div>
      <% } %>

      <!-- Signup Redirects -->
      <div class="mt-7 pt-5 border-t border-[var(--border-subtle)] text-center text-xs text-[var(--text-secondary)] space-y-2">
        <div>
          Want to deploy your college or university? 
          <a href="/register-institution" class="font-bold text-[var(--accent-primary)] hover:underline ml-1">
            Register Institution
          </a>
        </div>
        <div class="text-[11px] text-[var(--text-muted)]">
          Enrolled student joining campus? 
          <a href="/signup?tab=student" class="font-medium text-[var(--text-secondary)] hover:underline ml-1">
            Student Sign Up
          </a>
        </div>
      </div>

    </div>

    <!-- Security Footer -->
    <p class="text-center text-xs text-[#8B8F99] mt-6 font-medium">
      Protected with bcrypt salted password hashing & session authentication
    </p>
  </div>

  <script src="/js/main.js"></script>
  <script>
    function fillCredentials(email, password) {
      document.getElementById('email').value = email;
      document.getElementById('password').value = password;
    }
  </script>
</body>
</html>
