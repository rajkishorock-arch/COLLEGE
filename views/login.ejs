<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In - CampusPulse Enterprise SaaS</title>
  
  <!-- Anti-Flash Instant Theme Detection -->
  <script>
    (function() {
      try {
        const theme = localStorage.getItem('campuspulse-theme') || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[var(--bg-primary)] text-[var(--text-primary)] min-h-screen flex flex-col justify-between transition-colors duration-200 antialiased">

  <!-- ========================================================================= -->
  <!-- 1. APPLICATION HEADER                                                     -->
  <!-- ========================================================================= -->
  <header class="app-header">
    <div class="app-header-inner">
      <a href="/" class="brand-link">
        <div class="brand-icon-box">
          <i class="fa-solid fa-graduation-cap"></i>
        </div>
        <div class="brand-text-col">
          <div class="flex items-center">
            <span class="brand-name">CAMPUS<span style="color: var(--accent-primary);">PULSE</span></span>
            <span class="brand-tag">ENTERPRISE</span>
          </div>
          <span class="brand-sub">Autonomous Higher Education SaaS</span>
        </div>
      </a>

      <div class="flex items-center gap-2">
        <%- include('partials/theme-toggle') %>
        <div class="header-sep"></div>
        <a 
          href="/" 
          class="btn-secondary !min-h-[36px] !py-1.5 !px-3 !text-xs font-semibold"
        >
          <i class="fa-solid fa-arrow-left text-[11px]"></i>
          <span class="hidden sm:inline">Back to Home</span>
        </a>
      </div>
    </div>
  </header>

  <!-- ========================================================================= -->
  <!-- 2. LOGIN FORM CONTAINER                                                   -->
  <!-- ========================================================================= -->
  <main class="flex-1 flex items-center justify-center p-4 py-10" style="min-height: calc(100vh - 140px);">
    <div class="w-full" style="max-width: 440px;">
      
      <!-- Login Card -->
      <div class="card card-static p-6 sm:p-8">
        
        <div class="mb-6">
          <div class="eyebrow-pill mb-2">
            <i class="fa-solid fa-shield-halved text-[10px]"></i>
            <span>SECURE AUTHENTICATION</span>
          </div>
          <h1 class="text-2xl font-bold text-primary tracking-tight">
            Institutional Sign In
          </h1>
          <p class="text-xs sm:text-sm text-secondary mt-1 leading-relaxed">
            Access your verified student dashboard or administrator controls.
          </p>
        </div>

        <!-- Flash Alerts -->
        <% if (error) { %>
          <div class="badge-danger w-full p-3.5 mb-5 rounded-xl text-xs sm:text-sm flex items-start gap-2.5" style="border-radius: 12px;">
            <i class="fa-solid fa-circle-exclamation text-base shrink-0 mt-0.5"></i>
            <span><%= error %></span>
          </div>
        <% } %>

        <% if (success) { %>
          <div class="badge-success w-full p-3.5 mb-5 rounded-xl text-xs sm:text-sm flex items-start gap-2.5" style="border-radius: 12px;">
            <i class="fa-solid fa-circle-check text-base shrink-0 mt-0.5"></i>
            <span><%= success %></span>
          </div>
        <% } %>

        <form action="/login" method="POST" class="space-y-4">
          <!-- Email Input -->
          <div>
            <label for="email" class="block text-xs font-bold uppercase tracking-wider text-secondary mb-1.5">
              Email Address *
            </label>
            <div class="input-with-icon">
              <i class="fa-regular fa-envelope input-icon-left"></i>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="admin@college.edu or student@college.edu"
              />
            </div>
          </div>

          <!-- Password Input -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="password" class="block text-xs font-bold uppercase tracking-wider text-secondary">
                Password *
              </label>
              <a href="/forgot-password" class="text-xs font-semibold text-accent hover:underline">
                Forgot Password?
              </a>
            </div>
            <div class="input-with-icon">
              <i class="fa-solid fa-lock input-icon-left"></i>
              <input 
                type="password" 
                id="password" 
                name="password" 
                required 
                placeholder="••••••••••••"
              />
            </div>
          </div>

          <button 
            type="submit" 
            class="btn-primary w-full py-3.5 text-sm font-bold flex items-center justify-center gap-2 rounded-xl shadow-md mt-2"
          >
            <span>Sign In to Platform</span>
            <i class="fa-solid fa-arrow-right text-xs"></i>
          </button>
        </form>

        <% if (typeof showDemoCredentials !== 'undefined' && showDemoCredentials) { %>
        <!-- Quick Demo Access Section -->
        <div class="mt-7 pt-5 border-t border-subtle">
          <div class="flex items-center justify-center gap-1.5 mb-3">
            <i class="fa-solid fa-bolt text-amber-500 text-xs"></i>
            <p class="text-[11px] font-bold tracking-wider text-secondary uppercase">
              1-Click Multi-Tenant Demo Credentials
            </p>
          </div>
          <div class="grid grid-cols-2 gap-2 text-xs">
            <!-- Super Admin -->
            <button 
              type="button" 
              onclick="fillCredentials('admin@college.edu', 'admin123')"
              class="badge-accent py-2.5 px-3 rounded-xl transition-all text-left flex items-center gap-2 font-medium"
              style="border-radius: 10px; cursor: pointer;"
            >
              <i class="fa-solid fa-crown text-[10px]"></i>
              <span class="truncate">Super Admin</span>
            </button>

            <!-- Student CPIT -->
            <button 
              type="button" 
              onclick="fillCredentials('alex@college.edu', 'student123')"
              class="btn-secondary py-2.5 px-3 rounded-xl transition-all text-left flex items-center gap-2 font-medium"
              style="border-radius: 10px; min-height: 38px;"
            >
              <i class="fa-solid fa-user-graduate text-[10px] text-accent"></i>
              <span class="truncate">Student (CPIT)</span>
            </button>
            
            <!-- Apex Admin -->
            <button 
              type="button" 
              onclick="fillCredentials('admin@apex.edu', 'admin123')"
              class="badge-success py-2.5 px-3 rounded-xl transition-all text-left flex items-center gap-2 font-medium"
              style="border-radius: 10px; cursor: pointer;"
            >
              <i class="fa-solid fa-building-columns text-[10px]"></i>
              <span class="truncate">Apex Admin</span>
            </button>

            <!-- Apex Student -->
            <button 
              type="button" 
              onclick="fillCredentials('student@apex.edu', 'student123')"
              class="badge-success py-2.5 px-3 rounded-xl transition-all text-left flex items-center gap-2 font-medium"
              style="border-radius: 10px; cursor: pointer;"
            >
              <i class="fa-solid fa-graduation-cap text-[10px]"></i>
              <span class="truncate">Apex Student</span>
            </button>
          </div>
        </div>
        <% } %>

        <!-- Registration Onboarding Links -->
        <div class="mt-7 pt-5 border-t border-subtle text-center text-xs text-secondary space-y-2">
          <div>
            Deploying a college or university? 
            <a href="/register-institution" class="font-bold text-accent hover:underline ml-1">
              Register Institution →
            </a>
          </div>
          <div class="text-[11px] text-muted">
            Enrolled student joining campus? 
            <a href="/signup?tab=student" class="font-medium text-secondary hover:underline ml-1">
              Student Sign Up
            </a>
          </div>
        </div>

      </div>

      <p class="text-center text-[11px] text-muted mt-6">
        Protected with multi-tenant row-level isolation & salted bcrypt authentication
      </p>

    </div>
  </main>

  <!-- ========================================================================= -->
  <!-- 3. COMPACT FOOTER                                                         -->
  <!-- ========================================================================= -->
  <footer class="app-footer">
    <div class="app-footer-inner">
      <div class="flex items-center gap-2">
        <span class="font-bold text-primary">CampusPulse</span>
        <span>•</span>
        <span>Autonomous Higher Education SaaS</span>
      </div>
      <div class="flex items-center gap-6">
        <a href="/signup?tab=institution" class="hover:text-primary transition-colors">Register Institution</a>
        <a href="/signup?tab=student" class="hover:text-primary transition-colors">Student Sign Up</a>
        <a href="mailto:institutional-support@campuspulse.edu" class="hover:text-primary transition-colors">Support</a>
      </div>
    </div>
  </footer>

  <script src="/js/main.js"></script>
  <script>
    function fillCredentials(email, password) {
      document.getElementById('email').value = email;
      document.getElementById('password').value = password;
    }
  </script>
</body>
</html>
