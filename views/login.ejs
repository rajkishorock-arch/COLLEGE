<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In - CampusPulse</title>
  
  <!-- Anti-Flash Instant Theme Detection -->
  <script>
    (function() {
      try {
        const theme = localStorage.getItem('campuspulse-theme') || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Google Fonts: Space Grotesk + Google Sans Flex + Google Sans Code + Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,slnt,wdth,wght,ROND@8..144,-10..0,25..150,400..700,0..100&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&display=swap">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-white dark:bg-[#090C15] text-gray-900 dark:text-gray-100 antialiased overflow-x-hidden selection:bg-emerald-500 selection:text-white">

  <!-- ========================================================================= -->
  <!-- Split Screen Authentication Layout (1:1 Match with User Reference)       -->
  <!-- ========================================================================= -->
  <div class="auth-split-container">
    
    <!-- LEFT: FORM COLUMN (35-45% Desktop) -->
    <div class="auth-form-column">
      <div class="w-full max-w-md mx-auto py-6">
        
        <!-- Top Row: Back to Home + Theme Switcher -->
        <div class="flex items-center justify-between mb-4">
          <a href="/" class="inline-flex items-center text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors group">
            <i class="fa-solid fa-arrow-left text-xs mr-2 transition-transform duration-200 group-hover:-translate-x-0.5"></i>
            <span>Back to Home</span>
          </a>
          <%- include('partials/theme-toggle') %>
        </div>

        <!-- Brand Title: CampusPulse -->
        <div class="mb-5">
          <h1 class="text-3xl sm:text-4xl font-black text-gray-900 dark:text-white tracking-tight font-['Space_Grotesk',sans-serif]">
            CampusPulse
          </h1>
        </div>

        <!-- Heading: Log in to your account -->
        <div class="mb-6">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white tracking-tight mb-1.5 font-['Space_Grotesk',sans-serif]">
            Log in to your account
          </h2>
          <p class="text-sm text-gray-500 dark:text-gray-400">
            Don't have an account? 
            <a href="/signup" class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">
              Sign Up
            </a>
          </p>
        </div>

        <!-- Flash Alert Messages -->
        <% if (error) { %>
          <div class="p-3.5 mb-4 rounded-xl text-xs sm:text-sm flex items-start gap-2.5 bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-300">
            <i class="fa-solid fa-circle-exclamation text-base shrink-0 mt-0.5 text-red-500"></i>
            <span class="font-medium"><%= error %></span>
          </div>
        <% } %>

        <% if (success) { %>
          <div class="p-3.5 mb-4 rounded-xl text-xs sm:text-sm flex items-start gap-2.5 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300">
            <i class="fa-solid fa-circle-check text-base shrink-0 mt-0.5 text-emerald-500"></i>
            <span class="font-medium"><%= success %></span>
          </div>
        <% } %>

        <!-- Login with Google Button -->
        <button 
          type="button" 
          onclick="handleGoogleLoginNotice()" 
          class="auth-google-btn mb-5"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
          </svg>
          <span class="font-medium text-gray-700 dark:text-gray-200">Login with Google</span>
        </button>

        <!-- Divider: Or email or phone number -->
        <div class="relative mb-5">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-gray-200 dark:border-gray-800"></div>
          </div>
          <div class="relative flex justify-center text-xs">
            <span class="px-3 bg-white dark:bg-[#090C15] text-gray-400 font-medium">
              Or email or phone number
            </span>
          </div>
        </div>

        <!-- Login Form -->
        <form action="/login" method="POST" class="space-y-4" id="login-form">
          
          <!-- Email or Phone or Roll No Input -->
          <div>
            <input 
              type="text" 
              id="email" 
              name="email" 
              required 
              autocomplete="username"
              placeholder="Email or phone"
              class="auth-clean-input"
            />
          </div>

          <!-- Password Input with Show/Hide Eye Toggle -->
          <div class="relative">
            <input 
              type="password" 
              id="password" 
              name="password" 
              required 
              autocomplete="current-password"
              placeholder="Password"
              class="auth-clean-input !pr-10"
            />
            <button 
              type="button" 
              onclick="togglePasswordVisibility('password', this)"
              aria-label="Toggle password visibility"
              class="absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors p-1"
              style="background: transparent; border: none; cursor: pointer;"
            >
              <i class="fa-regular fa-eye text-sm" id="eye-icon"></i>
            </button>
          </div>

          <!-- Forgot Password Link -->
          <div class="text-right">
            <a href="/forgot-password" class="text-xs sm:text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 font-medium transition-colors">
              Forgot password?
            </a>
          </div>

          <!-- Sign In Button with Ambient Orange Halo Glow -->
          <div class="auth-halo-button-wrapper pt-1">
            <div class="auth-halo-button-glow" aria-hidden="true"></div>
            <div class="auth-halo-button-border">
              <button type="submit" id="submit-btn" class="auth-halo-button-inner">
                <span id="btn-text">Sign In</span>
                <span id="btn-spinner" class="hidden flex items-center gap-2">
                  <i class="fa-solid fa-spinner fa-spin text-sm"></i>
                  <span>Signing In...</span>
                </span>
              </button>
            </div>
          </div>
        </form>

        <% if (typeof showDemoCredentials !== 'undefined' && showDemoCredentials) { %>
        <!-- 1-Click Multi-Tenant Demo Credentials -->
        <div class="mt-7 pt-5 border-t border-gray-100 dark:border-gray-800">
          <div class="flex items-center justify-between mb-3">
            <span class="text-[11px] font-bold uppercase tracking-wider text-gray-400 flex items-center gap-1.5 font-['Space_Grotesk']">
              <i class="fa-solid fa-bolt text-amber-500"></i> 1-Click Demo Accounts
            </span>
            <span class="text-[10px] text-gray-400 font-mono">Auto-fills form</span>
          </div>

          <div class="grid grid-cols-2 gap-2 text-xs">
            <!-- Super Admin -->
            <button 
              type="button" 
              onclick="fillCredentials('admin@college.edu', 'admin123', this)"
              class="demo-pill group"
            >
              <div class="flex items-center gap-2 truncate">
                <div class="w-5 h-5 rounded bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-[10px] shrink-0 font-bold">
                  <i class="fa-solid fa-crown"></i>
                </div>
                <span class="font-bold text-gray-900 dark:text-white truncate">Super Admin</span>
              </div>
              <i class="fa-solid fa-arrow-turn-down text-[9px] text-gray-400 group-hover:text-blue-600 transition-colors"></i>
            </button>

            <!-- Student CPIT -->
            <button 
              type="button" 
              onclick="fillCredentials('alex@college.edu', 'student123', this)"
              class="demo-pill group"
            >
              <div class="flex items-center gap-2 truncate">
                <div class="w-5 h-5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-[10px] shrink-0 font-bold">
                  <i class="fa-solid fa-user-graduate"></i>
                </div>
                <span class="font-bold text-gray-900 dark:text-white truncate">Student (Alex)</span>
              </div>
              <i class="fa-solid fa-arrow-turn-down text-[9px] text-gray-400 group-hover:text-emerald-600 transition-colors"></i>
            </button>

            <!-- Apex Admin -->
            <button 
              type="button" 
              onclick="fillCredentials('admin@apex.edu', 'admin123', this)"
              class="demo-pill group"
            >
              <div class="flex items-center gap-2 truncate">
                <div class="w-5 h-5 rounded bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center text-[10px] shrink-0 font-bold">
                  <i class="fa-solid fa-building-columns"></i>
                </div>
                <span class="font-bold text-gray-900 dark:text-white truncate">Apex Admin</span>
              </div>
              <i class="fa-solid fa-arrow-turn-down text-[9px] text-gray-400 group-hover:text-blue-600 transition-colors"></i>
            </button>

            <!-- Apex Student -->
            <button 
              type="button" 
              onclick="fillCredentials('student@apex.edu', 'student123', this)"
              class="demo-pill group"
            >
              <div class="flex items-center gap-2 truncate">
                <div class="w-5 h-5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center text-[10px] shrink-0 font-bold">
                  <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <span class="font-bold text-gray-900 dark:text-white truncate">Apex Student</span>
              </div>
              <i class="fa-solid fa-arrow-turn-down text-[9px] text-gray-400 group-hover:text-amber-600 transition-colors"></i>
            </button>
          </div>
        </div>
        <% } %>

        <!-- Master Console Institutional Link -->
        <div class="mt-8 pt-4 border-t border-gray-100 dark:border-gray-800 text-center">
          <p class="text-xs text-gray-500 dark:text-gray-400">
            Institutional Administrator? 
            <a href="/signup?tab=institution" class="font-semibold text-gray-800 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 underline ml-1">
              Access Master Console &rarr;
            </a>
          </p>
        </div>

      </div>
    </div>

    <!-- RIGHT: SHOWCASE IMAGE COLUMN (55-65% Desktop) -->
    <div class="auth-showcase-column">
      
      <!-- Ambient Glowing Orbs -->
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-[#00ed64]/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-[#00684a]/25 rounded-full blur-3xl pointer-events-none"></div>
      <div 
        class="absolute inset-0 pointer-events-none" 
        style="background: radial-gradient(circle at center, rgba(0, 237, 100, 0.12) 0%, transparent 70%);"
      ></div>

      <!-- Framed Workshop Photo Container (Matching media_1790651853943.png) -->
      <div class="auth-showcase-frame">
        <img 
          src="https://images.pexels.com/photos/9242834/pexels-photo-9242834.jpeg" 
          alt="Campus Robotics & AI/ML Tech Lab" 
          class="auth-showcase-img"
        />
        
        <!-- Bottom Vignette Gradient -->
        <div class="auth-showcase-overlay"></div>

        <!-- Bottom Typography Overlay -->
        <div class="auth-showcase-content">
          <div class="auth-badge-pill">
            <span class="w-2 h-2 rounded-full bg-[#00ed64] animate-pulse"></span>
            <span>AI/ML CLUB</span>
          </div>

          <h3 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-white mb-2 font-['Space_Grotesk',sans-serif]">
            Welcome to AIML Club
          </h3>

          <p class="text-sm sm:text-base font-medium text-[#c1ccd6] max-w-lg leading-relaxed">
            Empowering the future with Artificial Intelligence &amp; Machine Learning.
          </p>
        </div>
      </div>

    </div>

  </div>

  <script src="/js/main.js"></script>
  <script>
    // 1-Click Credentials Auto-fill with Tactile Feedback
    function fillCredentials(email, password, btnElement) {
      const emailInput = document.getElementById('email');
      const passwordInput = document.getElementById('password');

      emailInput.value = email;
      passwordInput.value = password;

      // Add visual feedback
      if (btnElement) {
        btnElement.classList.add('flash-filled');
        setTimeout(() => btnElement.classList.remove('flash-filled'), 600);
      }

      // Input glow animation
      emailInput.style.borderColor = '#00ed64';
      passwordInput.style.borderColor = '#00ed64';
      setTimeout(() => {
        emailInput.style.borderColor = '';
        passwordInput.style.borderColor = '';
      }, 500);
    }

    // Toggle Password Visibility
    function togglePasswordVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      const icon = btn.querySelector('i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      }
    }

    // Google Sign-in Notification
    function handleGoogleLoginNotice() {
      alert('Google OAuth Single Sign-On (SSO): Please use institutional email credentials or 1-Click Demo Accounts to sign in to your verified campus workspace.');
    }

    // Submit Loading State
    document.getElementById('login-form').addEventListener('submit', function() {
      const submitBtn = document.getElementById('submit-btn');
      const btnText = document.getElementById('btn-text');
      const btnSpinner = document.getElementById('btn-spinner');

      submitBtn.disabled = true;
      btnText.classList.add('hidden');
      btnSpinner.classList.remove('hidden');
    });
  </script>
</body>
</html>
