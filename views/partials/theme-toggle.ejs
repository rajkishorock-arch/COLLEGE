<!-- CampusPulse Theme Selector (Light / Dark / System) -->
<div class="theme-selector-pill inline-flex items-center" role="group" aria-label="Theme selection">
  <button 
    type="button" 
    onclick="setCampusPulseTheme('light')" 
    data-theme-btn="light" 
    title="Light Mode" 
    aria-label="Switch to Light Mode"
  >
    <i class="fa-regular fa-sun text-xs text-amber-500"></i>
    <span class="text-[11px] font-medium hidden sm:inline">Light</span>
  </button>
  <button 
    type="button" 
    onclick="setCampusPulseTheme('dark')" 
    data-theme-btn="dark" 
    title="Dark Mode" 
    aria-label="Switch to Dark Mode"
  >
    <i class="fa-regular fa-moon text-xs text-indigo-400"></i>
    <span class="text-[11px] font-medium hidden sm:inline">Dark</span>
  </button>
  <button 
    type="button" 
    onclick="setCampusPulseTheme('system')" 
    data-theme-btn="system" 
    title="System Mode" 
    aria-label="Switch to System Preference"
  >
    <i class="fa-solid fa-circle-half-stroke text-xs text-slate-400"></i>
    <span class="text-[11px] font-medium hidden sm:inline">System</span>
  </button>
</div>
