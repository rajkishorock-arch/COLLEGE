<% if (typeof error !== 'undefined' && error) { %>
  <div class="toast-notification flash-alert flash-alert-error mb-6 bg-[var(--bg-surface)] border border-rose-500/30 text-[var(--text-primary)] flex items-center justify-between shadow-md" role="alert">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-rose-50 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0">
        <i class="fa-solid fa-circle-exclamation text-sm"></i>
      </div>
      <span class="text-xs sm:text-sm font-medium leading-snug"><%= error %></span>
    </div>
    <button type="button" onclick="this.closest('.toast-notification').remove()" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] p-1 rounded transition-colors" title="Dismiss">
      <i class="fa-solid fa-xmark text-sm"></i>
    </button>
  </div>
<% } %>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="toast-notification flash-alert flash-alert-success mb-6 bg-[var(--bg-surface)] border border-green-500/30 text-[var(--text-primary)] flex items-center justify-between shadow-md" role="alert">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-green-50 dark:bg-green-950/50 text-green-600 dark:text-green-400 flex items-center justify-center shrink-0">
        <i class="fa-solid fa-circle-check text-sm"></i>
      </div>
      <span class="text-xs sm:text-sm font-medium leading-snug"><%= success %></span>
    </div>
    <button type="button" onclick="this.closest('.toast-notification').remove()" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] p-1 rounded transition-colors" title="Dismiss">
      <i class="fa-solid fa-xmark text-sm"></i>
    </button>
  </div>
<% } %>
