<!-- CampusPulse Enterprise Sidebar Component -->
<aside id="app-sidebar" class="app-sidebar -translate-x-full md:translate-x-0" aria-label="Main Navigation">
  
  <!-- Brand Header -->
  <div class="sidebar-header">
    <a href="<%= user && (user.role === 'admin' || user.role === 'super_admin') ? '/admin/dashboard' : '/student/dashboard' %>" class="brand-link">
      <div class="brand-icon-box">
        <i class="fa-solid fa-graduation-cap"></i>
      </div>
      <div class="brand-text-col">
        <div class="flex items-center">
          <span class="brand-name">CAMPUS<span style="color: var(--accent-primary);">PULSE</span></span>
        </div>
        <span class="brand-sub">Higher Education SaaS</span>
      </div>
    </a>
    <button id="close-sidebar-btn" type="button" aria-label="Close Sidebar" class="md:hidden text-secondary hover:text-primary p-1 rounded-lg" style="background: transparent; border: none; cursor: pointer;">
      <i class="fa-solid fa-xmark text-lg"></i>
    </button>
  </div>

  <!-- Navigation Links with Sliding Active Indicator -->
  <div class="sidebar-nav-scroll">
    
    <!-- Sliding Active Indicator -->
    <div id="nav-active-indicator" style="opacity: 0;">
      <div class="indicator-bar"></div>
      <div class="indicator-bg"></div>
    </div>

    <% if (user && user.role === 'student') { %>
      <div class="sidebar-section-title">
        Core Academics
      </div>

      <a href="/student/dashboard" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'dashboard') ? 'active' : '' %>">
        <i class="fa-solid fa-gauge-high w-5 text-center text-sm"></i>
        <span>Dashboard</span>
      </a>

      <a href="/student/checkin" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'checkin') ? 'active' : '' %>">
        <i class="fa-solid fa-qrcode w-5 text-center text-sm" style="color: var(--accent-primary);"></i>
        <span>Self Check-In</span>
      </a>

      <a href="/student/timetable" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'timetable') ? 'active' : '' %>">
        <i class="fa-solid fa-calendar-days w-5 text-center text-sm"></i>
        <span>Timetable</span>
      </a>

      <a href="/student/announcements" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'announcements') ? 'active' : '' %>">
        <i class="fa-solid fa-bullhorn w-5 text-center text-sm"></i>
        <span>Notice Board</span>
      </a>

      <a href="/student/assignments" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'assignments') ? 'active' : '' %>">
        <i class="fa-solid fa-file-arrow-up w-5 text-center text-sm"></i>
        <span>Assignments</span>
      </a>

      <div class="sidebar-section-title" style="margin-top: 10px;">
        Records & Services
      </div>

      <a href="/student/fees" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'fees') ? 'active' : '' %>">
        <i class="fa-solid fa-receipt w-5 text-center text-sm"></i>
        <span>Fee Status</span>
      </a>

      <a href="/student/attendance" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'attendance') ? 'active' : '' %>">
        <i class="fa-solid fa-clipboard-user w-5 text-center text-sm"></i>
        <span>Attendance Record</span>
      </a>

      <a href="/student/results" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'results') ? 'active' : '' %>">
        <i class="fa-solid fa-chart-simple w-5 text-center text-sm"></i>
        <span>Results & CGPA</span>
      </a>

      <a href="/student/library" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'library') ? 'active' : '' %>">
        <i class="fa-solid fa-book-bookmark w-5 text-center text-sm"></i>
        <span>Library</span>
      </a>

      <a href="/student/quiz" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'quiz') ? 'active' : '' %>">
        <i class="fa-solid fa-pen-to-square w-5 text-center text-sm"></i>
        <span>Quizzes & Tests</span>
      </a>

      <a href="/student/profile" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'profile') ? 'active' : '' %>">
        <i class="fa-solid fa-user-gear w-5 text-center text-sm"></i>
        <span>My Profile</span>
      </a>

    <% } else if (user && (user.role === 'admin' || user.role === 'super_admin')) { %>
      
      <div class="sidebar-section-title">
        Institutional Management
      </div>

      <a href="/admin/dashboard" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'dashboard') ? 'active' : '' %>">
        <i class="fa-solid fa-chart-pie w-5 text-center text-sm"></i>
        <span>Overview</span>
      </a>

      <a href="/admin/students" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'students') ? 'active' : '' %>">
        <i class="fa-solid fa-user-graduate w-5 text-center text-sm"></i>
        <span>Students</span>
      </a>

      <a href="/admin/attendance" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'attendance') ? 'active' : '' %>">
        <i class="fa-solid fa-calendar-check w-5 text-center text-sm"></i>
        <span>Attendance & Sessions</span>
      </a>

      <a href="/admin/timetable" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'timetable') ? 'active' : '' %>">
        <i class="fa-solid fa-calendar-days w-5 text-center text-sm"></i>
        <span>Timetable</span>
      </a>

      <a href="/admin/announcements" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'announcements') ? 'active' : '' %>">
        <i class="fa-solid fa-bullhorn w-5 text-center text-sm"></i>
        <span>Notice Board</span>
      </a>

      <a href="/admin/assignments" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'assignments') ? 'active' : '' %>">
        <i class="fa-solid fa-file-circle-check w-5 text-center text-sm"></i>
        <span>Assignments</span>
      </a>

      <div class="sidebar-section-title" style="margin-top: 10px;">
        Finance & Operations
      </div>

      <a href="/admin/fees" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'fees') ? 'active' : '' %>">
        <i class="fa-solid fa-receipt w-5 text-center text-sm"></i>
        <span>Fee Management</span>
      </a>

      <a href="/admin/results" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'results') ? 'active' : '' %>">
        <i class="fa-solid fa-square-poll-vertical w-5 text-center text-sm"></i>
        <span>Results & CGPA</span>
      </a>

      <a href="/admin/library" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'library') ? 'active' : '' %>">
        <i class="fa-solid fa-book-open-reader w-5 text-center text-sm"></i>
        <span>Library Catalog</span>
      </a>

      <a href="/admin/quiz" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'quiz') ? 'active' : '' %>">
        <i class="fa-solid fa-file-circle-question w-5 text-center text-sm"></i>
        <span>Quizzes</span>
      </a>

      <a href="/admin/tenant-settings" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'tenant-settings') ? 'active' : '' %>">
        <i class="fa-solid fa-sliders w-5 text-center text-sm"></i>
        <span>Institution Settings</span>
      </a>

      <% if (user.role === 'super_admin') { %>
        <div class="sidebar-section-title" style="margin-top: 10px; color: var(--accent-primary);">
          Platform Administration
        </div>

        <a href="/super-admin" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'super-admin-overview') ? 'active' : '' %>">
          <i class="fa-solid fa-network-wired w-5 text-center text-sm" style="color: var(--accent-primary);"></i>
          <span>Platform Overview</span>
        </a>

        <a href="/super-admin/tenants" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'super-admin-tenants') ? 'active' : '' %>">
          <i class="fa-solid fa-building-columns w-5 text-center text-sm"></i>
          <span>Institutions (Tenants)</span>
        </a>

        <a href="/super-admin/audit" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'super-admin-audit') ? 'active' : '' %>">
          <i class="fa-solid fa-shield-halved w-5 text-center text-sm"></i>
          <span>Platform Audit</span>
        </a>

        <a href="/admin/manage-admins" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'manage-admins') ? 'active' : '' %>">
          <i class="fa-solid fa-user-shield w-5 text-center text-sm" style="color: var(--accent-primary);"></i>
          <span>Manage Admins</span>
        </a>
      <% } %>

      <div class="sidebar-section-title" style="margin-top: 10px;">
        Account & Audit
      </div>

      <a href="/admin/audit-log" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'audit-log') ? 'active' : '' %>">
        <i class="fa-solid fa-clock-rotate-left w-5 text-center text-sm"></i>
        <span>Audit History</span>
      </a>

      <a href="/admin/profile" class="sidebar-link <%= (typeof pageName !== 'undefined' && pageName === 'profile') ? 'active' : '' %>">
        <i class="fa-solid fa-user-gear w-5 text-center text-sm"></i>
        <span>Admin Profile</span>
      </a>

    <% } %>

  </div>

  <!-- Tenant Badge in Sidebar -->
  <% if (typeof tenant !== 'undefined' && tenant) { %>
    <div style="padding: 10px 14px; margin: 0 12px 8px; border-radius: 10px; background-color: var(--bg-surface-hover); border: 1px solid var(--border-subtle); font-size: 12px;">
      <div class="font-bold text-primary truncate flex items-center gap-2">
        <span style="width: 8px; height: 8px; border-radius: 50%; background-color: <%= tenant.primary_color || 'var(--accent-primary)' %>; flex-shrink: 0;"></span>
        <span class="truncate"><%= tenant.name %></span>
      </div>
      <div class="flex justify-between items-center text-[10px] text-muted mt-1">
        <span class="font-mono font-bold" style="color: var(--accent-primary);"><%= tenant.code %></span>
        <span style="color: var(--success); font-weight: 600; text-transform: capitalize;"><%= tenant.status %></span>
      </div>
    </div>
  <% } %>

  <!-- User Profile Section in Sidebar -->
  <% if (user) { %>
    <div style="padding: 12px; border-top: 1px solid var(--border-subtle); background-color: var(--bg-surface);">
      <a href="<%= user.role === 'student' ? '/student/profile' : '/admin/profile' %>" class="flex items-center gap-3 p-2 rounded-lg hover:bg-surface-hover transition-colors mb-2 text-decoration-none">
        <% if (user.profile_photo) { %>
          <img 
            src="<%= user.profile_photo %>" 
            alt="<%= user.name %>" 
            style="width: 36px; height: 36px; border-radius: 8px; object-fit: cover; border: 1px solid var(--border-subtle); flex-shrink: 0;"
          />
        <% } else { %>
          <div style="width: 36px; height: 36px; border-radius: 8px; background-color: rgba(79, 70, 229, 0.08); border: 1px solid rgba(79, 70, 229, 0.2); display: flex; align-items: center; justify-content: center; color: var(--accent-primary); font-weight: 700; font-size: 12px; flex-shrink: 0;">
            <%= user.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() %>
          </div>
        <% } %>
        <div class="overflow-hidden flex-1">
          <p class="text-xs font-bold text-primary truncate"><%= user.name %></p>
          <p class="text-[11px] text-secondary truncate">
            <% if (user.role === 'student' && user.roll_no) { %>
              <%= user.roll_no %>
            <% } else { %>
              <%= user.email %>
            <% } %>
          </p>
        </div>
        <i class="fa-solid fa-chevron-right text-[10px] text-muted"></i>
      </a>

      <a href="/logout" class="btn-secondary w-full !min-h-[34px] !py-1.5 !px-3 text-xs font-bold flex items-center justify-center gap-2" style="color: var(--danger); border-color: rgba(220, 38, 38, 0.25);">
        <i class="fa-solid fa-arrow-right-from-bracket text-xs"></i>
        <span>Sign Out</span>
      </a>
    </div>
  <% } %>

</aside>

<!-- Mobile Overlay Backdrop -->
<div id="sidebar-overlay" class="hidden sidebar-backdrop md:hidden"></div>
