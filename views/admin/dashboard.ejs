<!-- Admin Dashboard Overview -->
<div class="space-y-6">

  <!-- Welcome Admin Banner -->
  <div class="card p-6 border border-[var(--border-subtle)] bg-[var(--bg-surface)] rounded-xl shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 text-xs font-semibold border border-amber-200 dark:border-amber-800 mb-2">
          <i class="fa-solid fa-shield-halved text-[10px]"></i>
          <span>Administrator Control Center</span>
        </div>
        <h1 class="text-xl sm:text-2xl font-bold text-[var(--text-primary)] font-['Space_Grotesk'] tracking-tight">
          Campus Operations Overview
        </h1>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] mt-1 max-w-xl font-normal leading-relaxed">
          Real-time institutional metrics on student enrollment, academic attendance rates, library circulation, and testing performance.
        </p>
      </div>

      <div class="flex items-center gap-2.5 shrink-0">
        <a href="/admin/attendance" class="btn-primary py-2 px-3.5 text-xs font-semibold rounded-lg flex items-center gap-1.5">
          <i class="fa-solid fa-calendar-check text-xs"></i>
          <span>Mark Attendance</span>
        </a>
        <a href="/admin/library" class="btn-secondary py-2 px-3.5 text-xs font-semibold rounded-lg flex items-center gap-1.5">
          <i class="fa-solid fa-book text-xs"></i>
          <span>Circulation Desk</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Bento Grid Summary Cards (Responsive 4-stat layout) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    
    <!-- 1. Total Students -->
    <div class="card p-5 flex flex-col justify-between border border-[var(--border-subtle)] bg-[var(--bg-surface)] rounded-xl">
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-medium text-[var(--text-secondary)]">Total Students</span>
          <div class="w-8 h-8 rounded-lg bg-indigo-50 dark:bg-indigo-950/40 text-[var(--accent-primary)] flex items-center justify-center text-sm">
            <i class="fa-solid fa-user-graduate"></i>
          </div>
        </div>
        <div class="flex items-baseline gap-2">
          <span class="text-2xl font-bold text-[var(--text-primary)] font-['Space_Grotesk']">
            <%= stats.totalStudents %>
          </span>
          <span class="status-pill text-[10px] py-0.5 px-2 font-bold badge-accent">
            Active
          </span>
        </div>
        <p class="text-[11px] text-[var(--text-muted)] mt-2">
          Enrolled across all academic departments.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-[var(--border-subtle)]">
        <a href="/admin/students" class="text-xs font-semibold text-[var(--accent-primary)] hover:underline flex items-center justify-between">
          <span>Student Directory</span>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>
    </div>

    <!-- 2. Campus Average Attendance -->
    <div class="card p-5 flex flex-col justify-between border border-[var(--border-subtle)] bg-[var(--bg-surface)] rounded-xl">
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-medium text-[var(--text-secondary)]">Average Attendance</span>
          <div class="w-8 h-8 rounded-lg bg-green-50 dark:bg-green-950/40 text-green-600 dark:text-green-400 flex items-center justify-center text-sm">
            <i class="fa-solid fa-chart-line"></i>
          </div>
        </div>
        <div class="flex items-baseline gap-2">
          <span class="text-2xl font-bold font-['Space_Grotesk'] <%= stats.averageAttendance >= 75 ? 'text-green-600 dark:text-green-400' : 'text-rose-600 dark:text-rose-400' %>">
            <%= stats.averageAttendance %>%
          </span>
          <span class="status-pill text-[10px] py-0.5 px-2 font-bold <%= stats.averageAttendance >= 75 ? 'badge-success' : 'badge-danger' %>">
            <%= stats.averageAttendance >= 75 ? 'Healthy' : 'Below 75%' %>
          </span>
        </div>
        <p class="text-[11px] text-[var(--text-muted)] mt-2">
          Campus-wide lecture attendance rate.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-[var(--border-subtle)]">
        <a href="/admin/attendance" class="text-xs font-semibold text-[var(--accent-primary)] hover:underline flex items-center justify-between">
          <span>Attendance Records</span>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>
    </div>

    <!-- 3. Total Library Catalog -->
    <div class="card p-5 flex flex-col justify-between border border-[var(--border-subtle)] bg-[var(--bg-surface)] rounded-xl">
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-medium text-[var(--text-secondary)]">Library Catalog</span>
          <div class="w-8 h-8 rounded-lg bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 flex items-center justify-center text-sm">
            <i class="fa-solid fa-book-bookmark"></i>
          </div>
        </div>
        <div class="flex items-baseline gap-2">
          <span class="text-2xl font-bold text-[var(--text-primary)] font-['Space_Grotesk']">
            <%= stats.totalBooks %>
          </span>
          <span class="text-xs font-semibold text-[var(--text-muted)]">Copies</span>
        </div>
        <p class="text-[11px] text-[var(--text-muted)] mt-2">
          <%= stats.totalTitles %> cataloged curriculum titles.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-[var(--border-subtle)]">
        <a href="/admin/library" class="text-xs font-semibold text-[var(--accent-primary)] hover:underline flex items-center justify-between">
          <span>Book Inventory</span>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>
    </div>

    <!-- 4. Active Circulation / Overdue -->
    <div class="card p-5 flex flex-col justify-between border border-[var(--border-subtle)] bg-[var(--bg-surface)] rounded-xl">
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-medium text-[var(--text-secondary)]">Active Loans</span>
          <div class="w-8 h-8 rounded-lg <%= stats.overdueCount > 0 ? 'bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400' : 'bg-indigo-50 dark:bg-indigo-950/40 text-[var(--accent-primary)]' %> flex items-center justify-center text-sm">
            <i class="fa-solid fa-book-reader"></i>
          </div>
        </div>
        <div class="flex items-baseline gap-2">
          <span class="text-2xl font-bold text-[var(--text-primary)] font-['Space_Grotesk']">
            <%= stats.booksIssued %>
          </span>
          <% if (stats.overdueCount > 0) { %>
            <span class="status-pill text-[10px] py-0.5 px-2 font-bold badge-danger">
              <%= stats.overdueCount %> Overdue
            </span>
          <% } else { %>
            <span class="status-pill text-[10px] py-0.5 px-2 font-bold badge-success">
              On Schedule
            </span>
          <% } %>
        </div>
        <p class="text-[11px] text-[var(--text-muted)] mt-2">
          Issued textbooks to enrolled students.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-[var(--border-subtle)]">
        <a href="/admin/library" class="text-xs font-semibold text-[var(--accent-primary)] hover:underline flex items-center justify-between">
          <span>Circulation Desk</span>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>
    </div>

  </div>

  <!-- Lower Tables Grid (Recently Registered Students & Active Circulation) -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
    
    <!-- Recently Registered Students -->
    <div class="card p-5 border border-[var(--border-subtle)] bg-[var(--bg-surface)] rounded-xl">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-indigo-50 dark:bg-indigo-950/40 text-[var(--accent-primary)] flex items-center justify-center text-xs">
            <i class="fa-solid fa-users"></i>
          </div>
          <div>
            <h2 class="text-sm font-bold text-[var(--text-primary)] font-['Space_Grotesk']">Recently Enrolled Students</h2>
            <p class="text-[11px] text-[var(--text-muted)]">New student accounts on platform</p>
          </div>
        </div>
        <a href="/admin/students" class="text-xs font-semibold text-[var(--accent-primary)] hover:underline flex items-center gap-1">
          <span>View All</span>
          <i class="fa-solid fa-arrow-right text-[9px]"></i>
        </a>
      </div>

      <% if (recentStudents && recentStudents.length > 0) { %>
        <div class="divide-y divide-[var(--border-subtle)]">
          <% recentStudents.forEach(st => { %>
            <div class="py-2.5 flex items-center justify-between hover:bg-[var(--bg-surface-hover)] -mx-2 px-2 rounded-lg transition-colors">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-[var(--bg-primary)] border border-[var(--border-subtle)] text-[var(--accent-primary)] flex items-center justify-center font-bold text-xs">
                  <%= st.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() %>
                </div>
                <div>
                  <h3 class="text-xs font-bold text-[var(--text-primary)] leading-tight"><%= st.name %></h3>
                  <p class="text-[11px] text-[var(--text-secondary)] mt-0.5"><%= st.roll_no %> • <%= st.course %></p>
                </div>
              </div>
              <a href="/admin/students/<%= st.id %>" class="btn-secondary text-[11px] font-semibold py-1 px-2.5 rounded-md">
                Profile
              </a>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="py-8 text-center text-[var(--text-muted)]">
          <div class="w-10 h-10 rounded-lg bg-[var(--bg-primary)] text-[var(--text-muted)] flex items-center justify-center text-base mx-auto mb-2 border border-[var(--border-subtle)]">
            <i class="fa-solid fa-user-xmark"></i>
          </div>
          <p class="font-bold text-[var(--text-primary)] text-xs">No registered students</p>
          <p class="text-[11px] text-[var(--text-secondary)] max-w-sm mx-auto mt-0.5">Add student accounts via the directory to get started.</p>
        </div>
      <% } %>
    </div>

    <!-- Active / Overdue Book Loans -->
    <div class="card p-5 border border-[var(--border-subtle)] bg-[var(--bg-surface)] rounded-xl">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xs">
            <i class="fa-solid fa-book"></i>
          </div>
          <div>
            <h2 class="text-sm font-bold text-[var(--text-primary)] font-['Space_Grotesk']">Active Book Circulation</h2>
            <p class="text-[11px] text-[var(--text-muted)]">Live loans and return deadlines</p>
          </div>
        </div>
        <a href="/admin/library" class="text-xs font-semibold text-[var(--accent-primary)] hover:underline flex items-center gap-1">
          <span>Desk</span>
          <i class="fa-solid fa-arrow-right text-[9px]"></i>
        </a>
      </div>

      <% if (recentIssuedBooks && recentIssuedBooks.length > 0) { %>
        <div class="divide-y divide-[var(--border-subtle)]">
          <% recentIssuedBooks.forEach(item => { %>
            <div class="py-2.5 flex items-center justify-between hover:bg-[var(--bg-surface-hover)] -mx-2 px-2 rounded-lg transition-colors">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg <%= item.isOverdue ? 'bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-800' : 'bg-[var(--bg-primary)] text-[var(--text-secondary)] border border-[var(--border-subtle)]' %> flex items-center justify-center text-xs">
                  <i class="fa-solid fa-book"></i>
                </div>
                <div>
                  <h3 class="text-xs font-bold text-[var(--text-primary)] truncate max-w-[180px] leading-tight"><%= item.title %></h3>
                  <p class="text-[11px] text-[var(--text-secondary)] mt-0.5"><span class="font-medium text-[var(--text-primary)]"><%= item.student_name %></span> (<%= item.roll_no %>)</p>
                </div>
              </div>
              <div class="text-right">
                <% if (item.isOverdue) { %>
                  <span class="status-pill text-[10px] py-0.5 px-2 font-bold badge-danger">
                    OVERDUE
                  </span>
                <% } else { %>
                  <span class="status-pill text-[10px] py-0.5 px-2 font-semibold badge-success">
                    Due <%= item.due_date %>
                  </span>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="py-8 text-center text-[var(--text-muted)]">
          <div class="w-10 h-10 rounded-lg bg-[var(--bg-primary)] text-[var(--text-muted)] flex items-center justify-center text-base mx-auto mb-2 border border-[var(--border-subtle)]">
            <i class="fa-solid fa-book-open"></i>
          </div>
          <p class="font-bold text-[var(--text-primary)] text-xs">No active loans</p>
          <p class="text-[11px] text-[var(--text-secondary)] max-w-sm mx-auto mt-0.5">All borrowed books have been returned to the catalog.</p>
        </div>
      <% } %>
    </div>

  </div>

</div>
