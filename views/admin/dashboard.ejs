<!-- Admin Dashboard Overview (Exact Dark Theme & Bento Grid Layout) -->
<div class="space-y-[48px]">

  <!-- Welcome Admin Banner -->
  <div class="card relative overflow-hidden bg-gradient-to-r from-[#F0EDFD]/40 via-[#FFFFFF] to-[#F0EDFD]/40 border border-[#E5E7EB] p-[28px] rounded-[12px]" style="--i: 1;">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FEF6E7] text-[var(--warning)] text-xs font-semibold tracking-wide border border-[rgba(255,165,2,0.25)] mb-3">
          <i class="fa-solid fa-shield-halved"></i>
          <span>Administrator Control Center</span>
        </div>
        <h1 class="page-title text-[#111318]">
          Campus Operations Overview
        </h1>
        <p class="text-[#5B5F6B] text-sm mt-2 max-w-xl font-normal leading-relaxed">
          Real-time institutional metrics on student enrollment, academic attendance rates, library circulation, and testing performance.
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <a href="/admin/attendance" class="btn-primary">
          <i class="fa-solid fa-calendar-check"></i>
          <span>Mark Attendance</span>
        </a>
        <a href="/admin/library" class="btn-secondary">
          <i class="fa-solid fa-book"></i>
          <span>Circulation Desk</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Bento Grid Summary Cards (20px gap, Asymmetric layout) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-[20px]">
    
    <!-- 1. Featured Total Students Bento Card (2 Columns Wide) -->
    <div class="md:col-span-2 card flex flex-col justify-between" style="--i: 2;">
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="stat-label text-[#5B5F6B]">Total Student Enrollment</span>
          <div class="w-10 h-10 rounded-[8px] bg-[#F0EDFD] text-[var(--accent-primary)] flex items-center justify-center text-lg border border-[var(--border-subtle)]">
            <i class="fa-solid fa-user-graduate"></i>
          </div>
        </div>

        <div class="flex items-baseline gap-4 mt-2">
          <span class="metric-number text-[#111318]">
            <%= stats.totalStudents %>
          </span>
          <span class="status-pill badge-accent">
            Active Verified Profiles
          </span>
        </div>

        <p class="body-text mt-3 text-sm">
          Enrolled across Computer Science, Information Technology, AI & Data Science, and Engineering disciplines.
        </p>
      </div>

      <div class="mt-6 pt-4 border-t border-[#E5E7EB] flex items-center justify-between">
        <span class="text-xs text-[#8B8F99]">Directory Ledger</span>
        <a href="/admin/students" class="text-xs font-semibold text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] flex items-center gap-1.5 group">
          <span>Manage Student Directory</span>
          <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
        </a>
      </div>
    </div>

    <!-- 2. Campus Average Attendance Bento Card (1 Column Wide) -->
    <div class="card flex flex-col justify-between" style="--i: 3;">
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="stat-label text-[#5B5F6B]">Average Attendance</span>
          <div class="w-10 h-10 rounded-[8px] bg-[#E8F8EE] text-[var(--success)] flex items-center justify-center text-lg border border-[var(--border-subtle)]">
            <i class="fa-solid fa-chart-line"></i>
          </div>
        </div>
        <div class="flex items-baseline gap-2.5">
          <span class="metric-number <%= stats.averageAttendance >= 75 ? 'text-[var(--success)]' : 'text-[var(--danger)]' %>">
            <%= stats.averageAttendance %>%
          </span>
          <span class="status-pill <%= stats.averageAttendance >= 75 ? 'badge-success' : 'badge-danger' %>">
            <%= stats.averageAttendance >= 75 ? 'Healthy' : 'Below Target' %>
          </span>
        </div>
        <p class="body-text mt-3 text-xs">
          Aggregated institutional attendance across all classroom roll-calls.
        </p>
      </div>
      <div class="mt-6 pt-4 border-t border-[#E5E7EB]">
        <a href="/admin/attendance" class="text-xs font-semibold text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] flex items-center justify-between group">
          <span>Open Roll Call Ledger</span>
          <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
        </a>
      </div>
    </div>

    <!-- 3. Total Library Catalog Bento Card (1 Column Wide) -->
    <div class="card flex flex-col justify-between" style="--i: 4;">
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="stat-label text-[#5B5F6B]">Library Catalog</span>
          <div class="w-10 h-10 rounded-[8px] bg-[#FEF6E7] text-[var(--warning)] flex items-center justify-center text-lg border border-[var(--border-subtle)]">
            <i class="fa-solid fa-book-bookmark"></i>
          </div>
        </div>
        <div class="flex items-baseline gap-2.5">
          <span class="metric-number text-[#111318]">
            <%= stats.totalBooks %>
          </span>
          <span class="text-xs font-semibold text-[#5B5F6B]">Total Copies</span>
        </div>
        <p class="body-text mt-3 text-xs">
          <%= stats.totalTitles %> unique literary & engineering curriculum titles.
        </p>
      </div>
      <div class="mt-6 pt-4 border-t border-[#E5E7EB]">
        <a href="/admin/library" class="text-xs font-semibold text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] flex items-center justify-between group">
          <span>Manage Book Inventory</span>
          <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
        </a>
      </div>
    </div>

    <!-- 4. Active Circulation / Overdue Bento Card (2 Columns Wide) -->
    <div class="md:col-span-2 card flex flex-col justify-between" style="--i: 5;">
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="stat-label text-[#5B5F6B]">Circulation & Overdue Monitoring</span>
          <div class="w-10 h-10 rounded-[8px] <%= stats.overdueCount > 0 ? 'bg-[#FEECEE] text-[var(--danger)]' : 'bg-[#F0EDFD] text-[var(--accent-primary)]' %> flex items-center justify-center text-lg border border-[var(--border-subtle)]">
            <i class="fa-solid fa-book-reader"></i>
          </div>
        </div>
        <div class="flex items-baseline gap-3">
          <span class="metric-number text-[#111318]">
            <%= stats.booksIssued %>
          </span>
          <% if (stats.overdueCount > 0) { %>
            <span class="status-pill badge-danger font-bold">
              <%= stats.overdueCount %> Overdue Returns
            </span>
          <% } else { %>
            <span class="status-pill badge-success">
              All Returns On Schedule
            </span>
          <% } %>
        </div>
        <p class="body-text mt-3 text-sm">
          Track borrowed technical textbooks, issue new books to enrolled student IDs, and manage return deadlines.
        </p>
      </div>
      <div class="mt-6 pt-4 border-t border-[#E5E7EB] flex items-center justify-between">
        <span class="text-xs text-[#8B8F99]">Circulation Desk</span>
        <a href="/admin/library" class="text-xs font-semibold text-[var(--accent-primary)] hover:text-[var(--accent-primary-hover)] flex items-center gap-1.5 group">
          <span>Circulation & Returns</span>
          <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
        </a>
      </div>
    </div>

  </div>

  <!-- Lower Tables Grid (Recently Registered Students & Active Circulation) -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-[20px]">
    
    <!-- Recently Registered Students -->
    <div class="card" style="--i: 6;">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-[8px] bg-[#F0EDFD] text-[var(--accent-primary)] flex items-center justify-center text-base shrink-0 mt-0.5 border border-[var(--border-subtle)]">
            <i class="fa-solid fa-users"></i>
          </div>
          <div>
            <h2 class="section-title">Recently Enrolled Students</h2>
            <p class="text-muted-desc">Newly registered student accounts on the platform</p>
          </div>
        </div>
        <a href="/admin/students" class="text-xs font-semibold text-[var(--accent-primary)] hover:underline flex items-center gap-1">
          <span>All Students</span>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>

      <% if (recentStudents && recentStudents.length > 0) { %>
        <div class="divide-y divide-[#E5E7EB]">
          <% recentStudents.forEach(st => { %>
            <div class="py-3.5 flex items-center justify-between hover:bg-[#F7F7F9]/50 -mx-3 px-3 rounded-[8px] transition-colors">
              <div class="flex items-center gap-3.5">
                <div class="w-10 h-10 rounded-[8px] bg-[#FFFFFF] border border-[#E5E7EB] text-[var(--accent-primary)] flex items-center justify-center font-bold text-xs">
                  <%= st.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() %>
                </div>
                <div>
                  <h3 class="card-title text-[#111318] text-sm"><%= st.name %></h3>
                  <p class="text-xs text-[#5B5F6B] font-medium mt-0.5"><%= st.roll_no %> • <%= st.course %></p>
                </div>
              </div>
              <a href="/admin/students/<%= st.id %>" class="btn-secondary text-xs font-semibold py-1.5 px-3">
                View Profile
              </a>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="py-12 text-center text-[#8B8F99]">
          <div class="w-12 h-12 rounded-[12px] bg-[#FFFFFF] text-[#8B8F99] flex items-center justify-center text-xl mx-auto mb-3 border border-[#E5E7EB]">
            <i class="fa-solid fa-user-xmark"></i>
          </div>
          <p class="font-bold text-[#111318] text-sm">No registered students</p>
          <p class="text-xs text-[#5B5F6B] max-w-sm mx-auto mt-1">Add student accounts via the student directory to get started.</p>
        </div>
      <% } %>
    </div>

    <!-- Active / Overdue Book Loans -->
    <div class="card" style="--i: 7;">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-[8px] bg-[#FEF6E7] text-[var(--warning)] flex items-center justify-center text-base shrink-0 mt-0.5 border border-[var(--border-subtle)]">
            <i class="fa-solid fa-book"></i>
          </div>
          <div>
            <h2 class="section-title">Active Book Circulation</h2>
            <p class="text-muted-desc">Live borrowings and return deadlines across the student body</p>
          </div>
        </div>
        <a href="/admin/library" class="text-xs font-semibold text-[var(--accent-primary)] hover:underline flex items-center gap-1">
          <span>Circulation Desk</span>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>

      <% if (recentIssuedBooks && recentIssuedBooks.length > 0) { %>
        <div class="divide-y divide-[#E5E7EB]">
          <% recentIssuedBooks.forEach(item => { %>
            <div class="py-3.5 flex items-center justify-between hover:bg-[#F7F7F9]/50 -mx-3 px-3 rounded-[8px] transition-colors">
              <div class="flex items-center gap-3.5">
                <div class="w-10 h-10 rounded-[8px] <%= item.isOverdue ? 'bg-[#FEECEE] text-[var(--danger)] border border-[#FECDD3]' : 'bg-[#FFFFFF] text-[#5B5F6B] border border-[#E5E7EB]' %> flex items-center justify-center text-xs">
                  <i class="fa-solid fa-book"></i>
                </div>
                <div>
                  <h3 class="card-title text-[#111318] truncate max-w-[200px] text-sm"><%= item.title %></h3>
                  <p class="text-xs text-[#5B5F6B] mt-0.5">Issued to: <span class="font-semibold text-[#111318]"><%= item.student_name %></span> (<%= item.roll_no %>)</p>
                </div>
              </div>
              <div class="text-right">
                <% if (item.isOverdue) { %>
                  <span class="status-pill text-[10px] font-bold badge-danger">
                    OVERDUE
                  </span>
                <% } else { %>
                  <span class="status-pill text-xs font-semibold badge-success">
                    Due: <%= item.due_date %>
                  </span>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="py-12 text-center text-[#8B8F99]">
          <div class="w-12 h-12 rounded-[12px] bg-[#FFFFFF] text-[#8B8F99] flex items-center justify-center text-xl mx-auto mb-3 border border-[#E5E7EB]">
            <i class="fa-solid fa-book-open"></i>
          </div>
          <p class="font-bold text-[#111318] text-sm">No books currently checked out</p>
          <p class="text-xs text-[#5B5F6B] max-w-sm mx-auto mt-1">All borrowed books have been returned to the library inventory.</p>
        </div>
      <% } %>
    </div>

  </div>

</div>
