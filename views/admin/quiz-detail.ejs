<!-- Quiz Management Detail (Questions & Submissions - Exact Dark Theme Spec) -->
<div class="space-y-[48px]">

  <!-- Breadcrumb & Back -->
  <div class="flex items-center justify-between" style="--i: 1;">
    <a href="/admin/quiz" class="inline-flex items-center gap-2 text-xs font-semibold text-[#5B5F6B] hover:text-[#111318] transition-colors">
      <i class="fa-solid fa-arrow-left"></i>
      <span>Back to Assessment Manager</span>
    </a>
    <span class="status-pill text-xs font-semibold badge-accent">
      <%= quiz.subject %>
    </span>
  </div>

  <!-- Quiz Info Banner -->
  <div class="card flex flex-col md:flex-row md:items-center justify-between gap-6" style="--i: 2;">
    <div>
      <h1 class="page-title text-[#111318]"><%= quiz.title %></h1>
      <p class="body-text mt-1.5 text-sm">
        <%= questions.length %> questions configured • <%= attempts.length %> student attempts recorded
      </p>
    </div>

    <button 
      type="button" 
      onclick="openModal('add-question-modal')"
      class="btn-primary py-2.5 px-4 text-xs font-semibold shrink-0"
    >
      <i class="fa-solid fa-plus"></i>
      <span>Add MCQ Question</span>
    </button>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-[20px]">
    
    <!-- Left 2 Cols: Questions List -->
    <div class="lg:col-span-2 space-y-6">
      <div class="flex items-start gap-3.5 px-1">
        <div class="w-10 h-10 rounded-[8px] bg-[#F0EDFD] text-[var(--accent-primary)] flex items-center justify-center text-base shrink-0 mt-0.5 border border-[var(--border-subtle)]">
          <i class="fa-solid fa-list-ol"></i>
        </div>
        <div>
          <h2 class="section-title">Quiz Question Inventory</h2>
          <p class="text-muted-desc"><%= questions.length %> question items in active test rotation</p>
        </div>
      </div>

      <% if (questions && questions.length > 0) { %>
        <div class="space-y-4">
          <% questions.forEach((q, idx) => { %>
            <div class="card space-y-4" style="--i: <%= Math.min(idx + 3, 8) %>;">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-start gap-3.5">
                  <span class="w-7 h-7 rounded-[6px] bg-[var(--accent-primary)] text-white flex items-center justify-center text-xs font-bold shrink-0 mt-0.5 shadow-sm font-['Space_Grotesk']">
                    <%= idx + 1 %>
                  </span>
                  <h3 class="card-title text-[#111318] leading-snug text-base"><%= q.question %></h3>
                </div>

                <form action="/admin/quiz/<%= quiz.id %>/questions/delete/<%= q.id %>" method="POST" onsubmit="return confirm('Delete this question?');">
                  <button type="submit" class="p-2 rounded-[8px] text-[#8B8F99] hover:text-[var(--danger)] hover:bg-[rgba(255,71,87,0.1)] transition-colors text-xs" title="Delete Question">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </form>
              </div>

              <!-- Options Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs pt-2">
                <div class="p-3 rounded-[8px] <%= q.correct_option === 'a' ? 'bg-[rgba(46,213,115,0.1)] border border-[#A7F3D0] text-[#111318] font-medium' : 'bg-[#FFFFFF] border border-[#E5E7EB] text-[#5B5F6B]' %>">
                  <span class="font-bold text-[var(--accent-primary)] mr-1 font-['Space_Grotesk']">A:</span> <%= q.option_a %>
                  <% if (q.correct_option === 'a') { %><span class="ml-1 text-[11px] text-[var(--success)] font-bold">✓ Correct</span><% } %>
                </div>
                <div class="p-3 rounded-[8px] <%= q.correct_option === 'b' ? 'bg-[rgba(46,213,115,0.1)] border border-[#A7F3D0] text-[#111318] font-medium' : 'bg-[#FFFFFF] border border-[#E5E7EB] text-[#5B5F6B]' %>">
                  <span class="font-bold text-[var(--accent-primary)] mr-1 font-['Space_Grotesk']">B:</span> <%= q.option_b %>
                  <% if (q.correct_option === 'b') { %><span class="ml-1 text-[11px] text-[var(--success)] font-bold">✓ Correct</span><% } %>
                </div>
                <div class="p-3 rounded-[8px] <%= q.correct_option === 'c' ? 'bg-[rgba(46,213,115,0.1)] border border-[#A7F3D0] text-[#111318] font-medium' : 'bg-[#FFFFFF] border border-[#E5E7EB] text-[#5B5F6B]' %>">
                  <span class="font-bold text-[var(--accent-primary)] mr-1 font-['Space_Grotesk']">C:</span> <%= q.option_c %>
                  <% if (q.correct_option === 'c') { %><span class="ml-1 text-[11px] text-[var(--success)] font-bold">✓ Correct</span><% } %>
                </div>
                <div class="p-3 rounded-[8px] <%= q.correct_option === 'd' ? 'bg-[rgba(46,213,115,0.1)] border border-[#A7F3D0] text-[#111318] font-medium' : 'bg-[#FFFFFF] border border-[#E5E7EB] text-[#5B5F6B]' %>">
                  <span class="font-bold text-[var(--accent-primary)] mr-1 font-['Space_Grotesk']">D:</span> <%= q.option_d %>
                  <% if (q.correct_option === 'd') { %><span class="ml-1 text-[11px] text-[var(--success)] font-bold">✓ Correct</span><% } %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="card py-12 text-center text-[#8B8F99]">
          <div class="w-12 h-12 rounded-[12px] bg-[#FFFFFF] text-[#8B8F99] flex items-center justify-center text-xl mx-auto mb-3 border border-[#E5E7EB]">
            <i class="fa-solid fa-file-circle-plus"></i>
          </div>
          <p class="font-bold text-[#111318] text-sm">No questions added yet</p>
          <p class="text-xs text-[#5B5F6B] max-w-sm mx-auto mt-1">Click 'Add MCQ Question' above to insert question items and options.</p>
        </div>
      <% } %>
    </div>

    <!-- Right 1 Col: Student Attempts -->
    <div class="space-y-6">
      <div class="flex items-start gap-3.5 px-1">
        <div class="w-10 h-10 rounded-[8px] bg-[#F0EDFD] text-[var(--accent-primary)] flex items-center justify-center text-base shrink-0 mt-0.5 border border-[var(--border-subtle)]">
          <i class="fa-solid fa-users-viewfinder"></i>
        </div>
        <div>
          <h2 class="section-title">Student Attempts</h2>
          <p class="text-muted-desc"><%= attempts.length %> recorded submissions</p>
        </div>
      </div>

      <div class="card p-5 overflow-hidden" style="--i: 3;">
        <% if (attempts && attempts.length > 0) { %>
          <div class="divide-y divide-[#E5E7EB] text-xs">
            <% attempts.forEach(att => { %>
              <div class="py-3.5 flex items-center justify-between">
                <div>
                  <h3 class="card-title text-[#111318] text-sm"><%= att.student_name %></h3>
                  <p class="text-[#8B8F99] font-medium text-xs mt-0.5"><%= att.roll_no %> • <%= att.attempted_at %></p>
                </div>
                <div class="text-right">
                  <span class="font-bold text-[#111318] text-sm font-['Space_Grotesk']"><%= att.score %> / <%= att.total %></span>
                  <span class="block text-xs font-semibold <%= att.percentage >= 50 ? 'text-[var(--success)]' : 'text-[var(--danger)]' %> mt-0.5">
                    <%= att.percentage %>%
                  </span>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="py-10 text-center text-[#8B8F99]">
            <p class="font-bold text-[#111318] text-xs">No student attempts logged</p>
            <p class="text-xs text-[#5B5F6B] mt-0.5">Results will show here as students complete the quiz.</p>
          </div>
        <% } %>
      </div>
    </div>

  </div>

</div>

<!-- Modal: Add MCQ Question (Scale 0.95->1 + Fade 250ms) -->
<div id="add-question-modal" class="modal-backdrop hidden">
  <div class="modal-panel max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-lg font-bold text-[#111318] font-['Space_Grotesk']">Add MCQ Question</h3>
      <button type="button" onclick="closeModal('add-question-modal')" class="text-[#5B5F6B] hover:text-[#111318]">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form action="/admin/quiz/<%= quiz.id %>/questions/add" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Question Statement *</label>
        <textarea name="question" required rows="2" placeholder="e.g. Which layer of OSI model does TCP belong to?" class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]"></textarea>
      </div>

      <div class="space-y-2.5">
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B]">Answer Options *</label>
        <div class="flex items-center gap-2">
          <span class="w-6 text-xs font-bold text-[var(--accent-primary)] font-['Space_Grotesk']">A</span>
          <input type="text" name="option_a" required placeholder="Option A text" class="flex-1 px-3 py-2 text-xs bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
        </div>
        <div class="flex items-center gap-2">
          <span class="w-6 text-xs font-bold text-[var(--accent-primary)] font-['Space_Grotesk']">B</span>
          <input type="text" name="option_b" required placeholder="Option B text" class="flex-1 px-3 py-2 text-xs bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
        </div>
        <div class="flex items-center gap-2">
          <span class="w-6 text-xs font-bold text-[var(--accent-primary)] font-['Space_Grotesk']">C</span>
          <input type="text" name="option_c" required placeholder="Option C text" class="flex-1 px-3 py-2 text-xs bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
        </div>
        <div class="flex items-center gap-2">
          <span class="w-6 text-xs font-bold text-[var(--accent-primary)] font-['Space_Grotesk']">D</span>
          <input type="text" name="option_d" required placeholder="Option D text" class="flex-1 px-3 py-2 text-xs bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Correct Answer Option *</label>
        <select name="correct_option" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318] font-bold">
          <option value="a">Option A</option>
          <option value="b">Option B</option>
          <option value="c">Option C</option>
          <option value="d">Option D</option>
        </select>
      </div>

      <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E5E7EB]">
        <button type="button" onclick="closeModal('add-question-modal')" class="btn-secondary py-2 px-4 text-xs font-medium">
          Cancel
        </button>
        <button type="submit" class="btn-primary py-2 px-5 text-xs font-semibold">
          Save Question
        </button>
      </div>
    </form>
  </div>
</div>
