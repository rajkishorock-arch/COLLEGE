<div class="space-y-[48px]">

  <!-- Header -->
  <div class="card" style="--i: 1;">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold badge-accent mb-2">
          <i class="fa-solid fa-credit-card"></i>
          <span>Financial Administration</span>
        </div>
        <h1 class="page-title text-[#111318]">Student Fee Management</h1>
        <p class="body-text mt-1.5 text-sm">Issue semester tuition dues, record offline drafts or transactions, and monitor outstanding departmental balances</p>
      </div>

      <button type="button" onclick="openModal('create-fee-modal')" class="btn-primary py-2.5 px-5 text-xs font-semibold flex items-center gap-2">
        <i class="fa-solid fa-plus"></i>
        <span>Assign Student Fee</span>
      </button>
    </div>

    <!-- Summary Metrics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 mt-6 border-t border-[#E5E7EB]">
      <div class="p-4 rounded-[10px] bg-[#FFFFFF] border border-[#E5E7EB]">
        <div class="text-[11px] font-semibold uppercase text-[#5B5F6B]">Total Tuition Invoiced</div>
        <div class="text-xl sm:text-2xl font-bold text-[#111318] font-['Space_Grotesk'] mt-1">
          ₹<%= totalDue.toLocaleString('en-IN') %>
        </div>
      </div>
      <div class="p-4 rounded-[10px] bg-[#FFFFFF] border border-[#E5E7EB]">
        <div class="text-[11px] font-semibold uppercase text-[var(--success)]">Total Revenue Collected</div>
        <div class="text-xl sm:text-2xl font-bold text-[var(--success)] font-['Space_Grotesk'] mt-1">
          ₹<%= totalCollected.toLocaleString('en-IN') %>
        </div>
      </div>
      <div class="p-4 rounded-[10px] bg-[#FFFFFF] border border-[#E5E7EB]">
        <div class="text-[11px] font-semibold uppercase text-[var(--warning)]">Pending Student Invoices</div>
        <div class="text-xl sm:text-2xl font-bold text-[var(--warning)] font-['Space_Grotesk'] mt-1">
          <%= pendingCount %> Records
        </div>
      </div>
    </div>
  </div>

  <!-- Fee Ledger Table -->
  <div class="card p-0 overflow-hidden" style="--i: 2;">
    <div class="p-[28px] border-b border-[#E5E7EB] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-[8px] bg-[#F0EDFD] text-[var(--accent-primary)] flex items-center justify-center text-base shrink-0 border border-[var(--border-subtle)]">
          <i class="fa-solid fa-receipt"></i>
        </div>
        <div>
          <h2 class="section-title">Institutional Invoices & Fee Status</h2>
          <p class="text-muted-desc"><%= fees.length %> student invoices tracked</p>
        </div>
      </div>

      <!-- Filters -->
      <form method="GET" action="/admin/fees" class="flex items-center gap-2.5">
        <select name="status" class="px-3 py-1.5 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-xs text-[#111318]" onchange="this.form.submit()">
          <option value="">All Payment States</option>
          <option value="Paid" <%= selectedStatus === 'Paid' ? 'selected' : '' %>>Paid Only</option>
          <option value="Pending" <%= selectedStatus === 'Pending' ? 'selected' : '' %>>Pending Dues</option>
          <option value="Partial" <%= selectedStatus === 'Partial' ? 'selected' : '' %>>Partial Dues</option>
        </select>
        <select name="term" class="px-3 py-1.5 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-xs text-[#111318]" onchange="this.form.submit()">
          <option value="">All Academic Terms</option>
          <option value="Semester 1" <%= selectedTerm === 'Semester 1' ? 'selected' : '' %>>Semester 1</option>
          <option value="Semester 2" <%= selectedTerm === 'Semester 2' ? 'selected' : '' %>>Semester 2</option>
          <option value="Semester 3" <%= selectedTerm === 'Semester 3' ? 'selected' : '' %>>Semester 3</option>
          <option value="Semester 4" <%= selectedTerm === 'Semester 4' ? 'selected' : '' %>>Semester 4</option>
          <option value="Semester 5" <%= selectedTerm === 'Semester 5' ? 'selected' : '' %>>Semester 5</option>
          <option value="Semester 6" <%= selectedTerm === 'Semester 6' ? 'selected' : '' %>>Semester 6</option>
        </select>
      </form>
    </div>

    <div class="overflow-x-auto">
      <table class="table-comfortable">
        <thead>
          <tr>
            <th>Student Details</th>
            <th>Term</th>
            <th>Amount Due</th>
            <th>Amount Paid</th>
            <th>Due Date</th>
            <th class="text-center">Status</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#E5E7EB]">
          <% if (fees && fees.length > 0) { %>
            <% fees.forEach(fee => { %>
              <tr class="hover:bg-[#F7F7F9]/50 transition-colors">
                <td>
                  <div class="font-semibold text-[#111318] text-xs"><%= fee.student_name %></div>
                  <div class="text-[11px] text-[#8B8F99]"><%= fee.roll_no %> • <%= fee.course %></div>
                </td>
                <td class="font-medium text-[#111318] text-xs">
                  <%= fee.term %>
                </td>
                <td class="font-bold text-[#111318] text-xs font-['Space_Grotesk']">
                  ₹<%= fee.amount_due.toLocaleString('en-IN') %>
                </td>
                <td class="font-bold text-[var(--success)] text-xs font-['Space_Grotesk']">
                  ₹<%= fee.amount_paid.toLocaleString('en-IN') %>
                </td>
                <td class="text-xs text-[#5B5F6B]">
                  <%= fee.due_date || '—' %>
                </td>
                <td class="text-center">
                  <span class="status-pill text-xs font-semibold <%= fee.status === 'Paid' ? 'badge-success' : fee.status === 'Partial' ? 'badge-warning' : 'badge-danger' %>">
                    <%= fee.status %>
                  </span>
                </td>
                <td class="text-right">
                  <% if (fee.status !== 'Paid') { %>
                    <form action="/admin/fees/mark-paid/<%= fee.id %>" method="POST" class="inline">
                      <button type="submit" class="btn-primary py-1 px-3 text-xs font-semibold">
                        <i class="fa-solid fa-check text-[10px]"></i>
                        <span>Mark Paid</span>
                      </button>
                    </form>
                  <% } else { %>
                    <span class="text-xs text-[var(--success)] font-mono">Paid <%= fee.paid_at ? fee.paid_at.substring(0, 10) : '✓' %></span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" class="py-12 text-center text-[#8B8F99]">
                <p class="font-bold text-[#111318] text-sm">No Fee Records Found</p>
                <p class="text-xs text-[#5B5F6B] max-w-sm mx-auto mt-1">Use the "Assign Student Fee" button to create tuition invoices.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Modal: Assign Fee -->
<div id="create-fee-modal" class="modal-backdrop">
  <div class="modal-panel">
    <div class="flex items-center justify-between pb-4 border-b border-[#E5E7EB]">
      <h3 class="card-title text-[#111318] flex items-center gap-2">
        <i class="fa-solid fa-receipt text-[var(--accent-primary)]"></i>
        <span>Assign Tuition Invoice</span>
      </h3>
      <button type="button" onclick="closeModal('create-fee-modal')" class="text-[#5B5F6B] hover:text-[#111318] text-lg">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form action="/admin/fees/create" method="POST" class="space-y-4 pt-4">
      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Enrolled Student *</label>
        <select name="student_id" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
          <% students.forEach(st => { %>
            <option value="<%= st.id %>"><%= st.name %> (<%= st.roll_no %> - <%= st.course %>)</option>
          <% }); %>
        </select>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Academic Term *</label>
          <select name="term" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
            <option value="Semester 1">Semester 1</option>
            <option value="Semester 2">Semester 2</option>
            <option value="Semester 3">Semester 3</option>
            <option value="Semester 4">Semester 4</option>
            <option value="Semester 5">Semester 5</option>
            <option value="Semester 6" selected>Semester 6</option>
            <option value="Semester 7">Semester 7</option>
            <option value="Semester 8">Semester 8</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Amount Due (INR ₹) *</label>
          <input type="number" name="amount_due" required min="1000" step="500" value="45000" class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Payment Deadline Due Date</label>
        <input type="date" name="due_date" class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
      </div>

      <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E5E7EB]">
        <button type="button" onclick="closeModal('create-fee-modal')" class="btn-secondary py-2 px-4 text-xs font-medium">
          Cancel
        </button>
        <button type="submit" class="btn-primary py-2 px-5 text-xs font-semibold">
          Issue Invoice
        </button>
      </div>
    </form>
  </div>
</div>
