<div class="space-y-6">

  <!-- Header Section with Add Button -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 fade-slide-up">
    <div>
      <div class="flex items-center gap-2">
        <span class="status-pill text-xs font-semibold bg-[#EDE9FE] text-[#6C5CE7] border border-[#DDD6FE]">
          <i class="fa-solid fa-crown text-[10px]"></i> Super Admin Exclusive
        </span>
      </div>
      <h1 class="page-title text-2xl sm:text-3xl text-[#111318] mt-2">Administrator Access Control</h1>
      <p class="body-text text-xs sm:text-sm mt-1">
        Manage administrative privileges, provision staff accounts, and control platform governance.
      </p>
    </div>

    <div>
      <button 
        type="button" 
        onclick="openModal('add-admin-modal')"
        class="btn-primary py-2.5 px-4 text-xs font-semibold flex items-center gap-2 shadow-sm"
      >
        <i class="fa-solid fa-user-plus text-xs"></i>
        <span>Provision New Admin</span>
      </button>
    </div>
  </div>

  <!-- Flash Alerts -->
  <% if (success) { %>
    <div class="p-4 rounded-[8px] bg-[#E8F8EE] border border-[var(--success)] text-[#1E9E57] text-xs sm:text-sm font-medium flex items-center gap-3 fade-slide-up">
      <i class="fa-solid fa-circle-check text-base shrink-0"></i>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="p-4 rounded-[8px] bg-[#FEECEE] border border-[var(--danger)] text-[#E5384B] text-xs sm:text-sm font-medium flex items-center gap-3 fade-slide-up">
      <i class="fa-solid fa-circle-exclamation text-base shrink-0"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Metrics / Stats Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="card p-5" style="--i: 1;">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs uppercase font-semibold tracking-wider text-[#5B5F6B]">Total Admins</p>
          <h3 class="text-2xl font-bold text-[#111318] font-['Space_Grotesk'] mt-1"><%= stats.totalAdmins %></h3>
        </div>
        <div class="w-10 h-10 rounded-[8px] bg-[#F0EDFD] text-[var(--accent-primary)] flex items-center justify-center text-lg border border-[var(--border-subtle)]">
          <i class="fa-solid fa-users-gear"></i>
        </div>
      </div>
      <p class="text-[11px] text-[#8B8F99] mt-3">Governance accounts</p>
    </div>

    <div class="card p-5" style="--i: 2;">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs uppercase font-semibold tracking-wider text-[#5B5F6B]">Super Admins</p>
          <h3 class="text-2xl font-bold text-[#6C5CE7] font-['Space_Grotesk'] mt-1"><%= stats.superAdminCount %></h3>
        </div>
        <div class="w-10 h-10 rounded-[8px] bg-[#EDE9FE] text-[#6C5CE7] flex items-center justify-center text-lg border border-[#DDD6FE]">
          <i class="fa-solid fa-crown"></i>
        </div>
      </div>
      <p class="text-[11px] text-[#8B8F99] mt-3">Full institutional control</p>
    </div>

    <div class="card p-5" style="--i: 3;">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs uppercase font-semibold tracking-wider text-[#5B5F6B]">Admin Staff</p>
          <h3 class="text-2xl font-bold text-[#E67E22] font-['Space_Grotesk'] mt-1"><%= stats.staffAdminCount %></h3>
        </div>
        <div class="w-10 h-10 rounded-[8px] bg-[#FEF6E7] text-[var(--warning)] flex items-center justify-center text-lg border border-[#FDE68A]">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
      </div>
      <p class="text-[11px] text-[#8B8F99] mt-3">Academic & operational staff</p>
    </div>

    <div class="card p-5" style="--i: 4;">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs uppercase font-semibold tracking-wider text-[#5B5F6B]">Active Accounts</p>
          <h3 class="text-2xl font-bold text-[#1E9E57] font-['Space_Grotesk'] mt-1"><%= stats.activeCount %></h3>
        </div>
        <div class="w-10 h-10 rounded-[8px] bg-[#E8F8EE] text-[var(--success)] flex items-center justify-center text-lg border border-[#BBF7D0]">
          <i class="fa-solid fa-user-check"></i>
        </div>
      </div>
      <p class="text-[11px] text-[#8B8F99] mt-3"><%= stats.totalAdmins - stats.activeCount %> deactivated</p>
    </div>
  </div>

  <!-- Role Hierarchy Security Notice -->
  <div class="p-4 rounded-[12px] bg-[#F7F7F9] border border-[#E5E7EB] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-[#5B5F6B]">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-[#EDE9FE] text-[#6C5CE7] flex items-center justify-center shrink-0">
        <i class="fa-solid fa-lock"></i>
      </div>
      <div>
        <span class="font-semibold text-[#111318]">Two-Tier Access Policy:</span>
        Staff Admins can perform daily operations (attendance, marks, library, quizzes) but cannot alter admin rosters. Only Super Admins can provision or deactivate admin credentials.
      </div>
    </div>
    <span class="text-[11px] font-mono text-[#8B8F99] shrink-0">Enforced by Server Guard</span>
  </div>

  <!-- Administrators Table -->
  <div class="card p-0 overflow-hidden fade-slide-up" style="--i: 2;">
    <div class="px-6 py-4 border-b border-[#E5E7EB] flex items-center justify-between bg-[#FAFAFB]">
      <h3 class="text-base font-bold text-[#111318] font-['Space_Grotesk']">System Administrators Directory</h3>
      <span class="text-xs text-[#8B8F99] font-medium"><%= admins.length %> total records</span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-[#E5E7EB] text-[11px] uppercase tracking-wider text-[#8B8F99] bg-[#FAFAFB]">
            <th class="py-3 px-6 font-semibold">Administrator</th>
            <th class="py-3 px-6 font-semibold">Role Tier</th>
            <th class="py-3 px-6 font-semibold">Account Status</th>
            <th class="py-3 px-6 font-semibold">Security State</th>
            <th class="py-3 px-6 font-semibold">Provisioned</th>
            <th class="py-3 px-6 font-semibold text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#E5E7EB] text-xs">
          <% admins.forEach(adm => { %>
            <tr class="hover:bg-[#F7F7F9] transition-colors <%= adm.id === currentUserId ? 'bg-[#F0EDFD]/20' : '' %>">
              <td class="py-4 px-6">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-[8px] <%= adm.role === 'super_admin' ? 'bg-[#EDE9FE] text-[#6C5CE7]' : 'bg-[#FEF6E7] text-[#E67E22]' %> flex items-center justify-center font-bold text-xs shrink-0">
                    <i class="fa-solid <%= adm.role === 'super_admin' ? 'fa-crown' : 'fa-user-shield' %>"></i>
                  </div>
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="font-semibold text-[#111318]"><%= adm.name %></span>
                      <% if (adm.id === currentUserId) { %>
                        <span class="status-pill text-[10px] py-0.5 px-1.5 font-bold bg-[#EDE9FE] text-[#6C5CE7]">You</span>
                      <% } %>
                    </div>
                    <p class="text-[11px] text-[#5B5F6B]"><%= adm.email %></p>
                  </div>
                </div>
              </td>

              <td class="py-4 px-6">
                <% if (adm.role === 'super_admin') { %>
                  <span class="status-pill text-xs font-semibold bg-[#EDE9FE] text-[#6C5CE7] border border-[#DDD6FE]">
                    <i class="fa-solid fa-crown text-[10px]"></i> Super Admin
                  </span>
                <% } else { %>
                  <span class="status-pill text-xs font-semibold badge-warning">
                    <i class="fa-solid fa-shield-halved text-[10px]"></i> Admin (Staff)
                  </span>
                <% } %>
              </td>

              <td class="py-4 px-6">
                <% if (adm.is_active === 1) { %>
                  <span class="status-pill text-xs font-semibold badge-success">
                    <i class="fa-solid fa-circle text-[6px]"></i> Active
                  </span>
                <% } else { %>
                  <span class="status-pill text-xs font-semibold badge-danger">
                    <i class="fa-solid fa-ban text-[10px]"></i> Deactivated
                  </span>
                <% } %>
              </td>

              <td class="py-4 px-6">
                <% if (adm.locked_until && new Date(adm.locked_until) > new Date()) { %>
                  <span class="status-pill text-xs font-semibold badge-danger" title="Locked until <%= adm.locked_until %>">
                    <i class="fa-solid fa-lock text-[10px]"></i> Locked (Brute Force)
                  </span>
                <% } else if (adm.failed_attempts > 0) { %>
                  <span class="text-[11px] text-[var(--warning)] font-medium">
                    <%= adm.failed_attempts %>/5 failed attempts
                  </span>
                <% } else { %>
                  <span class="text-[11px] text-[#1E9E57] font-medium flex items-center gap-1">
                    <i class="fa-solid fa-circle-check text-[10px]"></i> Verified Secure
                  </span>
                <% } %>
              </td>

              <td class="py-4 px-6 text-[#5B5F6B] font-mono text-[11px]">
                <%= adm.created_at ? new Date(adm.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Initial Seed' %>
              </td>

              <td class="py-4 px-6 text-right">
                <% if (adm.id === currentUserId) { %>
                  <span class="text-[11px] text-[#8B8F99] italic">Self Protected</span>
                <% } else { %>
                  <div class="flex items-center justify-end gap-2">
                    
                    <!-- Deactivate / Activate Button -->
                    <form action="/admin/manage-admins/toggle-status/<%= adm.id %>" method="POST" class="inline">
                      <button 
                        type="submit"
                        class="px-2.5 py-1.5 rounded-[6px] border text-xs font-semibold transition-all flex items-center gap-1.5 <%= adm.is_active === 1 ? 'border-[#E5E7EB] hover:bg-[#FEECEE] text-[#E5384B]' : 'border-[var(--success)] bg-[#E8F8EE] text-[#1E9E57] hover:bg-[#D1F2DE]' %>"
                        onclick="return confirm('<%= adm.is_active === 1 ? 'Deactivating this admin will prevent them from signing in. Past records will remain intact. Proceed?' : 'Reactivate this admin account?' %>');"
                      >
                        <i class="fa-solid <%= adm.is_active === 1 ? 'fa-user-slash' : 'fa-user-check' %>"></i>
                        <span><%= adm.is_active === 1 ? 'Deactivate' : 'Reactivate' %></span>
                      </button>
                    </form>

                    <!-- Delete Button -->
                    <form action="/admin/manage-admins/delete/<%= adm.id %>" method="POST" class="inline">
                      <button 
                        type="submit"
                        class="p-1.5 rounded-[6px] text-[#8B8F99] hover:text-[var(--danger)] hover:bg-[#FEECEE] transition-colors"
                        title="Delete Admin Account"
                        onclick="return confirm('Permanently delete <%= adm.name %>? This cannot be undone.');"
                      >
                        <i class="fa-solid fa-trash-can text-xs"></i>
                      </button>
                    </form>

                  </div>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Modal: Provision New Admin -->
<div id="add-admin-modal" class="modal-backdrop hidden">
  <div class="modal-panel max-w-lg">
    <div class="flex items-center justify-between mb-5">
      <div>
        <h3 class="text-lg font-bold text-[#111318] font-['Space_Grotesk']">Provision Administrator Account</h3>
        <p class="text-xs text-[#5B5F6B] mt-0.5">Create a verified administrative or operational staff credential</p>
      </div>
      <button type="button" onclick="closeModal('add-admin-modal')" class="text-[#5B5F6B] hover:text-[#111318]">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form action="/admin/manage-admins/add" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Full Name *</label>
        <input 
          type="text" 
          name="name" 
          required 
          placeholder="e.g. Dr. Arthur Vance"
          class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318] focus:border-[var(--accent-primary)] focus:outline-none"
        >
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Official Email *</label>
        <input 
          type="email" 
          name="email" 
          required 
          placeholder="e.g. arthur.vance@college.edu"
          class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318] focus:border-[var(--accent-primary)] focus:outline-none"
        >
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Initial Password * (Min 6 characters)</label>
        <input 
          type="password" 
          name="password" 
          required 
          minlength="6"
          placeholder="••••••••••••"
          class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318] focus:border-[var(--accent-primary)] focus:outline-none"
        >
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Role Tier Assignment *</label>
        <select 
          name="role" 
          required 
          class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318] focus:border-[var(--accent-primary)] focus:outline-none"
        >
          <option value="admin">Administrator (Staff) — Day-to-day operations (Attendance, Results, Library, Quizzes)</option>
          <option value="super_admin">Super Administrator — Full governance + Create/deactivate admins</option>
        </select>
        <p class="text-[11px] text-[#8B8F99] mt-1.5">
          Regular admins cannot manage other admin accounts or escalate their own privileges.
        </p>
      </div>

      <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E5E7EB]">
        <button type="button" onclick="closeModal('add-admin-modal')" class="btn-secondary py-2 px-4 text-xs font-medium">
          Cancel
        </button>
        <button type="submit" class="btn-primary py-2 px-5 text-xs font-semibold">
          Create Account
        </button>
      </div>
    </form>
  </div>
</div>
