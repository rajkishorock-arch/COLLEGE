<div class="space-y-[48px]">

  <!-- Header -->
  <div class="card" style="--i: 1;">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold badge-accent mb-2">
          <i class="fa-solid fa-calendar-days"></i>
          <span>Academic Scheduling</span>
        </div>
        <h1 class="page-title text-[#111318]">Course Timetable Management</h1>
        <p class="body-text mt-1.5 text-sm">Configure weekly classroom sessions, lecture timings, and room assignments per academic department</p>
      </div>

      <button type="button" onclick="openModal('add-slot-modal')" class="btn-primary py-2.5 px-5 text-xs font-semibold flex items-center gap-2">
        <i class="fa-solid fa-plus"></i>
        <span>Add Timetable Slot</span>
      </button>
    </div>

    <!-- Course Filter -->
    <form method="GET" action="/admin/timetable" class="pt-6 mt-6 border-t border-[#E5E7EB] flex flex-col sm:flex-row sm:items-center gap-4">
      <label class="text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] whitespace-nowrap">Filter By Enrolled Program:</label>
      <select name="course" class="px-4 py-2 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-xs font-medium text-[#111318] focus:border-[var(--accent-primary)] max-w-xs" onchange="this.form.submit()">
        <% courses.forEach(c => { %>
          <option value="<%= c %>" <%= selectedCourse === c ? 'selected' : '' %>><%= c %></option>
        <% }); %>
      </select>
    </form>
  </div>

  <!-- Weekly Timetable Schedule Table -->
  <div class="card p-0 overflow-hidden" style="--i: 2;">
    <div class="p-[28px] border-b border-[#E5E7EB] flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-[8px] bg-[#F0EDFD] text-[var(--accent-primary)] flex items-center justify-center text-base shrink-0 border border-[var(--border-subtle)]">
          <i class="fa-solid fa-table-cells-large"></i>
        </div>
        <div>
          <h2 class="section-title"><%= selectedCourse %> Schedule</h2>
          <p class="text-muted-desc"><%= slots.length %> scheduled lecture blocks</p>
        </div>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="table-comfortable">
        <thead>
          <tr>
            <th>Day of Week</th>
            <th>Timing</th>
            <th>Subject</th>
            <th>Room / Lab</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#E5E7EB]">
          <% if (slots && slots.length > 0) { %>
            <% slots.forEach(slot => { %>
              <tr class="hover:bg-[#F7F7F9]/50 transition-colors">
                <td class="font-bold text-[#111318] text-xs font-['Space_Grotesk']">
                  <span class="px-2.5 py-1 rounded-[6px] bg-[#FFFFFF] border border-[#E5E7EB]">
                    <%= slot.day_of_week %>
                  </span>
                </td>
                <td class="text-xs font-mono text-[var(--accent-primary)]">
                  <%= slot.start_time %> - <%= slot.end_time %>
                </td>
                <td class="font-semibold text-[#111318] text-xs">
                  <%= slot.subject %>
                </td>
                <td class="text-xs text-[#5B5F6B]">
                  <i class="fa-solid fa-door-open text-[10px] text-[#8B8F99] mr-1"></i>
                  <%= slot.room || 'Classroom' %>
                </td>
                <td class="text-right">
                  <form action="/admin/timetable/delete/<%= slot.id %>" method="POST" class="inline" onsubmit="return confirm('Remove this slot from timetable?');">
                    <button type="submit" class="text-[var(--danger)] hover:underline text-xs font-medium">
                      Remove
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="py-12 text-center text-[#8B8F99]">
                <p class="font-bold text-[#111318] text-sm">No Class Sessions Scheduled</p>
                <p class="text-xs text-[#5B5F6B] max-w-sm mx-auto mt-1">Use the "Add Timetable Slot" button to populate the weekly lecture schedule.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Modal: Add Slot -->
<div id="add-slot-modal" class="modal-backdrop">
  <div class="modal-panel">
    <div class="flex items-center justify-between pb-4 border-b border-[#E5E7EB]">
      <h3 class="card-title text-[#111318] flex items-center gap-2">
        <i class="fa-solid fa-calendar-plus text-[var(--accent-primary)]"></i>
        <span>Add Weekly Lecture Slot</span>
      </h3>
      <button type="button" onclick="closeModal('add-slot-modal')" class="text-[#5B5F6B] hover:text-[#111318] text-lg">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form action="/admin/timetable/create" method="POST" class="space-y-4 pt-4">
      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Academic Program *</label>
        <select name="course" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
          <% courses.forEach(c => { %>
            <option value="<%= c %>" <%= selectedCourse === c ? 'selected' : '' %>><%= c %></option>
          <% }); %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Subject *</label>
        <select name="subject" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
          <% subjects.forEach(s => { %>
            <option value="<%= s %>"><%= s %></option>
          <% }); %>
        </select>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Day *</label>
          <select name="day_of_week" required class="w-full px-3 py-2 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
            <option value="Monday">Monday</option>
            <option value="Tuesday">Tuesday</option>
            <option value="Wednesday">Wednesday</option>
            <option value="Thursday">Thursday</option>
            <option value="Friday">Friday</option>
            <option value="Saturday">Saturday</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Start Time *</label>
          <input type="time" name="start_time" required value="09:00" class="w-full px-3 py-2 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">End Time *</label>
          <input type="time" name="end_time" required value="10:30" class="w-full px-3 py-2 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Room / Lab Hall</label>
        <input type="text" name="room" placeholder="e.g. Hall A-101 or Lab CS-2" class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
      </div>

      <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E5E7EB]">
        <button type="button" onclick="closeModal('add-slot-modal')" class="btn-secondary py-2 px-4 text-xs font-medium">
          Cancel
        </button>
        <button type="submit" class="btn-primary py-2 px-5 text-xs font-semibold">
          Add Slot to Schedule
        </button>
      </div>
    </form>
  </div>
</div>
