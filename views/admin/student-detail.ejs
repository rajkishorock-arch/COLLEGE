<!-- Student 360 Profile (Admin View - Exact Dark Theme Spec) -->
<div class="space-y-[48px]">

  <!-- Breadcrumb & Back -->
  <div class="flex items-center justify-between" style="--i: 1;">
    <a href="/admin/students" class="inline-flex items-center gap-2 text-xs font-semibold text-[#5B5F6B] hover:text-[#111318] transition-colors">
      <i class="fa-solid fa-arrow-left"></i>
      <span>Back to Student Directory</span>
    </a>
    <span class="status-pill text-xs font-semibold badge-accent">
      Academic Record 360°
    </span>
  </div>

  <!-- Student Hero Profile Card -->
  <div class="card flex flex-col md:flex-row md:items-center justify-between gap-6" style="--i: 2;">
    <div class="flex items-center gap-5">
      <div class="w-16 h-16 rounded-[12px] bg-[var(--accent-primary)] text-white flex items-center justify-center font-bold text-2xl shadow-lg shadow-[var(--accent-glow)] shrink-0 font-['Space_Grotesk']">
        <%= student.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() %>
      </div>
      <div>
        <h1 class="page-title text-[#111318]"><%= student.name %></h1>
        <div class="flex flex-wrap items-center gap-3 mt-2 text-xs text-[#5B5F6B]">
          <span class="font-bold text-[#111318] px-2.5 py-1 rounded-[6px] bg-[#FFFFFF] border border-[#E5E7EB] font-['Space_Grotesk']"><%= student.roll_no %></span>
          <span>•</span>
          <span class="font-medium text-[#111318]"><%= student.course %></span>
          <span>•</span>
          <span class="text-[#8B8F99]"><%= student.email %></span>
        </div>
      </div>
    </div>

    <!-- Attendance Meter Widget -->
    <div class="flex items-center gap-4 bg-[#FFFFFF] p-4 rounded-[8px] border border-[#E5E7EB] shrink-0">
      <div class="text-right">
        <span class="stat-label text-[#8B8F99] block mb-1">Attendance Rate</span>
        <span class="metric-number <%= overallAttendance >= 75 ? 'text-[var(--success)]' : 'text-[var(--danger)]' %>">
          <%= overallAttendance %>%
        </span>
      </div>
      <div class="w-12 h-12 rounded-[8px] <%= overallAttendance >= 75 ? 'bg-[#E8F8EE] text-[var(--success)] border border-[#A7F3D0]' : 'bg-[#FEECEE] text-[var(--danger)] border border-[#FECDD3]' %> flex items-center justify-center text-xl shrink-0">
        <i class="fa-solid <%= overallAttendance >= 75 ? 'fa-circle-check' : 'fa-triangle-exclamation' %>"></i>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-[20px]">
    
    <!-- Left Column: Attendance & Results -->
    <div class="space-y-[48px]">
      
      <!-- Subject Attendance Breakdown -->
      <div class="card" style="--i: 3;">
        <div class="flex items-start gap-3.5 mb-6">
          <div class="w-10 h-10 rounded-[8px] bg-[#F0EDFD] text-[var(--accent-primary)] flex items-center justify-center text-base shrink-0 mt-0.5 border border-[var(--border-subtle)]">
            <i class="fa-solid fa-list-check"></i>
          </div>
          <div>
            <h2 class="section-title">Subject Attendance Breakdown</h2>
            <p class="text-muted-desc">Course module attendance percentages and hours</p>
          </div>
        </div>

        <% if (attendanceStats && attendanceStats.length > 0) { %>
          <div class="space-y-3.5">
            <% attendanceStats.forEach(subj => { %>
              <div class="p-4 rounded-[8px] bg-[#FFFFFF] border border-[#E5E7EB]">
                <div class="flex items-center justify-between text-xs mb-2">
                  <span class="font-semibold text-[#111318] text-sm"><%= subj.subject %></span>
                  <span class="font-bold font-['Space_Grotesk'] <%= subj.percentage >= 75 ? 'text-[var(--success)]' : 'text-[var(--danger)]' %>">
                    <%= subj.attended %> / <%= subj.total %> (<%= subj.percentage %>%)
                  </span>
                </div>
                <div class="w-full bg-[#FFFFFF] h-2 rounded-full overflow-hidden border border-[#E5E7EB]">
                  <div 
                    class="h-full rounded-full transition-all duration-700 <%= subj.percentage >= 75 ? 'bg-[var(--success)]' : 'bg-[var(--danger)]' %>" 
                    style="width: <%= Math.min(subj.percentage, 100) %>%;"
                  ></div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="py-10 text-center text-[#8B8F99]">
            <div class="w-10 h-10 rounded-[8px] bg-[#FFFFFF] text-[#8B8F99] flex items-center justify-center text-base mx-auto mb-2 border border-[#E5E7EB]">
              <i class="fa-solid fa-calendar-xmark"></i>
            </div>
            <p class="font-bold text-[#111318] text-xs">No attendance recorded yet</p>
            <p class="text-xs text-[#5B5F6B] mt-0.5">Faculty has not logged sessions for this student.</p>
          </div>
        <% } %>
      </div>

      <!-- Examination Results -->
      <div class="card" style="--i: 4;">
        <div class="flex items-start gap-3.5 mb-6">
          <div class="w-10 h-10 rounded-[8px] bg-[#F0EDFD] text-[var(--accent-primary)] flex items-center justify-center text-base shrink-0 mt-0.5 border border-[var(--border-subtle)]">
            <i class="fa-solid fa-award"></i>
          </div>
          <div>
            <h2 class="section-title">Academic Results</h2>
            <p class="text-muted-desc">Semester exam evaluations and assigned letter grades</p>
          </div>
        </div>

        <% if (results && results.length > 0) { %>
          <div class="divide-y divide-[#E5E7EB]">
            <% results.forEach(res => { %>
              <div class="py-3.5 flex items-center justify-between text-xs">
                <div>
                  <h3 class="card-title text-[#111318] text-sm"><%= res.subject %></h3>
                  <span class="text-[#8B8F99] font-medium"><%= res.exam_type %></span>
                </div>
                <div class="text-right">
                  <span class="font-bold text-[#111318] text-sm font-['Space_Grotesk']"><%= res.marks_obtained %> / <%= res.max_marks %></span>
                  <span class="ml-2 font-bold font-['Space_Grotesk'] <%= res.percentage >= 75 ? 'text-[var(--success)]' : 'text-[var(--warning)]' %>">(<%= res.percentage %>%)</span>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="py-10 text-center text-[#8B8F99]">
            <div class="w-10 h-10 rounded-[8px] bg-[#FFFFFF] text-[#8B8F99] flex items-center justify-center text-base mx-auto mb-2 border border-[#E5E7EB]">
              <i class="fa-solid fa-file-excel"></i>
            </div>
            <p class="font-bold text-[#111318] text-xs">No examination marks published</p>
            <p class="text-xs text-[#5B5F6B] mt-0.5">Official scores will show here once entered in the ledger.</p>
          </div>
        <% } %>
      </div>

    </div>

    <!-- Right Column: Library Issues & Quiz Attempts -->
    <div class="space-y-[48px]">
      
      <!-- Library History -->
      <div class="card" style="--i: 5;">
        <div class="flex items-start gap-3.5 mb-6">
          <div class="w-10 h-10 rounded-[8px] bg-[#FEF6E7] text-[var(--warning)] flex items-center justify-center text-base shrink-0 mt-0.5 border border-[var(--border-subtle)]">
            <i class="fa-solid fa-book"></i>
          </div>
          <div>
            <h2 class="section-title">Library Borrowing History</h2>
            <p class="text-muted-desc">Checked-out titles and circulation records</p>
          </div>
        </div>

        <% if (books && books.length > 0) { %>
          <div class="space-y-3.5">
            <% books.forEach(b => { %>
              <div class="p-4 rounded-[8px] border <%= b.isOverdue ? 'border-[var(--danger)] bg-[rgba(255,71,87,0.06)]' : (b.status === 'Returned' ? 'border-[#E5E7EB] bg-[#FFFFFF]' : 'border-[#DDD6FE] bg-[rgba(108,92,231,0.06)]') %> flex items-center justify-between text-xs">
                <div>
                  <h3 class="card-title text-[#111318] truncate max-w-[200px] text-sm"><%= b.title %></h3>
                  <p class="text-[#5B5F6B] mt-0.5">Due Date: <%= b.due_date %></p>
                </div>
                <div>
                  <% if (b.status === 'Returned') { %>
                    <span class="status-pill text-xs font-semibold text-[#5B5F6B] bg-[#F7F7F9] border border-[#E5E7EB]">Returned</span>
                  <% } else if (b.isOverdue) { %>
                    <span class="status-pill text-xs font-bold badge-danger">Overdue</span>
                  <% } else { %>
                    <span class="status-pill text-xs font-semibold badge-success">Active</span>
                  <% } %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="py-10 text-center text-[#8B8F99]">
            <div class="w-10 h-10 rounded-[8px] bg-[#FFFFFF] text-[#8B8F99] flex items-center justify-center text-base mx-auto mb-2 border border-[#E5E7EB]">
              <i class="fa-solid fa-book-bookmark"></i>
            </div>
            <p class="font-bold text-[#111318] text-xs">No library transactions</p>
            <p class="text-xs text-[#5B5F6B] mt-0.5">This student has not checked out any books.</p>
          </div>
        <% } %>
      </div>

      <!-- Quiz Attempts -->
      <div class="card" style="--i: 6;">
        <div class="flex items-start gap-3.5 mb-6">
          <div class="w-10 h-10 rounded-[8px] bg-[#F0EDFD] text-[var(--accent-primary)] flex items-center justify-center text-base shrink-0 mt-0.5 border border-[var(--border-subtle)]">
            <i class="fa-solid fa-lightbulb"></i>
          </div>
          <div>
            <h2 class="section-title">Quiz Test Submissions</h2>
            <p class="text-muted-desc">Completed self-assessments and auto-graded results</p>
          </div>
        </div>

        <% if (quizAttempts && quizAttempts.length > 0) { %>
          <div class="divide-y divide-[#E5E7EB]">
            <% quizAttempts.forEach(qa => { %>
              <div class="py-3.5 flex items-center justify-between text-xs">
                <div>
                  <h3 class="card-title text-[#111318] text-sm"><%= qa.quiz_title %></h3>
                  <p class="text-[#8B8F99] font-medium"><%= qa.attempted_at %></p>
                </div>
                <div class="font-bold text-[#111318] text-sm font-['Space_Grotesk']">
                  <%= qa.score %> / <%= qa.total %> (<%= Math.round((qa.score / qa.total) * 100) %>%)
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="py-10 text-center text-[#8B8F99]">
            <div class="w-10 h-10 rounded-[8px] bg-[#FFFFFF] text-[#8B8F99] flex items-center justify-center text-base mx-auto mb-2 border border-[#E5E7EB]">
              <i class="fa-solid fa-clipboard-question"></i>
            </div>
            <p class="font-bold text-[#111318] text-xs">No quiz submissions</p>
            <p class="text-xs text-[#5B5F6B] mt-0.5">Student has not attempted published online quizzes.</p>
          </div>
        <% } %>
      </div>

    </div>

  </div>

</div>
