<!-- Admin Attendance Management (Exact Dark Theme & Bug Fix Preserved) -->
<div class="space-y-[48px]">

  <!-- Header & Subject/Date Selection -->
  <div class="card" style="--i: 1;">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold badge-accent mb-2">
          <i class="fa-solid fa-clipboard-user"></i>
          <span>Academic Roll Call</span>
        </div>
        <h1 class="page-title text-[#111318]">Daily Roll Call Attendance</h1>
        <p class="body-text mt-1.5 text-sm">Record, audit, and update verified student classroom attendance records in bulk</p>
      </div>

      <div class="flex items-center gap-3">
        <% if (isAlreadyMarked) { %>
          <span class="status-pill text-xs font-semibold badge-warning self-start md:self-auto">
            <i class="fa-solid fa-clock-rotate-left"></i>
            <span>Editing Recorded Session</span>
          </span>
        <% } else { %>
          <span class="status-pill text-xs font-semibold badge-success self-start md:self-auto">
            <i class="fa-solid fa-plus"></i>
            <span>New Attendance Session</span>
          </span>
        <% } %>

        <form action="/admin/attendance/start-session" method="POST" class="inline">
          <input type="hidden" name="subject" value="<%= selectedSubject %>">
          <input type="hidden" name="date" value="<%= selectedDate %>">
          <button type="submit" class="btn-primary py-2 px-4 text-xs font-semibold flex items-center gap-2">
            <i class="fa-solid fa-tower-broadcast"></i>
            <span>Start 15m Live Code</span>
          </button>
        </form>
      </div>
    </div>

    <!-- Active Live Session Display (if any live) -->
    <% if (typeof activeSessions !== 'undefined' && activeSessions && activeSessions.length > 0) { %>
      <div class="mb-6 p-5 rounded-[12px] bg-[rgba(108,92,231,0.08)] border-2 border-[var(--accent-primary)] shadow-lg shadow-[var(--accent-glow)]">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-[10px] bg-[var(--accent-primary)] text-white flex items-center justify-center text-xl shrink-0">
              <i class="fa-solid fa-qrcode"></i>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="status-pill text-[10px] badge-accent animate-pulse">LIVE BROADCAST</span>
                <span class="text-xs text-[#5B5F6B]"><%= activeSessions[0].subject %> (<%= activeSessions[0].date %>)</span>
              </div>
              <div class="text-2xl sm:text-3xl font-bold text-[#111318] font-['Space_Grotesk'] tracking-[0.2em] mt-1 text-[var(--accent-primary)]">
                <%= activeSessions[0].session_code %>
              </div>
              <p class="text-xs text-[#5B5F6B] mt-1">
                Display this code on board. Valid for ~<%= activeSessions[0].minutes_remaining %> more minutes.
              </p>
            </div>
          </div>
          <form action="/admin/attendance/end-session/<%= activeSessions[0].id %>" method="POST">
            <button type="submit" class="px-4 py-2 rounded-[8px] bg-[#FEECEE] text-[var(--danger)] border border-[#FECDD3] hover:bg-[rgba(255,71,87,0.25)] text-xs font-semibold transition-all">
              <i class="fa-solid fa-stop text-xs mr-1"></i> End Session Now
            </button>
          </form>
        </div>
      </div>
    <% } %>

    <!-- Filter Form -->
    <form method="GET" action="/admin/attendance" class="grid grid-cols-1 sm:grid-cols-3 gap-[20px] pt-6 border-t border-[#E5E7EB]">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-2">Curriculum Subject</label>
        <select name="subject" class="w-full px-4 py-2.5 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-xs font-medium text-[#111318] focus:border-[var(--accent-primary)]" onchange="this.form.submit()">
          <% subjects.forEach(subj => { %>
            <option value="<%= subj %>" <%= selectedSubject === subj ? 'selected' : '' %>><%= subj %></option>
          <% }); %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-2">Session Date</label>
        <input 
          type="date" 
          name="date" 
          value="<%= selectedDate %>" 
          class="w-full px-4 py-2.5 bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-xs font-medium text-[#111318] focus:border-[var(--accent-primary)]"
          onchange="this.form.submit()"
        />
      </div>

      <div class="flex items-end">
        <button type="submit" class="btn-secondary w-full py-2.5 text-xs font-semibold">
          <i class="fa-solid fa-filter"></i>
          <span>Load Session Roster</span>
        </button>
      </div>
    </form>
  </div>

  <!-- Bulk Roll Call Form -->
  <div class="card p-0 overflow-hidden" style="--i: 2;">
    
    <div class="p-[28px] border-b border-[#E5E7EB] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-start gap-3.5">
        <div class="w-10 h-10 rounded-[8px] bg-[#F0EDFD] text-[var(--accent-primary)] flex items-center justify-center text-base shrink-0 mt-0.5 border border-[var(--border-subtle)]">
          <i class="fa-solid fa-users-rectangle"></i>
        </div>
        <div>
          <h2 class="section-title">
            Enrolled Student Roll Call (<%= selectedSubject %>)
          </h2>
          <p class="text-muted-desc">Class Session: <%= selectedDate %></p>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-2.5">
        <a 
          href="/admin/export/attendance.csv" 
          class="btn-secondary py-1.5 px-3 text-xs font-semibold flex items-center gap-1.5"
          title="Export Attendance History to CSV"
        >
          <i class="fa-solid fa-file-csv"></i>
          <span>Export CSV</span>
        </a>
        <button 
          type="button" 
          id="mark-all-present" 
          class="px-3.5 py-1.5 rounded-[8px] bg-[#E8F8EE] hover:bg-[rgba(46,213,115,0.2)] text-[var(--success)] text-xs font-semibold transition-all border border-[#A7F3D0] flex items-center gap-2"
        >
          <i class="fa-solid fa-check-double text-xs"></i>
          <span>All Present</span>
        </button>
        <button 
          type="button" 
          id="mark-all-absent" 
          class="px-3.5 py-1.5 rounded-[8px] bg-[#FEECEE] hover:bg-[rgba(255,71,87,0.2)] text-[var(--danger)] text-xs font-semibold transition-all border border-[#FECDD3] flex items-center gap-2"
        >
          <i class="fa-solid fa-xmark text-xs"></i>
          <span>All Absent</span>
        </button>
      </div>
    </div>

    <form action="/admin/attendance" method="POST">
      <input type="hidden" name="date" value="<%= selectedDate %>">
      <input type="hidden" name="subject" value="<%= selectedSubject %>">

      <div class="overflow-x-auto">
        <table class="table-comfortable">
          <thead>
            <tr>
              <th>Roll Number</th>
              <th>Student Name</th>
              <th>Academic Program</th>
              <th class="text-center">Attendance Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#E5E7EB]">
            <% if (students && students.length > 0) { %>
              <% students.forEach(st => { %>
                <tr class="attendance-row <%= st.status === 'Present' ? 'row-present' : 'row-absent' %> hover:bg-[#F7F7F9]/40 transition-colors">
                  <td class="font-bold text-[#111318] text-xs font-['Space_Grotesk']">
                    <%= st.roll_no %>
                  </td>
                  <td class="font-semibold text-[#111318]">
                    <%= st.name %>
                  </td>
                  <td class="text-[#5B5F6B] text-xs">
                    <%= st.course %>
                  </td>
                  <td>
                    <div class="flex items-center justify-center gap-4">
                      <!-- Present Radio -->
                      <label for="status_<%= st.id %>_present" class="attendance-radio-label inline-flex items-center gap-2 cursor-pointer px-3.5 py-1.5 rounded-[6px] border border-transparent hover:bg-[rgba(46,213,115,0.1)] transition-all select-none">
                        <input 
                          type="radio" 
                          id="status_<%= st.id %>_present"
                          name="status_<%= st.id %>" 
                          value="Present" 
                          <%= st.status === 'Present' ? 'checked' : '' %>
                          class="w-4 h-4 text-[var(--success)] focus:ring-[var(--success)] border-[#E5E7EB] bg-[#FFFFFF] cursor-pointer"
                        />
                        <span class="text-xs font-semibold text-[var(--success)]">Present</span>
                      </label>

                      <!-- Absent Radio -->
                      <label for="status_<%= st.id %>_absent" class="attendance-radio-label inline-flex items-center gap-2 cursor-pointer px-3.5 py-1.5 rounded-[6px] border border-transparent hover:bg-[rgba(255,71,87,0.1)] transition-all select-none">
                        <input 
                          type="radio" 
                          id="status_<%= st.id %>_absent"
                          name="status_<%= st.id %>" 
                          value="Absent" 
                          <%= st.status === 'Absent' ? 'checked' : '' %>
                          class="w-4 h-4 text-[var(--danger)] focus:ring-[var(--danger)] border-[#E5E7EB] bg-[#FFFFFF] cursor-pointer"
                        />
                        <span class="text-xs font-semibold text-[var(--danger)]">Absent</span>
                      </label>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="4" class="py-12 text-center text-[#8B8F99]">
                  <div class="w-12 h-12 rounded-[12px] bg-[#FFFFFF] text-[#8B8F99] flex items-center justify-center text-xl mx-auto mb-3 border border-[#E5E7EB]">
                    <i class="fa-solid fa-users-slash"></i>
                  </div>
                  <p class="font-bold text-[#111318] text-sm">No registered students found</p>
                  <p class="text-xs text-[#5B5F6B] max-w-sm mx-auto mt-1">Enroll students in the directory before taking class attendance.</p>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Submit Footer -->
      <div class="p-[28px] bg-[#FFFFFF] border-t border-[#E5E7EB] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <p class="body-text text-xs">
          Saving updates will immediately synchronize student dashboards and academic eligibility counters.
        </p>
        <button 
          type="submit" 
          id="save-attendance-btn"
          class="btn-primary py-2.5 px-6 text-xs font-semibold shrink-0"
        >
          <i class="fa-solid fa-floppy-disk btn-text"></i>
          <span class="btn-text">Save Attendance Records</span>
        </button>
      </div>

    </form>
  </div>

  <!-- Past Attendance Sessions Summary -->
  <div class="card p-0 overflow-hidden" style="--i: 3;">
    <div class="p-[28px] border-b border-[#E5E7EB] flex items-start gap-3.5">
      <div class="w-10 h-10 rounded-[8px] bg-[#F0EDFD] text-[var(--accent-primary)] flex items-center justify-center text-base shrink-0 mt-0.5 border border-[var(--border-subtle)]">
        <i class="fa-solid fa-calendar-days"></i>
      </div>
      <div>
        <h2 class="section-title">Recent Class Sessions Summary</h2>
        <p class="text-muted-desc">Quick overview of previously submitted roll calls</p>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="table-comfortable">
        <thead>
          <tr>
            <th>Date</th>
            <th>Subject</th>
            <th class="text-center">Total Students</th>
            <th class="text-center">Present</th>
            <th class="text-center">Absent</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#E5E7EB]">
          <% recentLogs.forEach(log => { %>
            <tr class="hover:bg-[#F7F7F9]/40 transition-colors">
              <td class="font-medium text-[#111318] text-xs"><%= log.date %></td>
              <td class="font-semibold text-[#111318]"><%= log.subject %></td>
              <td class="text-center text-[#5B5F6B] font-semibold"><%= log.total %></td>
              <td class="text-center text-[var(--success)] font-bold font-['Space_Grotesk']"><%= log.presentCount %></td>
              <td class="text-center text-[var(--danger)] font-bold font-['Space_Grotesk']"><%= log.absentCount %></td>
              <td class="text-right">
                <a 
                  href="/admin/attendance?date=<%= log.date %>&subject=<%= encodeURIComponent(log.subject) %>" 
                  class="btn-secondary py-1.5 px-3 text-xs font-semibold"
                >
                  <span>Edit Session</span>
                  <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

</div>
