<!-- Admin Library Management (Exact Dark Theme & Modal Animation Spec) -->
<div class="space-y-[48px]">

  <!-- Header & Actions -->
  <div class="card flex flex-col md:flex-row md:items-center justify-between gap-6" style="--i: 1;">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold badge-accent mb-2">
        <i class="fa-solid fa-book-bookmark"></i>
        <span>Circulation & Inventory</span>
      </div>
      <h1 class="page-title text-[#111318]">Library Circulation Desk</h1>
      <p class="body-text mt-1.5 text-sm">Issue books, process returns, track overdue loans, and maintain the central catalog</p>
    </div>

    <div class="flex flex-wrap items-center gap-3 shrink-0">
      <a href="/admin/export/library.csv" class="btn-secondary py-2.5 px-3.5 text-xs font-semibold flex items-center gap-1.5">
        <i class="fa-solid fa-file-csv"></i>
        <span>Export CSV</span>
      </a>

      <button 
        type="button" 
        onclick="openModal('issue-book-modal')"
        class="btn-primary py-2.5 px-4 text-xs font-semibold"
      >
        <i class="fa-solid fa-hand-holding-hand"></i>
        <span>Issue Book</span>
      </button>

      <button 
        type="button" 
        onclick="openModal('add-book-modal')"
        class="btn-secondary py-2.5 px-4 text-xs font-semibold"
      >
        <i class="fa-solid fa-plus"></i>
        <span>Add New Title</span>
      </button>
    </div>
  </div>

  <!-- Active Book Issues & Overdue Loans Table -->
  <div class="card p-0 overflow-hidden" style="--i: 2;">
    <div class="p-[28px] border-b border-[#E5E7EB] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-start gap-3.5">
        <div class="w-10 h-10 rounded-[8px] bg-[#FEF6E7] text-[var(--warning)] flex items-center justify-center text-base shrink-0 mt-0.5 border border-[var(--border-subtle)]">
          <i class="fa-solid fa-clock-rotate-left"></i>
        </div>
        <div>
          <h2 class="section-title">Circulation Records (Issued & Returned)</h2>
          <p class="text-muted-desc">Items flagged in red have exceeded their loan return timeline</p>
        </div>
      </div>
      <span class="status-pill text-xs font-semibold badge-danger self-start sm:self-center">
        <%= issuedBooks.filter(b => b.isOverdue).length %> Overdue Loans
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="table-comfortable">
        <thead>
          <tr>
            <th>Book Title</th>
            <th>Borrowing Student</th>
            <th>Issue Date</th>
            <th>Due Date</th>
            <th class="text-center">Status</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#E5E7EB]">
          <% if (issuedBooks && issuedBooks.length > 0) { %>
            <% issuedBooks.forEach(issue => { %>
              <tr class="hover:bg-[#F7F7F9]/40 transition-colors <%= issue.isOverdue ? 'bg-[rgba(255,71,87,0.06)]' : '' %>">
                <td class="font-semibold text-[#111318]">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-[8px] <%= issue.isOverdue ? 'bg-[#FEECEE] text-[var(--danger)] border border-[#FECDD3]' : 'bg-[#F0EDFD] text-[var(--accent-primary)] border border-[var(--border-subtle)]' %> flex items-center justify-center text-xs shrink-0">
                      <i class="fa-solid fa-book"></i>
                    </div>
                    <span><%= issue.book_title %></span>
                  </div>
                </td>
                <td class="text-[#5B5F6B] text-xs">
                  <span class="font-semibold text-[#111318]"><%= issue.student_name %></span>
                  <span class="text-[#8B8F99] font-medium block mt-0.5 font-['Space_Grotesk']"><%= issue.student_roll %></span>
                </td>
                <td class="text-[#8B8F99] text-xs font-medium"><%= issue.issue_date %></td>
                <td class="text-xs font-bold <%= issue.isOverdue ? 'text-[var(--danger)]' : 'text-[#111318]' %>">
                  <%= issue.due_date %>
                </td>
                <td class="text-center">
                  <% if (issue.status === 'Returned') { %>
                    <span class="status-pill text-xs font-semibold text-[#5B5F6B] bg-[#F7F7F9] border border-[#E5E7EB]">
                      Returned
                    </span>
                  <% } else if (issue.isOverdue) { %>
                    <span class="status-pill text-xs font-bold badge-danger">
                      OVERDUE
                    </span>
                  <% } else { %>
                    <span class="status-pill text-xs font-semibold badge-success">
                      Active Loan
                    </span>
                  <% } %>
                </td>
                <td class="text-right">
                  <% if (issue.status === 'Issued') { %>
                    <form action="/admin/library/return/<%= issue.id %>" method="POST" class="inline">
                      <button 
                        type="submit" 
                        class="btn-secondary py-1.5 px-3 text-xs font-semibold text-[var(--success)] border-[#A7F3D0] hover:bg-[rgba(46,213,115,0.1)]"
                        title="Mark as Returned"
                      >
                        <i class="fa-solid fa-arrow-rotate-left mr-1"></i> Return
                      </button>
                    </form>
                  <% } else { %>
                    <span class="text-xs text-[#8B8F99] font-medium">Completed</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="py-12 text-center text-[#8B8F99]">
                <div class="w-12 h-12 rounded-[12px] bg-[#FFFFFF] text-[#8B8F99] flex items-center justify-center text-xl mx-auto mb-3 border border-[#E5E7EB]">
                  <i class="fa-solid fa-book-open"></i>
                </div>
                <p class="font-bold text-[#111318] text-sm">No book loan records found</p>
                <p class="text-xs text-[#5B5F6B] max-w-sm mx-auto mt-1">Click 'Issue Book' above to check out a textbook to a student.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Book Inventory Catalog -->
  <div class="card p-0 overflow-hidden" style="--i: 3;">
    <div class="p-[28px] border-b border-[#E5E7EB] flex items-center justify-between">
      <div class="flex items-start gap-3.5">
        <div class="w-10 h-10 rounded-[8px] bg-[#F0EDFD] text-[var(--accent-primary)] flex items-center justify-center text-base shrink-0 mt-0.5 border border-[var(--border-subtle)]">
          <i class="fa-solid fa-layer-group"></i>
        </div>
        <div>
          <h2 class="section-title">Master Inventory Catalog</h2>
          <p class="text-muted-desc">Manage physical inventory counts and on-shelf copy balances</p>
        </div>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="table-comfortable">
        <thead>
          <tr>
            <th>Book Title</th>
            <th>Author</th>
            <th>Category</th>
            <th class="text-center">Available / Total Copies</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#E5E7EB]">
          <% if (books && books.length > 0) { %>
            <% books.forEach(b => { %>
              <tr class="hover:bg-[#F7F7F9]/40 transition-colors">
                <td class="font-semibold text-[#111318]"><%= b.title %></td>
                <td class="text-[#5B5F6B] text-xs font-medium"><%= b.author %></td>
                <td>
                  <span class="label-caps px-2.5 py-0.5 rounded-[6px] bg-[#FFFFFF] text-[#5B5F6B] border border-[#E5E7EB]">
                    <%= b.category %>
                  </span>
                </td>
                <td class="text-center font-bold text-[#111318] font-['Space_Grotesk']">
                  <span class="<%= b.available_copies > 0 ? 'text-[var(--success)] font-bold' : 'text-[var(--danger)] font-bold' %>">
                    <%= b.available_copies %>
                  </span> <span class="text-[#8B8F99] font-normal">/ <%= b.total_copies %></span>
                </td>
                <td class="text-right">
                  <form action="/admin/library/delete/<%= b.id %>" method="POST" onsubmit="return confirm('Remove this title from catalog?');" class="inline">
                    <button type="submit" class="p-2 rounded-[8px] text-[#8B8F99] hover:text-[var(--danger)] hover:bg-[rgba(255,71,87,0.1)] transition-colors" title="Delete Book From Catalog">
                      <i class="fa-solid fa-trash-can text-xs"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="py-12 text-center text-[#8B8F99]">
                <div class="w-12 h-12 rounded-[12px] bg-[#FFFFFF] text-[#8B8F99] flex items-center justify-center text-xl mx-auto mb-3 border border-[#E5E7EB]">
                  <i class="fa-solid fa-book-medical"></i>
                </div>
                <p class="font-bold text-[#111318] text-sm">No books in catalog</p>
                <p class="text-xs text-[#5B5F6B] max-w-sm mx-auto mt-1">Click 'Add New Title' above to populate the library database.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Modal: Issue Book (Scale 0.95->1 + Fade 250ms) -->
<div id="issue-book-modal" class="modal-backdrop hidden">
  <div class="modal-panel">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-lg font-bold text-[#111318] font-['Space_Grotesk']">Issue Book to Student</h3>
      <button type="button" onclick="closeModal('issue-book-modal')" class="text-[#5B5F6B] hover:text-[#111318]">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form action="/admin/library/issue" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Select Book *</label>
        <select name="book_id" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
          <option value="">Select an Available Book</option>
          <% availableBooks.forEach(b => { %>
            <option value="<%= b.id %>">
              <%= b.title %> (<%= b.available_copies %> in stock)
            </option>
          <% }); %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Borrowing Student *</label>
        <select name="student_id" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
          <option value="">Select Student</option>
          <% students.forEach(st => { %>
            <option value="<%= st.id %>"><%= st.name %> (<%= st.roll_no %>)</option>
          <% }); %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Scheduled Due Date *</label>
        <% 
          const twoWeeksLater = new Date(Date.now() + 14 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
        %>
        <input type="date" name="due_date" value="<%= twoWeeksLater %>" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
      </div>

      <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E5E7EB]">
        <button type="button" onclick="closeModal('issue-book-modal')" class="btn-secondary py-2 px-4 text-xs font-medium">
          Cancel
        </button>
        <button type="submit" class="btn-primary py-2 px-5 text-xs font-semibold">
          Confirm Issue
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Add Book Title (Scale 0.95->1 + Fade 250ms) -->
<div id="add-book-modal" class="modal-backdrop hidden">
  <div class="modal-panel">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-lg font-bold text-[#111318] font-['Space_Grotesk']">Add Book to Catalog</h3>
      <button type="button" onclick="closeModal('add-book-modal')" class="text-[#5B5F6B] hover:text-[#111318]">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form action="/admin/library/add" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Title *</label>
        <input type="text" name="title" required placeholder="e.g. Introduction to Algorithms" class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Author *</label>
        <input type="text" name="author" required placeholder="e.g. Thomas H. Cormen" class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Category *</label>
          <input type="text" name="category" required placeholder="e.g. Computer Science" class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Total Copies *</label>
          <input type="number" min="1" name="total_copies" value="5" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
        </div>
      </div>

      <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E5E7EB]">
        <button type="button" onclick="closeModal('add-book-modal')" class="btn-secondary py-2 px-4 text-xs font-medium">
          Cancel
        </button>
        <button type="submit" class="btn-primary py-2 px-5 text-xs font-semibold">
          Add Title
        </button>
      </div>
    </form>
  </div>
</div>
