<div class="space-y-[48px]">

  <!-- Header -->
  <div class="card" style="--i: 1;">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold badge-accent mb-2">
          <i class="fa-solid fa-bullhorn"></i>
          <span>Official Communication</span>
        </div>
        <h1 class="page-title text-[#111318]">Campus Announcements & Notices</h1>
        <p class="body-text mt-1.5 text-sm">Broadcast campus alerts, exam schedules, and academic bulletins live to all enrolled student portals</p>
      </div>

      <button type="button" onclick="openModal('create-announcement-modal')" class="btn-primary py-2.5 px-5 text-xs font-semibold flex items-center gap-2">
        <i class="fa-solid fa-plus"></i>
        <span>Publish Announcement</span>
      </button>
    </div>
  </div>

  <!-- Announcements List -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[20px]">
    <% if (announcements && announcements.length > 0) { %>
      <% announcements.forEach((ann, idx) => { %>
        <div class="card flex flex-col justify-between" style="--i: <%= idx + 2 %>;">
          <div>
            <div class="flex items-start justify-between gap-3 mb-3">
              <span class="status-pill text-[10px] <%= ann.priority === 'urgent' ? 'badge-danger animate-pulse' : 'badge-accent' %>">
                <%= ann.priority === 'urgent' ? 'URGENT NOTICE' : 'GENERAL BULLETIN' %>
              </span>
              <span class="text-[11px] text-[#8B8F99] font-mono"><%= ann.created_at.substring(0, 10) %></span>
            </div>

            <h3 class="card-title text-[#111318] text-base font-bold mb-2">
              <%= ann.title %>
            </h3>
            <p class="body-text text-xs text-[#5B5F6B] leading-relaxed">
              <%= ann.body %>
            </p>
          </div>

          <div class="pt-4 mt-5 border-t border-[#E5E7EB] flex items-center justify-between text-xs">
            <span class="text-[#8B8F99] text-[11px]">By <%= ann.posted_by_name %></span>
            <form action="/admin/announcements/delete/<%= ann.id %>" method="POST" onsubmit="return confirm('Are you sure you want to remove this announcement?');">
              <button type="submit" class="text-[var(--danger)] hover:underline text-xs font-medium flex items-center gap-1">
                <i class="fa-solid fa-trash-can text-[10px]"></i>
                <span>Delete</span>
              </button>
            </form>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="col-span-full card py-16 text-center text-[#8B8F99]">
        <div class="w-14 h-14 rounded-[12px] bg-[#FFFFFF] text-[#8B8F99] flex items-center justify-center text-2xl mx-auto mb-3 border border-[#E5E7EB]">
          <i class="fa-solid fa-bullhorn"></i>
        </div>
        <p class="font-bold text-[#111318] text-base">No Notices Published</p>
        <p class="text-xs text-[#5B5F6B] max-w-sm mx-auto mt-1">Click the button above to publish your first campus announcement.</p>
      </div>
    <% } %>
  </div>

</div>

<!-- Modal: Publish Announcement -->
<div id="create-announcement-modal" class="modal-backdrop">
  <div class="modal-panel">
    <div class="flex items-center justify-between pb-4 border-b border-[#E5E7EB]">
      <h3 class="card-title text-[#111318] flex items-center gap-2">
        <i class="fa-solid fa-bullhorn text-[var(--accent-primary)]"></i>
        <span>Publish Institutional Notice</span>
      </h3>
      <button type="button" onclick="closeModal('create-announcement-modal')" class="text-[#5B5F6B] hover:text-[#111318] text-lg">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form action="/admin/announcements/create" method="POST" class="space-y-4 pt-4">
      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Announcement Headline *</label>
        <input type="text" name="title" required placeholder="e.g. Mid-Term Examination Schedule Announced" class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Priority Level</label>
        <select name="priority" class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
          <option value="normal">Normal Bulletin (Routine Academic Update)</option>
          <option value="urgent">Urgent Notice (Emergency / Immediate Action Required)</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Notice Body Content *</label>
        <textarea name="body" required rows="4" placeholder="Detailed explanation and instructions for students..." class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]"></textarea>
      </div>

      <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E5E7EB]">
        <button type="button" onclick="closeModal('create-announcement-modal')" class="btn-secondary py-2 px-4 text-xs font-medium">
          Cancel
        </button>
        <button type="submit" class="btn-primary py-2 px-5 text-xs font-semibold">
          Publish Live to Students
        </button>
      </div>
    </form>
  </div>
</div>
