<!-- Admin Results Management (Exact Dark Theme & Modal Animation Spec) -->
<div class="space-y-[48px]">

  <!-- Header & Add Result Modal Trigger -->
  <div class="card flex flex-col md:flex-row md:items-center justify-between gap-6" style="--i: 1;">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold badge-accent mb-2">
        <i class="fa-solid fa-graduation-cap"></i>
        <span>Grading & Evaluation Ledger</span>
      </div>
      <h1 class="page-title text-[#111318]">Academic Grade Ledger</h1>
      <p class="body-text mt-1.5 text-sm">Record examination scores, midterm grades, and official performance marks</p>
    </div>

    <div class="flex items-center gap-3">
      <a href="/admin/export/results.csv" class="btn-secondary py-2.5 px-4 text-xs font-semibold shrink-0 flex items-center gap-1.5">
        <i class="fa-solid fa-file-csv"></i>
        <span>Export CSV</span>
      </a>
      <button 
        type="button" 
        onclick="openModal('add-result-modal')"
        class="btn-primary py-2.5 px-4 text-xs font-semibold shrink-0"
      >
        <i class="fa-solid fa-plus"></i>
        <span>Record Assessment Marks</span>
      </button>
    </div>
  </div>

  <!-- Filter Bar -->
  <div class="card" style="--i: 2;">
    <form method="GET" action="/admin/results" class="grid grid-cols-1 sm:grid-cols-3 gap-[20px]">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-2">Filter by Student</label>
        <select name="student_id" onchange="this.form.submit()" class="w-full px-4 py-2.5 text-xs font-medium bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] focus:border-[var(--accent-primary)] text-[#111318]">
          <option value="">All Registered Students</option>
          <% students.forEach(st => { %>
            <option value="<%= st.id %>" <%= filterStudent === st.id ? 'selected' : '' %>>
              <%= st.name %> (<%= st.roll_no %>)
            </option>
          <% }); %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-[#5B5F6B] mb-2">Filter by Course Subject</label>
        <select name="subject" onchange="this.form.submit()" class="w-full px-4 py-2.5 text-xs font-medium bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] focus:border-[var(--accent-primary)] text-[#111318]">
          <option value="">All Course Modules</option>
          <% subjects.forEach(s => { %>
            <option value="<%= s %>" <%= filterSubject === s ? 'selected' : '' %>><%= s %></option>
          <% }); %>
        </select>
      </div>

      <div class="flex items-end">
        <a href="/admin/results" class="btn-secondary w-full py-2.5 text-xs font-semibold">
          <i class="fa-solid fa-rotate-left text-xs"></i>
          <span>Reset Filters</span>
        </a>
      </div>
    </form>
  </div>

  <!-- Results Table -->
  <div class="card p-0 overflow-hidden" style="--i: 3;">
    <div class="overflow-x-auto">
      <table class="table-comfortable">
        <thead>
          <tr>
            <th>Student</th>
            <th>Semester</th>
            <th>Subject</th>
            <th>Exam Type</th>
            <th class="text-center">Score</th>
            <th class="text-center">Percentage</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#E5E7EB]">
          <% if (results && results.length > 0) { %>
            <% results.forEach(r => { %>
              <tr class="hover:bg-[#F7F7F9]/40 transition-colors">
                <td class="font-semibold text-[#111318]">
                  <div class="flex items-center gap-2.5">
                    <span class="text-xs font-bold text-[#8B8F99] font-['Space_Grotesk']">[<%= r.roll_no %>]</span>
                    <span><%= r.student_name %></span>
                  </div>
                </td>
                <td>
                  <span class="status-pill text-[10px] font-bold badge-accent">
                    <%= r.semester || 'Semester 1' %>
                  </span>
                </td>
                <td class="text-[#5B5F6B] text-xs font-medium">
                  <%= r.subject %>
                </td>
                <td>
                  <span class="px-2.5 py-1 rounded-[6px] bg-[#FFFFFF] text-[#5B5F6B] text-xs border border-[#E5E7EB]">
                    <%= r.exam_type %>
                  </span>
                </td>
                <td class="text-center font-bold text-[#111318] font-['Space_Grotesk']">
                  <%= r.marks_obtained %> <span class="text-[#8B8F99] font-normal">/ <%= r.max_marks %></span>
                </td>
                <td class="text-center">
                  <span class="status-pill text-xs font-semibold <%= r.percentage >= 75 ? 'badge-success' : 'badge-warning' %>">
                    <%= r.percentage %>%
                  </span>
                </td>
                <td class="text-right">
                  <form action="/admin/results/delete/<%= r.id %>" method="POST" onsubmit="return confirm('Delete this result record?');" class="inline">
                    <button 
                      type="submit" 
                      class="p-2 rounded-[8px] text-[#8B8F99] hover:text-[var(--danger)] hover:bg-[rgba(255,71,87,0.1)] transition-colors"
                      title="Delete Record"
                    >
                      <i class="fa-solid fa-trash-can text-xs"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="py-12 text-center text-[#8B8F99]">
                <div class="w-12 h-12 rounded-[12px] bg-[#FFFFFF] text-[#8B8F99] flex items-center justify-center text-xl mx-auto mb-3 border border-[#E5E7EB]">
                  <i class="fa-solid fa-file-excel"></i>
                </div>
                <p class="font-bold text-[#111318] text-sm">No exam marks match your criteria</p>
                <p class="text-xs text-[#5B5F6B] max-w-sm mx-auto mt-1">Select different student filters or record new assessment scores.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Modal: Add Result (Scale 0.95->1 + Fade 250ms) -->
<div id="add-result-modal" class="modal-backdrop hidden">
  <div class="modal-panel">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-lg font-bold text-[#111318] font-['Space_Grotesk']">Record Assessment Marks</h3>
      <button type="button" onclick="closeModal('add-result-modal')" class="text-[#5B5F6B] hover:text-[#111318]">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form action="/admin/results/add" method="POST" class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Enrolled Student *</label>
          <select name="student_id" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
            <option value="">Select Student</option>
            <% students.forEach(st => { %>
              <option value="<%= st.id %>"><%= st.name %> (<%= st.roll_no %> - <%= st.course %>)</option>
            <% }); %>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Academic Semester *</label>
          <select name="semester" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
            <option value="Semester 1">Semester 1</option>
            <option value="Semester 2">Semester 2</option>
            <option value="Semester 3">Semester 3</option>
            <option value="Semester 4">Semester 4</option>
            <option value="Semester 5">Semester 5</option>
            <option value="Semester 6" selected>Semester 6</option>
            <option value="Semester 7">Semester 7</option>
            <option value="Semester 8">Semester 8</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Curriculum Subject *</label>
          <select name="subject" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
            <% subjects.forEach(s => { %>
              <option value="<%= s %>"><%= s %></option>
            <% }); %>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Assessment Type *</label>
          <select name="exam_type" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
            <option value="Semester End Examination">Semester End Examination</option>
            <option value="Mid-Term Assessment">Mid-Term Assessment</option>
            <option value="Practical Lab Exam">Practical Lab Exam</option>
            <option value="Internal Assignment Test">Internal Assignment Test</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Marks Obtained *</label>
          <input type="number" step="0.5" min="0" max="100" name="marks_obtained" required placeholder="e.g. 84" class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Maximum Marks *</label>
          <input type="number" name="max_marks" required value="100" class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
        </div>
      </div>

      <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E5E7EB]">
        <button type="button" onclick="closeModal('add-result-modal')" class="btn-secondary py-2 px-4 text-xs font-medium">
          Cancel
        </button>
        <button type="submit" class="btn-primary py-2 px-5 text-xs font-semibold">
          Save Marks
        </button>
      </div>
    </form>
  </div>
</div>
