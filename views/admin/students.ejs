<!-- Admin Student Management (Exact Dark Theme & Modal Animation Spec) -->
<div class="space-y-[48px]">

  <!-- Header & Actions -->
  <div class="card flex flex-col md:flex-row md:items-center justify-between gap-6" style="--i: 1;">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold badge-accent mb-2">
        <i class="fa-solid fa-users"></i>
        <span>Enrollment Management</span>
      </div>
      <h1 class="page-title text-[#111318]">Student Directory</h1>
      <p class="body-text mt-1.5 text-sm">Manage enrolled student accounts, credentials, and academic programs</p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <!-- Search Form -->
      <form action="/admin/students" method="GET" class="flex items-center gap-2">
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#8B8F99] text-xs">
            <i class="fa-solid fa-magnifying-glass"></i>
          </div>
          <input 
            type="text" 
            name="q" 
            placeholder="Search name, roll, course..." 
            value="<%= searchQuery %>"
            class="pl-9 pr-3.5 py-2 text-xs bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318] placeholder-[#8B8F99] w-48 sm:w-64"
          />
        </div>
        <button type="submit" class="btn-secondary py-2 px-3.5 text-xs font-semibold">
          Filter
        </button>
        <% if (searchQuery) { %>
          <a href="/admin/students" class="px-2.5 py-2 text-[#5B5F6B] hover:text-[#111318] text-xs font-semibold">Clear</a>
        <% } %>
      </form>

      <!-- Export CSV Button -->
      <a href="/admin/export/students.csv" class="btn-secondary py-2 px-3.5 text-xs font-semibold shrink-0 flex items-center gap-1.5">
        <i class="fa-solid fa-file-csv"></i>
        <span>Export CSV</span>
      </a>

      <!-- Add Student Button -->
      <button 
        type="button" 
        onclick="openModal('add-student-modal')"
        class="btn-primary py-2 px-4 text-xs font-semibold shrink-0"
      >
        <i class="fa-solid fa-user-plus"></i>
        <span>Add Student</span>
      </button>
    </div>
  </div>

  <!-- Students Table -->
  <div class="card p-0 overflow-hidden" style="--i: 2;">
    <div class="overflow-x-auto">
      <table class="table-comfortable">
        <thead>
          <tr>
            <th>Student</th>
            <th>Roll Number</th>
            <th>Enrolled Course</th>
            <th>Email</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#E5E7EB]">
          <% if (students && students.length > 0) { %>
            <% students.forEach(st => { %>
              <tr class="hover:bg-[#F7F7F9]/40 transition-colors">
                <td class="font-semibold text-[#111318]">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-[8px] bg-[#F0EDFD] text-[var(--accent-primary)] flex items-center justify-center font-bold text-xs shrink-0 border border-[var(--border-subtle)]">
                      <%= st.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() %>
                    </div>
                    <span><%= st.name %></span>
                  </div>
                </td>
                <td class="font-bold text-[#111318] text-xs uppercase font-['Space_Grotesk']">
                  <%= st.roll_no %>
                </td>
                <td class="text-[#5B5F6B] text-xs">
                  <%= st.course %>
                </td>
                <td class="text-[#8B8F99] text-xs">
                  <%= st.email %>
                </td>
                <td class="text-right">
                  <div class="flex items-center justify-end gap-2">
                    <a 
                      href="/admin/students/<%= st.id %>" 
                      class="btn-secondary py-1.5 px-3 text-xs font-semibold"
                      title="View Student 360 Profile"
                    >
                      <i class="fa-solid fa-id-card mr-1"></i> Profile
                    </a>

                    <button 
                      type="button" 
                      onclick="openEditStudentModal('<%= st.id %>', '<%= st.name %>', '<%= st.email %>', '<%= st.roll_no %>', '<%= st.course %>')"
                      class="p-2 rounded-[8px] text-[#5B5F6B] hover:text-[#111318] hover:bg-[#F7F7F9] transition-colors"
                      title="Edit Student"
                    >
                      <i class="fa-solid fa-pen-to-square text-xs"></i>
                    </button>

                    <form action="/admin/students/delete/<%= st.id %>" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this student? All attendance, marks, and quiz records will be erased.');" class="inline">
                      <button 
                        type="submit" 
                        class="p-2 rounded-[8px] text-[#8B8F99] hover:text-[var(--danger)] hover:bg-[rgba(255,71,87,0.1)] transition-colors"
                        title="Delete Student"
                      >
                        <i class="fa-solid fa-trash-can text-xs"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="py-12 text-center text-[#8B8F99]">
                <div class="w-12 h-12 rounded-[12px] bg-[#FFFFFF] text-[#8B8F99] flex items-center justify-center text-xl mx-auto mb-3 border border-[#E5E7EB]">
                  <i class="fa-solid fa-user-xmark"></i>
                </div>
                <p class="font-bold text-[#111318] text-sm">No students match your query</p>
                <p class="text-xs text-[#5B5F6B] max-w-sm mx-auto mt-1">Try refining search parameters or click 'Add Student' above to enroll a new student.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Modal: Add Student (Scale 0.95->1 + Fade 250ms) -->
<div id="add-student-modal" class="modal-backdrop hidden">
  <div class="modal-panel">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-lg font-bold text-[#111318] font-['Space_Grotesk']">Enroll New Student</h3>
      <button type="button" onclick="closeModal('add-student-modal')" class="text-[#5B5F6B] hover:text-[#111318]">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form action="/admin/students/add" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Full Legal Name *</label>
        <input type="text" name="name" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Email *</label>
          <input type="email" name="email" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Roll Number *</label>
          <input type="text" name="roll_no" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318] uppercase">
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Course / Degree *</label>
        <select name="course" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
          <option value="B.Tech Computer Science">B.Tech Computer Science</option>
          <option value="B.Tech Information Technology">B.Tech Information Technology</option>
          <option value="B.Tech AI & Data Science">B.Tech AI & Data Science</option>
          <option value="B.Tech Electronics & Communication">B.Tech Electronics & Communication</option>
          <option value="BCA / MCA">BCA / MCA</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Temporary Password (min 6) *</label>
        <input type="password" name="password" required minlength="6" class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
      </div>

      <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E5E7EB]">
        <button type="button" onclick="closeModal('add-student-modal')" class="btn-secondary py-2 px-4 text-xs font-medium">
          Cancel
        </button>
        <button type="submit" class="btn-primary py-2 px-5 text-xs font-semibold">
          Save Student
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Edit Student (Scale 0.95->1 + Fade 250ms) -->
<div id="edit-student-modal" class="modal-backdrop hidden">
  <div class="modal-panel">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-lg font-bold text-[#111318] font-['Space_Grotesk']">Edit Student Record</h3>
      <button type="button" onclick="closeModal('edit-student-modal')" class="text-[#5B5F6B] hover:text-[#111318]">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form id="edit-student-form" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Full Legal Name *</label>
        <input type="text" id="edit-name" name="name" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Email *</label>
          <input type="email" id="edit-email" name="email" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Roll Number *</label>
          <input type="text" id="edit-roll" name="roll_no" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318] uppercase">
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Course / Degree *</label>
        <select id="edit-course" name="course" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
          <option value="B.Tech Computer Science">B.Tech Computer Science</option>
          <option value="B.Tech Information Technology">B.Tech Information Technology</option>
          <option value="B.Tech AI & Data Science">B.Tech AI & Data Science</option>
          <option value="B.Tech Electronics & Communication">B.Tech Electronics & Communication</option>
          <option value="BCA / MCA">BCA / MCA</option>
        </select>
      </div>

      <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E5E7EB]">
        <button type="button" onclick="closeModal('edit-student-modal')" class="btn-secondary py-2 px-4 text-xs font-medium">
          Cancel
        </button>
        <button type="submit" class="btn-primary py-2 px-5 text-xs font-semibold">
          Update Record
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openEditStudentModal(id, name, email, roll, course) {
    document.getElementById('edit-student-form').action = `/admin/students/edit/${id}`;
    document.getElementById('edit-name').value = name;
    document.getElementById('edit-email').value = email;
    document.getElementById('edit-roll').value = roll;
    document.getElementById('edit-course').value = course;
    openModal('edit-student-modal');
  }
</script>
