<!-- Admin Quiz Management (Exact Dark Theme & Modal Animation Spec) -->
<div class="space-y-[48px]">

  <!-- Header & Create Quiz Modal Trigger -->
  <div class="card flex flex-col md:flex-row md:items-center justify-between gap-6" style="--i: 1;">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold badge-accent mb-2">
        <i class="fa-solid fa-graduation-cap"></i>
        <span>Evaluation Engine</span>
      </div>
      <h1 class="page-title text-[#111318]">Quiz & Assessment Manager</h1>
      <p class="body-text mt-1.5 text-sm">Design multiple-choice assessments, configure answer keys, and audit student performance</p>
    </div>

    <button 
      type="button" 
      onclick="openModal('create-quiz-modal')"
      class="btn-primary py-2.5 px-4 text-xs font-semibold shrink-0"
    >
      <i class="fa-solid fa-plus"></i>
      <span>Create New Quiz</span>
    </button>
  </div>

  <!-- Quizzes Grid (20px gap, Equal Heights) -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[20px]" style="--i: 2;">
    <% if (quizzes && quizzes.length > 0) { %>
      <% quizzes.forEach(q => { %>
        <div class="card flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="label-caps px-2.5 py-0.5 rounded-[6px] bg-[#FFFFFF] text-[var(--accent-primary)] border border-[#E5E7EB]">
                <%= q.subject %>
              </span>
              <span class="text-xs text-[#8B8F99] font-medium flex items-center gap-1.5">
                <i class="fa-solid fa-list-check text-[var(--accent-primary)]"></i>
                <span><%= q.question_count %> Questions</span>
              </span>
            </div>

            <h2 class="card-title text-[#111318] leading-snug mt-2 text-base"><%= q.title %></h2>
            
            <div class="grid grid-cols-2 gap-3 mt-5 pt-4 border-t border-[#E5E7EB] text-xs">
              <div class="p-3 rounded-[8px] bg-[#FFFFFF] border border-[#E5E7EB]">
                <span class="stat-label text-[#8B8F99] block mb-1">Submissions</span>
                <span class="font-bold text-[#111318] text-base font-['Space_Grotesk']"><%= q.attempts_count %></span>
              </div>
              <div class="p-3 rounded-[8px] bg-[rgba(108,92,231,0.1)] border border-[#DDD6FE]">
                <span class="stat-label text-[var(--accent-primary)] block mb-1">Avg Score</span>
                <span class="font-bold text-[var(--accent-primary)] text-base font-['Space_Grotesk']"><%= q.average_score %>%</span>
              </div>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-[#E5E7EB] flex items-center justify-between">
            <form action="/admin/quiz/delete/<%= q.id %>" method="POST" onsubmit="return confirm('Delete this quiz and all its questions and attempts?');" class="inline">
              <button type="submit" class="p-2 rounded-[8px] text-[#8B8F99] hover:text-[var(--danger)] hover:bg-[rgba(255,71,87,0.1)] transition-colors" title="Delete Quiz">
                <i class="fa-solid fa-trash-can text-xs"></i>
              </button>
            </form>

            <a 
              href="/admin/quiz/<%= q.id %>" 
              class="btn-secondary py-1.5 px-3 text-xs font-semibold"
            >
              <span>Manage Questions</span>
              <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </a>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="col-span-full py-12 text-center card">
        <div class="w-12 h-12 rounded-[12px] bg-[#FFFFFF] text-[#8B8F99] flex items-center justify-center text-xl mx-auto mb-3 border border-[#E5E7EB]">
          <i class="fa-solid fa-file-circle-question"></i>
        </div>
        <p class="font-bold text-[#111318] text-sm">No quizzes created yet</p>
        <p class="text-xs text-[#5B5F6B] max-w-sm mx-auto mt-1">Click 'Create New Quiz' above to draft questions and publish your first test.</p>
      </div>
    <% } %>
  </div>

</div>

<!-- Modal: Create Quiz (Scale 0.95->1 + Fade 250ms) -->
<div id="create-quiz-modal" class="modal-backdrop hidden">
  <div class="modal-panel">
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-lg font-bold text-[#111318] font-['Space_Grotesk']">Create New Quiz</h3>
      <button type="button" onclick="closeModal('create-quiz-modal')" class="text-[#5B5F6B] hover:text-[#111318]">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form action="/admin/quiz/create" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Quiz Title *</label>
        <input type="text" name="title" required placeholder="e.g. Operating Systems Memory Management" class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase text-[#5B5F6B] mb-1.5">Curriculum Subject *</label>
        <select name="subject" required class="w-full px-4 py-2.5 text-sm bg-[#FFFFFF] border border-[#E5E7EB] rounded-[8px] text-[#111318]">
          <% const safeSubjects = (typeof subjects !== 'undefined' && subjects) ? subjects : ['Data Structures & Algorithms', 'Database Management Systems', 'Operating Systems', 'Computer Networks', 'Web Technologies', 'Software Engineering', 'Artificial Intelligence']; %>
          <% safeSubjects.forEach(s => { %>
            <option value="<%= s %>"><%= s %></option>
          <% }); %>
        </select>
      </div>

      <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#E5E7EB]">
        <button type="button" onclick="closeModal('create-quiz-modal')" class="btn-secondary py-2 px-4 text-xs font-medium">
          Cancel
        </button>
        <button type="submit" class="btn-primary py-2 px-5 text-xs font-semibold">
          Create & Add Questions
        </button>
      </div>
    </form>
  </div>
</div>
