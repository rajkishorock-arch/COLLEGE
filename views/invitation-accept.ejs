<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Accept Invitation — <%= invite.tenant_name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[#F8F9FB] min-h-screen flex items-center justify-center p-4 antialiased text-[#111318]">

  <div class="w-full max-w-md bg-white border border-[#E5E7EB] rounded-2xl p-8 shadow-sm">
    <div class="text-center mb-6">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-[#F0EDFD] text-[var(--accent-primary)] text-2xl font-bold mb-3 shadow-xs">
        <i class="fa-solid fa-envelope-open-text"></i>
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-[#111318]">Complete Your Registration</h1>
      <p class="text-sm text-[#5B5F6B] mt-1.5">
        You've been invited to join <span class="font-semibold text-[#111318]"><%= invite.tenant_name %></span> as <span class="uppercase tracking-wider font-bold text-[var(--accent-primary)] text-xs"><%= invite.role.replace('_', ' ') %></span>.
      </p>
    </div>

    <% if (error) { %>
      <div class="mb-5 p-3.5 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-xl flex items-center gap-2.5">
        <i class="fa-solid fa-circle-exclamation shrink-0"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/invitation/accept" method="POST" class="space-y-4">
      <input type="hidden" name="token" value="<%= token %>">

      <div>
        <label class="block text-xs font-semibold text-[#5B5F6B] uppercase tracking-wider mb-1.5">Assigned Email</label>
        <input type="email" value="<%= invite.email %>" disabled class="w-full px-3.5 py-2.5 bg-gray-50 border border-[#E5E7EB] rounded-xl text-sm font-medium text-gray-500 cursor-not-allowed">
        <p class="text-[11px] text-gray-400 mt-1">This email address is securely bound to your invitation.</p>
      </div>

      <div>
        <label for="name" class="block text-xs font-semibold text-[#5B5F6B] uppercase tracking-wider mb-1.5">Full Name *</label>
        <input type="text" id="name" name="name" required placeholder="e.g. John Doe" class="w-full px-3.5 py-2.5 bg-white border border-[#E5E7EB] rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[var(--accent-primary)] focus:border-transparent transition-all">
      </div>

      <% if (invite.role === 'student') { %>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="rollNo" class="block text-xs font-semibold text-[#5B5F6B] uppercase tracking-wider mb-1.5">Roll Number</label>
            <input type="text" id="rollNo" name="rollNo" placeholder="e.g. CS2026-105" class="w-full px-3.5 py-2.5 bg-white border border-[#E5E7EB] rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[var(--accent-primary)] focus:border-transparent transition-all">
          </div>
          <div>
            <label for="course" class="block text-xs font-semibold text-[#5B5F6B] uppercase tracking-wider mb-1.5">Course / Dept</label>
            <input type="text" id="course" name="course" placeholder="e.g. B.Tech CS" class="w-full px-3.5 py-2.5 bg-white border border-[#E5E7EB] rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[var(--accent-primary)] focus:border-transparent transition-all">
          </div>
        </div>
      <% } %>

      <div>
        <label for="password" class="block text-xs font-semibold text-[#5B5F6B] uppercase tracking-wider mb-1.5">Create Password *</label>
        <input type="password" id="password" name="password" required minlength="6" placeholder="At least 6 characters" class="w-full px-3.5 py-2.5 bg-white border border-[#E5E7EB] rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[var(--accent-primary)] focus:border-transparent transition-all">
      </div>

      <div class="pt-2">
        <label for="securityQuestion" class="block text-xs font-semibold text-[#5B5F6B] uppercase tracking-wider mb-1.5">Security Question *</label>
        <select id="securityQuestion" name="securityQuestion" class="w-full px-3.5 py-2.5 bg-white border border-[#E5E7EB] rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[var(--accent-primary)] focus:border-transparent transition-all">
          <option value="What is your favorite subject?">What is your favorite subject?</option>
          <option value="What was the name of your first school?">What was the name of your first school?</option>
          <option value="What city were you born in?">What city were you born in?</option>
        </select>
      </div>

      <div>
        <label for="securityAnswer" class="block text-xs font-semibold text-[#5B5F6B] uppercase tracking-wider mb-1.5">Security Answer *</label>
        <input type="text" id="securityAnswer" name="securityAnswer" required placeholder="Your answer" class="w-full px-3.5 py-2.5 bg-white border border-[#E5E7EB] rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[var(--accent-primary)] focus:border-transparent transition-all">
      </div>

      <button type="submit" class="w-full mt-4 py-2.5 px-4 bg-[var(--accent-primary)] hover:bg-[var(--accent-primary-hover)] text-white font-semibold rounded-xl text-sm transition-all shadow-sm">
        Activate Account &amp; Proceed
      </button>
    </form>

    <div class="mt-6 text-center text-xs text-gray-400">
      Already have an active account? <a href="/login" class="text-[var(--accent-primary)] font-semibold hover:underline">Sign In</a>
    </div>
  </div>

</body>
</html>
