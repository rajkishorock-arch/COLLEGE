<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Institution Setup Wizard - CampusPulse' %></title>
  
  <!-- Anti-Flash Instant Theme Detection -->
  <script>
    (function() {
      try {
        const theme = localStorage.getItem('campuspulse-theme') || 'system';
        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Google Fonts Pairing: Space Grotesk + Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[var(--bg-primary)] text-[var(--text-primary)] min-h-screen flex flex-col antialiased transition-colors duration-200">

  <!-- Top Navigation Header -->
  <header class="h-16 bg-[var(--bg-surface)] border-b border-[var(--border-subtle)] px-6 flex items-center justify-between sticky top-0 z-30">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-[8px] bg-[var(--accent-primary)] text-white flex items-center justify-center text-lg font-bold shadow-md shadow-[var(--accent-glow)]">
        <i class="fa-solid fa-graduation-cap"></i>
      </div>
      <div>
        <span class="font-bold text-base tracking-tight text-[var(--text-primary)] font-['Space_Grotesk'] leading-none">
          CAMPUS<span class="text-[var(--accent-primary)]">PULSE</span>
        </span>
        <span class="text-[10px] uppercase tracking-wider text-[var(--text-muted)] block font-medium mt-0.5">
          Self-Service Onboarding
        </span>
      </div>
    </div>

    <div class="flex items-center gap-4">
      <%- include('partials/theme-toggle') %>
      <div class="hidden sm:flex items-center gap-2 pl-3 border-l border-[var(--border-subtle)] text-xs text-[var(--text-secondary)]">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="font-medium"><%= user ? user.name : 'Administrator' %></span>
      </div>
    </div>
  </header>

  <!-- Main Wizard Container -->
  <main class="flex-1 max-w-4xl w-full mx-auto px-4 py-8 sm:py-12">
    
    <!-- Hero Header -->
    <div class="text-center mb-8 fade-slide-up">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-[rgba(108,92,231,0.12)] text-[var(--accent-primary)] border border-[rgba(108,92,231,0.25)] mb-3">
        <i class="fa-solid fa-wand-magic-sparkles text-xs"></i>
        <span>Autonomous SaaS Provisioning</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight font-['Space_Grotesk'] text-[var(--text-primary)]">
        Welcome to <%= tenant ? tenant.name : 'Your Institution' %>
      </h1>
      <p class="text-sm text-[var(--text-secondary)] max-w-md mx-auto mt-1.5">
        Complete these 4 rapid steps to personalize your institutional campus environment.
      </p>
    </div>

    <!-- 4-Step Progress Indicator -->
    <div class="mb-10 fade-slide-up stagger-1">
      <div class="grid grid-cols-4 gap-2 sm:gap-4 max-w-2xl mx-auto">
        
        <!-- Step 1 Indicator -->
        <a href="/onboarding/wizard?step=1" class="flex flex-col items-center group">
          <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm transition-all <%= step >= 1 ? 'bg-[var(--accent-primary)] text-white shadow-md shadow-[var(--accent-glow)]' : 'bg-[var(--bg-surface)] text-[var(--text-muted)] border border-[var(--border-subtle)]' %>">
            <% if (step > 1) { %><i class="fa-solid fa-check"></i><% } else { %>1<% } %>
          </div>
          <span class="text-[11px] font-semibold mt-2 text-center <%= step === 1 ? 'text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)]' %>">
            Profile
          </span>
        </a>

        <!-- Step 2 Indicator -->
        <a href="/onboarding/wizard?step=2" class="flex flex-col items-center group">
          <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm transition-all <%= step >= 2 ? 'bg-[var(--accent-primary)] text-white shadow-md shadow-[var(--accent-glow)]' : 'bg-[var(--bg-surface)] text-[var(--text-muted)] border border-[var(--border-subtle)]' %>">
            <% if (step > 2) { %><i class="fa-solid fa-check"></i><% } else { %>2<% } %>
          </div>
          <span class="text-[11px] font-semibold mt-2 text-center <%= step === 2 ? 'text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)]' %>">
            Academics
          </span>
        </a>

        <!-- Step 3 Indicator -->
        <a href="/onboarding/wizard?step=3" class="flex flex-col items-center group">
          <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm transition-all <%= step >= 3 ? 'bg-[var(--accent-primary)] text-white shadow-md shadow-[var(--accent-glow)]' : 'bg-[var(--bg-surface)] text-[var(--text-muted)] border border-[var(--border-subtle)]' %>">
            <% if (step > 3) { %><i class="fa-solid fa-check"></i><% } else { %>3<% } %>
          </div>
          <span class="text-[11px] font-semibold mt-2 text-center <%= step === 3 ? 'text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)]' %>">
            Team
          </span>
        </a>

        <!-- Step 4 Indicator -->
        <a href="/onboarding/wizard?step=4" class="flex flex-col items-center group">
          <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm transition-all <%= step >= 4 ? 'bg-[var(--accent-primary)] text-white shadow-md shadow-[var(--accent-glow)]' : 'bg-[var(--bg-surface)] text-[var(--text-muted)] border border-[var(--border-subtle)]' %>">
            <% if (step === 4) { %><i class="fa-solid fa-flag-checkered"></i><% } else { %>4<% } %>
          </div>
          <span class="text-[11px] font-semibold mt-2 text-center <%= step === 4 ? 'text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)]' %>">
            Launch
          </span>
        </a>

      </div>
    </div>

    <!-- Alerts -->
    <% if (error) { %>
      <div class="mb-6 p-4 rounded-[8px] bg-[#FEECEE] dark:bg-red-950/40 border border-[var(--danger)] text-[#E5384B] dark:text-red-400 text-sm font-medium flex items-center gap-3">
        <i class="fa-solid fa-circle-exclamation shrink-0"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <!-- STEP 1: Institution Profile -->
    <% if (step === 1) { %>
      <div class="card p-6 sm:p-8 fade-slide-up">
        <div class="border-b border-[var(--border-subtle)] pb-4 mb-6 flex items-center justify-between">
          <div>
            <h2 class="text-xl font-bold font-['Space_Grotesk'] text-[var(--text-primary)]">
              Step 1: Institutional Profile & Branding
            </h2>
            <p class="text-xs text-[var(--text-secondary)] mt-0.5">
              Confirm your official institution credentials and custom branding palette
            </p>
          </div>
          <span class="status-pill text-xs font-semibold badge-accent">Step 1 of 4</span>
        </div>

        <form action="/onboarding/wizard/step1" method="POST" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                Official Institution Name *
              </label>
              <input 
                type="text" 
                name="name" 
                required 
                value="<%= tenant ? tenant.name : '' %>"
                class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                Short Name / Acronym
              </label>
              <input 
                type="text" 
                name="short_name" 
                value="<%= tenant && tenant.short_name ? tenant.short_name : '' %>"
                placeholder="e.g. MIT, CPIT, STANFORD"
                class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                Institution Type
              </label>
              <select name="institution_type" class="w-full px-4 py-2.5 rounded-[8px] border text-sm">
                <option value="university" <%= tenant && tenant.institution_type === 'university' ? 'selected' : '' %>>University</option>
                <option value="college" <%= !tenant || tenant.institution_type === 'college' ? 'selected' : '' %>>College of Higher Education</option>
                <option value="engineering" <%= tenant && tenant.institution_type === 'engineering' ? 'selected' : '' %>>Institute of Technology / Engineering</option>
                <option value="medical" <%= tenant && tenant.institution_type === 'medical' ? 'selected' : '' %>>Medical / Health Sciences Institute</option>
                <option value="business" <%= tenant && tenant.institution_type === 'business' ? 'selected' : '' %>>Business & Management School</option>
                <option value="academy" <%= tenant && tenant.institution_type === 'academy' ? 'selected' : '' %>>Polytechnic / Academy</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                Contact Phone
              </label>
              <input 
                type="text" 
                name="phone" 
                value="<%= tenant && tenant.phone ? tenant.phone : '' %>"
                placeholder="+1 (555) 000-0000"
                class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
              Campus Address / Location
            </label>
            <input 
              type="text" 
              name="address" 
              value="<%= tenant && tenant.address ? tenant.address : '' %>"
              placeholder="e.g. 100 University Boulevard, Tech Campus"
              class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
            />
          </div>

          <div class="pt-4 border-t border-[var(--border-subtle)] flex items-center justify-between">
            <span class="text-xs text-[var(--text-muted)]">Institution ID: <code class="font-mono text-[var(--text-primary)]"><%= tenant ? tenant.id : '' %></code></span>
            <button type="submit" class="btn-primary">
              <span>Next: Academic Structure</span>
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </button>
          </div>
        </form>
      </div>
    <% } %>

    <!-- STEP 2: Academic Structure -->
    <% if (step === 2) { %>
      <% 
        const instType = (tenant && tenant.institution_type) ? tenant.institution_type.toLowerCase() : 'college';
        let suggestedDepts = [];
        let instTypeName = 'College / Higher Education';
        if (instType === 'engineering') {
          instTypeName = 'Institute of Technology / Engineering';
          suggestedDepts = [
            { name: 'Civil Engineering', code: 'CIVIL' },
            { name: 'Mechanical Engineering', code: 'MECH' },
            { name: 'Electrical & Electronics Engineering', code: 'EEE' },
            { name: 'Computer Science & Engineering', code: 'CSE' }
          ];
        } else if (instType === 'medical') {
          instTypeName = 'Medical / Health Sciences Institute';
          suggestedDepts = [
            { name: 'General Medicine', code: 'MED' },
            { name: 'General Surgery', code: 'SURG' },
            { name: 'Pediatrics', code: 'PED' },
            { name: 'Nursing & Allied Health', code: 'NURS' }
          ];
        } else if (instType === 'business') {
          instTypeName = 'Business & Management School';
          suggestedDepts = [
            { name: 'Finance & Accounting', code: 'FIN' },
            { name: 'Marketing Management', code: 'MKT' },
            { name: 'Operations & Supply Chain', code: 'OPS' },
            { name: 'Human Resources & Org Behavior', code: 'HR' }
          ];
        } else if (instType === 'university') {
          instTypeName = 'University';
          suggestedDepts = [
            { name: 'Faculty of Arts & Humanities', code: 'ARTS' },
            { name: 'Faculty of Natural Sciences', code: 'SCI' },
            { name: 'School of Engineering', code: 'ENG' },
            { name: 'Faculty of Law & Governance', code: 'LAW' }
          ];
        } else {
          suggestedDepts = [
            { name: 'English Literature', code: 'ENG' },
            { name: 'History & Political Science', code: 'HIST' },
            { name: 'Economics', code: 'ECON' },
            { name: 'Commerce & Accounting', code: 'COMM' }
          ];
        }
      %>
      <div class="card p-6 sm:p-8 fade-slide-up">
        <div class="border-b border-[var(--border-subtle)] pb-4 mb-6 flex items-center justify-between">
          <div>
            <h2 class="text-xl font-bold font-['Space_Grotesk'] text-[var(--text-primary)]">
              Step 2: Academic Structure & Departments
            </h2>
            <p class="text-xs text-[var(--text-secondary)] mt-0.5">
              Establish foundational departments and active academic term for your <span class="font-semibold text-[var(--accent-primary)]"><%= instTypeName %></span>
            </p>
          </div>
          <span class="status-pill text-xs font-semibold badge-accent">Step 2 of 4</span>
        </div>

        <form action="/onboarding/wizard/step2" method="POST" class="space-y-6">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
              Current Academic Session *
            </label>
            <input 
              type="text" 
              name="academic_year" 
              value="<%= tenant && tenant.academic_year ? tenant.academic_year : '2025-2026' %>"
              required 
              class="w-full max-w-sm px-4 py-2.5 rounded-[8px] border text-sm"
            />
          </div>

          <!-- Existing Configured Departments -->
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-2">
              Existing Configured Departments
            </label>
            <% if (departments && departments.length > 0) { %>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
                <% departments.forEach(dept => { %>
                  <div class="p-3.5 rounded-[8px] border border-[var(--border-subtle)] bg-[var(--bg-surface-hover)] flex items-center justify-between">
                    <div>
                      <p class="text-sm font-bold text-[var(--text-primary)]"><%= dept.name %></p>
                      <p class="text-xs text-[var(--text-muted)] font-mono">Code: <%= dept.code %></p>
                    </div>
                    <span class="badge badge-success text-[10px]">Active</span>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="p-4 rounded-[8px] border border-dashed border-[var(--border-subtle)] bg-[var(--bg-surface-hover)]/30 text-xs text-[var(--text-muted)] mb-4 flex items-center gap-2">
                <i class="fa-solid fa-circle-info text-[var(--text-secondary)]"></i>
                <span>No departments created yet. You can pick recommended departments below, type a custom one, or skip to configure later.</span>
              </div>
            <% } %>
          </div>

          <!-- Quick Recommendations based on Institution Type -->
          <div class="p-4 rounded-[8px] border border-[var(--border-subtle)] bg-[var(--bg-surface-hover)]/20">
            <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--accent-primary)] mb-2.5 flex items-center gap-2">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              <span>Recommended for <%= instTypeName %> (Select Any to Add)</span>
            </h3>
            <p class="text-xs text-[var(--text-muted)] mb-3">
              Click to select standard foundation departments for your institution:
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <% suggestedDepts.forEach(s => { 
                const alreadyExists = departments && departments.some(d => d.code === s.code || d.name.toLowerCase() === s.name.toLowerCase());
              %>
                <label class="p-3 rounded-[8px] border <%= alreadyExists ? 'border-emerald-300 bg-emerald-50/20 opacity-60 cursor-not-allowed' : 'border-[var(--border-subtle)] bg-[var(--bg-surface-hover)] hover:border-[var(--accent-primary)] cursor-pointer' %> flex items-center justify-between text-xs transition-colors">
                  <div class="flex items-center gap-2.5">
                    <input 
                      type="checkbox" 
                      name="selected_departments" 
                      value="<%= s.name %>|<%= s.code %>"
                      <%= alreadyExists ? 'checked disabled' : '' %>
                      class="rounded text-[var(--accent-primary)] focus:ring-0"
                    />
                    <div>
                      <span class="font-bold text-[var(--text-primary)] block"><%= s.name %></span>
                      <span class="text-[10px] text-[var(--text-muted)] font-mono">Code: <%= s.code %></span>
                    </div>
                  </div>
                  <% if (alreadyExists) { %>
                    <span class="text-[10px] text-emerald-600 font-semibold">Added</span>
                  <% } %>
                </label>
              <% }); %>
            </div>
          </div>

          <!-- Custom Department -->
          <div class="p-4 rounded-[8px] border border-dashed border-[var(--border-subtle)] bg-[var(--bg-surface-hover)]/40">
            <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--accent-primary)] mb-3 flex items-center gap-2">
              <i class="fa-solid fa-plus-circle"></i>
              <span>Add Custom Department (Optional)</span>
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <input 
                  type="text" 
                  name="new_department_name" 
                  placeholder="e.g. Electrical Engineering, Economics, Pediatrics"
                  class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
                />
              </div>
              <div>
                <input 
                  type="text" 
                  name="new_department_code" 
                  placeholder="Code (e.g. EE, ECON, PED)"
                  class="w-full px-4 py-2.5 rounded-[8px] border text-sm uppercase"
                />
              </div>
            </div>
          </div>

          <div class="pt-4 border-t border-[var(--border-subtle)] flex flex-wrap items-center justify-between gap-3">
            <a href="/onboarding/wizard?step=1" class="btn-secondary">
              <i class="fa-solid fa-arrow-left text-xs"></i>
              <span>Back</span>
            </a>
            <div class="flex items-center gap-2.5">
              <button type="submit" name="action" value="skip" class="btn-secondary text-xs">
                <span>Skip Department Setup for Now</span>
              </button>
              <button type="submit" class="btn-primary">
                <span>Next: Team Invitations</span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
              </button>
            </div>
          </div>
        </form>
      </div>
    <% } %>

    <!-- STEP 3: Initial Users -->
    <% if (step === 3) { %>
      <div class="card p-6 sm:p-8 fade-slide-up">
        <div class="border-b border-[var(--border-subtle)] pb-4 mb-6 flex items-center justify-between">
          <div>
            <h2 class="text-xl font-bold font-['Space_Grotesk'] text-[var(--text-primary)]">
              Step 3: Initial Staff & Faculty (Optional)
            </h2>
            <p class="text-xs text-[var(--text-secondary)] mt-0.5">
              Send fast cryptographic invitations to colleagues or skip and invite later from admin portal
            </p>
          </div>
          <span class="status-pill text-xs font-semibold badge-accent">Step 3 of 4</span>
        </div>

        <form action="/onboarding/wizard/step3" method="POST" class="space-y-6">
          <div class="space-y-4">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                Faculty / Professor Email (Optional)
              </label>
              <input 
                type="email" 
                name="faculty_email" 
                placeholder="faculty.lead@college.edu"
                class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
              />
              <p class="text-[11px] text-[var(--text-muted)] mt-1">
                Will be provisioned with institutional management privileges
              </p>
            </div>

            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-1.5">
                Academic Staff / Registrar Email (Optional)
              </label>
              <input 
                type="email" 
                name="staff_email" 
                placeholder="registrar@college.edu"
                class="w-full px-4 py-2.5 rounded-[8px] border text-sm"
              />
            </div>
          </div>

          <div class="p-4 rounded-[8px] bg-[rgba(108,92,231,0.06)] border border-[rgba(108,92,231,0.2)] text-xs text-[var(--text-secondary)] flex items-start gap-3">
            <i class="fa-solid fa-shield-halved text-[var(--accent-primary)] text-sm shrink-0 mt-0.5"></i>
            <div>
              <p class="font-bold text-[var(--text-primary)]">Cryptographically Verified Invitations</p>
              <p class="mt-0.5">Invited users receive single-use secure tokens strictly bound to your tenant ID. They can never access data belonging to other institutions.</p>
            </div>
          </div>

          <div class="pt-4 border-t border-[var(--border-subtle)] flex items-center justify-between">
            <button type="submit" name="action" value="skip" class="btn-secondary">
              <span>Skip for Now</span>
            </button>
            <button type="submit" name="action" value="continue" class="btn-primary">
              <span>Save & Continue</span>
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </button>
          </div>
        </form>
      </div>
    <% } %>

    <!-- STEP 4: Ready to Launch -->
    <% if (step === 4) { %>
      <div class="card p-6 sm:p-10 fade-slide-up text-center">
        
        <div class="w-16 h-16 rounded-full bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-3xl mx-auto mb-5 shadow-lg shadow-emerald-500/10">
          <i class="fa-solid fa-circle-check"></i>
        </div>

        <h2 class="text-2xl sm:text-3xl font-bold font-['Space_Grotesk'] text-[var(--text-primary)] tracking-tight">
          Your CampusPulse Institution is Ready!
        </h2>
        <p class="text-sm text-[var(--text-secondary)] max-w-lg mx-auto mt-2 leading-relaxed">
          <strong><%= tenant ? tenant.name : 'Your institution' %></strong> is fully provisioned with isolated database Row-Level Security, private object storage, and dedicated admin controls.
        </p>

        <!-- Summary Specs Card -->
        <div class="my-8 max-w-lg mx-auto p-5 rounded-[12px] bg-[var(--bg-surface-hover)] border border-[var(--border-subtle)] text-left space-y-3">
          <div class="flex items-center justify-between text-xs pb-2 border-b border-[var(--border-subtle)]">
            <span class="text-[var(--text-muted)]">Institution Code</span>
            <span class="font-mono font-bold text-[var(--text-primary)]"><%= tenant ? tenant.code : 'CODE' %></span>
          </div>
          <div class="flex items-center justify-between text-xs pb-2 border-b border-[var(--border-subtle)]">
            <span class="text-[var(--text-muted)]">Tenant Isolation Plane</span>
            <span class="badge badge-success text-[10px]">Row-Level Security Active</span>
          </div>
          <div class="flex items-center justify-between text-xs pb-2 border-b border-[var(--border-subtle)]">
            <span class="text-[var(--text-muted)]">Owner / Lead Administrator</span>
            <span class="font-medium text-[var(--text-primary)]"><%= user ? user.name : 'Administrator' %> (<%= user ? user.email : '' %>)</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span class="text-[var(--text-muted)]">Active Academic Term</span>
            <span class="font-medium text-[var(--text-primary)]"><%= tenant ? tenant.academic_year : '2025-2026' %></span>
          </div>
        </div>

        <form action="/onboarding/wizard/finish" method="POST">
          <button type="submit" class="btn-primary py-3.5 px-8 text-base shadow-lg shadow-[var(--accent-glow)]">
            <i class="fa-solid fa-rocket mr-2"></i>
            <span>Launch Administrator Dashboard</span>
          </button>
        </form>

      </div>
    <% } %>

  </main>

  <script src="/js/main.js"></script>
</body>
</html>
